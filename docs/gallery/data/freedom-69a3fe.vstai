{"format":1,"name":"Freedom","assembly":"const MAX_FRAMES: i32 = 8192;\nconst MAX_CHANNELS: i32 = 2;\nconst MAX_PARAMS: i32 = 64;\nconst NV: i32 = 16;\nconst NU: i32 = 8;\nconst CH: i32 = 32;\nconst PI: f32 = 3.14159265;\nconst NOISE_SCALE: f32 = 4.656613e-10;\n\nconst inBuf = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\nconst outBuf = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\nconst params = new StaticArray<f32>(MAX_PARAMS);\n\nlet sampleRate: f32 = 44100;\nlet rng: u32 = 2463534242;\nlet counter: i32 = 0;\nlet lastFreq: f32 = 0;\nlet gSync: bool = false;\nlet gUnison: i32 = 1;\nlet gGlideCoef: f32 = 1;\nlet gm: f32 = 0.7;\nlet fG: f32 = 0.1;\nlet fK: f32 = 1;\nlet fA: f32 = 1;\nlet fType: i32 = 0;\nlet smOct: f32 = 11.5;\nlet smRes: f32 = 0.2;\nlet smDrv: f32 = 0.1;\nlet cw: i32 = 0;\nlet cph: f32 = 0;\nlet stN: i32 = 0;\n\nconst vActive = new StaticArray<i32>(NV);\nconst vNote = new StaticArray<i32>(NV);\nconst vGate = new StaticArray<i32>(NV);\nconst vAge = new StaticArray<i32>(NV);\nconst vFreq = new StaticArray<f32>(NV);\nconst vTgt = new StaticArray<f32>(NV);\nconst vVel = new StaticArray<f32>(NV);\nconst vSub = new StaticArray<f32>(NV);\nconst eSt = new StaticArray<i32>(NV * 3);\nconst eLv = new StaticArray<f32>(NV * 3);\nconst vF = new StaticArray<f32>(NV * 8);\nconst vPh = new StaticArray<f32>(NV * NU * 3);\nconst vPink = new StaticArray<f32>(NV * 9);\n\nconst eInc = new StaticArray<f32>(3);\nconst eDc = new StaticArray<f32>(3);\nconst eSu = new StaticArray<f32>(3);\nconst eRc = new StaticArray<f32>(3);\nconst lfoPh = new StaticArray<f32>(3);\nconst lfoCur = new StaticArray<f32>(3);\nconst lfoPrev = new StaticArray<f32>(3);\nconst stId = new StaticArray<i32>(16);\nconst stF = new StaticArray<f32>(16);\nconst stV = new StaticArray<f32>(16);\n\nconst incArr = new StaticArray<f32>(NU * 3);\nconst gLArr = new StaticArray<f32>(NU);\nconst gRArr = new StaticArray<f32>(NU);\nconst oInc = new StaticArray<f32>(3);\nconst oVol = new StaticArray<f32>(3);\nconst oPw = new StaticArray<f32>(3);\nconst oWave = new StaticArray<i32>(3);\nconst ms = new StaticArray<f32>(11);\nconst md = new StaticArray<f32>(8);\nconst slotSrc = new StaticArray<i32>(4);\nconst slotDst = new StaticArray<i32>(4);\nconst slotDep = new StaticArray<f32>(4);\nconst lfoBuf = new StaticArray<f32>(768);\nconst cutBuf = new StaticArray<f32>(256);\nconst resBuf = new StaticArray<f32>(256);\nconst drvBuf = new StaticArray<f32>(256);\nconst cbL = new StaticArray<f32>(8192);\nconst cbR = new StaticArray<f32>(8192);\n\nfunction clampf(x: f32, lo: f32, hi: f32): f32 {\n  if (x < lo) return lo;\n  if (x > hi) return hi;\n  return x;\n}\n\nfunction absf(x: f32): f32 {\n  return x < 0.0 ? -x : x;\n}\n\nfunction noise(): f32 {\n  rng ^= rng << 13;\n  rng ^= rng >> 17;\n  rng ^= rng << 5;\n  return f32(i32(rng)) * NOISE_SCALE;\n}\n\nfunction fastTanh(x: f32): f32 {\n  const c: f32 = clampf(x, -3.0, 3.0);\n  const c2: f32 = c * c;\n  return c * (27.0 + c2) / (27.0 + 9.0 * c2);\n}\n\nfunction sineApprox(p: f32): f32 {\n  const t: f32 = p * 2.0 - 1.0;\n  let y: f32 = 4.0 * t * (1.0 - absf(t));\n  y = 0.225 * (y * absf(y) - y) + y;\n  return y;\n}\n\nfunction blep(t: f32, dt: f32): f32 {\n  if (t < dt) {\n    const x: f32 = t / dt;\n    return x + x - x * x - 1.0;\n  }\n  if (t > 1.0 - dt) {\n    const x: f32 = (t - 1.0) / dt;\n    return x * x + x + x + 1.0;\n  }\n  return 0.0;\n}\n\nfunction oscSample(wave: i32, p: f32, dt: f32, pw: f32): f32 {\n  if (wave == 0) return sineApprox(p);\n  if (wave == 1) return 4.0 * absf(p - 0.5) - 1.0;\n  if (wave == 2) return (2.0 * p - 1.0) - blep(p, dt);\n  if (wave == 3) {\n    let y: f32 = p < 0.5 ? 1.0 : -1.0;\n    y += blep(p, dt);\n    let q: f32 = p + 0.5;\n    if (q >= 1.0) q -= 1.0;\n    y -= blep(q, dt);\n    return y;\n  }\n  if (wave == 4) {\n    let y: f32 = p < pw ? 1.0 : -1.0;\n    y += blep(p, dt);\n    let q: f32 = p - pw;\n    if (q < 0.0) q += 1.0;\n    y -= blep(q, dt);\n    return y;\n  }\n  return 0.0;\n}\n\nfunction timeOf(p: f32): f32 {\n  return 0.001 * Mathf.pow(10000.0, clampf(p, 0.0, 1.0));\n}\n\nfunction lfoShape(k: i32, shape: i32, p: f32): f32 {\n  if (shape == 0) return sineApprox(p);\n  if (shape == 1) return 4.0 * absf(p - 0.5) - 1.0;\n  if (shape == 2) return 2.0 * p - 1.0;\n  if (shape == 3) return 1.0 - 2.0 * p;\n  if (shape == 4) return p < 0.5 ? 1.0 : -1.0;\n  if (shape == 5) return lfoCur[k];\n  const x: f32 = p * p * (3.0 - 2.0 * p);\n  return lfoPrev[k] + (lfoCur[k] - lfoPrev[k]) * x;\n}\n\nfunction envStep(i: i32, e: i32): f32 {\n  let st: i32 = eSt[i];\n  let lv: f32 = eLv[i];\n  if (st == 1) {\n    lv += eInc[e];\n    if (lv >= 1.0) {\n      lv = 1.0;\n      st = 2;\n    }\n  } else if (st == 2) {\n    const s: f32 = eSu[e];\n    lv = s + (lv - s) * eDc[e];\n    if (absf(lv - s) < 0.0005) {\n      lv = s;\n      st = 3;\n    }\n  } else if (st == 3) {\n    lv = eSu[e];\n  } else if (st == 4) {\n    lv = lv * eRc[e];\n    if (lv < 0.0002) {\n      lv = 0.0;\n      st = 0;\n    }\n  }\n  eSt[i] = st;\n  eLv[i] = lv;\n  return lv;\n}\n\nfunction svfStage(x: f32, idx: i32, mode: i32): f32 {\n  const s1: f32 = vF[idx];\n  const s2: f32 = vF[idx + 1];\n  const hp: f32 = (x - (fK + fG) * s1 - s2) * fA;\n  const bp: f32 = fG * hp + s1;\n  const lp: f32 = fG * bp + s2;\n  vF[idx] = fG * hp + bp;\n  vF[idx + 1] = fG * bp + lp;\n  if (mode == 0) return lp;\n  if (mode == 1) return hp;\n  if (mode == 2) return fK * bp;\n  return lp + hp;\n}\n\nfunction filt(x: f32, idx: i32): f32 {\n  let y: f32 = 0;\n  if (fType == 0) {\n    y = svfStage(x, idx, 0);\n  } else if (fType == 1) {\n    y = svfStage(svfStage(x, idx, 0), idx + 2, 0);\n  } else if (fType == 2) {\n    y = svfStage(x, idx, 1);\n  } else if (fType == 3) {\n    y = svfStage(svfStage(x, idx, 1), idx + 2, 1);\n  } else if (fType == 4) {\n    y = svfStage(x, idx, 2);\n  } else {\n    y = svfStage(x, idx, 3);\n  }\n  if (!(y > -200.0 && y < 200.0)) {\n    vF[idx] = 0.0;\n    vF[idx + 1] = 0.0;\n    vF[idx + 2] = 0.0;\n    vF[idx + 3] = 0.0;\n    y = 0.0;\n  }\n  return fastTanh(y * 0.3) * 3.3333;\n}\n\nfunction readDelay(buf: StaticArray<f32>, w: i32, d: f32): f32 {\n  const rp: f32 = f32(w) - d;\n  const fi: f32 = Mathf.floor(rp);\n  const fr: f32 = rp - fi;\n  const i0: i32 = i32(fi) & 8191;\n  const i1: i32 = (i0 + 1) & 8191;\n  return buf[i0] * (1.0 - fr) + buf[i1] * fr;\n}\n\nfunction stackRemove(id: i32): void {\n  let at: i32 = -1;\n  for (let i: i32 = 0; i < stN; i++) {\n    if (stId[i] == id) at = i;\n  }\n  if (at < 0) return;\n  for (let i: i32 = at; i < stN - 1; i++) {\n    stId[i] = stId[i + 1];\n    stF[i] = stF[i + 1];\n    stV[i] = stV[i + 1];\n  }\n  stN = stN - 1;\n}\n\nfunction stackPush(id: i32, f: f32, v: f32): void {\n  if (stN >= 16) {\n    for (let i: i32 = 0; i < 15; i++) {\n      stId[i] = stId[i + 1];\n      stF[i] = stF[i + 1];\n      stV[i] = stV[i + 1];\n    }\n    stN = 15;\n  }\n  stId[stN] = id;\n  stF[stN] = f;\n  stV[stN] = v;\n  stN = stN + 1;\n}\n\nfunction releaseVoice(v: i32): void {\n  vGate[v] = 0;\n  for (let e: i32 = 0; e < 3; e++) {\n    if (eSt[v * 3 + e] != 0) eSt[v * 3 + e] = 4;\n  }\n}\n\nfunction startVoice(v: i32, id: i32, f: f32, vel: f32, retrig: bool): void {\n  const wasActive: bool = vActive[v] != 0;\n  vNote[v] = id;\n  vGate[v] = 1;\n  vTgt[v] = f;\n  vVel[v] = vel;\n  vAge[v] = counter;\n  counter = counter + 1;\n  if (!wasActive) {\n    vActive[v] = 1;\n    vFreq[v] = (params[4] > 0.003 && lastFreq > 0.0) ? lastFreq : f;\n    for (let e: i32 = 0; e < 3; e++) {\n      eLv[v * 3 + e] = 0.0;\n      eSt[v * 3 + e] = 0;\n    }\n    for (let j: i32 = 0; j < NU * 3; j++) {\n      vPh[v * NU * 3 + j] = (noise() + 1.0) * 0.5;\n    }\n    vSub[v] = 0.0;\n    for (let j: i32 = 0; j < 8; j++) vF[v * 8 + j] = 0.0;\n    for (let j: i32 = 0; j < 9; j++) vPink[v * 9 + j] = 0.0;\n  }\n  if (retrig) {\n    for (let e: i32 = 0; e < 3; e++) eSt[v * 3 + e] = 1;\n  }\n  lastFreq = f;\n}\n\nfunction allocVoice(): i32 {\n  for (let v: i32 = 0; v < NV; v++) {\n    if (vActive[v] == 0) return v;\n  }\n  let best: i32 = -1;\n  let bestAge: i32 = 0x7fffffff;\n  for (let v: i32 = 0; v < NV; v++) {\n    if (vGate[v] == 0 && vAge[v] < bestAge) {\n      best = v;\n      bestAge = vAge[v];\n    }\n  }\n  if (best >= 0) return best;\n  for (let v: i32 = 0; v < NV; v++) {\n    if (vAge[v] < bestAge) {\n      best = v;\n      bestAge = vAge[v];\n    }\n  }\n  return best < 0 ? 0 : best;\n}\n\nfunction renderVoice(v: i32, frames: i32): void {\n  const nu: i32 = gUnison;\n  const sr: f32 = sampleRate;\n  const vb: i32 = v * 3;\n  const uniDet: f32 = clampf(params[3], 0.0, 1.0);\n  const nuF: f32 = f32(nu);\n  const ug: f32 = 0.5 / Mathf.sqrt(nuF);\n  const fType0: i32 = i32(Mathf.floor(params[28] + 0.5));\n  let ci: i32 = 0;\n  for (let c0: i32 = 0; c0 < frames; c0 += CH) {\n    let c1: i32 = c0 + CH;\n    if (c1 > frames) c1 = frames;\n\n    vFreq[v] = vFreq[v] + (vTgt[v] - vFreq[v]) * gGlideCoef;\n    const fr: f32 = vFreq[v] < 1.0 ? 1.0 : vFreq[v];\n    const ampE: f32 = eLv[vb];\n    const fltE: f32 = eLv[vb + 1];\n    const modE: f32 = eLv[vb + 2];\n    const keyOct: f32 = Mathf.log2(fr / 261.63);\n    ms[0] = 0.0;\n    ms[1] = lfoBuf[ci * 3];\n    ms[2] = lfoBuf[ci * 3 + 1];\n    ms[3] = lfoBuf[ci * 3 + 2];\n    ms[4] = ampE;\n    ms[5] = fltE;\n    ms[6] = modE;\n    ms[7] = vVel[v];\n    ms[8] = params[6];\n    ms[9] = params[8];\n    ms[10] = clampf(keyOct / 5.0, -1.0, 1.0);\n    for (let d: i32 = 0; d < 8; d++) md[d] = 0.0;\n    for (let s: i32 = 0; s < 4; s++) {\n      if (slotSrc[s] > 0 && slotDst[s] > 0) {\n        md[slotDst[s]] = md[slotDst[s]] + ms[slotSrc[s]] * slotDep[s];\n      }\n    }\n\n    const baseSemi: f32 = params[5] * 0.01 + params[7] * 2.0 + md[1] * 12.0 + md[7] * 0.5;\n    for (let k: i32 = 0; k < 3; k++) {\n      const o: i32 = 9 + k * 5;\n      const semi: f32 = Mathf.floor(params[o + 1] + 0.5) * 12.0 + params[o + 2] + baseSemi;\n      oInc[k] = fr * Mathf.pow(2.0, semi / 12.0) / sr;\n      oWave[k] = i32(Mathf.floor(params[o] + 0.5));\n      oVol[k] = clampf(params[o + 3], 0.0, 1.0);\n      oPw[k] = clampf(params[o + 4] + md[6] * 0.45, 0.05, 0.95);\n    }\n    const subInc: f32 = fr * (params[26] > 1.5 ? 0.25 : 0.5) / sr;\n    const subLvl: f32 = clampf(params[25], 0.0, 1.0);\n    const nzLvl: f32 = clampf(params[27], 0.0, 1.0) * 0.5;\n\n    for (let u: i32 = 0; u < nu; u++) {\n      let sp: f32 = 0.0;\n      let ratio: f32 = 1.0;\n      if (nu > 1) {\n        sp = f32(u) * 2.0 / f32(nu - 1) - 1.0;\n        ratio = Mathf.pow(2.0, sp * uniDet * 50.0 / 1200.0);\n      }\n      for (let k: i32 = 0; k < 3; k++) {\n        incArr[u * 3 + k] = clampf(oInc[k] * ratio, 0.00001, 0.45);\n      }\n      const pan: f32 = clampf(sp * 0.85 + md[5], -1.0, 1.0);\n      const ang: f32 = (pan + 1.0) * 0.78539816;\n      gLArr[u] = Mathf.cos(ang) * ug * 1.4142;\n      gRArr[u] = Mathf.sin(ang) * ug * 1.4142;\n    }\n\n    const cutOct: f32 = cutBuf[ci] + params[32] * keyOct + params[33] * fltE * 5.0 + (vVel[v] - 0.5) * params[34] * 3.0 + md[2] * 4.0;\n    let fc: f32 = Mathf.pow(2.0, clampf(cutOct, 3.0, 15.0));\n    fc = clampf(fc, 20.0, 0.45 * sr);\n    if (fc > 20000.0) fc = 20000.0;\n    fG = Mathf.tan(PI * fc / sr);\n    const rs: f32 = clampf(resBuf[ci] + md[3] * 0.5, 0.0, 1.0);\n    fK = 2.0 * (1.0 - rs * 0.99);\n    fA = 1.0 / (1.0 + fK * fG + fG * fG);\n    fType = fType0;\n    const pg: f32 = 0.8 * (1.0 + clampf(drvBuf[ci], 0.0, 1.0) * 6.0);\n    const ampGain: f32 = clampf(1.0 + md[4], 0.0, 2.0) * (0.3 + 0.7 * vVel[v]);\n\n    for (let s: i32 = c0; s < c1; s++) {\n      let aL: f32 = 0.0;\n      let aR: f32 = 0.0;\n      for (let u: i32 = 0; u < nu; u++) {\n        const pb: i32 = (v * NU + u) * 3;\n        const ib: i32 = u * 3;\n        let wrapped: bool = false;\n        let sum: f32 = 0.0;\n        const dt0: f32 = incArr[ib];\n        let p0: f32 = vPh[pb] + dt0;\n        if (p0 >= 1.0) {\n          p0 -= 1.0;\n          wrapped = true;\n        }\n        vPh[pb] = p0;\n        if (oVol[0] > 0.0 && oWave[0] < 5) {\n          sum += oscSample(oWave[0], p0, dt0, oPw[0]) * oVol[0];\n        }\n        for (let k: i32 = 1; k < 3; k++) {\n          const dtk: f32 = incArr[ib + k];\n          let pk: f32 = vPh[pb + k] + dtk;\n          if (gSync && wrapped) pk = p0 * dtk / dt0;\n          if (pk >= 1.0) pk -= 1.0;\n          vPh[pb + k] = pk;\n          if (oVol[k] > 0.0 && oWave[k] < 5) {\n            sum += oscSample(oWave[k], pk, dtk, oPw[k]) * oVol[k];\n          }\n        }\n        aL += sum * gLArr[u];\n        aR += sum * gRArr[u];\n      }\n\n      let nz: f32 = 0.0;\n      if (nzLvl > 0.0) nz += noise() * nzLvl;\n      for (let k: i32 = 0; k < 3; k++) {\n        if (oWave[k] >= 5 && oVol[k] > 0.0) {\n          const w: f32 = noise();\n          if (oWave[k] == 5) {\n            nz += w * oVol[k] * 0.5;\n          } else {\n            const pi: i32 = v * 9 + k * 3;\n            const b0: f32 = vPink[pi] * 0.99765 + w * 0.099046;\n            const b1: f32 = vPink[pi + 1] * 0.963 + w * 0.2965164;\n            const b2: f32 = vPink[pi + 2] * 0.57 + w * 1.0526913;\n            vPink[pi] = b0;\n            vPink[pi + 1] = b1;\n            vPink[pi + 2] = b2;\n            nz += (b0 + b1 + b2 + w * 0.1848) * 0.2 * oVol[k];\n          }\n        }\n      }\n      if (subLvl > 0.0) {\n        let sph: f32 = vSub[v] + subInc;\n        if (sph >= 1.0) sph -= 1.0;\n        vSub[v] = sph;\n        let sq: f32 = sph < 0.5 ? 1.0 : -1.0;\n        sq += blep(sph, subInc);\n        let q: f32 = sph + 0.5;\n        if (q >= 1.0) q -= 1.0;\n        sq -= blep(q, subInc);\n        nz += sq * subLvl * 0.7;\n      }\n      aL += nz * 0.4;\n      aR += nz * 0.4;\n\n      const ae: f32 = envStep(vb, 0);\n      envStep(vb + 1, 1);\n      envStep(vb + 2, 2);\n\n      const xl: f32 = fastTanh(aL * pg);\n      const xr: f32 = fastTanh(aR * pg);\n      const yl: f32 = filt(xl, v * 8);\n      const yr: f32 = filt(xr, v * 8 + 4);\n      const g: f32 = ae * ampGain;\n      outBuf[s] = outBuf[s] + yl * g;\n      outBuf[MAX_FRAMES + s] = outBuf[MAX_FRAMES + s] + yr * g;\n    }\n    ci++;\n    if (eSt[vb] == 0) {\n      vActive[v] = 0;\n      return;\n    }\n  }\n}\n\nfunction setDefaults(): void {\n  params[0] = 0.7;\n  params[1] = 0;\n  params[2] = 1;\n  params[3] = 0.3;\n  params[4] = 0;\n  params[5] = 0;\n  params[6] = 0;\n  params[7] = 0;\n  params[8] = 0;\n  params[9] = 2;\n  params[10] = 0;\n  params[11] = 0;\n  params[12] = 0.7;\n  params[13] = 0.5;\n  params[14] = 2;\n  params[15] = 0;\n  params[16] = 0.1;\n  params[17] = 0.5;\n  params[18] = 0.5;\n  params[19] = 3;\n  params[20] = -1;\n  params[21] = 0;\n  params[22] = 0;\n  params[23] = 0.5;\n  params[24] = 0;\n  params[25] = 0.3;\n  params[26] = 1;\n  params[27] = 0;\n  params[28] = 1;\n  params[29] = 3000;\n  params[30] = 0.2;\n  params[31] = 0.1;\n  params[32] = 0.4;\n  params[33] = 0.3;\n  params[34] = 0.3;\n  params[35] = 0.25;\n  params[36] = 0.65;\n  params[37] = 0.7;\n  params[38] = 0.6;\n  params[39] = 0.2;\n  params[40] = 0.65;\n  params[41] = 0.3;\n  params[42] = 0.6;\n  params[43] = 0.5;\n  params[44] = 0.6;\n  params[45] = 0.5;\n  params[46] = 0.6;\n  params[47] = 4;\n  params[48] = 0.5;\n  params[49] = 0;\n  params[50] = 1;\n  params[51] = 0.5;\n  params[52] = 0;\n  params[53] = 0.3;\n  params[54] = 0.5;\n  params[55] = 0;\n  params[56] = 0.3;\n  params[57] = 0;\n  params[58] = 0.8;\n  params[59] = 0;\n  params[60] = 100;\n  params[61] = 100;\n  params[62] = 100;\n  params[63] = 100;\n}\n\nexport function init(sr: f32, maxFrames: i32, ch: i32): void {\n  sampleRate = sr > 8000.0 ? sr : 44100.0;\n  setDefaults();\n  for (let v: i32 = 0; v < NV; v++) {\n    vActive[v] = 0;\n    vNote[v] = -1;\n    vGate[v] = 0;\n    vAge[v] = 0;\n    vFreq[v] = 440.0;\n    vTgt[v] = 440.0;\n    vVel[v] = 0.0;\n    vSub[v] = 0.0;\n  }\n  for (let i: i32 = 0; i < NV * 3; i++) {\n    eSt[i] = 0;\n    eLv[i] = 0.0;\n  }\n  for (let i: i32 = 0; i < NV * 8; i++) vF[i] = 0.0;\n  for (let i: i32 = 0; i < NV * 9; i++) vPink[i] = 0.0;\n  for (let i: i32 = 0; i < NV * NU * 3; i++) vPh[i] = 0.0;\n  for (let k: i32 = 0; k < 3; k++) {\n    lfoPh[k] = 0.0;\n    lfoCur[k] = 0.0;\n    lfoPrev[k] = 0.0;\n  }\n  for (let i: i32 = 0; i < 8192; i++) {\n    cbL[i] = 0.0;\n    cbR[i] = 0.0;\n  }\n  stN = 0;\n  counter = 0;\n  lastFreq = 0.0;\n  cw = 0;\n  cph = 0.0;\n  gm = params[0];\n  smOct = Mathf.log2(clampf(params[29], 20.0, 20000.0));\n  smRes = params[30];\n  smDrv = params[31];\n}\n\nexport function getInputPtr(): usize { return changetype<usize>(inBuf); }\nexport function getOutputPtr(): usize { return changetype<usize>(outBuf); }\nexport function getParamsPtr(): usize { return changetype<usize>(params); }\nexport function getNumParams(): i32 { return 64; }\n\nexport function noteOn(id: i32, f: f32, v: f32): void {\n  let vel: f32 = v;\n  if (vel > 1.0) vel = vel / 127.0;\n  vel = clampf(vel, 0.02, 1.0);\n  const fr: f32 = f < 20.0 ? 20.0 : f;\n  const mode: i32 = i32(Mathf.floor(params[1] + 0.5));\n  if (mode == 0) {\n    startVoice(allocVoice(), id, fr, vel, true);\n    return;\n  }\n  stackRemove(id);\n  stackPush(id, fr, vel);\n  const legato: bool = mode == 2 && vActive[0] != 0 && vGate[0] != 0;\n  startVoice(0, id, fr, vel, !legato);\n}\n\nexport function noteOff(id: i32): void {\n  const mode: i32 = i32(Mathf.floor(params[1] + 0.5));\n  if (mode != 0) {\n    stackRemove(id);\n    if (stN > 0) {\n      if (vNote[0] == id && vGate[0] != 0) {\n        vNote[0] = stId[stN - 1];\n        vTgt[0] = stF[stN - 1];\n        vVel[0] = stV[stN - 1];\n      }\n      return;\n    }\n  }\n  for (let v: i32 = 0; v < NV; v++) {\n    if (vNote[v] == id && vGate[v] != 0) releaseVoice(v);\n  }\n}\n\nexport function process(n: i32): void {\n  const frames: i32 = n > MAX_FRAMES ? MAX_FRAMES : n;\n  if (frames <= 0) return;\n  const sr: f32 = sampleRate;\n  for (let f: i32 = 0; f < frames; f++) {\n    outBuf[f] = 0.0;\n    outBuf[MAX_FRAMES + f] = 0.0;\n  }\n\n  gUnison = i32(Mathf.floor(clampf(params[2], 1.0, 8.0) + 0.5));\n  gSync = params[24] > 0.5;\n  const gl: f32 = clampf(params[4], 0.0, 1.0);\n  if (gl < 0.003) {\n    gGlideCoef = 1.0;\n  } else {\n    gGlideCoef = 1.0 - Mathf.exp(-f32(CH) / (sr * (0.005 + gl * gl * 3.0)));\n  }\n\n  for (let e: i32 = 0; e < 3; e++) {\n    const b: i32 = 35 + e * 4;\n    const a: f32 = timeOf(params[b]);\n    eInc[e] = clampf(1.0 / (a * sr), 0.0, 1.0);\n    eDc[e] = Mathf.exp(-4.6 / (timeOf(params[b + 1]) * sr));\n    eSu[e] = clampf(params[b + 2], 0.0, 1.0);\n    eRc[e] = Mathf.exp(-4.6 / (timeOf(params[b + 3]) * sr));\n  }\n\n  for (let s: i32 = 0; s < 4; s++) {\n    let code: i32 = i32(Mathf.floor(params[60 + s] + 0.5));\n    if (code < 0) code = 0;\n    if (code > 17687) code = 17687;\n    const sd: i32 = code / 201;\n    slotDep[s] = f32(code - sd * 201 - 100) / 100.0;\n    slotSrc[s] = sd / 8;\n    slotDst[s] = sd - (sd / 8) * 8;\n  }\n\n  const nChunks: i32 = (frames + CH - 1) / CH;\n  const cutTarget: f32 = Mathf.log2(clampf(params[29], 20.0, 20000.0));\n  for (let ci: i32 = 0; ci < nChunks; ci++) {\n    let len: i32 = frames - ci * CH;\n    if (len > CH) len = CH;\n    for (let k: i32 = 0; k < 3; k++) {\n      const pb: i32 = 47 + k * 3;\n      const rate: f32 = clampf(params[pb], 0.01, 40.0);\n      const depth: f32 = clampf(params[pb + 1], 0.0, 1.0);\n      const shape: i32 = i32(Mathf.floor(params[pb + 2] + 0.5));\n      let ph: f32 = lfoPh[k] + rate * f32(len) / sr;\n      if (ph >= 1.0) {\n        ph -= 1.0;\n        lfoPrev[k] = lfoCur[k];\n        lfoCur[k] = noise();\n      }\n      lfoPh[k] = ph;\n      lfoBuf[ci * 3 + k] = lfoShape(k, shape, ph) * depth;\n    }\n    smOct = smOct + (cutTarget - smOct) * 0.25;\n    smRes = smRes + (params[30] - smRes) * 0.25;\n    smDrv = smDrv + (params[31] - smDrv) * 0.25;\n    cutBuf[ci] = smOct;\n    resBuf[ci] = smRes;\n    drvBuf[ci] = smDrv;\n  }\n\n  for (let v: i32 = 0; v < NV; v++) {\n    if (vActive[v] != 0) renderVoice(v, frames);\n  }\n\n  const dd: f32 = clampf(params[56], 0.0, 1.0);\n  const dm: f32 = clampf(params[57], 0.0, 1.0);\n  const crate: f32 = clampf(params[58], 0.05, 10.0);\n  const dep: f32 = clampf(params[59], 0.0, 1.0);\n  const cInc: f32 = crate / sr;\n  const mTarget: f32 = clampf(params[0], 0.0, 1.0);\n  for (let s: i32 = 0; s < frames; s++) {\n    let l: f32 = outBuf[s];\n    let r: f32 = outBuf[MAX_FRAMES + s];\n    if (dm > 0.001) {\n      const dg: f32 = 1.0 + dd * 20.0;\n      const wl: f32 = fastTanh(l * dg) * 0.6;\n      const wr: f32 = fastTanh(r * dg) * 0.6;\n      l = l * (1.0 - dm) + wl * dm;\n      r = r * (1.0 - dm) + wr * dm;\n    }\n    cbL[cw] = l;\n    cbR[cw] = r;\n    if (dep > 0.001) {\n      const mL: f32 = sineApprox(cph);\n      let q: f32 = cph + 0.25;\n      if (q >= 1.0) q -= 1.0;\n      const mR: f32 = sineApprox(q);\n      const dl: f32 = (0.012 + 0.005 * dep * mL) * sr;\n      const dr: f32 = (0.012 + 0.005 * dep * mR) * sr;\n      l = l * (1.0 - 0.4 * dep) + readDelay(cbL, cw, dl) * 0.6 * dep;\n      r = r * (1.0 - 0.4 * dep) + readDelay(cbR, cw, dr) * 0.6 * dep;\n    }\n    cph += cInc;\n    if (cph >= 1.0) cph -= 1.0;\n    cw = (cw + 1) & 8191;\n    gm = gm + (mTarget - gm) * 0.002;\n    outBuf[s] = fastTanh(l * gm);\n    outBuf[MAX_FRAMES + s] = fastTanh(r * gm);\n  }\n}\n","html":"<!DOCTYPE html>\n<html lang='en'>\n<head>\n<meta charset='utf-8'>\n<meta name='viewport' content='width=device-width, initial-scale=1'>\n<title>FREEDOM</title>\n<style>\n  :root {\n    --bg: #0e1319;\n    --panel: #141a22;\n    --panel2: #1b232d;\n    --well: #0b1016;\n    --line: rgba(255,255,255,.05);\n    --line2: rgba(255,255,255,.09);\n    --ink: #dfe5ec;\n    --ink2: #98a3b1;\n    --muted: #64707f;\n    --accent: #6fd8bd;\n    --soft: rgba(111,216,189,.16);\n    --warn: #ff6b6b;\n  }\n  .ta { --accent: #6fd8bd; --soft: rgba(111,216,189,.16); }\n  .tb { --accent: #a98bff; --soft: rgba(169,139,255,.16); }\n  .tc { --accent: #e9c46a; --soft: rgba(233,196,106,.16); }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; height: 100%; overflow: hidden; }\n  body {\n    background: var(--bg);\n    color: var(--ink);\n    font: 11px/1.4 -apple-system, BlinkMacSystemFont, Segoe UI, Inter, system-ui, sans-serif;\n    -webkit-user-select: none;\n    user-select: none;\n  }\n  .app { display: flex; flex-direction: column; height: 100vh; }\n  .top {\n    display: flex; align-items: center; gap: 18px; flex-wrap: wrap;\n    padding: 8px 16px;\n    background: linear-gradient(180deg, #151c25, #10161d);\n    border-bottom: 1px solid var(--line2);\n  }\n  .logo { display: flex; align-items: center; gap: 10px; }\n  .brand { font-size: 22px; font-weight: 600; letter-spacing: 7px; color: #f2f5f9; line-height: 1; }\n  .tagline { font-size: 8px; letter-spacing: 2.2px; text-transform: uppercase; color: var(--muted); margin-top: 4px; }\n  .sp { flex: 1; }\n  .small-lbl { font-size: 8px; letter-spacing: 2px; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }\n  .library { display: flex; flex-direction: column; }\n  .pbrow { display: flex; gap: 5px; align-items: center; }\n  .sel {\n    appearance: none; background: #10161d; color: var(--ink); font: inherit; font-size: 11px;\n    border: 1px solid var(--line2); border-radius: 6px; padding: 5px 24px 5px 10px; cursor: pointer;\n    background-image: linear-gradient(45deg, transparent 50%, var(--ink2) 50%), linear-gradient(-45deg, transparent 50%, var(--ink2) 50%);\n    background-position: calc(100% - 13px) 53%, calc(100% - 9px) 53%;\n    background-size: 4px 4px; background-repeat: no-repeat;\n  }\n  .sel:focus { outline: none; border-color: var(--accent); }\n  #soundSel { min-width: 200px; height: 28px; }\n  .btn {\n    appearance: none; border: 1px solid var(--line2); background: var(--panel2); color: var(--ink2);\n    font: inherit; font-size: 10px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase;\n    padding: 0 11px; height: 28px; border-radius: 6px; cursor: pointer;\n  }\n  .btn:hover { color: var(--ink); border-color: rgba(255,255,255,.18); }\n  .meters { display: flex; flex-direction: column; width: 150px; }\n  .mtr { height: 6px; background: var(--well); border: 1px solid var(--line2); border-radius: 3px; margin-bottom: 3px; position: relative; overflow: hidden; }\n  .mtr .fl { position: absolute; left: 0; top: 0; bottom: 0; background: #6fd8bd; width: 0; }\n  .master { display: flex; flex-direction: column; align-items: center; }\n  .tabs { display: flex; gap: 26px; padding: 0 18px; border-bottom: 1px solid var(--line2); }\n  .tab {\n    appearance: none; background: transparent; border: 0; border-bottom: 2px solid transparent;\n    color: var(--ink2); font: inherit; font-size: 10.5px; letter-spacing: 2px; text-transform: uppercase;\n    padding: 11px 2px; cursor: pointer;\n  }\n  .tab .no { color: var(--muted); margin-right: 8px; font-size: 9px; }\n  .tab:hover { color: var(--ink); }\n  .tab.on { color: #fff; border-bottom-color: #6fd8bd; }\n  .tab.on .no { color: #6fd8bd; }\n  .pages { flex: 1; min-height: 0; overflow: auto; }\n  .page { display: none; padding: 12px 16px; }\n  .page.on { display: flex; flex-wrap: wrap; gap: 12px; align-content: flex-start; }\n  .panel {\n    background: linear-gradient(180deg, #161d26, #131920);\n    border: 1px solid var(--line2); border-radius: 6px;\n    display: flex; flex-direction: column; min-width: 0; flex: 1 1 250px;\n  }\n  .panel .head {\n    display: flex; align-items: center; gap: 10px; height: 32px; padding: 0 14px;\n    border-bottom: 1px solid var(--line); font-size: 10.5px; letter-spacing: 2px; text-transform: uppercase;\n  }\n  .panel .head .no { color: var(--muted); font-size: 9.5px; }\n  .panel .head .ttl { color: #eef2f6; font-weight: 700; }\n  .panel .head .pill { margin-left: auto; }\n  .panel .body { padding: 12px 14px 14px; display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-start; }\n  .panel .body.col { flex-direction: column; flex-wrap: nowrap; align-items: stretch; }\n  .krow { display: flex; gap: 6px; justify-content: space-around; align-items: flex-start; flex-wrap: wrap; }\n  .cell { display: flex; flex-direction: column; align-items: center; gap: 4px; min-width: 46px; }\n  .cell .lbl { font-size: 8.5px; letter-spacing: 1.3px; text-transform: uppercase; color: var(--ink2); white-space: nowrap; }\n  .num { font-size: 10.5px; color: #e6ebf1; font-variant-numeric: tabular-nums; white-space: nowrap; }\n  .knob { cursor: ns-resize; touch-action: none; display: block; }\n  .knob .disc { fill: #10161d; stroke: #2a3340; }\n  .knob .track { fill: none; stroke: #222b36; stroke-width: 3.4; stroke-linecap: round; }\n  .knob .arc { fill: none; stroke: var(--accent); stroke-width: 3.6; stroke-linecap: round; }\n  .knob .ind { stroke: #eef2f6; stroke-width: 1.8; stroke-linecap: round; }\n  .disp { position: relative; background: var(--well); border: 1px solid var(--line2); border-radius: 8px; overflow: hidden; }\n  .disp canvas { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: block; }\n  .wavebox { height: 56px; flex: 1; }\n  .oscrow { display: flex; gap: 10px; align-items: flex-start; }\n  .pill {\n    appearance: none; border: 1px solid var(--line2); background: var(--well); color: var(--muted);\n    font: inherit; font-size: 9px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase;\n    padding: 4px 10px; border-radius: 6px; cursor: pointer;\n  }\n  .pill.on { color: var(--accent); border-color: var(--accent); background: var(--soft); }\n  .seg { display: inline-flex; background: var(--well); border: 1px solid var(--line2); border-radius: 8px; padding: 2px; align-self: flex-start; }\n  .seg button {\n    appearance: none; border: 0; background: transparent; color: var(--ink2); font: inherit; font-size: 9.5px;\n    font-weight: 600; letter-spacing: .6px; padding: 5px 11px; cursor: pointer; border-radius: 6px;\n  }\n  .seg button.on { background: var(--accent); color: #0b1511; }\n  .fader { position: relative; width: 22px; height: 104px; background: var(--well); border: 1px solid var(--line2); border-radius: 6px; cursor: pointer; touch-action: none; overflow: hidden; }\n  .fader .fill { position: absolute; left: 0; right: 0; bottom: 0; background: var(--accent); opacity: .85; }\n  .fader .cap { position: absolute; left: 2px; right: 2px; height: 3px; background: #f4f5f6; }\n  .erow { display: flex; align-items: center; gap: 12px; padding: 6px 0; border-bottom: 1px solid var(--line); }\n  .erow:last-child { border-bottom: 0; }\n  .elbl { flex: 0 0 62px; font-size: 10px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; color: var(--accent); }\n  .erow .disp { flex: 1 1 150px; height: 66px; min-width: 120px; cursor: pointer; }\n  .eknobs { display: flex; gap: 4px; }\n  .mrow { display: flex; align-items: center; gap: 8px; padding: 6px 0; border-bottom: 1px solid var(--line); }\n  .mrow:last-child { border-bottom: 0; }\n  .mno { color: var(--muted); font-size: 9.5px; width: 18px; }\n  .mrow input[type=range] { flex: 1; min-width: 90px; accent-color: #6fd8bd; }\n  .mrow .num { width: 44px; text-align: right; }\n  .dock { padding: 8px 18px 10px; background: linear-gradient(180deg, #10161d, #0c1117); border-top: 1px solid var(--line2); }\n  .piano { position: relative; height: 62px; display: flex; border: 1px solid var(--line2); border-radius: 8px; overflow: hidden; background: #0a0c0e; touch-action: none; }\n  .wk { flex: 1; background: linear-gradient(#f4f5f6, #dadce0); border-right: 1px solid #1d2125; }\n  .wk.down { background: linear-gradient(#6fd8bd, #4fb59b); }\n  .bk { position: absolute; top: 0; height: 60%; background: linear-gradient(#2a2f35, #15181b); z-index: 2; border: 1px solid #000; border-top: 0; border-radius: 0 0 4px 4px; }\n  .bk.down { background: linear-gradient(#6fd8bd, #3f917c); }\n  .menu { position: fixed; z-index: 60; background: var(--panel); border: 1px solid var(--line2); border-radius: 6px; padding: 4px; min-width: 160px; box-shadow: 0 12px 30px rgba(0,0,0,.55); }\n  .menu .mi { padding: 6px 11px; font-size: 10px; color: var(--ink2); cursor: pointer; border-radius: 6px; }\n  .menu .mi:hover { background: var(--panel2); color: var(--ink); }\n  .note { font-size: 9px; color: var(--muted); letter-spacing: .6px; }\n</style>\n</head>\n<body>\n<div class='app'>\n  <div class='top'>\n    <div class='logo'>\n      <svg viewBox='0 0 28 28' width='28' height='28'>\n        <rect x='2' y='9' width='5' height='17' rx='1.5' fill='#6fd8bd'></rect>\n        <rect x='11' y='3' width='5' height='23' rx='1.5' fill='#a98bff'></rect>\n        <rect x='20' y='13' width='5' height='13' rx='1.5' fill='#e9c46a'></rect>\n      </svg>\n      <div>\n        <div class='brand'>FREEDOM</div>\n        <div class='tagline'>Subtractive synthesizer &middot; BSM &middot; Liberty DAW</div>\n      </div>\n    </div>\n    <div class='library'>\n      <div class='small-lbl'>Sound library</div>\n      <div class='pbrow'>\n        <button class='btn' id='prevBtn'>&lsaquo;</button>\n        <select id='soundSel' class='sel'></select>\n        <button class='btn' id='nextBtn'>&rsaquo;</button>\n        <button class='btn' id='saveBtn'>Save</button>\n      </div>\n    </div>\n    <span class='sp'></span>\n    <div>\n      <div class='small-lbl'>Output</div>\n      <div class='meters'>\n        <div class='mtr'><div class='fl' id='mL'></div></div>\n        <div class='mtr'><div class='fl' id='mR'></div></div>\n      </div>\n    </div>\n    <div class='master'>\n      <div class='small-lbl'>Master</div>\n      <div id='masterHost'></div>\n    </div>\n  </div>\n  <div class='tabs' id='tabs'></div>\n  <div class='pages' id='pages'></div>\n  <div class='dock'><div class='piano' id='kbd'></div></div>\n</div>\n\n<script>\n'use strict';\n\n/* ===================== constants ===================== */\nconst NP = 64;\nconst WAVES = ['Sine', 'Triangle', 'Saw', 'Square', 'Pulse', 'White Noise', 'Pink Noise'];\nconst FTYPES = ['LP 12', 'LP 24', 'HP 12', 'HP 24', 'Band Pass', 'Notch'];\nconst LSHAPES = ['Sine', 'Triangle', 'Saw Up', 'Saw Down', 'Square', 'S&H', 'Smooth Rnd'];\nconst SOURCES = ['None', 'LFO 1', 'LFO 2', 'LFO 3', 'Amp Env', 'Filter Env', 'Mod Env', 'Velocity', 'Mod Wheel', 'Aftertouch', 'Key Track'];\nconst DESTS = ['None', 'Pitch', 'Cutoff', 'Resonance', 'Amplitude', 'Pan', 'Pulse Width', 'Fine Tune'];\n\n/* ===================== patch helpers ===================== */\nconst mx = (src, dst, d) => (src * 8 + dst) * 201 + Math.round(d * 100) + 100;\nconst oscP = (n, wave, oct, tune, vol, pw) => {\n  const b = 9 + 5 * n;\n  return { [b]: wave, [b + 1]: oct, [b + 2]: tune, [b + 3]: vol, [b + 4]: pw };\n};\nconst subP = (lvl, oct, nz) => ({ 25: lvl, 26: oct, 27: nz });\nconst filtP = (type, cut, res, drive, kt, env, vel) => ({ 28: type, 29: cut, 30: res, 31: drive, 32: kt, 33: env, 34: vel });\nconst envP = (b, a, d, s, r) => ({ [b]: a, [b + 1]: d, [b + 2]: s, [b + 3]: r });\nconst lfoP = (k, rate, depth, shape) => ({ [47 + 3 * k]: rate, [48 + 3 * k]: depth, [49 + 3 * k]: shape });\nconst voiceP = (mode, uni, det, glide) => ({ 1: mode, 2: uni, 3: det, 4: glide });\nconst fxP = (dd, dm, cr, cd) => ({ 56: dd, 57: dm, 58: cr, 59: cd });\nconst slot = (n, src, dst, d) => ({ [60 + n]: mx(src, dst, d) });\n\nfunction build(parts, from) {\n  const p = (from || new Array(NP).fill(0)).slice();\n  parts.forEach(o => {\n    for (const k in o) p[+k] = o[k];\n  });\n  return p;\n}\n\nconst DEF = build([\n  { 0: 0.7 },\n  voiceP(0, 1, 0.3, 0),\n  oscP(0, 2, 0, 0, 0.7, 0.5),\n  oscP(1, 2, 0, 0.1, 0.5, 0.5),\n  oscP(2, 3, -1, 0, 0, 0.5),\n  { 24: 0 },\n  subP(0.3, 1, 0),\n  filtP(1, 3000, 0.2, 0.1, 0.4, 0.3, 0.3),\n  envP(35, 0.25, 0.65, 0.7, 0.6),\n  envP(39, 0.2, 0.65, 0.3, 0.6),\n  envP(43, 0.5, 0.6, 0.5, 0.6),\n  lfoP(0, 4, 0.5, 0),\n  lfoP(1, 1, 0.5, 0),\n  lfoP(2, 0.3, 0.5, 0),\n  fxP(0.3, 0, 0.8, 0),\n  { 60: 100, 61: 100, 62: 100, 63: 100 }\n]);\n\nconst clamp = (v, a, b) => Math.max(a, Math.min(b, v));\n\nconst CATS = [\n  ['Bass', [voiceP(1, 1, 0.2, 0.03), oscP(0, 2, -1, 0, 0.8, 0.5), oscP(1, 3, -1, 0.08, 0.5, 0.5), oscP(2, 0, 0, 0, 0, 0.5), subP(0.5, 1, 0), filtP(1, 500, 0.3, 0.3, 0.3, 0.55, 0.4), envP(35, 0.2, 0.5, 0.8, 0.35), envP(39, 0.15, 0.55, 0.15, 0.4)]],\n  ['Lead', [voiceP(2, 2, 0.25, 0.2), oscP(0, 2, 0, 0, 0.7, 0.5), oscP(1, 4, 0, 0.1, 0.5, 0.35), oscP(2, 2, 1, 0.05, 0.25, 0.5), subP(0, 1, 0), filtP(1, 3800, 0.3, 0.2, 0.5, 0.35, 0.4), envP(35, 0.2, 0.6, 0.75, 0.5), envP(39, 0.2, 0.6, 0.5, 0.5), lfoP(0, 5, 0.3, 0), slot(0, 1, 1, 0.12), slot(1, 8, 2, 0.5), fxP(0.2, 0, 0.8, 0.2)]],\n  ['Pad', [voiceP(0, 4, 0.4, 0), oscP(0, 2, 0, 0, 0.6, 0.5), oscP(1, 2, 0, 0.15, 0.6, 0.5), oscP(2, 3, -1, 0, 0.3, 0.5), subP(0.2, 1, 0), filtP(0, 1800, 0.2, 0.05, 0.3, 0.2, 0.1), envP(35, 0.8, 0.8, 0.8, 0.85), envP(39, 0.8, 0.8, 0.5, 0.8), lfoP(1, 0.3, 0.4, 1), slot(0, 2, 2, 0.3), fxP(0, 0, 0.4, 0.6)]],\n  ['Pluck', [voiceP(0, 1, 0.2, 0), oscP(0, 2, 0, 0, 0.7, 0.5), oscP(1, 3, 0, 0.1, 0.4, 0.5), oscP(2, 0, 0, 0, 0, 0.5), subP(0.1, 1, 0), filtP(1, 1000, 0.3, 0.1, 0.5, 0.7, 0.5), envP(35, 0.15, 0.55, 0, 0.4), envP(39, 0.15, 0.5, 0, 0.45), fxP(0, 0, 0.8, 0.15)]],\n  ['Keys', [voiceP(0, 1, 0.2, 0), oscP(0, 1, 0, 0, 0.7, 0.5), oscP(1, 0, 1, 0.05, 0.4, 0.5), oscP(2, 2, 0, 0, 0.2, 0.5), subP(0, 1, 0), filtP(0, 4000, 0.15, 0.05, 0.5, 0.25, 0.5), envP(35, 0.2, 0.7, 0.4, 0.5), envP(39, 0.2, 0.7, 0.2, 0.5), fxP(0, 0, 0.6, 0.3)]],\n  ['Brass', [voiceP(0, 2, 0.2, 0), oscP(0, 2, 0, 0, 0.7, 0.5), oscP(1, 2, 0, 0.12, 0.6, 0.5), oscP(2, 3, -1, 0, 0.2, 0.5), subP(0, 1, 0), filtP(1, 1200, 0.2, 0.2, 0.4, 0.7, 0.4), envP(35, 0.45, 0.6, 0.8, 0.45), envP(39, 0.55, 0.6, 0.6, 0.5), lfoP(0, 5.5, 0.3, 0), slot(0, 1, 1, 0.08), fxP(0.1, 0, 0.8, 0.15)]],\n  ['Strings', [voiceP(0, 6, 0.35, 0), oscP(0, 2, 0, 0, 0.6, 0.5), oscP(1, 2, 0, 0.1, 0.6, 0.5), oscP(2, 2, 1, 0, 0.2, 0.5), subP(0, 1, 0), filtP(0, 3000, 0.15, 0.05, 0.4, 0.2, 0.2), envP(35, 0.7, 0.8, 0.9, 0.8), envP(39, 0.7, 0.8, 0.6, 0.8), fxP(0, 0, 0.5, 0.7)]],\n  ['FX', [voiceP(0, 3, 0.7, 0), oscP(0, 2, 0, 0, 0.3, 0.5), oscP(1, 3, 1, 0.5, 0.3, 0.5), oscP(2, 5, 0, 0, 0.5, 0.5), subP(0, 1, 0), filtP(4, 1500, 0.6, 0.2, 0.2, 0.5, 0.2), envP(35, 0.7, 0.8, 0.6, 0.85), envP(39, 0.7, 0.8, 0.4, 0.8), lfoP(2, 3, 0.8, 5), slot(0, 3, 2, 0.5), fxP(0.2, 0.2, 0.3, 0.5)]],\n  ['Bell', [voiceP(0, 1, 0.2, 0), oscP(0, 0, 0, 0, 0.6, 0.5), oscP(1, 0, 1, 4.9, 0.4, 0.5), oscP(2, 0, 2, 2, 0.25, 0.5), subP(0, 1, 0), filtP(0, 8000, 0.1, 0, 0.5, 0.1, 0.4), envP(35, 0.1, 0.85, 0, 0.85), envP(39, 0.1, 0.8, 0.2, 0.8), fxP(0, 0, 0.7, 0.4)]],\n  ['Drone', [voiceP(1, 3, 0.3, 0.1), oscP(0, 2, -1, 0, 0.7, 0.5), oscP(1, 3, -1, 0.12, 0.5, 0.5), oscP(2, 0, 0, 0, 0, 0.5), subP(0.6, 2, 0.05), filtP(1, 400, 0.35, 0.3, 0.2, 0.2, 0.1), envP(35, 0.8, 0.9, 0.9, 0.9), envP(39, 0.8, 0.9, 0.6, 0.9), lfoP(1, 0.2, 0.7, 1), slot(0, 2, 2, 0.5), fxP(0.2, 0.1, 0.3, 0.5)]]\n];\n\nconst VARS = [\n  ['Classic', p => {}],\n  ['Warm', p => { p[29] = clamp(p[29] * 0.6, 20, 20000); p[58] = 0.4; p[59] = Math.max(p[59], 0.35); }],\n  ['Bright', p => { p[29] = clamp(p[29] * 2.2, 20, 20000); p[30] = Math.min(0.9, p[30] + 0.1); }],\n  ['Wide', p => { p[2] = Math.max(p[2], 5); p[3] = 0.55; p[59] = Math.max(p[59], 0.5); }],\n  ['Dirty', p => { p[56] = 0.55; p[57] = 0.5; p[31] = Math.min(1, p[31] + 0.3); }],\n  ['Fat', p => { p[19] = 2; p[20] = -1; p[22] = Math.max(p[22], 0.5); p[25] = Math.max(p[25], 0.4); }],\n  ['Soft', p => { p[35] = Math.max(p[35], 0.55); p[29] = clamp(p[29] * 0.7, 20, 20000); p[33] = p[33] * 0.5; }],\n  ['Punchy', p => { p[36] = Math.min(p[36], 0.5); p[33] = Math.min(1, p[33] + 0.25); p[35] = Math.min(p[35], 0.2); }],\n  ['Moving', p => { p[47] = 3; p[48] = 0.8; p[63] = mx(1, 2, 0.45); }],\n  ['Resonant', p => { p[30] = 0.7; p[33] = Math.max(p[33], 0.4); }]\n];\n\nconst PRESETS = [];\nCATS.forEach(c => {\n  VARS.forEach(v => {\n    const p = build(c[1], DEF);\n    v[1](p);\n    PRESETS.push({ name: c[0] + ' ' + v[0], data: p });\n  });\n});\n\n/* ===================== param state + bridge ===================== */\nconst P = DEF.slice();\nconst seen = new Array(NP).fill(false);\nconst listeners = [];\nfor (let i = 0; i < NP; i++) listeners.push([]);\nconst animators = [];\n\nconst vs = () => window.vstai;\n\nfunction sendParam(i, v) {\n  if (vs() && vs().setParam) vs().setParam(i, v);\n}\n\nfunction pset(i, v) {\n  P[i] = v;\n  sendParam(i, v);\n  listeners[i].forEach(f => f(v));\n}\n\nfunction bind(i, repaint) {\n  listeners[i].push(repaint);\n  if (vs() && vs().onParam) {\n    vs().onParam((idx, val) => {\n      if (idx === i) {\n        seen[i] = true;\n        P[i] = +val;\n        repaint(+val);\n      }\n    });\n  }\n}\n\nfunction whenReady(cb) {\n  let done = false;\n  const run = () => { if (!done) { done = true; cb(); } };\n  function go() {\n    if (window.vstai.onReady) window.vstai.onReady(run);\n    else run();\n  }\n  if (window.vstai) return go();\n  const t = setInterval(() => {\n    if (window.vstai) { clearInterval(t); go(); }\n  }, 25);\n}\n\n/* ===================== dom helpers ===================== */\nfunction el(tag, cls, html) {\n  const e = document.createElement(tag);\n  if (cls) e.className = cls;\n  if (html != null) e.innerHTML = html;\n  return e;\n}\n\nconst SVGNS = 'http://www.w3.org/2000/svg';\nfunction svgEl(tag, attrs) {\n  const e = document.createElementNS(SVGNS, tag);\n  for (const k in attrs) e.setAttribute(k, attrs[k]);\n  return e;\n}\n\nfunction panel(parent, no, title, acc, extra) {\n  const p = el('section', 'panel ' + acc);\n  const head = el('div', 'head', '<span class=\"no\">' + no + '</span><span class=\"ttl\">' + title + '</span>');\n  p.append(head);\n  const body = el('div', 'body' + (extra ? ' ' + extra : ''));\n  p.append(body);\n  parent.append(p);\n  body.head = head;\n  return body;\n}\n\nlet menuEl = null;\nfunction closeMenu() {\n  if (menuEl) { menuEl.remove(); menuEl = null; }\n}\naddEventListener('pointerdown', e => {\n  if (menuEl && !menuEl.contains(e.target)) closeMenu();\n}, true);\n\nfunction paramMenu(e, index) {\n  e.preventDefault();\n  closeMenu();\n  const m = el('div', 'menu');\n  const items = [\n    { label: 'Reset to default', fn: () => pset(index, DEF[index]) },\n    { label: 'Create automation clip...', fn: () => { if (vs() && vs().hostMenu) vs().hostMenu(index); } }\n  ];\n  items.forEach(it => {\n    const d = el('div', 'mi');\n    d.textContent = it.label;\n    d.onclick = () => { closeMenu(); it.fn(); };\n    m.append(d);\n  });\n  m.style.left = Math.min(e.clientX, innerWidth - 170) + 'px';\n  m.style.top = Math.min(e.clientY, innerHeight - 70) + 'px';\n  document.body.append(m);\n  menuEl = m;\n}\n\n/* ===================== formatters ===================== */\nconst fPct = v => Math.round(v * 100) + '%';\nconst fHz = v => (v >= 1000 ? (v / 1000).toFixed(2) + ' kHz' : Math.round(v) + ' Hz');\nconst fTime = p => {\n  const ms = Math.pow(10000, p);\n  return ms >= 1000 ? (ms / 1000).toFixed(2) + ' s' : ms.toFixed(ms < 10 ? 1 : 0) + ' ms';\n};\nconst fSt = v => (v > 0 ? '+' : '') + v.toFixed(2) + ' st';\nconst fInt = v => (v > 0 ? '+' : '') + Math.round(v);\nconst fSigned = v => (v > 0 ? '+' : '') + Math.round(v * 100) + '%';\n\n/* ===================== controls ===================== */\nfunction makeKnob(parent, o) {\n  const i = o.index;\n  const cell = el('div', 'cell');\n  cell.dataset.param = i;\n  const size = o.size || 46;\n  const svg = svgEl('svg', { class: 'knob', viewBox: '0 0 100 100', width: size, height: size });\n  const a0 = 135;\n  const a1 = 405;\n  const R = 39;\n  const polar = (deg, r) => [50 + r * Math.cos(deg * Math.PI / 180), 50 + r * Math.sin(deg * Math.PI / 180)];\n  const arcPath = (from, to, r) => {\n    const s = polar(from, r);\n    const e = polar(to, r);\n    return 'M ' + s[0] + ' ' + s[1] + ' A ' + r + ' ' + r + ' 0 ' + (to - from > 180 ? 1 : 0) + ' 1 ' + e[0] + ' ' + e[1];\n  };\n  svg.append(svgEl('circle', { class: 'disc', cx: 50, cy: 50, r: 30 }));\n  svg.append(svgEl('path', { class: 'track', d: arcPath(a0, a1, R) }));\n  const arc = svgEl('path', { class: 'arc' });\n  const ind = svgEl('line', { class: 'ind' });\n  svg.append(arc, ind);\n  const num = el('div', 'num');\n  const lbl = el('div', 'lbl', o.label);\n  cell.append(svg, num, lbl);\n  parent.append(cell);\n\n  const fmt = o.fmt || (v => v.toFixed(2));\n  const toN = v => (o.log ? Math.log(v / o.min) / Math.log(o.max / o.min) : (v - o.min) / (o.max - o.min));\n  const fromN = n => (o.log ? o.min * Math.pow(o.max / o.min, n) : o.min + n * (o.max - o.min));\n\n  function draw(v) {\n    const n = clamp(toN(v), 0, 1);\n    const ang = a0 + n * (a1 - a0);\n    arc.setAttribute('d', arcPath(a0, ang + 0.01, R));\n    const p1 = polar(ang, 11);\n    const p2 = polar(ang, 29);\n    ind.setAttribute('x1', p1[0]);\n    ind.setAttribute('y1', p1[1]);\n    ind.setAttribute('x2', p2[0]);\n    ind.setAttribute('y2', p2[1]);\n    num.textContent = fmt(v);\n  }\n\n  function user(n) {\n    let v = fromN(clamp(n, 0, 1));\n    if (o.int) v = Math.round(v);\n    pset(i, clamp(v, o.min, o.max));\n  }\n\n  let drag = null;\n  svg.addEventListener('pointerdown', e => {\n    if (e.button !== 0) return;\n    drag = { y: e.clientY, n: clamp(toN(P[i]), 0, 1) };\n    svg.setPointerCapture(e.pointerId);\n  });\n  svg.addEventListener('pointermove', e => {\n    if (!drag) return;\n    const speed = e.shiftKey ? 800 : 180;\n    user(drag.n + (drag.y - e.clientY) / speed);\n  });\n  svg.addEventListener('pointerup', () => { drag = null; });\n  svg.addEventListener('pointercancel', () => { drag = null; });\n  svg.addEventListener('wheel', e => {\n    e.preventDefault();\n    const step = o.int ? 1 / (o.max - o.min) : (e.shiftKey ? 0.005 : 0.025);\n    user(toN(P[i]) - Math.sign(e.deltaY) * step);\n  }, { passive: false });\n  svg.addEventListener('dblclick', () => pset(i, DEF[i]));\n  svg.addEventListener('contextmenu', e => paramMenu(e, i));\n\n  bind(i, draw);\n  draw(P[i]);\n}\n\nfunction makeSelect(parent, index, names, off) {\n  const sel = el('select', 'sel');\n  sel.dataset.param = index;\n  names.forEach((t, k) => {\n    const op = el('option');\n    op.value = k;\n    op.textContent = t;\n    sel.append(op);\n  });\n  sel.onchange = () => {\n    pset(index, (+sel.value) + (off || 0));\n    sel.blur();\n  };\n  parent.append(sel);\n  const paint = v => { sel.value = Math.round(v) - (off || 0); };\n  bind(index, paint);\n  paint(P[index]);\n  return sel;\n}\n\nfunction makeSeg(parent, index, labels, vals) {\n  const host = el('div', 'seg');\n  host.dataset.param = index;\n  const btns = labels.map((t, k) => {\n    const b = el('button');\n    b.textContent = t;\n    b.onclick = () => pset(index, vals[k]);\n    host.append(b);\n    return b;\n  });\n  parent.append(host);\n  const paint = v => {\n    let best = 0;\n    vals.forEach((x, k) => { if (Math.abs(x - v) < Math.abs(vals[best] - v)) best = k; });\n    btns.forEach((b, k) => b.classList.toggle('on', k === best));\n  };\n  bind(index, paint);\n  paint(P[index]);\n}\n\nfunction makeToggle(parent, index, text) {\n  const b = el('button', 'pill');\n  b.dataset.param = index;\n  b.textContent = text;\n  b.onclick = () => pset(index, P[index] >= 0.5 ? 0 : 1);\n  parent.append(b);\n  const paint = v => b.classList.toggle('on', v >= 0.5);\n  bind(index, paint);\n  paint(P[index]);\n}\n\nfunction makeFader(parent, o) {\n  const i = o.index;\n  const cell = el('div', 'cell');\n  cell.dataset.param = i;\n  const host = el('div', 'fader');\n  const fill = el('div', 'fill');\n  const cap = el('div', 'cap');\n  host.append(fill, cap);\n  const num = el('div', 'num');\n  const lbl = el('div', 'lbl', o.label);\n  cell.append(host, num, lbl);\n  parent.append(cell);\n  const fmt = o.fmt || fPct;\n  function draw(v) {\n    const n = clamp((v - o.min) / (o.max - o.min), 0, 1);\n    fill.style.height = (n * 100) + '%';\n    cap.style.bottom = 'calc(' + (n * 100) + '% - 1px)';\n    num.textContent = fmt(v);\n  }\n  const fromPt = e => {\n    const r = host.getBoundingClientRect();\n    return o.min + (o.max - o.min) * clamp(1 - (e.clientY - r.top) / r.height, 0, 1);\n  };\n  let drag = false;\n  host.addEventListener('pointerdown', e => {\n    if (e.button !== 0) return;\n    drag = true;\n    host.setPointerCapture(e.pointerId);\n    pset(i, fromPt(e));\n  });\n  host.addEventListener('pointermove', e => { if (drag) pset(i, fromPt(e)); });\n  const up = () => {\n    if (!drag) return;\n    drag = false;\n    if (o.spring) pset(i, o.spring.to);\n  };\n  host.addEventListener('pointerup', up);\n  host.addEventListener('pointercancel', up);\n  host.addEventListener('dblclick', () => pset(i, DEF[i]));\n  host.addEventListener('contextmenu', e => paramMenu(e, i));\n  bind(i, draw);\n  draw(P[i]);\n}\n\n/* ===================== canvases ===================== */\nfunction fitCanvas(cv) {\n  const host = cv.parentElement;\n  const dpr = window.devicePixelRatio || 1;\n  const w = host.clientWidth;\n  const h = host.clientHeight;\n  if (!w || !h) return null;\n  if (cv.width !== Math.round(w * dpr) || cv.height !== Math.round(h * dpr)) {\n    cv.width = Math.round(w * dpr);\n    cv.height = Math.round(h * dpr);\n  }\n  const ctx = cv.getContext('2d');\n  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n  ctx.clearRect(0, 0, w, h);\n  return { ctx: ctx, W: w, H: h, acc: getComputedStyle(host).getPropertyValue('--accent').trim() || '#6fd8bd' };\n}\n\nfunction grid(ctx, W, H, cols, rows) {\n  ctx.strokeStyle = 'rgba(255,255,255,.05)';\n  ctx.lineWidth = 1;\n  ctx.beginPath();\n  for (let k = 1; k < cols; k++) {\n    const x = Math.round(W * k / cols) + 0.5;\n    ctx.moveTo(x, 0);\n    ctx.lineTo(x, H);\n  }\n  for (let k = 1; k < rows; k++) {\n    const y = Math.round(H * k / rows) + 0.5;\n    ctx.moveTo(0, y);\n    ctx.lineTo(W, y);\n  }\n  ctx.stroke();\n}\n\nfunction waveAt(kind, t, pw) {\n  t = ((t % 1) + 1) % 1;\n  if (kind === 0) return Math.sin(t * Math.PI * 2);\n  if (kind === 1) return 4 * Math.abs(t - 0.5) - 1;\n  if (kind === 2) return 2 * t - 1;\n  if (kind === 3) return t < 0.5 ? 1 : -1;\n  if (kind === 4) return t < pw ? 1 : -1;\n  return Math.sin(t * 91.7) * Math.sin(t * 37.3 + 1) + Math.sin(t * 173.1) * 0.5;\n}\n\nfunction makeOscView(parent, n) {\n  const b = 9 + 5 * n;\n  const host = el('div', 'disp wavebox');\n  const cv = el('canvas');\n  host.append(cv);\n  parent.append(host);\n  bind(b, () => {});\n  bind(b + 4, () => {});\n  animators.push(() => {\n    const f = fitCanvas(cv);\n    if (!f) return;\n    const kind = Math.round(P[b]);\n    f.ctx.lineWidth = 1.5;\n    grid(f.ctx, f.W, f.H, 4, 2);\n    f.ctx.strokeStyle = f.acc;\n    f.ctx.beginPath();\n    for (let x = 0; x <= f.W; x++) {\n      const y = f.H / 2 - waveAt(kind, x / f.W * 2, P[b + 4]) * f.H * 0.36;\n      if (x) f.ctx.lineTo(x, y); else f.ctx.moveTo(x, y);\n    }\n    f.ctx.stroke();\n  });\n}\n\nfunction makeLfoView(parent, shapeIdx) {\n  const host = el('div', 'disp');\n  host.style.height = '64px';\n  const cv = el('canvas');\n  host.append(cv);\n  parent.append(host);\n  bind(shapeIdx, () => {});\n  animators.push(() => {\n    const f = fitCanvas(cv);\n    if (!f) return;\n    const sh = Math.round(P[shapeIdx]);\n    const fn = t => {\n      t = ((t % 1) + 1) % 1;\n      if (sh === 0) return Math.sin(t * Math.PI * 2);\n      if (sh === 1) return 4 * Math.abs(t - 0.5) - 1;\n      if (sh === 2) return 2 * t - 1;\n      if (sh === 3) return 1 - 2 * t;\n      if (sh === 4) return t < 0.5 ? 1 : -1;\n      if (sh === 5) return Math.sin(Math.floor(t * 8) * 2.7) ;\n      return Math.sin(t * 6.28) * 0.6 + Math.sin(t * 15.7 + 1) * 0.4;\n    };\n    grid(f.ctx, f.W, f.H, 4, 2);\n    f.ctx.strokeStyle = f.acc;\n    f.ctx.lineWidth = 1.5;\n    f.ctx.beginPath();\n    for (let x = 0; x <= f.W; x++) {\n      const y = f.H / 2 - fn(x / f.W * 2) * f.H * 0.38;\n      if (x) f.ctx.lineTo(x, y); else f.ctx.moveTo(x, y);\n    }\n    f.ctx.stroke();\n  });\n}\n\nfunction makeFilterView(parent) {\n  const host = el('div', 'disp');\n  host.style.height = '88px';\n  const cv = el('canvas');\n  host.append(cv);\n  parent.append(host);\n  [28, 29, 30].forEach(i => bind(i, () => {}));\n  function mag(type, x, k) {\n    const den2 = (1 - x * x) * (1 - x * x) + k * k * x * x;\n    const d = Math.sqrt(den2) + 1e-9;\n    if (type === 0) return 1 / d;\n    if (type === 1) return 1 / (den2 + 1e-9);\n    if (type === 2) return x * x / d;\n    if (type === 3) return Math.pow(x, 4) / (den2 + 1e-9);\n    if (type === 4) return k * x / d;\n    return Math.abs(1 - x * x) / d;\n  }\n  animators.push(() => {\n    const f = fitCanvas(cv);\n    if (!f) return;\n    const type = Math.round(P[28]);\n    const fc = P[29];\n    const k = 2 * (1 - P[30] * 0.99);\n    grid(f.ctx, f.W, f.H, 8, 4);\n    f.ctx.beginPath();\n    for (let px = 0; px <= f.W; px++) {\n      const freq = 20 * Math.pow(1000, px / f.W);\n      const m = mag(type, freq / fc, k);\n      const db = clamp(20 * Math.log10(m + 1e-6), -40, 30);\n      const y = f.H - ((db + 40) / 70) * (f.H - 6) - 3;\n      if (px) f.ctx.lineTo(px, y); else f.ctx.moveTo(px, y);\n    }\n    f.ctx.save();\n    f.ctx.lineTo(f.W, f.H);\n    f.ctx.lineTo(0, f.H);\n    f.ctx.closePath();\n    f.ctx.fillStyle = f.acc;\n    f.ctx.globalAlpha = 0.1;\n    f.ctx.fill();\n    f.ctx.restore();\n    f.ctx.beginPath();\n    for (let px = 0; px <= f.W; px++) {\n      const freq = 20 * Math.pow(1000, px / f.W);\n      const m = mag(type, freq / fc, k);\n      const db = clamp(20 * Math.log10(m + 1e-6), -40, 30);\n      const y = f.H - ((db + 40) / 70) * (f.H - 6) - 3;\n      if (px) f.ctx.lineTo(px, y); else f.ctx.moveTo(px, y);\n    }\n    f.ctx.strokeStyle = f.acc;\n    f.ctx.lineWidth = 1.6;\n    f.ctx.stroke();\n    const cx = Math.log(fc / 20) / Math.log(1000) * f.W;\n    f.ctx.strokeStyle = 'rgba(255,255,255,.18)';\n    f.ctx.beginPath();\n    f.ctx.moveTo(cx, 0);\n    f.ctx.lineTo(cx, f.H);\n    f.ctx.stroke();\n  });\n}\n\nfunction makeADSR(parent, base, name, acc) {\n  const row = el('div', 'erow ' + acc);\n  row.dataset.param = base;\n  row.append(el('div', 'elbl', name));\n  const gv = el('div', 'disp');\n  const cv = el('canvas');\n  gv.append(cv);\n  row.append(gv);\n  const kn = el('div', 'eknobs');\n  row.append(kn);\n  ['A', 'D', 'S', 'R'].forEach((l, j) => {\n    makeKnob(kn, { index: base + j, label: l, min: 0, max: 1, size: 34, fmt: j === 2 ? fPct : fTime });\n  });\n  parent.append(row);\n  const pad = 10;\n  let size = { W: 100, H: 60 };\n  const pts = () => {\n    const W = size.W;\n    const H = size.H;\n    const w = W - pad * 2;\n    const h = H - pad * 2;\n    const xA = pad + w * 0.25 * P[base];\n    const xD = xA + w * 0.25 * P[base + 1];\n    const xS = xD + w * 0.18;\n    const xR = xS + w * 0.32 * P[base + 3];\n    return [[pad, H - pad], [xA, pad], [xD, H - pad - h * P[base + 2]], [xS, H - pad - h * P[base + 2]], [xR, H - pad]];\n  };\n  let drag = -1;\n  gv.addEventListener('pointerdown', e => {\n    const r = gv.getBoundingClientRect();\n    const mx0 = e.clientX - r.left;\n    const my0 = e.clientY - r.top;\n    const p = pts();\n    let best = -1;\n    let bd = 600;\n    [1, 2, 4].forEach(k => {\n      const dx = p[k][0] - mx0;\n      const dy = p[k][1] - my0;\n      const dd = dx * dx + dy * dy;\n      if (dd < bd) { bd = dd; best = k; }\n    });\n    drag = best;\n    if (drag >= 0) gv.setPointerCapture(e.pointerId);\n  });\n  gv.addEventListener('pointermove', e => {\n    if (drag < 0) return;\n    const r = gv.getBoundingClientRect();\n    const W = size.W;\n    const H = size.H;\n    const w = W - pad * 2;\n    const h = H - pad * 2;\n    const mxp = clamp(e.clientX - r.left, pad, W - pad);\n    const myp = clamp(e.clientY - r.top, pad, H - pad);\n    if (drag === 1) {\n      pset(base, clamp((mxp - pad) / (w * 0.25), 0, 1));\n    } else if (drag === 2) {\n      const xA = pad + w * 0.25 * P[base];\n      pset(base + 1, clamp((mxp - xA) / (w * 0.25), 0, 1));\n      pset(base + 2, clamp((H - pad - myp) / h, 0, 1));\n    } else if (drag === 4) {\n      const xS = pad + w * 0.25 * P[base] + w * 0.25 * P[base + 1] + w * 0.18;\n      pset(base + 3, clamp((mxp - xS) / (w * 0.32), 0, 1));\n    }\n  });\n  gv.addEventListener('pointerup', () => { drag = -1; });\n  gv.addEventListener('pointercancel', () => { drag = -1; });\n  animators.push(() => {\n    const f = fitCanvas(cv);\n    if (!f) return;\n    size = { W: f.W, H: f.H };\n    const ac = getComputedStyle(row).getPropertyValue('--accent').trim() || '#6fd8bd';\n    const p = pts();\n    grid(f.ctx, f.W, f.H, 8, 4);\n    f.ctx.beginPath();\n    p.forEach((q, k) => { if (k) f.ctx.lineTo(q[0], q[1]); else f.ctx.moveTo(q[0], q[1]); });\n    f.ctx.save();\n    f.ctx.lineTo(p[4][0], f.H - pad);\n    f.ctx.lineTo(pad, f.H - pad);\n    f.ctx.closePath();\n    f.ctx.fillStyle = ac;\n    f.ctx.globalAlpha = 0.1;\n    f.ctx.fill();\n    f.ctx.restore();\n    f.ctx.beginPath();\n    p.forEach((q, k) => { if (k) f.ctx.lineTo(q[0], q[1]); else f.ctx.moveTo(q[0], q[1]); });\n    f.ctx.strokeStyle = ac;\n    f.ctx.lineWidth = 1.6;\n    f.ctx.stroke();\n    [1, 2, 4].forEach(k => {\n      f.ctx.beginPath();\n      f.ctx.arc(p[k][0], p[k][1], 3.6, 0, 7);\n      f.ctx.fillStyle = '#0b1016';\n      f.ctx.fill();\n      f.ctx.strokeStyle = ac;\n      f.ctx.stroke();\n    });\n  });\n}\n\nfunction makeMatrixRow(parent, n) {\n  const idx = 60 + n;\n  const row = el('div', 'mrow');\n  row.dataset.param = idx;\n  row.append(el('div', 'mno', '0' + (n + 1)));\n  const s = el('select', 'sel');\n  SOURCES.forEach((t, k) => {\n    const o = el('option');\n    o.value = k;\n    o.textContent = t;\n    s.append(o);\n  });\n  const d = el('select', 'sel');\n  DESTS.forEach((t, k) => {\n    const o = el('option');\n    o.value = k;\n    o.textContent = t;\n    d.append(o);\n  });\n  const r = el('input');\n  r.type = 'range';\n  r.min = -100;\n  r.max = 100;\n  r.step = 1;\n  const val = el('div', 'num');\n  row.append(s, el('span', 'note', '→'), d, r, val);\n  parent.append(row);\n  function paint(v) {\n    const code = clamp(Math.round(v), 0, 17687);\n    const sd = Math.floor(code / 201);\n    s.value = Math.floor(sd / 8);\n    d.value = sd % 8;\n    r.value = (code % 201) - 100;\n    val.textContent = (+r.value > 0 ? '+' : '') + r.value + '%';\n  }\n  function push() {\n    pset(idx, ((+s.value) * 8 + (+d.value)) * 201 + (+r.value) + 100);\n  }\n  s.onchange = () => { push(); s.blur(); };\n  d.onchange = () => { push(); d.blur(); };\n  r.oninput = push;\n  r.onchange = () => r.blur();\n  r.ondblclick = () => { r.value = 0; push(); };\n  bind(idx, paint);\n  paint(P[idx]);\n}\n\n/* ===================== pages ===================== */\nfunction buildOscPage(root) {\n  for (let n = 0; n < 3; n++) {\n    const b = 9 + 5 * n;\n    const acc = ['ta', 'tb', 'tc'][n];\n    const body = panel(root, '0' + (n + 1), 'Oscillator ' + (n + 1), acc, 'col');\n    if (n === 1) {\n      const h = el('div');\n      h.style.marginLeft = 'auto';\n      body.head.append(h);\n      makeToggle(h, 24, 'Hard sync 2+3');\n    }\n    const top = el('div', 'oscrow');\n    makeSelect(top, b, WAVES, 0);\n    makeOscView(top, n);\n    body.append(top);\n    const kr = el('div', 'krow');\n    body.append(kr);\n    makeKnob(kr, { index: b + 1, label: 'Octave', min: -2, max: 2, int: true, fmt: fInt });\n    makeKnob(kr, { index: b + 2, label: 'Semi / Fine', min: -12, max: 12, fmt: fSt });\n    makeKnob(kr, { index: b + 4, label: 'Pulse Width', min: 0.05, max: 0.95, fmt: fPct });\n  }\n  const mb = panel(root, '04', 'Mixer', 'tc', 'col');\n  const fr = el('div', 'krow');\n  mb.append(fr);\n  makeFader(fr, { index: 12, label: 'Osc 1', min: 0, max: 1 });\n  makeFader(fr, { index: 17, label: 'Osc 2', min: 0, max: 1 });\n  makeFader(fr, { index: 22, label: 'Osc 3', min: 0, max: 1 });\n  makeFader(fr, { index: 25, label: 'Sub', min: 0, max: 1 });\n  makeFader(fr, { index: 27, label: 'Noise', min: 0, max: 1 });\n  const sr = el('div', 'krow');\n  mb.append(sr);\n  sr.append(el('span', 'note', 'SUB OCTAVE'));\n  makeSeg(sr, 26, ['-1', '-2'], [1, 2]);\n}\n\nfunction buildFilterPage(root) {\n  const fb = panel(root, '01', 'Filter', 'tb', 'col');\n  const sel = el('div');\n  sel.style.marginLeft = 'auto';\n  fb.head.append(sel);\n  makeSelect(sel, 28, FTYPES, 0);\n  makeFilterView(fb);\n  const kr = el('div', 'krow');\n  fb.append(kr);\n  makeKnob(kr, { index: 29, label: 'Cutoff', min: 20, max: 20000, log: true, fmt: fHz });\n  makeKnob(kr, { index: 30, label: 'Resonance', min: 0, max: 1, fmt: fPct });\n  makeKnob(kr, { index: 31, label: 'Drive', min: 0, max: 1, fmt: fPct });\n  makeKnob(kr, { index: 32, label: 'Key Track', min: 0, max: 1, fmt: fPct });\n  makeKnob(kr, { index: 33, label: 'Env Amount', min: -1, max: 1, fmt: fSigned });\n  makeKnob(kr, { index: 34, label: 'Velocity', min: 0, max: 1, fmt: fPct });\n  const eb = panel(root, '02', 'Envelopes', 'tc', 'col');\n  eb.parentElement.style.flex = '1.6 1 420px';\n  makeADSR(eb, 35, 'Amp', 'ta');\n  makeADSR(eb, 39, 'Filter', 'tb');\n  makeADSR(eb, 43, 'Mod', 'tc');\n}\n\nfunction buildModPage(root) {\n  for (let k = 0; k < 3; k++) {\n    const b = 47 + 3 * k;\n    const body = panel(root, '0' + (k + 1), 'LFO ' + (k + 1), ['ta', 'tb', 'tc'][k], 'col');\n    makeLfoView(body, b + 2);\n    makeSelect(body, b + 2, LSHAPES, 0);\n    const kr = el('div', 'krow');\n    body.append(kr);\n    makeKnob(kr, { index: b, label: 'Rate', min: 0.05, max: 30, log: true, fmt: v => v.toFixed(2) + ' Hz' });\n    makeKnob(kr, { index: b + 1, label: 'Depth', min: 0, max: 1, fmt: fPct });\n  }\n  const mb = panel(root, '04', 'Modulation matrix', 'ta', 'col');\n  mb.parentElement.style.flex = '1 1 100%';\n  for (let n = 0; n < 4; n++) makeMatrixRow(mb, n);\n  mb.append(el('div', 'note', 'Source → destination with bipolar depth. Slots are stored with the preset.'));\n}\n\nfunction buildVoicePage(root) {\n  const vb = panel(root, '01', 'Voice', 'ta', 'col');\n  makeSeg(vb, 1, ['Poly', 'Mono', 'Legato'], [0, 1, 2]);\n  const kr = el('div', 'krow');\n  vb.append(kr);\n  makeKnob(kr, { index: 2, label: 'Unison', min: 1, max: 8, int: true, fmt: v => Math.round(v) + ' vox' });\n  makeKnob(kr, { index: 3, label: 'Detune', min: 0, max: 1, fmt: fPct });\n  makeKnob(kr, { index: 4, label: 'Glide', min: 0, max: 1, fmt: v => (v < 0.003 ? 'off' : (v * v * 3).toFixed(2) + ' s') });\n  makeKnob(kr, { index: 5, label: 'Tune', min: -100, max: 100, fmt: v => (v > 0 ? '+' : '') + Math.round(v) + ' ct' });\n  const pb = panel(root, '02', 'Performance', 'tb');\n  makeFader(pb, { index: 7, label: 'Pitch', min: -1, max: 1, fmt: v => (v > 0 ? '+' : '') + (v * 2).toFixed(1) + ' st', spring: { to: 0 } });\n  makeFader(pb, { index: 6, label: 'Mod Wheel', min: 0, max: 1 });\n  makeFader(pb, { index: 8, label: 'Pressure', min: 0, max: 1 });\n  const db = panel(root, '03', 'Distortion', 'tc');\n  makeKnob(db, { index: 56, label: 'Drive', min: 0, max: 1, fmt: fPct });\n  makeKnob(db, { index: 57, label: 'Mix', min: 0, max: 1, fmt: fPct });\n  const cb = panel(root, '04', 'Chorus', 'ta');\n  makeKnob(cb, { index: 58, label: 'Rate', min: 0.1, max: 8, log: true, fmt: v => v.toFixed(2) + ' Hz' });\n  makeKnob(cb, { index: 59, label: 'Depth', min: 0, max: 1, fmt: fPct });\n}\n\nfunction buildTabs() {\n  const defs = [\n    ['Oscillators', buildOscPage],\n    ['Filter & Env', buildFilterPage],\n    ['Modulation', buildModPage],\n    ['Voice & FX', buildVoicePage]\n  ];\n  const tabs = document.getElementById('tabs');\n  const pages = document.getElementById('pages');\n  const btns = [];\n  const pgs = [];\n  defs.forEach((d, k) => {\n    const b = el('button', 'tab' + (k === 0 ? ' on' : ''));\n    const no = el('span', 'no', '0' + (k + 1));\n    b.append(no, document.createTextNode(d[0]));\n    tabs.append(b);\n    const pg = el('div', 'page' + (k === 0 ? ' on' : ''));\n    pages.append(pg);\n    d[1](pg);\n    btns.push(b);\n    pgs.push(pg);\n    b.onclick = () => {\n      btns.forEach((x, j) => x.classList.toggle('on', j === k));\n      pgs.forEach((x, j) => x.classList.toggle('on', j === k));\n    };\n  });\n}\n\n/* ===================== presets ===================== */\nfunction buildPresets() {\n  const sel = document.getElementById('soundSel');\n  PRESETS.forEach((p, k) => {\n    const o = el('option');\n    o.value = k;\n    o.textContent = (k < 9 ? '00' : k < 99 ? '0' : '') + (k + 1) + '  ' + p.name;\n    sel.append(o);\n  });\n  const load = k => {\n    k = (k + PRESETS.length) % PRESETS.length;\n    sel.value = k;\n    const d = PRESETS[k].data;\n    for (let i = 1; i < NP; i++) {\n      if (i === 6 || i === 7 || i === 8) continue;\n      pset(i, d[i]);\n    }\n    if (vs() && vs().loadPreset) vs().loadPreset(PRESETS[k].name);\n  };\n  sel.onchange = () => { load(+sel.value); sel.blur(); };\n  document.getElementById('prevBtn').onclick = () => load(+sel.value - 1);\n  document.getElementById('nextBtn').onclick = () => load(+sel.value + 1);\n  document.getElementById('saveBtn').onclick = () => {\n    if (vs() && vs().savePreset) vs().savePreset(PRESETS[+sel.value].name);\n  };\n}\n\n/* ===================== keyboard ===================== */\nconst KBASE = 48;\nconst KEYMAP = {\n  KeyA: 0, KeyW: 1, KeyS: 2, KeyE: 3, KeyD: 4, KeyF: 5, KeyT: 6, KeyG: 7, KeyY: 8,\n  KeyH: 9, KeyU: 10, KeyJ: 11, KeyK: 12, KeyO: 13, KeyL: 14, KeyP: 15, Semicolon: 16\n};\nconst held = new Map();\nconst keyEls = {};\nconst keysDown = new Map();\nconst ptrs = new Map();\nlet activity = 0;\n\nfunction keyDown(n, vel) {\n  const c = held.get(n) || 0;\n  held.set(n, c + 1);\n  if (c > 0) return;\n  if (keyEls[n]) keyEls[n].classList.add('down');\n  activity = Math.min(1, activity + 0.35);\n  if (vs() && vs().noteOn) vs().noteOn(n, vel || 100);\n}\n\nfunction keyUp(n) {\n  const c = held.get(n) || 0;\n  if (c <= 0) return;\n  if (c > 1) { held.set(n, c - 1); return; }\n  held.delete(n);\n  if (keyEls[n]) keyEls[n].classList.remove('down');\n  if (vs() && vs().noteOff) vs().noteOff(n);\n}\n\nfunction releaseAll() {\n  ptrs.forEach(n => keyUp(n));\n  ptrs.clear();\n  keysDown.forEach(n => keyUp(n));\n  keysDown.clear();\n}\n\nfunction buildKeyboard() {\n  const host = document.getElementById('kbd');\n  const base = 36;\n  const octaves = 4;\n  const pattern = [0, 2, 4, 5, 7, 9, 11];\n  const blacks = { 1: 0, 3: 1, 6: 3, 8: 4, 10: 5 };\n  const whites = [];\n  for (let o = 0; o < octaves; o++) pattern.forEach(s => whites.push(base + o * 12 + s));\n  whites.forEach(n => {\n    const k = el('div', 'wk');\n    k.dataset.note = n;\n    host.append(k);\n    keyEls[n] = k;\n  });\n  const wpc = 100 / whites.length;\n  for (let o = 0; o < octaves; o++) {\n    for (const semi in blacks) {\n      const n = base + o * 12 + (+semi);\n      const k = el('div', 'bk');\n      k.dataset.note = n;\n      k.style.width = (wpc * 0.6) + '%';\n      k.style.left = ((blacks[semi] + o * 7 + 1) * wpc - wpc * 0.3) + '%';\n      host.append(k);\n      keyEls[n] = k;\n    }\n  }\n  const velAt = e => {\n    const r = host.getBoundingClientRect();\n    return Math.round(55 + 72 * clamp((e.clientY - r.top) / r.height, 0, 1));\n  };\n  const noteAt = e => {\n    const t = document.elementFromPoint(e.clientX, e.clientY);\n    return t && t.dataset && t.dataset.note ? +t.dataset.note : null;\n  };\n  host.addEventListener('pointerdown', e => {\n    const n = noteAt(e);\n    if (n == null) return;\n    host.setPointerCapture(e.pointerId);\n    ptrs.set(e.pointerId, n);\n    keyDown(n, velAt(e));\n  });\n  host.addEventListener('pointermove', e => {\n    if (!ptrs.has(e.pointerId)) return;\n    const n = noteAt(e);\n    const cur = ptrs.get(e.pointerId);\n    if (n != null && n !== cur) {\n      keyUp(cur);\n      ptrs.set(e.pointerId, n);\n      keyDown(n, velAt(e));\n    }\n  });\n  const up = e => {\n    if (!ptrs.has(e.pointerId)) return;\n    keyUp(ptrs.get(e.pointerId));\n    ptrs.delete(e.pointerId);\n  };\n  host.addEventListener('pointerup', up);\n  host.addEventListener('pointercancel', up);\n  addEventListener('pointerup', up, true);\n  addEventListener('mouseup', releaseAllPointers, true);\n  addEventListener('blur', releaseAll);\n}\n\nfunction releaseAllPointers() {\n  ptrs.forEach(n => keyUp(n));\n  ptrs.clear();\n}\n\naddEventListener('keydown', e => {\n  if (e.metaKey || e.ctrlKey || e.altKey) return;\n  const t = e.target;\n  if (t && t.isContentEditable) return;\n  if (t && (t.tagName === 'TEXTAREA' || t.tagName === 'SELECT')) return;\n  if (t && t.tagName === 'INPUT' && t.type !== 'range' && t.type !== 'checkbox' && t.type !== 'button') return;\n  const off = KEYMAP[e.code];\n  if (off === undefined) return;\n  e.preventDefault();\n  if (e.repeat || keysDown.has(e.code)) return;\n  const n = KBASE + off;\n  keysDown.set(e.code, n);\n  keyDown(n, 100);\n});\n\naddEventListener('keyup', e => {\n  if (!keysDown.has(e.code)) return;\n  e.preventDefault();\n  keyUp(keysDown.get(e.code));\n  keysDown.delete(e.code);\n});\n\n/* ===================== boot ===================== */\nfunction boot() {\n  buildPresets();\n  buildTabs();\n  buildKeyboard();\n  const mh = document.getElementById('masterHost');\n  makeKnob(mh, { index: 0, label: '', min: 0, max: 1, size: 44, fmt: fPct });\n\n  const mL = document.getElementById('mL');\n  const mR = document.getElementById('mR');\n  let ph = 0;\n  function frame() {\n    animators.forEach(a => a());\n    activity *= 0.965;\n    ph += 0.2;\n    const base = Math.min(1, activity * (held.size ? 1 : 0.9));\n    const l = clamp(base * (0.85 + 0.15 * Math.sin(ph)) * (0.3 + P[0]), 0, 1);\n    const r = clamp(base * (0.85 + 0.15 * Math.sin(ph * 1.3 + 1)) * (0.3 + P[0]), 0, 1);\n    mL.style.width = (l * 100) + '%';\n    mR.style.width = (r * 100) + '%';\n    requestAnimationFrame(frame);\n  }\n  frame();\n\n  setTimeout(() => {\n    for (let i = 0; i < NP; i++) {\n      if (!seen[i]) sendParam(i, P[i]);\n    }\n  }, 200);\n}\n\nwhenReady(boot);\n</script>\n<script data-vstai-sound-bar>\n(function () {\n  if (window.__vstaiSoundBarBuilt) return;\n  var POS_KEY = 'vstai.soundBar.pos', MIN_KEY = 'vstai.soundBar.min';\n  var tries = 0;\n\n  function store(k, v) { try { if (v == null) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) {} return null; }\n\n  function ready() {\n    var V = window.vstai;\n    return V && V.presets && typeof V.openBrowser === 'function' && typeof V.saveSound === 'function';\n  }\n\n  function boot() {\n    if (window.__vstaiSoundBarBuilt) return;\n    if (window.__vstaiNativeSoundBar) return;                       // the host draws its own bar\n    if (!ready()) { if (++tries < 40) setTimeout(boot, 150); return; }\n    if (document.querySelector('[data-vstai-sound]')) return;       // the GUI has its own control\n    window.__vstaiSoundBarBuilt = true;\n    build(window.vstai);\n  }\n\n  function build(V) {\n    var host = document.createElement('div');\n    host.id = 'vstai-sound-bar';\n    host.setAttribute('data-vstai-sound-bar-host', '');\n    host.style.cssText = 'position:fixed;top:8px;right:8px;z-index:2147483000;margin:0;padding:0;border:0';\n    var root = host.attachShadow({ mode: 'open' });\n    var css = document.createElement('style');\n    css.textContent = [\n      ':host{all:initial}*{box-sizing:border-box}',\n      '.bar{display:flex;align-items:center;gap:1px;height:26px;padding:0 3px;border-radius:13px;',\n      ' background:rgba(14,18,24,.86);border:1px solid rgba(255,255,255,.2);box-shadow:0 2px 10px rgba(0,0,0,.45);',\n      ' color:#e6e9ee;font:11px/1 -apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,sans-serif;',\n      ' opacity:.62;transition:opacity .12s;user-select:none;-webkit-user-select:none}',\n      '.bar:hover,.bar.drag{opacity:1}',\n      'button{font:inherit;color:inherit;background:transparent;border:0;border-radius:10px;height:20px;min-width:20px;padding:0 5px;cursor:pointer;line-height:20px}',\n      'button:hover{background:rgba(255,255,255,.14)}button:active{background:rgba(255,255,255,.24)}',\n      '.grip{cursor:grab;min-width:12px;padding:0 3px;color:#8a95a5;letter-spacing:-2px;touch-action:none}.drag .grip{cursor:grabbing}',\n      '.name{max-width:130px;min-width:46px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:center;font-weight:600}',\n      '.save{background:#6fd8bd;color:#06231c;font-weight:700;margin-left:2px}.save:hover{background:#85e3cc}',\n      '.arrow{font-size:15px;padding:0 4px}',\n      '.min .hide{display:none}'\n    ].join('');\n    root.appendChild(css);\n\n    function el(tag, cls, text, title) {\n      var e = document.createElement(tag);\n      if (cls) e.className = cls;\n      if (text != null) e.textContent = text;\n      if (title) e.title = title;\n      if (tag === 'button') e.type = 'button';\n      return e;\n    }\n    var bar = el('div', 'bar');\n    var grip = el('button', 'grip', '⋮⋮', 'Drag to move');\n    var prev = el('button', 'arrow hide', '‹', 'Previous sound');\n    var name = el('button', 'name hide', 'Sounds', 'Browse sounds: types, tags, favorites');\n    var next = el('button', 'arrow hide', '›', 'Next sound');\n    var save = el('button', 'save hide', 'Save', 'Save the current knob positions as a sound');\n    var fold = el('button', 'fold', '–', 'Fold away');\n    [grip, prev, name, next, save, fold].forEach(function (b) { bar.appendChild(b); });\n    root.appendChild(bar);\n\n    // The page behind must keep keyboard focus (typing piano) and never see our pointer traffic.\n    bar.addEventListener('mousedown', function (e) { e.preventDefault(); });\n    ['pointerdown', 'mousedown', 'touchstart', 'click', 'contextmenu'].forEach(function (t) {\n      bar.addEventListener(t, function (e) { e.stopPropagation(); });\n    });\n\n    prev.onclick = function () { V.prevPreset(); };\n    next.onclick = function () { V.nextPreset(); };\n    name.onclick = function () { V.openBrowser(); };\n    save.onclick = function () { V.saveSound(); };\n\n    function setMin(m) {\n      bar.className = 'bar' + (m ? ' min' : '');\n      fold.textContent = m ? '♫' : '–';\n      fold.title = m ? 'Show the sound bar' : 'Fold away';\n      store(MIN_KEY, m ? '1' : '0');\n      clamp();\n    }\n    fold.onclick = function () { setMin(bar.className.indexOf('min') < 0); };\n\n    // ---- position: drag by the grip, remember, keep on screen ----------------\n    function clamp() {\n      var r = host.getBoundingClientRect(), w = window.innerWidth, h = window.innerHeight;\n      var x = Math.min(Math.max(0, r.left), Math.max(0, w - r.width));\n      var y = Math.min(Math.max(0, r.top), Math.max(0, h - r.height));\n      if (host.style.left || host.style.right === 'auto') { host.style.left = x + 'px'; host.style.top = y + 'px'; host.style.right = 'auto'; }\n    }\n    function place(x, y) { host.style.left = x + 'px'; host.style.top = y + 'px'; host.style.right = 'auto'; clamp(); }\n    var drag = null;\n    grip.addEventListener('pointerdown', function (e) {\n      var r = host.getBoundingClientRect();\n      drag = { dx: e.clientX - r.left, dy: e.clientY - r.top };\n      bar.className += ' drag';\n      try { grip.setPointerCapture(e.pointerId); } catch (x) {}\n    });\n    grip.addEventListener('pointermove', function (e) { if (drag) place(e.clientX - drag.dx, e.clientY - drag.dy); });\n    function drop() {\n      if (!drag) return;\n      drag = null; bar.className = bar.className.replace(' drag', '');\n      var r = host.getBoundingClientRect(); store(POS_KEY, Math.round(r.left) + ',' + Math.round(r.top));\n    }\n    grip.addEventListener('pointerup', drop);\n    grip.addEventListener('pointercancel', drop);\n    window.addEventListener('resize', clamp);\n\n    document.documentElement.appendChild(host);\n    setMin(store(MIN_KEY) === '1');\n    var saved = (store(POS_KEY) || '').split(',');\n    if (saved.length === 2 && isFinite(+saved[0]) && isFinite(+saved[1])) place(+saved[0], +saved[1]);\n    else {\n      // No remembered spot: once the GUI has drawn, park the bar where it hides the least.\n      var settle = function () { if (!drag) autoPlace(); };\n      setTimeout(settle, 700); setTimeout(settle, 2500);\n    }\n\n    // The corner / edge whose pill-sized patch is mostly empty background: sample a grid of points and\n    // count how many land on something control-sized (a panel or the page itself counts as background).\n    function autoPlace() {\n      if (store(POS_KEY)) return;\n      var w = window.innerWidth, h = window.innerHeight, r = host.getBoundingClientRect(), bw = r.width, bh = r.height, m = 8;\n      if (!bw || !bh) return;\n      var cand = [[w - bw - m, m], [m, m], [(w - bw) / 2, m], [w - bw - m, h - bh - m], [m, h - bh - m], [(w - bw) / 2, h - bh - m]];\n      var prev = host.style.display; host.style.display = 'none';          // look at the GUI, not at ourselves\n      var best = -1, bestScore = 1e9;\n      for (var c = 0; c < cand.length; c++) {\n        var x0 = cand[c][0], y0 = cand[c][1], score = 0;\n        for (var gx = 0; gx < 8; gx++) for (var gy = 0; gy < 3; gy++) {\n          var e = document.elementFromPoint(x0 + (gx + .5) * bw / 8, y0 + (gy + .5) * bh / 3);\n          if (!e || e === document.body || e === document.documentElement) continue;\n          var b = e.getBoundingClientRect();\n          if (b.width * b.height < .3 * w * h) score++;                        // a control-sized thing is under here\n        }\n        score += c * .01;                                                      // ties keep the earlier (top-right first) choice\n        if (score < bestScore) { bestScore = score; best = c; }\n      }\n      host.style.display = prev;\n      var cur = bestScore;\n      if (best > 0 || cur >= 1) place(cand[best][0], cand[best][1]);\n      host.__placed = best;\n    }\n\n    // ---- the name follows the loaded sound ------------------------------------\n    function show(d) {\n      var n = '';\n      for (var i = 0; i < d.entries.length; i++) if (d.entries[i].id === d.current) n = d.entries[i].name;\n      name.textContent = n || 'Sounds';\n      name.title = n ? n + ' – browse sounds' : 'Browse sounds: types, tags, favorites';\n    }\n    V.presets.onChange(show);\n    V.presets.list().catch(function () {});\n  }\n\n  // Give the GUI time to build itself first: one that makes its own sound control (data-vstai-sound)\n  // does it while loading, and the bar must see that before deciding to show up.\n  function later() { setTimeout(boot, 350); }\n  if (document.readyState === 'complete') later(); else window.addEventListener('load', later);\n})();\n</script>\n</body>\n</html>","wasmBase64":"","explanation":"FREEDOM is a 16-voice polyphonic subtractive synth (Poly/Mono/Legato, up to 8 unison voices, PolyBLEP oscillators, sub, noise, six resonant TPT filters, 3 ADSRs, 3 LFOs, a 4-slot mod matrix, distortion and chorus) with 100 generated factory presets and a typing-piano keyboard. The host ABI caps parameters at 64, so per-oscillator pan/phase, LFO sync/retrigger/fade, distortion tone and the full matrix grid are omitted, the matrix is 4 packed slots, and the output meter is note-activity based.","isInstrument":true,"locked":false,"provider":"cloud","model":"claude-sonnet-5-5","effort":"medium","thinking":true,"promptHistory":["# FREEDOM — PROFESSIONAL SUBTRACTIVE SYNTHESIZER\n## Virtual Instrument Development for LIBERTY DAW\n### BSM — Music Is Freedom\n\nYou are a senior audio software engineer, DSP specialist, synthesizer designer, and professional UI/UX developer.\n\nYour mission is to design and develop **FREEDOM**, a powerful, modern, professional-grade subtractive virtual synthesizer for my digital audio workstation, **LIBERTY DAW**.\n\nFREEDOM must be a fully functional software synthesizer, not a graphical mockup or simulation.\n\nIt must feature a complete subtractive synthesis engine, a premium futuristic interface, comprehensive sound-design capabilities, and **100 professionally programmed factory presets**.\n\nThe overall quality, workflow, and musical expressiveness should be inspired by professional instruments such as Minimoog, Prophet, Diva, and modern virtual analog synthesizers, while maintaining its own original identity.\n\n---\n\n# 1. SYNTHESIS ENGINE\n\nDevelop a professional polyphonic subtractive synthesis engine.\n\nMain specifications:\n\n- Minimum 16-note polyphony.\n- MONO, POLY, and LEGATO modes.\n- Up to 8 unison voices per note.\n- Intelligent voice allocation and voice stealing.\n- Velocity sensitivity.\n- MIDI Note On / Note Off.\n- Pitch Bend.\n- Modulation Wheel.\n- Aftertouch support.\n- Portamento and Glide.\n- Global tuning.\n- Stereo audio output.\n- Real-time parameter changes.\n- Sample-rate-independent processing.\n- Smooth parameter interpolation.\n- Efficient CPU usage.\n\nThe engine must remain stable when multiple instances of FREEDOM are running simultaneously.\n\n# 2. OSCILLATOR SECTION\n\nCreate three independent oscillators:\n\n**OSCILLATOR 1 — OSCILLATOR 2 — OSCILLATOR 3**\n\nEach oscillator must include:\n\nWaveforms:\n- Sine\n- Triangle\n- Sawtooth\n- Square\n- Pulse\n- White Noise\n- Pink Noise\n\nControls:\n- Oscillator ON/OFF\n- Waveform Selection\n- Octave\n- Semitone\n- Fine Tune\n- Volume\n- Pan\n- Pulse Width\n- Phase\n- Hard Sync where supported\n\nAdd a dedicated SUB OSCILLATOR with -1 and -2 octave options.\n\nProvide independent noise generation and mixing.\n\nUse high-quality, band-limited oscillator techniques to minimize aliasing.\n\n# 3. OSCILLATOR MIXER\n\nCreate an independent oscillator mixer with:\n\n- OSC 1 LEVEL\n- OSC 2 LEVEL\n- OSC 3 LEVEL\n- SUB LEVEL\n- NOISE LEVEL\n\nInclude visual level indicators.\n\nAll oscillator signals must be routed into the subtractive filter section.\n\n# 4. PROFESSIONAL FILTER SECTION\n\nImplement high-quality resonant filters.\n\nFilter types:\n\n- Low Pass 12 dB\n- Low Pass 24 dB\n- High Pass 12 dB\n- High Pass 24 dB\n- Band Pass\n- Notch\n\nFilter parameters:\n\n- Cutoff Frequency\n- Resonance\n- Drive\n- Key Tracking\n- Envelope Amount\n- Velocity Sensitivity\n\nProvide musical resonance behavior, including self-oscillation where appropriate.\n\nThe filters must respond smoothly to real-time modulation without audible stepping.\n\n# 5. ADSR ENVELOPES\n\nCreate three independent envelope generators:\n\n**AMP ENVELOPE**\n**FILTER ENVELOPE**\n**MODULATION ENVELOPE**\n\nEach envelope must include:\n\n- Attack\n- Decay\n- Sustain\n- Release\n\nAdd an interactive graphical envelope display.\n\nUsers must be able to modify envelope values with immediate audible feedback.\n\n# 6. LFO MODULATION\n\nCreate three independent Low Frequency Oscillators.\n\nAvailable waveforms:\n\n- Sine\n- Triangle\n- Saw Up\n- Saw Down\n- Square\n- Sample & Hold\n- Smooth Random\n\nControls:\n\n- Rate\n- Depth\n- Phase\n- Retrigger\n- Fade In\n- Tempo Sync\n\nPossible modulation destinations:\n\n- Oscillator Pitch\n- Filter Cutoff\n- Filter Resonance\n- Amplitude\n- Pan\n- Pulse Width\n- Oscillator Fine Tune\n\n# 7. MODULATION MATRIX\n\nDevelop a flexible modulation matrix.\n\nUsers must be able to assign modulation sources to multiple destinations.\n\nSources:\n\n- LFO 1 / 2 / 3\n- AMP Envelope\n- Filter Envelope\n- Mod Envelope\n- Velocity\n- Mod Wheel\n- Aftertouch\n- Key Tracking\n\nInclude adjustable modulation depth and bipolar modulation where applicable.\n\nAll modulation assignments must be saved within presets.\n\n# 8. BUILT-IN EFFECTS\n\nImplement a complete integrated effects section.\n\n**DISTORTION**\n- Drive\n- Tone\n- Mix\n\n**CHORUS**\n- Rate\n- Depth"],"params":[{"name":"Master","index":0,"min":0,"max":1,"default":0.7,"value":0.7},{"name":"Voice Mode (0 Poly, 1 Mono, 2 Legato)","index":1,"min":0,"max":2,"default":0,"value":0},{"name":"Unison Voices","index":2,"min":1,"max":8,"default":1,"value":1},{"name":"Unison Detune","index":3,"min":0,"max":1,"default":0.3,"value":0.3},{"name":"Glide","index":4,"min":0,"max":1,"default":0,"value":0},{"name":"Global Tune (cents)","index":5,"min":-100,"max":100,"default":0,"value":0},{"name":"Mod Wheel","index":6,"min":0,"max":1,"default":0,"value":0},{"name":"Pitch Bend (+/-2 st)","index":7,"min":-1,"max":1,"default":0,"value":0},{"name":"Aftertouch","index":8,"min":0,"max":1,"default":0,"value":0},{"name":"Osc1 Wave","index":9,"min":0,"max":6,"default":2,"value":2},{"name":"Osc1 Octave","index":10,"min":-2,"max":2,"default":0,"value":0},{"name":"Osc1 Semi/Fine","index":11,"min":-12,"max":12,"default":0,"value":0},{"name":"Osc1 Level","index":12,"min":0,"max":1,"default":0.7,"value":0.7},{"name":"Osc1 Pulse Width","index":13,"min":0.05,"max":0.95,"default":0.5,"value":0.5},{"name":"Osc2 Wave","index":14,"min":0,"max":6,"default":2,"value":2},{"name":"Osc2 Octave","index":15,"min":-2,"max":2,"default":0,"value":-1},{"name":"Osc2 Semi/Fine","index":16,"min":-12,"max":12,"default":0.1,"value":0.1},{"name":"Osc2 Level","index":17,"min":0,"max":1,"default":0.5,"value":0.5},{"name":"Osc2 Pulse Width","index":18,"min":0.05,"max":0.95,"default":0.5,"value":0.5},{"name":"Osc3 Wave","index":19,"min":0,"max":6,"default":3,"value":5},{"name":"Osc3 Octave","index":20,"min":-2,"max":2,"default":-1,"value":1},{"name":"Osc3 Semi/Fine","index":21,"min":-12,"max":12,"default":0,"value":0},{"name":"Osc3 Level","index":22,"min":0,"max":1,"default":0,"value":0.578650832176208},{"name":"Osc3 Pulse Width","index":23,"min":0.05,"max":0.95,"default":0.5,"value":0.5},{"name":"Hard Sync (Osc2+3 to Osc1)","index":24,"min":0,"max":1,"default":0,"value":0},{"name":"Sub Level","index":25,"min":0,"max":1,"default":0.3,"value":0.3},{"name":"Sub Octave (1=-1, 2=-2)","index":26,"min":1,"max":2,"default":1,"value":1},{"name":"Noise Level","index":27,"min":0,"max":1,"default":0,"value":0},{"name":"Filter Type","index":28,"min":0,"max":5,"default":1,"value":1},{"name":"Cutoff","index":29,"min":20,"max":20000,"default":3000,"value":287.6683654785156},{"name":"Resonance","index":30,"min":0,"max":1,"default":0.2,"value":0.687847197055817},{"name":"Filter Drive","index":31,"min":0,"max":1,"default":0.1,"value":0.639973938465118},{"name":"Key Tracking","index":32,"min":0,"max":1,"default":0.4,"value":0.749652802944183},{"name":"Filter Env Amount","index":33,"min":-1,"max":1,"default":0.3,"value":0.3},{"name":"Filter Velocity","index":34,"min":0,"max":1,"default":0.3,"value":0.3},{"name":"Amp Attack","index":35,"min":0,"max":1,"default":0.25,"value":0.25},{"name":"Amp Decay","index":36,"min":0,"max":1,"default":0.65,"value":0.75},{"name":"Amp Sustain","index":37,"min":0,"max":1,"default":0.7,"value":0.7},{"name":"Amp Release","index":38,"min":0,"max":1,"default":0.6,"value":0.6},{"name":"Filter Attack","index":39,"min":0,"max":1,"default":0.2,"value":0.2},{"name":"Filter Decay","index":40,"min":0,"max":1,"default":0.65,"value":0.65},{"name":"Filter Sustain","index":41,"min":0,"max":1,"default":0.3,"value":0.3},{"name":"Filter Release","index":42,"min":0,"max":1,"default":0.6,"value":0.6},{"name":"Mod Attack","index":43,"min":0,"max":1,"default":0.5,"value":0.5},{"name":"Mod Decay","index":44,"min":0,"max":1,"default":0.6,"value":0.6},{"name":"Mod Sustain","index":45,"min":0,"max":1,"default":0.5,"value":0.5},{"name":"Mod Release","index":46,"min":0,"max":1,"default":0.6,"value":0.6},{"name":"LFO1 Rate","index":47,"min":0.05,"max":30,"default":4,"value":15.466877937316895},{"name":"LFO1 Depth","index":48,"min":0,"max":1,"default":0.5,"value":0.860872387886047},{"name":"LFO1 Shape","index":49,"min":0,"max":6,"default":0,"value":0},{"name":"LFO2 Rate","index":50,"min":0.05,"max":30,"default":1,"value":1},{"name":"LFO2 Depth","index":51,"min":0,"max":1,"default":0.5,"value":0.5},{"name":"LFO2 Shape","index":52,"min":0,"max":6,"default":0,"value":0},{"name":"LFO3 Rate","index":53,"min":0.05,"max":30,"default":0.3,"value":0.3},{"name":"LFO3 Depth","index":54,"min":0,"max":1,"default":0.5,"value":0.5},{"name":"LFO3 Shape","index":55,"min":0,"max":6,"default":0,"value":0},{"name":"Distortion Drive","index":56,"min":0,"max":1,"default":0.3,"value":0.3},{"name":"Distortion Mix","index":57,"min":0,"max":1,"default":0,"value":0},{"name":"Chorus Rate","index":58,"min":0.1,"max":8,"default":0.8,"value":0.8},{"name":"Chorus Depth","index":59,"min":0,"max":1,"default":0,"value":0},{"name":"Mod Matrix Slot 1 (packed)","index":60,"min":0,"max":17687,"default":100,"value":3576},{"name":"Mod Matrix Slot 2 (packed)","index":61,"min":0,"max":17687,"default":100,"value":100},{"name":"Mod Matrix Slot 3 (packed)","index":62,"min":0,"max":17687,"default":100,"value":100},{"name":"Mod Matrix Slot 4 (packed)","index":63,"min":0,"max":17687,"default":100,"value":100}],"presets":[],"activeRevision":0,"nextRevisionId":2,"publishedAt":1792696377209}