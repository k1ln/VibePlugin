  "html": "<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Doob</title>\n<style>:root{color-scheme:dark;--ink:#efece1;--acc:#e8a33a}\n*{box-sizing:border-box}\nhtml,body{margin:0;height:100%;background:#120e0a;overflow:hidden;font-family:\"Helvetica Neue\",Helvetica,Arial,sans-serif;color:var(--ink);user-select:none;-webkit-user-select:none}\n#wrap{position:relative;width:100vw;height:100vh;overflow:hidden}\n#stage{position:absolute;left:0;top:0;width:1560px;height:900px;transform-origin:0 0;background:#1d1409}\n.cheek{position:absolute;top:0;bottom:0;width:30px;background:\n repeating-linear-gradient(90deg,rgba(0,0,0,.22) 0 1px,transparent 1px 5px),\n repeating-linear-gradient(93deg,rgba(255,200,130,.08) 0 2px,transparent 2px 11px),\n linear-gradient(180deg,#5b3419,#7a4a24 45%,#5a3519);box-shadow:inset 0 0 14px rgba(0,0,0,.6)}\n.cheek.l{left:0}.cheek.r{right:0}\n#plate{position:absolute;left:30px;top:0;width:1500px;height:900px;background:#201d19;box-shadow:0 0 0 1px #000}\n/* header */\n#hdr{position:absolute;left:0;top:0;width:1500px;height:48px;background:linear-gradient(180deg,#2a2620,#191611);border-bottom:1px solid #000}\n.brand{position:absolute;left:16px;top:3px;color:#f6ecd4;font-weight:900;font-size:26px;letter-spacing:6px}\n.brand small{display:block;font-size:7.5px;letter-spacing:2px;color:#b9a888;font-weight:600;margin-top:-2px}\n#sheet{position:absolute;left:250px;top:8px;display:flex;gap:6px;align-items:center}\n#sheet select{background:#14110d;color:#f1e6cf;border:1px solid #5a4a33;border-radius:3px;font-size:12px;padding:4px 6px;min-width:210px}\n.hbtn{background:#3a3126;color:#f4ead2;border:1px solid #6a5a40;border-radius:3px;font-size:11px;padding:4px 9px;cursor:pointer;font-weight:600;letter-spacing:.5px}\n.hbtn:hover{background:#4b3f2f}\n.hbtn.on{background:var(--acc);color:#190d02;border-color:#ffd08a}\n#status{position:absolute;right:14px;top:8px;font-family:Menlo,Consolas,monospace;font-size:11px;color:#f2c070;background:#0d0a07;border:1px solid #3a2f20;border-radius:3px;padding:6px 10px;min-width:260px;text-align:right;letter-spacing:.4px}\n#note{position:absolute;left:712px;top:5px;width:470px;font-size:9.5px;line-height:1.22;color:#cdbf9f;max-height:40px;overflow:hidden}\n/* faceplate: black panel, white lettering */\n#panel{position:absolute;left:0;top:52px;width:1500px;height:440px;background:\n radial-gradient(ellipse at 30% 0,rgba(255,255,255,.07),transparent 60%),\n repeating-linear-gradient(0deg,rgba(255,255,255,.012) 0 1px,transparent 1px 3px),\n linear-gradient(180deg,#2b2926,#1b1a18);border-radius:8px;box-shadow:0 0 0 2px #080706,inset 0 0 0 1px rgba(255,255,255,.08)}\n.sec{position:absolute;border:1.8px solid #e9e5d8;border-radius:5px}\n.sec>.st{position:absolute;left:0;right:0;top:-9px;text-align:center}\n.sec>.st span{background:#242321;padding:0 8px;font-size:11.5px;font-weight:800;letter-spacing:1.4px;color:#f4f0e3}\n.lab{position:absolute;transform:translateX(-50%);font-size:8.8px;font-weight:700;color:#efece1;white-space:nowrap;letter-spacing:.3px;line-height:11px;text-align:center}\n.lab.big{font-size:10.5px;letter-spacing:.8px}\n.lab.sm{font-size:7.8px;font-weight:600;color:#c9c5b6}\n.lab.hd{font-size:9.5px;letter-spacing:1px;color:#e8a33a}\n.lab.l{transform:none}\n.lab.sel{color:#ffd08a}\n.kn{position:absolute;touch-action:none;cursor:ns-resize;z-index:5}\n.kn svg,.ro svg,.rk svg{display:block;overflow:visible}\n.kn .ptr{stroke:#fff;stroke-width:2.4;stroke-linecap:round}\n.kn:hover .rim,.kn.act .rim{stroke:#ffc474}\n.kn.act .rim{stroke-width:2.5}\n.ro{position:absolute;touch-action:none;cursor:pointer;z-index:5}\n.rk{position:absolute;touch-action:none;cursor:pointer;z-index:5}\n.led{position:absolute;width:11px;height:11px;margin:-5.5px 0 0 -5.5px;border-radius:50%;background:#3b1a12;box-shadow:inset 0 0 2px #000,0 0 0 1.5px #0a0a0a;z-index:4}\n.led.on{background:#ff4b2b;box-shadow:0 0 9px 3px rgba(255,75,43,.75),0 0 0 1.5px #0a0a0a}\n.led.g{background:#1d3a14}.led.g.on{background:#6bff4a;box-shadow:0 0 9px 3px rgba(107,255,74,.6),0 0 0 1.5px #0a0a0a}\n.mtr{position:absolute;width:10px;border:1.5px solid #0a0a0a;background:#101010;z-index:4;overflow:hidden}\n.mtr i{position:absolute;left:0;right:0;bottom:0;background:linear-gradient(0deg,#4fdc3a,#e8e03a 70%,#ff4b2b);height:0}\n/* lower deck */\n#deck{position:absolute;left:0;top:496px;width:1500px;height:404px;background:linear-gradient(180deg,#1b1812,#110f0b)}\n.lhc{position:absolute;left:12px;top:8px;width:250px;height:384px;background:linear-gradient(180deg,#2a2825,#1c1b19);border:2px solid #080706;border-radius:10px;box-shadow:inset 0 0 0 1px rgba(255,255,255,.08)}\n.lhc .st{position:absolute;left:0;right:0;top:6px;text-align:center;font-size:10px;font-weight:800;letter-spacing:1px;color:#f4f0e3}\n.whl{position:absolute;touch-action:none;cursor:ns-resize;z-index:5;border:2px solid #000;border-radius:8px;background:repeating-linear-gradient(0deg,#17171a 0 3px,#2a2a2e 3px 6px);box-shadow:0 0 0 2px #b9b6aa}\n.whl i{position:absolute;left:-3px;right:-3px;height:12px;margin-top:-6px;background:linear-gradient(180deg,#f4f3ec,#b4b2a6);border:2px solid #000;border-radius:4px}\n.kbd{position:absolute;left:276px;top:12px;width:1076px;height:380px;background:#0a0908;border:2px solid #000;border-radius:3px}\n.wk,.bk{position:absolute;touch-action:none;cursor:pointer}\n.wk{top:0;bottom:0;background:linear-gradient(180deg,#f8f6ee,#dcd9cd);border:1px solid #2a2a2a;border-radius:0 0 4px 4px;box-shadow:inset 0 -6px 6px rgba(0,0,0,.08)}\n.bk{top:0;height:62%;background:linear-gradient(180deg,#3d3d40,#050506);border:1px solid #000;border-radius:0 0 3px 3px;z-index:2;box-shadow:0 3px 4px rgba(0,0,0,.6)}\n.wk.hit{background:linear-gradient(180deg,#ffe0b4,#f0a850)}\n.bk.hit{background:linear-gradient(180deg,#c77a1a,#6b3a06)}\n.wk .nm{position:absolute;bottom:4px;left:0;right:0;text-align:center;font-size:8.5px;color:#7b7a72;font-weight:700}\n.rear{position:absolute;left:1364px;top:8px;width:124px;height:384px;background:linear-gradient(180deg,#2a2825,#1c1b19);border:2px solid #080706;border-radius:10px;box-shadow:inset 0 0 0 1px rgba(255,255,255,.08)}\n.rear .st{position:absolute;left:0;right:0;top:6px;text-align:center;font-size:10px;font-weight:800;letter-spacing:1px;color:#f4f0e3}\n/* tooltip / dialog */\n#tip{position:fixed;z-index:50;background:#0d0a07;color:#ffd9a8;border:1px solid #6a4a22;border-radius:3px;font:11px/1.3 Menlo,Consolas,monospace;padding:3px 7px;pointer-events:none;white-space:nowrap}\n#tip[hidden]{display:none}\n#glob{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);z-index:60;background:#17130e;color:#f1e6cf;border:1px solid #6a5a40;border-radius:8px;padding:16px 20px;width:660px;max-height:84vh;overflow:auto;font-size:12px;box-shadow:0 10px 40px rgba(0,0,0,.7)}\n#glob[hidden]{display:none}\n#glob h3{margin:0 0 4px;font-size:13px;letter-spacing:1px;color:#f2c070}\n#glob .grid{display:grid;grid-template-columns:200px 1fr;gap:7px 12px;align-items:center;margin:8px 0 14px}\n#glob select,#glob input[type=range]{background:#0d0a07;color:#f1e6cf;border:1px solid #5a4a33;border-radius:3px;font-size:12px;padding:3px}\n#glob .tp{font-size:10.5px;color:#a89a7e;grid-column:1/-1;margin-top:-4px}\n#glob .x{float:right}\n#glob table{border-collapse:collapse;font-size:11px;width:100%}\n#glob td,#glob th{padding:2px 6px;border-bottom:1px solid #2c261c;text-align:left}\n</style></head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <radialGradient id=\"dbKnob\" cx=\"42%\" cy=\"34%\" r=\"78%\"><stop offset=\"0\" stop-color=\"#5d5d62\"/><stop offset=\".5\" stop-color=\"#202023\"/><stop offset=\"1\" stop-color=\"#070708\"/></radialGradient>\n  <radialGradient id=\"dbCap\" cx=\"40%\" cy=\"30%\" r=\"80%\"><stop offset=\"0\" stop-color=\"#4c4c51\"/><stop offset=\"1\" stop-color=\"#0e0e10\"/></radialGradient>\n  <linearGradient id=\"dbNut\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#f4f3ee\"/><stop offset=\".5\" stop-color=\"#a9a89f\"/><stop offset=\"1\" stop-color=\"#6b6a63\"/></linearGradient>\n  <linearGradient id=\"dbLever\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\"><stop offset=\"0\" stop-color=\"#9a998f\"/><stop offset=\".45\" stop-color=\"#fbfaf4\"/><stop offset=\"1\" stop-color=\"#8e8d83\"/></linearGradient>\n</defs></svg>\n<div id=\"wrap\"><div id=\"stage\">\n  <div class=\"cheek l\"></div><div class=\"cheek r\"></div>\n  <div id=\"plate\"></div>\n</div></div>\n<div id=\"tip\" hidden></div>\n<div id=\"glob\" hidden></div>\n<script>\nvar DATA={\"params\":[{\"key\":\"TUNE\",\"name\":\"Tune\",\"curve\":\"lin\",\"min\":-1,\"max\":1,\"def\":0,\"steps\":0,\"fmt\":\"tune\",\"slot\":0,\"mult\":1,\"direct\":true,\"tip\":\"Overall tuning of all three oscillators (±4 semitones). A-440 reference: tune oscillator 1 to the A-440 switch.\",\"grp\":\"ctl\"},{\"key\":\"GLIDE\",\"name\":\"Glide\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0,\"steps\":0,\"fmt\":\"glide\",\"slot\":1,\"mult\":1,\"direct\":true,\"tip\":\"Portamento time (exponential, up to ~10 s). Active when the GLIDE switch is on.\",\"grp\":\"ctl\"},{\"key\":\"MODMIX\",\"name\":\"Modulation Mix\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0,\"steps\":0,\"fmt\":\"mix\",\"slot\":2,\"mult\":1,\"direct\":true,\"tip\":\"Blend of the two modulation sources: fully left = Oscillator 3 (or filter contour), fully right = noise (or LFO).\",\"grp\":\"ctl\"},{\"key\":\"OSC_MOD\",\"name\":\"Oscillator Modulation\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":0,\"steps\":2,\"fmt\":[\"off\",\"on\"],\"slot\":25,\"mult\":6718464,\"direct\":false,\"tip\":\"Sends the modulation (scaled by the MOD wheel) to the pitch of all three oscillators.\",\"grp\":\"ctl\"},{\"key\":\"FIL_MOD\",\"name\":\"Filter Modulation\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":0,\"steps\":2,\"fmt\":[\"off\",\"on\"],\"slot\":26,\"mult\":1,\"direct\":false,\"tip\":\"Sends the modulation (scaled by the MOD wheel) to the filter cutoff.\",\"grp\":\"ctl\"},{\"key\":\"O3_CTRL\",\"name\":\"Oscillator 3 Control\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":1,\"steps\":2,\"fmt\":[\"off\",\"on\"],\"slot\":26,\"mult\":2,\"direct\":false,\"tip\":\"On: oscillator 3 follows the keyboard. Off: it free-runs (FREQUENCY then sweeps 6 octaves) — an LFO / drone.\",\"grp\":\"ctl\"},{\"key\":\"O1_RANGE\",\"name\":\"Osc 1 Range\",\"curve\":\"int\",\"min\":0,\"max\":5,\"def\":3,\"steps\":6,\"fmt\":[\"LO\",\"32'\",\"16'\",\"8'\",\"4'\",\"2'\"],\"slot\":25,\"mult\":12,\"direct\":false,\"tip\":\"LO / 32' / 16' / 8' / 4' / 2'.\",\"grp\":\"osc\"},{\"key\":\"O1_WAVE\",\"name\":\"Osc 1 Waveform\",\"curve\":\"int\",\"min\":0,\"max\":5,\"def\":2,\"steps\":6,\"fmt\":[\"Triangle\",\"Shark tooth\",\"Sawtooth\",\"Square\",\"Wide pulse\",\"Narrow pulse\"],\"slot\":25,\"mult\":72,\"direct\":false,\"tip\":\"Triangle, sawtooth-triangular (shark tooth), sawtooth, square, wide rectangular, narrow rectangular.\",\"grp\":\"osc\"},{\"key\":\"O2_RANGE\",\"name\":\"Osc 2 Range\",\"curve\":\"int\",\"min\":0,\"max\":5,\"def\":3,\"steps\":6,\"fmt\":[\"LO\",\"32'\",\"16'\",\"8'\",\"4'\",\"2'\"],\"slot\":25,\"mult\":432,\"direct\":false,\"tip\":\"\",\"grp\":\"osc\"},{\"key\":\"O2_FREQ\",\"name\":\"Osc 2 Frequency\",\"curve\":\"lin\",\"min\":-1,\"max\":1,\"def\":0,\"steps\":0,\"fmt\":\"freq\",\"slot\":3,\"mult\":1,\"direct\":true,\"tip\":\"±7 semitones against oscillator 1.\",\"grp\":\"osc\"},{\"key\":\"O2_WAVE\",\"name\":\"Osc 2 Waveform\",\"curve\":\"int\",\"min\":0,\"max\":5,\"def\":2,\"steps\":6,\"fmt\":[\"Triangle\",\"Shark tooth\",\"Sawtooth\",\"Square\",\"Wide pulse\",\"Narrow pulse\"],\"slot\":25,\"mult\":2592,\"direct\":false,\"tip\":\"\",\"grp\":\"osc\"},{\"key\":\"O3_RANGE\",\"name\":\"Osc 3 Range\",\"curve\":\"int\",\"min\":0,\"max\":5,\"def\":3,\"steps\":6,\"fmt\":[\"LO\",\"32'\",\"16'\",\"8'\",\"4'\",\"2'\"],\"slot\":25,\"mult\":15552,\"direct\":false,\"tip\":\"\",\"grp\":\"osc\"},{\"key\":\"O3_FREQ\",\"name\":\"Osc 3 Frequency\",\"curve\":\"lin\",\"min\":-1,\"max\":1,\"def\":0,\"steps\":0,\"fmt\":\"freq\",\"slot\":4,\"mult\":1,\"direct\":true,\"tip\":\"±7 semitones; ±3 octaves (six-octave sweep) when OSCILLATOR 3 CONTROL is off.\",\"grp\":\"osc\"},{\"key\":\"O3_WAVE\",\"name\":\"Osc 3 Waveform\",\"curve\":\"int\",\"min\":0,\"max\":5,\"def\":2,\"steps\":6,\"fmt\":[\"Triangle\",\"Reverse saw\",\"Sawtooth\",\"Square\",\"Wide pulse\",\"Narrow pulse\"],\"slot\":25,\"mult\":93312,\"direct\":false,\"tip\":\"Oscillator 3 substitutes a reverse sawtooth for the shark tooth.\",\"grp\":\"osc\"},{\"key\":\"SW_O1\",\"name\":\"Osc 1 switch\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":1,\"steps\":2,\"fmt\":[\"off\",\"on\"],\"slot\":26,\"mult\":4,\"direct\":false,\"tip\":\"\",\"grp\":\"mix\"},{\"key\":\"VOL1\",\"name\":\"Oscillator 1\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0.7,\"steps\":0,\"fmt\":\"dial\",\"slot\":5,\"mult\":1,\"direct\":true,\"tip\":\"Mixer level (0-10). The mixer overloads into the filter at high settings — that is the fat Minimoog sound.\",\"grp\":\"mix\"},{\"key\":\"SW_O2\",\"name\":\"Osc 2 switch\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":0,\"steps\":2,\"fmt\":[\"off\",\"on\"],\"slot\":26,\"mult\":8,\"direct\":false,\"tip\":\"\",\"grp\":\"mix\"},{\"key\":\"VOL2\",\"name\":\"Oscillator 2\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0,\"steps\":0,\"fmt\":\"dial\",\"slot\":6,\"mult\":1,\"direct\":true,\"tip\":\"\",\"grp\":\"mix\"},{\"key\":\"SW_O3\",\"name\":\"Osc 3 switch\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":0,\"steps\":2,\"fmt\":[\"off\",\"on\"],\"slot\":26,\"mult\":16,\"direct\":false,\"tip\":\"\",\"grp\":\"mix\"},{\"key\":\"VOL3\",\"name\":\"Oscillator 3\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0,\"steps\":0,\"fmt\":\"dial\",\"slot\":7,\"mult\":1,\"direct\":true,\"tip\":\"Switching oscillator 3 off here does not affect its modulation signal.\",\"grp\":\"mix\"},{\"key\":\"SW_EXT\",\"name\":\"External input switch\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":0,\"steps\":2,\"fmt\":[\"off\",\"on\"],\"slot\":26,\"mult\":32,\"direct\":false,\"tip\":\"\",\"grp\":\"mix\"},{\"key\":\"VOLEXT\",\"name\":\"External Input\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0.5,\"steps\":0,\"fmt\":\"dial\",\"slot\":8,\"mult\":1,\"direct\":true,\"tip\":\"Microphone preamp on the host audio input. Set so the OVERLOAD lamp only blinks on loud peaks.\",\"grp\":\"mix\"},{\"key\":\"SW_NZ\",\"name\":\"Noise switch\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":0,\"steps\":2,\"fmt\":[\"off\",\"on\"],\"slot\":26,\"mult\":64,\"direct\":false,\"tip\":\"\",\"grp\":\"mix\"},{\"key\":\"VOLNZ\",\"name\":\"Noise\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0,\"steps\":0,\"fmt\":\"dial\",\"slot\":9,\"mult\":1,\"direct\":true,\"tip\":\"\",\"grp\":\"mix\"},{\"key\":\"NZ_COLOR\",\"name\":\"Noise Quality\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":0,\"steps\":2,\"fmt\":[\"White\",\"Pink\"],\"slot\":26,\"mult\":128,\"direct\":false,\"tip\":\"WHITE / PINK. (The modulation noise is the next colour down: pink / red.)\",\"grp\":\"mix\"},{\"key\":\"CUTOFF\",\"name\":\"Cutoff Frequency\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0.55,\"steps\":0,\"fmt\":\"cut\",\"slot\":10,\"mult\":1,\"direct\":true,\"tip\":\"-5 … +5 on the panel: ten octaves, 440 Hz at -1 (27 Hz - 28 kHz).\",\"grp\":\"filt\"},{\"key\":\"EMPH\",\"name\":\"Emphasis\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0.15,\"steps\":0,\"fmt\":\"dial\",\"slot\":11,\"mult\":1,\"direct\":true,\"tip\":\"Resonance. Regeneration begins between 7 and 8; at 10 the filter oscillates (a pure sine, the 'sixth sound source').\",\"grp\":\"filt\"},{\"key\":\"CONTOUR\",\"name\":\"Amount of Contour\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0.3,\"steps\":0,\"fmt\":\"dial\",\"slot\":12,\"mult\":1,\"direct\":true,\"tip\":\"How far the filter contour sweeps the cutoff (up to ~8.5 octaves).\",\"grp\":\"filt\"},{\"key\":\"FATK\",\"name\":\"Filter Attack\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0.1,\"steps\":0,\"fmt\":\"time\",\"slot\":13,\"mult\":1,\"direct\":true,\"tip\":\"\",\"grp\":\"filt\"},{\"key\":\"FDEC\",\"name\":\"Filter Decay\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0.45,\"steps\":0,\"fmt\":\"time\",\"slot\":14,\"mult\":1,\"direct\":true,\"tip\":\"\",\"grp\":\"filt\"},{\"key\":\"FSUS\",\"name\":\"Filter Sustain\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0.3,\"steps\":0,\"fmt\":\"dial\",\"slot\":15,\"mult\":1,\"direct\":true,\"tip\":\"\",\"grp\":\"filt\"},{\"key\":\"KB1\",\"name\":\"Keyboard Control 1\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":1,\"steps\":2,\"fmt\":[\"off\",\"on\"],\"slot\":26,\"mult\":256,\"direct\":false,\"tip\":\"Couples one third of the keyboard CV to the filter cutoff.\",\"grp\":\"filt\"},{\"key\":\"KB2\",\"name\":\"Keyboard Control 2\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":0,\"steps\":2,\"fmt\":[\"off\",\"on\"],\"slot\":26,\"mult\":512,\"direct\":false,\"tip\":\"Couples two thirds of the keyboard CV to the filter cutoff (both on = full tracking).\",\"grp\":\"filt\"},{\"key\":\"LATK\",\"name\":\"Loudness Attack\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0.05,\"steps\":0,\"fmt\":\"time\",\"slot\":16,\"mult\":1,\"direct\":true,\"tip\":\"\",\"grp\":\"loud\"},{\"key\":\"LDEC\",\"name\":\"Loudness Decay\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0.5,\"steps\":0,\"fmt\":\"time\",\"slot\":17,\"mult\":1,\"direct\":true,\"tip\":\"\",\"grp\":\"loud\"},{\"key\":\"LSUS\",\"name\":\"Loudness Sustain\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":1,\"steps\":0,\"fmt\":\"dial\",\"slot\":18,\"mult\":1,\"direct\":true,\"tip\":\"\",\"grp\":\"loud\"},{\"key\":\"OUTVOL\",\"name\":\"Main Output Volume\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0.7,\"steps\":0,\"fmt\":\"dial\",\"slot\":19,\"mult\":1,\"direct\":true,\"tip\":\"\",\"grp\":\"out\"},{\"key\":\"MAIN_ON\",\"name\":\"Main Output\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":1,\"steps\":2,\"fmt\":[\"off\",\"on\"],\"slot\":26,\"mult\":1024,\"direct\":false,\"tip\":\"MAIN OUTPUT switch: off silences the output (the headphone jack stays live on the hardware).\",\"grp\":\"out\"},{\"key\":\"A440\",\"name\":\"A-440\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":0,\"steps\":2,\"fmt\":[\"off\",\"on\"],\"slot\":26,\"mult\":2048,\"direct\":false,\"tip\":\"Tuning reference: a Wien-bridge sine (with a little harmonic content, as on the hardware) added to the output.\",\"grp\":\"out\"},{\"key\":\"PITCHW\",\"name\":\"Pitch Wheel\",\"curve\":\"lin\",\"min\":-1,\"max\":1,\"def\":0,\"steps\":0,\"fmt\":\"bip\",\"slot\":20,\"mult\":1,\"direct\":true,\"tip\":\"Bends the oscillators (not the filter). Spring-centred.\",\"grp\":\"lhc\"},{\"key\":\"MODW\",\"name\":\"Modulation Wheel\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0,\"steps\":0,\"fmt\":\"pct\",\"slot\":21,\"mult\":1,\"direct\":true,\"tip\":\"A level control for the Modulation Mix (audio taper, like the 50 K pot on the hardware).\",\"grp\":\"lhc\"},{\"key\":\"GLIDE_ON\",\"name\":\"Glide switch\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":0,\"steps\":2,\"fmt\":[\"off\",\"on\"],\"slot\":26,\"mult\":4096,\"direct\":false,\"tip\":\"GLIDE on/off (rocker switch left of the keyboard).\",\"grp\":\"lhc\"},{\"key\":\"DECAY_ON\",\"name\":\"Decay switch\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":0,\"steps\":2,\"fmt\":[\"off\",\"on\"],\"slot\":26,\"mult\":8192,\"direct\":false,\"tip\":\"On: after the key is released both contours fall at the DECAY time instead of cutting off.\",\"grp\":\"lhc\"},{\"key\":\"STRIG\",\"name\":\"S-Trig plug\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":0,\"steps\":2,\"fmt\":[\"off\",\"on\"],\"slot\":26,\"mult\":16384,\"direct\":false,\"tip\":\"The shorting plug in the rear TRIGGER INPUT: both contours are held at their sustain level, with or without a key.\",\"grp\":\"rear\"},{\"key\":\"FEEDBACK\",\"name\":\"Output → External In\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":0,\"steps\":2,\"fmt\":[\"off\",\"on\"],\"slot\":26,\"mult\":32768,\"direct\":false,\"tip\":\"Patch the output back into the external input (the classic Minimoog feedback mod; the reissue has it as a switch).\",\"grp\":\"rear\"},{\"key\":\"DRIFT\",\"name\":\"Oscillator Drift\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0.3,\"steps\":0,\"fmt\":\"pct\",\"slot\":22,\"mult\":1,\"direct\":true,\"tip\":\"Slow pitch instability of the three analog oscillators.\",\"grp\":\"rear\"},{\"key\":\"BLEED\",\"name\":\"Oscillator Bleed\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0.15,\"steps\":0,\"fmt\":\"pct\",\"slot\":23,\"mult\":1,\"direct\":true,\"tip\":\"Cross-modulation between the oscillators (they pull toward each other when nearly in tune).\",\"grp\":\"rear\"},{\"key\":\"KEY_PRI\",\"name\":\"Key Priority\",\"curve\":\"int\",\"min\":0,\"max\":2,\"def\":0,\"steps\":3,\"fmt\":[\"Low\",\"High\",\"Last\"],\"slot\":25,\"mult\":2239488,\"direct\":false,\"tip\":\"Original: LOW (the lowest held key wins). Reissue options: HIGH, LAST.\",\"grp\":\"rear\"},{\"key\":\"TRIG_MODE\",\"name\":\"Triggering\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":0,\"steps\":2,\"fmt\":[\"Single\",\"Multi\"],\"slot\":26,\"mult\":65536,\"direct\":false,\"tip\":\"SINGLE (original: overlapped keys do not re-trigger the contours) or MULTI.\",\"grp\":\"rear\"},{\"key\":\"BEND\",\"name\":\"Pitch Bend Range\",\"curve\":\"int\",\"min\":1,\"max\":12,\"def\":7,\"steps\":12,\"fmt\":\"st\",\"slot\":25,\"mult\":1,\"direct\":false,\"tip\":\"Semitones of the pitch wheel (7 is the authentic Model D range; 'half an octave' in the manual).\",\"grp\":\"rear\"},{\"key\":\"SCALE\",\"name\":\"Scale\",\"curve\":\"int\",\"min\":0,\"max\":3,\"def\":0,\"steps\":4,\"fmt\":[\"Equal temperament\",\"Pythagorean (C)\",\"Super-just 12\",\"Partch 43-tone\"],\"slot\":25,\"mult\":559872,\"direct\":false,\"tip\":\"Reissue scales: Equal, Pythagorean (C), Super-just, Partch 43-tone (one tone per key).\",\"grp\":\"rear\"},{\"key\":\"KEY_ERR\",\"name\":\"Vintage keyboard error\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":0,\"steps\":2,\"fmt\":[\"off\",\"on\"],\"slot\":26,\"mult\":131072,\"direct\":false,\"tip\":\"The original keyboard's 43-resistor string has ±1 % parts: each key is a few cents off (reissue option).\",\"grp\":\"rear\"},{\"key\":\"MOD_A\",\"name\":\"Modulation source A\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":0,\"steps\":2,\"fmt\":[\"Oscillator 3\",\"Filter contour\"],\"slot\":26,\"mult\":262144,\"direct\":false,\"tip\":\"Reissue: Oscillator 3 (original) or the filter contour.\",\"grp\":\"rear\"},{\"key\":\"MOD_B\",\"name\":\"Modulation source B\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":0,\"steps\":2,\"fmt\":[\"Noise\",\"LFO\"],\"slot\":26,\"mult\":524288,\"direct\":false,\"tip\":\"Reissue: Noise (original) or the dedicated LFO.\",\"grp\":\"rear\"},{\"key\":\"LFO_RATE\",\"name\":\"LFO Rate\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0.4,\"steps\":0,\"fmt\":\"lfo\",\"slot\":24,\"mult\":1,\"direct\":true,\"tip\":\"Reissue LFO: 0.1 - 30 Hz.\",\"grp\":\"rear\"},{\"key\":\"LFO_WAVE\",\"name\":\"LFO Waveform\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":0,\"steps\":2,\"fmt\":[\"Triangle\",\"Square\"],\"slot\":26,\"mult\":1048576,\"direct\":false,\"tip\":\"\",\"grp\":\"rear\"},{\"key\":\"LOCAL\",\"name\":\"Local\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":1,\"steps\":2,\"fmt\":[\"off\",\"on\"],\"slot\":26,\"mult\":2097152,\"direct\":false,\"tip\":\"Off: the keyboard drives nothing internally (gate / pitch ignored).\",\"grp\":\"rear\"}],\"slots\":27,\"slotMax\":16777216,\"presets\":[{\"name\":\"Init\",\"cat\":\"Init\",\"note\":\"The panel as it powers up: oscillator 1 on a sawtooth at 8', filter half open, loudness contour at full sustain.\",\"set\":{}},{\"name\":\"Moog Bass\",\"cat\":\"Basses\",\"note\":\"THE Minimoog bass: two oscillators at 16' (saw + square, a hair apart), filter nearly closed, contour opens it for a fat 'womp'. Keyboard control 1 keeps it round up the keys.\",\"set\":{\"O1_RANGE\":2,\"O1_WAVE\":2,\"O2_RANGE\":2,\"O2_WAVE\":3,\"O2_FREQ\":0.017142857142857144,\"SW_O2\":1,\"VOL1\":0.8,\"VOL2\":0.7,\"CUTOFF\":0.2,\"EMPH\":0.25,\"CONTOUR\":0.55,\"FATK\":0.002007058714746821,\"FDEC\":0.17877230456349147,\"FSUS\":0.12,\"LATK\":0.0012922292535137248,\"LDEC\":0.21679673843779926,\"LSUS\":0.8,\"KB1\":1,\"OUTVOL\":0.405}},{\"name\":\"Sub Bass 32'\",\"cat\":\"Basses\",\"note\":\"Triangle at 32' under a 16' sawtooth: all weight, almost no filter work. Low-note priority keeps it solid on overlaps.\",\"set\":{\"O1_RANGE\":1,\"O1_WAVE\":0,\"O2_RANGE\":2,\"O2_WAVE\":2,\"SW_O2\":1,\"VOL1\":0.9,\"VOL2\":0.35,\"CUTOFF\":0.35,\"EMPH\":0.1,\"CONTOUR\":0.3,\"FDEC\":0.13310316117577378,\"FSUS\":0.3,\"LDEC\":0.1921648779907568,\"LSUS\":0.9,\"KB1\":1,\"OUTVOL\":0.459}},{\"name\":\"Funk Bass\",\"cat\":\"Basses\",\"note\":\"Wide-pulse 16' with a snappy filter envelope (decay 0.2 s, sustain 0): the squelchy slap of '70s funk.\",\"set\":{\"O1_RANGE\":2,\"O1_WAVE\":4,\"O2_RANGE\":2,\"O2_WAVE\":2,\"O2_FREQ\":-0.014285714285714287,\"SW_O2\":1,\"VOL1\":0.8,\"VOL2\":0.5,\"CUTOFF\":0.15,\"EMPH\":0.45,\"CONTOUR\":0.7,\"FATK\":0,\"FDEC\":0.10439795301755929,\"FSUS\":0,\"LATK\":0,\"LDEC\":0.14936500513233056,\"LSUS\":0.6,\"KB1\":1,\"KB2\":0,\"OUTVOL\":0.559}},{\"name\":\"Taurus Pedal\",\"cat\":\"Basses\",\"note\":\"Shark-tooth at 32' + saw 16': the cathedral-pedal bass; long decay with the DECAY switch for a held release.\",\"set\":{\"O1_RANGE\":1,\"O1_WAVE\":1,\"O2_RANGE\":1,\"O2_WAVE\":2,\"O2_FREQ\":0.011428571428571429,\"SW_O2\":1,\"VOL1\":0.8,\"VOL2\":0.6,\"CUTOFF\":0.25,\"EMPH\":0.3,\"CONTOUR\":0.35,\"FDEC\":0.3259783580499591,\"FSUS\":0.4,\"LDEC\":0.35319851314234757,\"LSUS\":0.8,\"DECAY_ON\":1,\"OUTVOL\":0.476}},{\"name\":\"Acid Squelch\",\"cat\":\"Basses\",\"note\":\"Emphasis well into the resonant range, glide on: a sliding, squelching line. Play legato for the slides (single trigger).\",\"set\":{\"O1_RANGE\":2,\"O1_WAVE\":2,\"VOL1\":0.8,\"CUTOFF\":0.18,\"EMPH\":0.6799999999999999,\"CONTOUR\":0.6,\"FDEC\":0.12625881049110763,\"FSUS\":0.05,\"LDEC\":0.1645428787763151,\"LSUS\":0.8,\"GLIDE_ON\":1,\"GLIDE\":0.22000000000000003,\"KB1\":1,\"OUTVOL\":0.717}},{\"name\":\"Wobble (LFO)\",\"cat\":\"Basses\",\"note\":\"Reissue LFO into the filter: raise the MOD wheel and the saw bass wobbles. Rate on the Global dialog (or CC1 on a controller).\",\"set\":{\"O1_RANGE\":2,\"O1_WAVE\":2,\"O2_RANGE\":2,\"O2_WAVE\":2,\"O2_FREQ\":0.014285714285714287,\"SW_O2\":1,\"VOL1\":0.7,\"VOL2\":0.6,\"CUTOFF\":0.25,\"EMPH\":0.5,\"CONTOUR\":0.1,\"FIL_MOD\":1,\"MOD_B\":1,\"MODMIX\":1,\"MODW\":0.5,\"LFO_RATE\":0.55,\"LFO_WAVE\":0,\"KB1\":1,\"OUTVOL\":0.517}},{\"name\":\"Fat Unison Lead\",\"cat\":\"Leads\",\"note\":\"Three sawtooth oscillators a few cents apart: the cornerstone Minimoog lead. Mixer pushed into overload for the fatness. Wheel adds slow vibrato.\",\"set\":{\"O1_RANGE\":3,\"O1_WAVE\":2,\"O2_RANGE\":3,\"O2_WAVE\":2,\"O2_FREQ\":0.014285714285714287,\"O3_RANGE\":3,\"O3_WAVE\":2,\"O3_FREQ\":-0.017142857142857144,\"SW_O2\":1,\"SW_O3\":1,\"VOL1\":0.75,\"VOL2\":0.75,\"VOL3\":0.75,\"CUTOFF\":0.6,\"EMPH\":0.35,\"CONTOUR\":0.3,\"FATK\":0.017457001679698863,\"FDEC\":0.23902306616352298,\"FSUS\":0.5,\"LATK\":0.005125506722948419,\"LDEC\":0.1921648779907568,\"LSUS\":1,\"KB1\":1,\"KB2\":1,\"GLIDE_ON\":1,\"GLIDE\":0.16,\"OSC_MOD\":1,\"O3_CTRL\":1,\"OUTVOL\":0.4}},{\"name\":\"Emerson Lead\",\"cat\":\"Leads\",\"note\":\"Three saws, portamento, filter around +2 with emphasis: the soaring '70s prog lead. Pitch wheel half an octave for the swoops.\",\"set\":{\"O1_RANGE\":3,\"O1_WAVE\":2,\"O2_RANGE\":3,\"O2_WAVE\":2,\"O2_FREQ\":0.01,\"O3_RANGE\":3,\"O3_WAVE\":1,\"O3_FREQ\":-0.01,\"SW_O2\":1,\"SW_O3\":1,\"VOL1\":0.7,\"VOL2\":0.7,\"VOL3\":0.6,\"CUTOFF\":0.6799999999999999,\"EMPH\":0.4,\"CONTOUR\":0.2,\"FDEC\":0.1921648779907568,\"FSUS\":0.6,\"LSUS\":1,\"GLIDE_ON\":1,\"GLIDE\":0.24,\"KB1\":1,\"KB2\":1,\"BEND\":7,\"OUTVOL\":0.463}},{\"name\":\"Singing Square Lead\",\"cat\":\"Leads\",\"note\":\"Square + octave-up saw, emphasis high: a vocal, nasal lead. Vibrato on the wheel (oscillator 3 in LO, detached from the keys).\",\"set\":{\"O1_RANGE\":3,\"O1_WAVE\":3,\"O2_RANGE\":4,\"O2_WAVE\":2,\"O2_FREQ\":0.0071428571428571435,\"SW_O2\":1,\"VOL1\":0.8,\"VOL2\":0.4,\"CUTOFF\":0.58,\"EMPH\":0.55,\"CONTOUR\":0.35,\"FDEC\":0.1645428787763151,\"FSUS\":0.4,\"LSUS\":1,\"KB1\":1,\"O3_CTRL\":0,\"O3_RANGE\":0,\"O3_WAVE\":0,\"O3_FREQ\":0.34,\"OSC_MOD\":1,\"MODW\":0.22,\"MODMIX\":0,\"OUTVOL\":0.563}},{\"name\":\"Power Fifths\",\"cat\":\"Leads\",\"note\":\"Oscillator 2 a perfect fifth above (+7 semitones on its FREQUENCY knob): two-note power lead.\",\"set\":{\"O1_RANGE\":3,\"O1_WAVE\":2,\"O2_RANGE\":3,\"O2_WAVE\":2,\"O2_FREQ\":1,\"SW_O2\":1,\"VOL1\":0.7,\"VOL2\":0.65,\"CUTOFF\":0.62,\"EMPH\":0.25,\"CONTOUR\":0.3,\"FDEC\":0.21679673843779926,\"FSUS\":0.6,\"LSUS\":1,\"KB1\":1,\"KB2\":1,\"OUTVOL\":0.472}},{\"name\":\"Soft Triangle Lead\",\"cat\":\"Leads\",\"note\":\"Triangles an octave apart through a half-open filter: round and flute-like. Slow vibrato.\",\"set\":{\"O1_RANGE\":3,\"O1_WAVE\":0,\"O2_RANGE\":4,\"O2_WAVE\":0,\"SW_O2\":1,\"VOL1\":0.8,\"VOL2\":0.4,\"CUTOFF\":0.5,\"EMPH\":0.15,\"CONTOUR\":0.15,\"FSUS\":0.8,\"LATK\":0.04564545255776588,\"LSUS\":1,\"O3_CTRL\":0,\"O3_RANGE\":0,\"O3_WAVE\":0,\"O3_FREQ\":0.34,\"OSC_MOD\":1,\"MODW\":0.18,\"MODMIX\":0,\"OUTVOL\":0.465}},{\"name\":\"Brass Section\",\"cat\":\"Pads & Strings\",\"note\":\"Slow-ish filter attack (0.15 s) opens a sawtooth stack — the classic analog brass swell. Octave bend: wheel.\",\"set\":{\"O1_RANGE\":3,\"O1_WAVE\":2,\"O2_RANGE\":3,\"O2_WAVE\":2,\"O2_FREQ\":0.014285714285714287,\"O3_RANGE\":3,\"O3_WAVE\":2,\"O3_FREQ\":-0.014285714285714287,\"SW_O2\":1,\"SW_O3\":1,\"VOL1\":0.65,\"VOL2\":0.65,\"VOL3\":0.65,\"CUTOFF\":0.4,\"EMPH\":0.2,\"CONTOUR\":0.45,\"FATK\":0.2000997971195462,\"FDEC\":0.23902306616352298,\"FSUS\":0.6,\"LATK\":0.0754283640163154,\"LDEC\":0.2592721862597252,\"LSUS\":0.9,\"KB1\":1,\"KB2\":1,\"OUTVOL\":0.395}},{\"name\":\"String Ensemble\",\"cat\":\"Pads & Strings\",\"note\":\"Detuned saws, slow attack and a long DECAY-switch release, slow vibrato: lush analog strings.\",\"set\":{\"O1_RANGE\":3,\"O1_WAVE\":2,\"O2_RANGE\":3,\"O2_WAVE\":2,\"O2_FREQ\":0.025714285714285714,\"O3_RANGE\":0,\"O3_WAVE\":0,\"O3_FREQ\":0.34,\"SW_O2\":1,\"SW_O3\":1,\"VOL1\":0.55,\"VOL2\":0.55,\"VOL3\":0.4,\"CUTOFF\":0.5,\"EMPH\":0.1,\"CONTOUR\":0.2,\"FATK\":0.3848240880930774,\"FDEC\":0.3259783580499591,\"FSUS\":0.7,\"LATK\":0.28887842247229434,\"LDEC\":0.29505837709740973,\"LSUS\":1,\"DECAY_ON\":1,\"KB1\":1,\"KB2\":1,\"DRIFT\":0.45,\"O3_CTRL\":0,\"OSC_MOD\":1,\"MODW\":0.16,\"MODMIX\":0,\"OUTVOL\":0.43}},{\"name\":\"Warm Pad\",\"cat\":\"Pads & Strings\",\"note\":\"Square and saw an octave apart, filter slowly swelling, pulse-width flavour from the wide rectangular wave.\",\"set\":{\"O1_RANGE\":3,\"O1_WAVE\":4,\"O2_RANGE\":3,\"O2_WAVE\":2,\"O2_FREQ\":-0.017142857142857144,\"SW_O2\":1,\"VOL1\":0.6,\"VOL2\":0.5,\"CUTOFF\":0.35,\"EMPH\":0.25,\"CONTOUR\":0.3,\"FATK\":0.6191498550192417,\"FDEC\":0.46301755478095197,\"FSUS\":0.6,\"LATK\":0.4327140492968236,\"LDEC\":0.41950834918786967,\"LSUS\":1,\"DECAY_ON\":1,\"KB1\":1,\"KB2\":0,\"DRIFT\":0.5,\"OUTVOL\":0.416}},{\"name\":\"Flute\",\"cat\":\"Pads & Strings\",\"note\":\"Triangle at 4' with a touch of pink noise for the breath, gentle attack.\",\"set\":{\"O1_RANGE\":4,\"O1_WAVE\":0,\"VOL1\":0.8,\"SW_NZ\":1,\"VOLNZ\":0.06999999999999999,\"NZ_COLOR\":1,\"CUTOFF\":0.52,\"EMPH\":0.15,\"CONTOUR\":0.18,\"FATK\":0.10857274355250533,\"FDEC\":0.13310316117577378,\"FSUS\":0.8,\"LATK\":0.08454931344861845,\"LDEC\":0.13310316117577378,\"LSUS\":0.9,\"KB1\":1,\"KB2\":1,\"O3_CTRL\":0,\"O3_RANGE\":0,\"O3_WAVE\":0,\"O3_FREQ\":0.4,\"OSC_MOD\":1,\"MODW\":0.14,\"MODMIX\":0,\"OUTVOL\":0.505}},{\"name\":\"Organ (8-4-2)\",\"cat\":\"Keys & Plucks\",\"note\":\"Square waves at 8', 4' and 2' mixed like drawbars; wide-open filter, no envelope on the filter.\",\"set\":{\"O1_RANGE\":3,\"O1_WAVE\":3,\"O2_RANGE\":4,\"O2_WAVE\":3,\"O3_RANGE\":5,\"O3_WAVE\":3,\"SW_O2\":1,\"SW_O3\":1,\"VOL1\":0.6,\"VOL2\":0.45,\"VOL3\":0.3,\"CUTOFF\":0.6,\"EMPH\":0,\"CONTOUR\":0,\"LATK\":0.0012922292535137248,\"LDEC\":0.05315467259386912,\"LSUS\":1,\"KB1\":1,\"KB2\":1,\"DECAY_ON\":0,\"OUTVOL\":0.385}},{\"name\":\"Clav Pluck\",\"cat\":\"Keys & Plucks\",\"note\":\"Narrow pulse, filter envelope with no sustain and keyboard tracking: a funky clavinet-style pluck.\",\"set\":{\"O1_RANGE\":3,\"O1_WAVE\":5,\"O2_RANGE\":3,\"O2_WAVE\":5,\"O2_FREQ\":0.008571428571428572,\"SW_O2\":1,\"VOL1\":0.7,\"VOL2\":0.5,\"CUTOFF\":0.35,\"EMPH\":0.3,\"CONTOUR\":0.55,\"FATK\":0,\"FDEC\":0.0885640236677841,\"FSUS\":0,\"LDEC\":0.12625881049110763,\"LSUS\":0.2,\"KB1\":1,\"KB2\":1,\"OUTVOL\":0.558}},{\"name\":\"Harpsichord\",\"cat\":\"Keys & Plucks\",\"note\":\"Narrow pulses an octave apart with a very quick decay and plenty of tracking.\",\"set\":{\"O1_RANGE\":3,\"O1_WAVE\":5,\"O2_RANGE\":4,\"O2_WAVE\":5,\"SW_O2\":1,\"VOL1\":0.6,\"VOL2\":0.5,\"CUTOFF\":0.55,\"EMPH\":0.15,\"CONTOUR\":0.3,\"FATK\":0,\"FDEC\":0.0625362552688631,\"FSUS\":0,\"LDEC\":0.09661853958728248,\"LSUS\":0.1,\"KB1\":1,\"KB2\":1,\"OUTVOL\":0.539}},{\"name\":\"Pizzicato\",\"cat\":\"Keys & Plucks\",\"note\":\"Triangle + saw, both contours with short decays and zero sustain: a plucked-string stab.\",\"set\":{\"O1_RANGE\":3,\"O1_WAVE\":1,\"O2_RANGE\":3,\"O2_WAVE\":0,\"O2_FREQ\":0.014285714285714287,\"SW_O2\":1,\"VOL1\":0.7,\"VOL2\":0.4,\"CUTOFF\":0.32,\"EMPH\":0.2,\"CONTOUR\":0.5,\"FDEC\":0.09661853958728248,\"FSUS\":0,\"LDEC\":0.11559052720614113,\"LSUS\":0,\"KB1\":1,\"KB2\":1,\"OUTVOL\":0.874}},{\"name\":\"Mellow Electric Piano\",\"cat\":\"Keys & Plucks\",\"note\":\"Triangles with a bell-like 2' partial and a soft filter envelope.\",\"set\":{\"O1_RANGE\":3,\"O1_WAVE\":0,\"O2_RANGE\":5,\"O2_WAVE\":3,\"O2_FREQ\":0.004285714285714286,\"SW_O2\":1,\"VOL1\":0.8,\"VOL2\":0.16,\"CUTOFF\":0.4,\"EMPH\":0.1,\"CONTOUR\":0.3,\"FDEC\":0.1921648779907568,\"FSUS\":0.1,\"LDEC\":0.3259783580499591,\"LSUS\":0.15,\"KB1\":1,\"KB2\":1,\"OUTVOL\":0.478}},{\"name\":\"Filter Sine\",\"cat\":\"Effects & Drones\",\"note\":\"No oscillators: EMPHASIS at 10 makes the filter oscillate, and with both keyboard-control switches on it plays as a pure, tuned sine wave (the Minimoog's 'sixth sound source').\",\"set\":{\"SW_O1\":0,\"EMPH\":1,\"CUTOFF\":0.4,\"CONTOUR\":0,\"KB1\":1,\"KB2\":1,\"LSUS\":1,\"LATK\":0.011374347626696034,\"LDEC\":0.09661853958728248,\"OUTVOL\":0.298}},{\"name\":\"Resonant Kick\",\"cat\":\"Effects & Drones\",\"note\":\"The self-oscillating filter swept down by its contour: an analog kick drum. Play a low key.\",\"set\":{\"SW_O1\":0,\"SW_NZ\":1,\"VOLNZ\":0.04,\"EMPH\":1,\"CUTOFF\":0.1,\"CONTOUR\":0.5,\"FATK\":0,\"FDEC\":0.0625362552688631,\"FSUS\":0,\"LATK\":0,\"LDEC\":0.13310316117577378,\"LSUS\":0,\"KB1\":0,\"KB2\":0,\"OUTVOL\":0.355}},{\"name\":\"Laser Zap\",\"cat\":\"Effects & Drones\",\"note\":\"High saw through a resonant filter whose contour sweeps down in a quarter-second.\",\"set\":{\"O1_RANGE\":4,\"O1_WAVE\":2,\"VOL1\":0.6,\"CUTOFF\":0.3,\"EMPH\":0.8,\"CONTOUR\":0.9,\"FATK\":0,\"FDEC\":0.12625881049110763,\"FSUS\":0,\"LDEC\":0.17877230456349147,\"LSUS\":0.1,\"KB1\":0,\"OUTVOL\":0.43}},{\"name\":\"Wind\",\"cat\":\"Effects & Drones\",\"note\":\"White noise through a resonant band; the wheel brings in random filter modulation. Slow attack and release.\",\"set\":{\"SW_O1\":0,\"SW_NZ\":1,\"VOLNZ\":0.8,\"NZ_COLOR\":0,\"CUTOFF\":0.5,\"EMPH\":0.5,\"CONTOUR\":0.15,\"FATK\":0.6054398776223909,\"FDEC\":0.49953408942936867,\"FSUS\":0.6,\"LATK\":0.5134888859067959,\"LDEC\":0.49953408942936867,\"LSUS\":1,\"DECAY_ON\":1,\"FIL_MOD\":1,\"MODMIX\":1,\"MODW\":0.55,\"KB1\":1,\"KB2\":0,\"OUTVOL\":1}},{\"name\":\"Snare Noise\",\"cat\":\"Effects & Drones\",\"note\":\"Noise burst with a short filter contour plus a low triangle thump.\",\"set\":{\"O1_RANGE\":2,\"O1_WAVE\":0,\"VOL1\":0.4,\"SW_NZ\":1,\"VOLNZ\":0.8,\"CUTOFF\":0.65,\"EMPH\":0.2,\"CONTOUR\":0.4,\"FDEC\":0.0625362552688631,\"FSUS\":0,\"LDEC\":0.10439795301755929,\"LSUS\":0,\"KB1\":0,\"OUTVOL\":0.7}},{\"name\":\"Random Burble\",\"cat\":\"Effects & Drones\",\"note\":\"Noise into the filter cutoff (MOD wheel up): the classic sample-and-hold-style burble. Keys sound a 4-pulse tone.\",\"set\":{\"O1_RANGE\":3,\"O1_WAVE\":4,\"VOL1\":0.7,\"CUTOFF\":0.45,\"EMPH\":0.6,\"CONTOUR\":0,\"FIL_MOD\":1,\"MODMIX\":1,\"MODW\":0.6,\"LSUS\":1,\"OUTVOL\":0.626}},{\"name\":\"Oscillator 3 Drone\",\"cat\":\"Effects & Drones\",\"note\":\"S-TRIG plug in: the contours stay open, and the free-running oscillators drone. Play keys to shift osc 1+2 while oscillator 3 hums on its own.\",\"set\":{\"STRIG\":1,\"O1_RANGE\":2,\"O1_WAVE\":2,\"O2_RANGE\":2,\"O2_WAVE\":0,\"O2_FREQ\":0.028571428571428574,\"SW_O2\":1,\"O3_CTRL\":0,\"O3_RANGE\":1,\"O3_WAVE\":1,\"O3_FREQ\":0.4,\"SW_O3\":1,\"VOL1\":0.5,\"VOL2\":0.5,\"VOL3\":0.6,\"CUTOFF\":0.4,\"EMPH\":0.4,\"CONTOUR\":0,\"DRIFT\":0.7,\"BLEED\":0.4,\"LSUS\":0.9,\"OUTVOL\":0.54}},{\"name\":\"Feedback Growl\",\"cat\":\"Effects & Drones\",\"note\":\"OUTPUT → EXTERNAL IN feedback (the famous Minimoog mod): the output re-enters the mixer through the overloading preamp for a snarling, gritty edge.\",\"set\":{\"O1_RANGE\":2,\"O1_WAVE\":2,\"VOL1\":0.5,\"SW_EXT\":1,\"VOLEXT\":0.4,\"FEEDBACK\":1,\"CUTOFF\":0.35,\"EMPH\":0.3,\"CONTOUR\":0.4,\"FDEC\":0.21679673843779926,\"FSUS\":0.3,\"LDEC\":0.21679673843779926,\"LSUS\":0.8,\"OUTVOL\":0.6}},{\"name\":\"Overload Fat Lead\",\"cat\":\"Effects & Drones\",\"note\":\"Every mixer knob near 10: the mixer overloads into the filter and the sound thickens (what the manual calls 'distortion' — it is the secret of the sound).\",\"set\":{\"O1_RANGE\":3,\"O1_WAVE\":2,\"O2_RANGE\":3,\"O2_WAVE\":2,\"O2_FREQ\":0.011428571428571429,\"O3_RANGE\":2,\"O3_WAVE\":3,\"O3_FREQ\":-0.011428571428571429,\"SW_O2\":1,\"SW_O3\":1,\"VOL1\":1,\"VOL2\":1,\"VOL3\":1,\"CUTOFF\":0.55,\"EMPH\":0.3,\"CONTOUR\":0.25,\"FDEC\":0.1921648779907568,\"FSUS\":0.6,\"LSUS\":1,\"OUTVOL\":0.373,\"KB1\":1,\"KB2\":1}},{\"name\":\"Pythagorean Lead\",\"cat\":\"Reissue Options\",\"note\":\"Reissue SCALE = Pythagorean (C): pure fifths, slightly sharp major thirds — a medieval-bright lead.\",\"set\":{\"O1_RANGE\":3,\"O1_WAVE\":2,\"O2_RANGE\":3,\"O2_WAVE\":3,\"O2_FREQ\":0.004285714285714286,\"SW_O2\":1,\"VOL1\":0.7,\"VOL2\":0.5,\"CUTOFF\":0.6,\"EMPH\":0.25,\"CONTOUR\":0.3,\"FSUS\":0.6,\"LSUS\":1,\"KB1\":1,\"KB2\":1,\"SCALE\":1,\"OUTVOL\":0.391}},{\"name\":\"Partch 43 Keys\",\"cat\":\"Reissue Options\",\"note\":\"Reissue SCALE = Partch 43-tone: the 44 keys become one octave of microtones. Strange, beautiful, quite out of tune with everything else.\",\"set\":{\"O1_RANGE\":3,\"O1_WAVE\":1,\"O2_RANGE\":3,\"O2_WAVE\":0,\"O2_FREQ\":0.002857142857142857,\"SW_O2\":1,\"VOL1\":0.7,\"VOL2\":0.5,\"CUTOFF\":0.55,\"EMPH\":0.2,\"CONTOUR\":0.25,\"FSUS\":0.6,\"LSUS\":1,\"SCALE\":3,\"KB1\":1,\"KB2\":0,\"OUTVOL\":0.599}},{\"name\":\"Vintage Wobble Bass\",\"cat\":\"Reissue Options\",\"note\":\"DRIFT, BLEED and the vintage key error all up: a tired, imperfect 1971 instrument that is never quite in tune.\",\"set\":{\"O1_RANGE\":2,\"O1_WAVE\":2,\"O2_RANGE\":2,\"O2_WAVE\":2,\"O2_FREQ\":0.0071428571428571435,\"SW_O2\":1,\"VOL1\":0.7,\"VOL2\":0.7,\"CUTOFF\":0.25,\"EMPH\":0.35,\"CONTOUR\":0.45,\"FDEC\":0.1921648779907568,\"FSUS\":0.2,\"LDEC\":0.23902306616352298,\"LSUS\":0.8,\"DRIFT\":0.85,\"BLEED\":0.7,\"KEY_ERR\":1,\"OUTVOL\":0.565}},{\"name\":\"Multi-Trigger Stab\",\"cat\":\"Reissue Options\",\"note\":\"MULTI trigger: overlapping keys re-fire the contours (the original fires only on a clean press). Play chords-by-hand for repeated stabs.\",\"set\":{\"O1_RANGE\":3,\"O1_WAVE\":2,\"O2_RANGE\":3,\"O2_WAVE\":4,\"O2_FREQ\":0.011428571428571429,\"SW_O2\":1,\"VOL1\":0.7,\"VOL2\":0.5,\"CUTOFF\":0.35,\"EMPH\":0.3,\"CONTOUR\":0.5,\"FDEC\":0.11559052720614113,\"FSUS\":0.1,\"LDEC\":0.1645428787763151,\"LSUS\":0.2,\"TRIG_MODE\":1,\"KEY_PRI\":2,\"KB1\":1,\"KB2\":1,\"OUTVOL\":0.465}},{\"name\":\"Filter-Contour Vibrato\",\"cat\":\"Reissue Options\",\"note\":\"MOD source A = the filter contour (reissue patch point): the wheel then sends the filter envelope to the pitch — a pitch dive on every note.\",\"set\":{\"O1_RANGE\":3,\"O1_WAVE\":2,\"VOL1\":0.7,\"CUTOFF\":0.5,\"EMPH\":0.2,\"CONTOUR\":0.3,\"FATK\":0,\"FDEC\":0.14936500513233056,\"FSUS\":0,\"OSC_MOD\":1,\"MOD_A\":1,\"MODMIX\":0,\"MODW\":0.35,\"KB1\":1,\"KB2\":1,\"LSUS\":1,\"OUTVOL\":0.533}}]};\n(function () {\n\"use strict\";\n// =====================================================================\n//  Doob panel — a re-creation of the Minimoog Model D's front panel: CONTROLLERS | OSCILLATOR BANK | MIXER |\n//  MODIFIERS | OUTPUT on a black faceplate with white lettering, the left-hand controller (spring pitch wheel,\n//  mod wheel, glide / decay rockers), the 44-key F…C keyboard and a rear strip (S-trig plug, feedback patch,\n//  drift / bleed).  Every control is a \"logical parameter\" (params.mjs); build.mjs packs them into the host's\n//  float slots (mixed radix). This script owns the packing: R[key] = raw integer, V[key] = actual value,\n//  slot = Σ R·mult for packed params; direct params are plain floats.\n// =====================================================================\nvar P = DATA.params, BY = {}, FIELDS = {}, UPD = {}, SV = \"http://www.w3.org/2000/svg\";\nvar R = {}, V = {}, dragSlot = -1, SCALE = 1;\nP.forEach(function (p) { BY[p.key] = p; (FIELDS[p.slot] = FIELDS[p.slot] || []).push(p); UPD[p.key] = []; });\nvar NSLOT = DATA.slots;\n\nfunction el(tag, cls, parent, txt) { var e = document.createElement(tag); if (cls) e.className = cls; if (txt != null) e.textContent = txt; if (parent) parent.appendChild(e); return e; }\nfunction sv(tag, attrs, parent) { var e = document.createElementNS(SV, tag); for (var k in attrs) e.setAttribute(k, attrs[k]); if (parent) parent.appendChild(e); return e; }\nfunction clamp(x, a, b) { return x < a ? a : (x > b ? b : x); }\nfunction host(f) { var a = [].slice.call(arguments, 1); if (window.vstai && typeof window.vstai[f] === \"function\") window.vstai[f].apply(window.vstai, a); }\nfunction put(e, x, y, w, h) { e.style.left = x + \"px\"; e.style.top = y + \"px\"; if (w != null) e.style.width = w + \"px\"; if (h != null) e.style.height = h + \"px\"; return e; }\nfunction taper(x) { return (Math.exp(4.39 * x) - 1) / (Math.exp(4.39) - 1); }\n\n// ---------------------------------------------------------------- packing (identical to pack.mjs)\nfunction rawToActual(p, r) { if (p.curve === \"int\") return p.min + r; var n = p.steps > 1 ? r / (p.steps - 1) : 0; return p.min + n * (p.max - p.min); }\nfunction actualToRaw(p, v) {\n  if (p.curve === \"int\") return clamp(Math.round(v - p.min), 0, p.steps - 1);\n  var n = (v - p.min) / (p.max - p.min); return clamp(Math.round(n * (p.steps - 1)), 0, p.steps - 1);\n}\nfunction slotValue(s) {\n  var f = FIELDS[s], t = 0;\n  for (var i = 0; i < f.length; i++) { if (f[i].direct) return V[f[i].key]; t += R[f[i].key] * f[i].mult; }\n  return t;\n}\nfunction push(s) { host(\"setParam\", s, slotValue(s)); }\nfunction norm(p) { return p.direct ? (V[p.key] - p.min) / (p.max - p.min) : (p.steps > 1 ? R[p.key] / (p.steps - 1) : 0); }\nfunction touch(p) { var u = UPD[p.key]; for (var i = 0; i < u.length; i++) u[i](); }\nfunction setRaw(p, r) { r = clamp(Math.round(r), 0, p.steps - 1); R[p.key] = r; V[p.key] = rawToActual(p, r); }\nfunction setNorm(p, n) {\n  n = clamp(n, 0, 1);\n  if (p.direct) V[p.key] = p.min + n * (p.max - p.min); else setRaw(p, n * (p.steps - 1));\n  touch(p); push(p.slot);\n}\nfunction set(key, actual, quiet) {\n  var p = BY[key]; if (!p) return;\n  if (p.direct) V[key] = clamp(actual, p.min, p.max); else setRaw(p, actualToRaw(p, actual));\n  touch(p); if (!quiet) push(p.slot);\n}\nfunction decodeSlot(s, value) {\n  var f = FIELDS[s]; if (!f) return;\n  var k = Math.round(value);\n  for (var i = 0; i < f.length; i++) {\n    var p = f[i];\n    if (p.direct) V[p.key] = clamp(+value, p.min, p.max);\n    else { var raw = Math.floor(k / p.mult) % p.steps; R[p.key] = raw; V[p.key] = rawToActual(p, raw); }\n    touch(p);\n  }\n}\nP.forEach(function (p) { if (p.direct) V[p.key] = p.def; else { R[p.key] = actualToRaw(p, p.def); V[p.key] = rawToActual(p, R[p.key]); } });\nfunction snapshot() { var o = {}; P.forEach(function (p) { o[p.key] = V[p.key]; }); return o; }\nfunction applySnap(o) {\n  P.forEach(function (p) { var v = o[p.key]; if (v === undefined) v = p.def; if (p.direct) V[p.key] = clamp(v, p.min, p.max); else setRaw(p, actualToRaw(p, v)); });\n  P.forEach(touch); for (var s = 0; s < NSLOT; s++) push(s);\n}\nfunction bindKeys(keys, fn) { keys.forEach(function (k) { UPD[k].push(fn); }); fn(); }\n\n// ---------------------------------------------------------------- value formatting\nfunction fmtSec(t) { return t < 1 ? (t * 1000).toFixed(t < 0.01 ? 1 : 0) + \" ms\" : t.toFixed(2) + \" s\"; }\nfunction fmtVal(p) {\n  var v = V[p.key], f = p.fmt, n = norm(p);\n  if (Array.isArray(f)) return f[Math.round(v - p.min)] || String(v);\n  switch (f) {\n    case \"dial\": return (n * 10).toFixed(1);\n    case \"pct\": if (p.key === \"MODW\") return (taper(n) * 100).toFixed(1) + \" % depth (audio taper, \" + (n * 10).toFixed(1) + \")\"; return Math.round(n * 100) + \" %\";\n    case \"tune\": return (v > 0.005 ? \"+\" : \"\") + (v * 4).toFixed(2) + \" st\";\n    case \"bip\": return (v > 0.005 ? \"+\" : \"\") + v.toFixed(2) + \"  (\" + (v * V.BEND).toFixed(1) + \" st)\";\n    case \"freq\": if (p.key === \"O3_FREQ\" && !V.O3_CTRL) { var oc = v * 3; return (oc > 0.005 ? \"+\" : \"\") + oc.toFixed(2) + \" oct (free-running)\"; } var st = v * 7; return (st > 0.005 ? \"+\" : \"\") + st.toFixed(2) + \" st\";\n    case \"cut\": { var k = -5 + 10 * n, hz = 440 * Math.pow(2, k + 1); return (k > 0.005 ? \"+\" : \"\") + k.toFixed(2) + \"  (\" + (hz < 1000 ? hz.toFixed(hz < 100 ? 1 : 0) + \" Hz\" : (hz / 1000).toFixed(2) + \" kHz\") + \")\"; }\n    case \"time\": { var mx = (p.key === \"FATK\" ? 9 : (p.key === \"LATK\" ? 14 : 30)); return (n * 10).toFixed(1) + \"  (\" + fmtSec(0.001 + (mx - 0.001) * taper(n)) + \")\"; }\n    case \"glide\": return (n * 10).toFixed(1) + \"  (τ \" + fmtSec(0.00033 + 2.2 * taper(n)) + \")\";\n    case \"mix\": { var ro = 25 * (1 - n), rn = 25 * n, a = ro / (24 + ro) * 1.96, b = rn / (24 + rn) * 1.96; return (V.MOD_A ? \"contour \" : \"osc 3 \") + Math.round(a * 100) + \" %  ·  \" + (V.MOD_B ? \"LFO \" : \"noise \") + Math.round(b * 100) + \" %\"; }\n    case \"lfo\": { var h = 0.1 * Math.pow(300, n); return h.toFixed(h < 10 ? 2 : 1) + \" Hz\"; }\n    case \"st\": return Math.round(v) + \" st\";\n    default: return String(Math.round(v * 1000) / 1000);\n  }\n}\n\n// ---------------------------------------------------------------- stage geometry\nvar plate = document.getElementById(\"plate\"), stage = document.getElementById(\"stage\");\nvar DECK = 496;\nvar hdr = el(\"div\", \"\", plate); hdr.id = \"hdr\";\nvar panel = el(\"div\", \"\", plate); panel.id = \"panel\"; put(panel, 0, 52);\nvar deck = el(\"div\", \"\", plate); deck.id = \"deck\"; put(deck, 0, DECK);\n\nfunction section(x0, y0, x1, y1, title) { var s = el(\"div\", \"sec\", plate); put(s, x0, y0, x1 - x0, y1 - y0); var t = el(\"div\", \"st\", s); el(\"span\", \"\", t, title); return s; }\nfunction label(x, y, txt, cls, parent) { var l = el(\"div\", \"lab\" + (cls ? \" \" + cls : \"\"), parent || plate); l.style.whiteSpace = \"pre\"; l.textContent = txt; l.style.left = x + \"px\"; l.style.top = y + \"px\"; return l; }\n\n// ---------------------------------------------------------------- tooltip\nvar tip = document.getElementById(\"tip\");\nfunction showTip(e, p) { tip.hidden = false; tip.textContent = p.name + \": \" + fmtVal(p); tip.style.left = (e.clientX + 14) + \"px\"; tip.style.top = (e.clientY - 28) + \"px\"; }\nfunction hideTip() { tip.hidden = true; }\n\n// ---------------------------------------------------------------- knobs\nvar INK = \"#efece1\";\n// opts: nums = \"dial\" (0-10) | \"cut\" (-5 … +5) | [left, centre, right]; bipolar centre detent; label / ly\nfunction knob(key, cx, cy, r, opts) {\n  opts = opts || {};\n  var p = BY[key], pad = 22, size = 2 * (r + pad);\n  var w = el(\"div\", \"kn\", plate); put(w, cx - r - pad, cy - r - pad, size, size);\n  var svg = sv(\"svg\", { width: size, height: size, viewBox: \"0 0 \" + size + \" \" + size }, w), c = r + pad;\n  for (var i = 0; i < 11; i++) {\n    var a = (-150 + i * 30) * Math.PI / 180, big = i % 5 === 0, r0 = r + 3, r1 = r + (big ? 10 : 7);\n    sv(\"line\", { x1: c + r0 * Math.sin(a), y1: c - r0 * Math.cos(a), x2: c + r1 * Math.sin(a), y2: c - r1 * Math.cos(a), stroke: INK, \"stroke-width\": big ? 2 : 1.3 }, svg);\n    var txt = null;\n    if (opts.nums === \"dial\") txt = (r >= 24 || big) ? String(i) : null;\n    else if (opts.nums === \"cut\") txt = (i - 5 > 0 ? \"+\" : \"\") + (i - 5);\n    else if (Array.isArray(opts.nums) && (i === 0 || i === 5 || i === 10)) txt = opts.nums[i / 5];\n    if (txt !== null) {\n      var rr = r + 17, t = sv(\"text\", { x: c + rr * Math.sin(a), y: c - rr * Math.cos(a) + 3, \"text-anchor\": \"middle\", \"font-size\": 8, \"font-weight\": 700, fill: INK }, svg); t.textContent = txt;\n    }\n  }\n  sv(\"circle\", { cx: c, cy: c, r: r + 1, fill: \"#050506\" }, svg);\n  sv(\"circle\", { cx: c, cy: c, r: r - 1.5, fill: \"url(#dbKnob)\", class: \"rim\", stroke: \"#cfccc0\", \"stroke-width\": 1.6 }, svg);\n  sv(\"circle\", { cx: c, cy: c, r: r * 0.62, fill: \"url(#dbCap)\", stroke: \"#000\", \"stroke-width\": 1 }, svg);\n  var ptr = sv(\"line\", { x1: c, y1: c - r * 0.12, x2: c, y2: c - r + 3, class: \"ptr\" }, svg);\n  function draw() { ptr.setAttribute(\"transform\", \"rotate(\" + (-150 + 300 * norm(p)) + \" \" + c + \" \" + c + \")\"); }\n  bindKeys([key], draw);\n  var drag = null;\n  w.addEventListener(\"pointerdown\", function (e) {\n    e.preventDefault(); try { w.setPointerCapture(e.pointerId); } catch (x) {}\n    drag = { y: e.clientY, n: norm(p) }; dragSlot = p.slot; w.classList.add(\"act\"); showTip(e, p);\n  });\n  w.addEventListener(\"pointermove\", function (e) {\n    if (!drag) { showTip(e, p); return; }\n    var n = clamp(drag.n + (drag.y - e.clientY) / SCALE / (e.shiftKey ? 700 : 170), 0, 1);\n    if (opts.detent && Math.abs(n - 0.5) < 0.012) n = 0.5;\n    setNorm(p, n); showTip(e, p);\n  });\n  function end() { drag = null; dragSlot = -1; w.classList.remove(\"act\"); }\n  w.addEventListener(\"pointerup\", end); w.addEventListener(\"pointercancel\", end);\n  w.addEventListener(\"pointerleave\", function () { if (!drag) hideTip(); });\n  w.addEventListener(\"dblclick\", function () { set(key, p.def); hideTip(); });\n  w.addEventListener(\"wheel\", function (e) { e.preventDefault(); setNorm(p, norm(p) - e.deltaY / (e.shiftKey ? 8000 : 1800)); showTip(e, p); }, { passive: false });\n  if (opts.label) label(cx, cy + r + (opts.ly != null ? opts.ly : 17), opts.label, opts.lcls || \"big\");\n  return w;\n}\n\n// ---------------------------------------------------------------- waveform icons\nvar ICON = {\n  tri: \"M1,9 L4,2 L7,9 L10,2 L13,9\", shark: \"M1,9 L6,2 L8,9 L13,2 L15,9\", saw: \"M1,9 L6,2 L6,9 L12,2 L12,9\", sqr: \"M1,9 L1,3 L4,3 L4,9 L7,9 L7,3 L10,3 L10,9 L13,9\",\n  wide: \"M1,9 L1,3 L4,3 L4,9 L9,9 L9,3 L12,3 L12,9\", nar: \"M1,9 L1,3 L2.8,3 L2.8,9 L8,9 L8,3 L9.8,3 L9.8,9 L13,9\", rev: \"M1,2 L1,9 L6,2 L6,9 L12,2 L12,9\"\n};\nfunction icon(parent, kind, x, y) {\n  var g = sv(\"g\", { transform: \"translate(\" + x + \" \" + y + \") scale(1.3) translate(-7,-5.5)\" }, parent);\n  sv(\"path\", { d: ICON[kind], fill: \"none\", stroke: INK, \"stroke-width\": 1.5, \"stroke-linejoin\": \"round\", \"stroke-linecap\": \"round\" }, g);\n  return g;\n}\n// 6-position rotary selector (range / waveform): positions on a 250° arc, labels or icons around it\nfunction rotary6(key, cx, cy, r, items) {\n  var p = BY[key], n = items.length, pad = 36, size = 2 * (r + pad), c = r + pad;\n  var w = el(\"div\", \"ro\", plate); put(w, cx - r - pad, cy - r - pad, size, size);\n  var svg = sv(\"svg\", { width: size, height: size, viewBox: \"0 0 \" + size + \" \" + size }, w);\n  var STEP = 50, A0 = -125, lab = [];\n  items.forEach(function (it, i) {\n    var a = (A0 + STEP * i) * Math.PI / 180, rr = r + 19;\n    var x = c + rr * Math.sin(a), y = c - rr * Math.cos(a);\n    var g = sv(\"g\", {}, svg); lab.push(g);\n    sv(\"line\", { x1: c + (r + 3) * Math.sin(a), y1: c - (r + 3) * Math.cos(a), x2: c + (r + 8) * Math.sin(a), y2: c - (r + 8) * Math.cos(a), stroke: INK, \"stroke-width\": 1.4 }, g);\n    if (it.t) { var t = sv(\"text\", { x: x, y: y + 3, \"text-anchor\": \"middle\", \"font-size\": 10, \"font-weight\": 800, fill: INK }, g); t.textContent = it.t; }\n    else icon(g, it.i, x, y);\n    var hit = sv(\"circle\", { cx: x, cy: y, r: 11, fill: \"transparent\", style: \"cursor:pointer\" }, g);\n    hit.addEventListener(\"pointerdown\", function (e) { e.stopPropagation(); e.preventDefault(); set(key, p.min + i); });\n  });\n  sv(\"circle\", { cx: c, cy: c, r: r + 1, fill: \"#050506\" }, svg);\n  sv(\"circle\", { cx: c, cy: c, r: r - 1.5, fill: \"url(#dbKnob)\", stroke: \"#cfccc0\", \"stroke-width\": 1.6, class: \"rim\" }, svg);\n  sv(\"circle\", { cx: c, cy: c, r: r * 0.55, fill: \"url(#dbCap)\", stroke: \"#000\", \"stroke-width\": 1 }, svg);\n  var ptr = sv(\"line\", { x1: c, y1: c - r * 0.15, x2: c, y2: c - r + 3, stroke: \"#fff\", \"stroke-width\": 3, \"stroke-linecap\": \"round\" }, svg);\n  function draw() {\n    var i = clamp(Math.round(V[key] - p.min), 0, n - 1);\n    ptr.setAttribute(\"transform\", \"rotate(\" + (A0 + STEP * i) + \" \" + c + \" \" + c + \")\");\n    lab.forEach(function (g, k) { g.setAttribute(\"opacity\", k === i ? 1 : 0.55); g.setAttribute(\"filter\", k === i ? \"\" : \"\"); });\n  }\n  bindKeys([key], draw);\n  var drag = null;\n  w.addEventListener(\"pointerdown\", function (e) {\n    e.preventDefault(); try { w.setPointerCapture(e.pointerId); } catch (x) {}\n    var r2 = w.getBoundingClientRect(), x0 = (e.clientX - r2.left) / SCALE - size / 2;\n    drag = { x: e.clientX, i: Math.round(V[key] - p.min), moved: false, side: x0 >= 0 ? 1 : -1 };\n  });\n  w.addEventListener(\"pointermove\", function (e) {\n    if (!drag) { showTip(e, p); return; }\n    var d = Math.round((e.clientX - drag.x) / SCALE / 22);\n    if (d !== 0 || drag.moved) { drag.moved = true; set(key, p.min + clamp(drag.i + d, 0, n - 1)); showTip(e, p); }\n  });\n  function end() { if (drag && !drag.moved) set(key, p.min + clamp(drag.i + drag.side, 0, n - 1)); drag = null; }\n  w.addEventListener(\"pointerup\", end); w.addEventListener(\"pointercancel\", function () { drag = null; });\n  w.addEventListener(\"wheel\", function (e) { e.preventDefault(); set(key, p.min + clamp(Math.round(V[key] - p.min) + (e.deltaY < 0 ? 1 : -1), 0, n - 1)); }, { passive: false });\n  w.addEventListener(\"pointerleave\", hideTip);\n  return w;\n}\nvar RANGE_ITEMS = [{ t: \"LO\" }, { t: \"32'\" }, { t: \"16'\" }, { t: \"8'\" }, { t: \"4'\" }, { t: \"2'\" }];\nvar WAVE12 = [{ i: \"tri\" }, { i: \"shark\" }, { i: \"saw\" }, { i: \"sqr\" }, { i: \"wide\" }, { i: \"nar\" }];\nvar WAVE3 = [{ i: \"tri\" }, { i: \"rev\" }, { i: \"saw\" }, { i: \"sqr\" }, { i: \"wide\" }, { i: \"nar\" }];\n\n// ---------------------------------------------------------------- rocker switch (ON up / OFF down)\nfunction rocker(key, cx, cy, opts) {\n  opts = opts || {};\n  var p = BY[key], size = 34, w = el(\"div\", \"rk\", plate); put(w, cx - size / 2, cy - size / 2, size, size);\n  var svg = sv(\"svg\", { width: size, height: size, viewBox: \"-17 -17 34 34\" }, w);\n  var hex = []; for (var i = 0; i < 6; i++) { var a = Math.PI / 3 * i + Math.PI / 6; hex.push((14 * Math.cos(a)) + \",\" + (14 * Math.sin(a))); }\n  sv(\"polygon\", { points: hex.join(\" \"), fill: \"url(#dbNut)\", stroke: \"#111\", \"stroke-width\": 1.4 }, svg);\n  sv(\"circle\", { cx: 0, cy: 0, r: 8.5, fill: \"#111\" }, svg);\n  var lever = sv(\"g\", {}, svg);\n  sv(\"rect\", { x: -3.4, y: -17, width: 6.8, height: 17, rx: 3, fill: \"url(#dbLever)\", stroke: \"#000\", \"stroke-width\": 1 }, lever);\n  sv(\"circle\", { cx: 0, cy: -16, r: 4.2, fill: \"url(#dbLever)\", stroke: \"#000\", \"stroke-width\": 1 }, lever);\n  var caps = opts.caps || [\"ON\", \"OFF\"], up = label(cx, cy - size / 2 - 11, caps[0], \"sm\"), dn = label(cx, cy + size / 2 + 1, caps[1], \"sm\");\n  if (opts.title) label(cx, cy + size / 2 + 13, opts.title, opts.tcls || \"big\");\n  function draw() { var on = V[key] === p.max; lever.setAttribute(\"transform\", \"rotate(\" + (on ? 0 : 180) + \")\"); up.className = \"lab sm\" + (on ? \" sel\" : \"\"); dn.className = \"lab sm\" + (on ? \"\" : \" sel\"); }\n  bindKeys([key], draw);\n  w.addEventListener(\"pointerdown\", function (e) { e.preventDefault(); set(key, V[key] === p.max ? p.min : p.max); showTip(e, p); });\n  w.addEventListener(\"pointermove\", function (e) { showTip(e, p); }); w.addEventListener(\"pointerleave\", hideTip);\n  return w;\n}\nfunction led(x, y, cls) { var l = el(\"div\", \"led\" + (cls ? \" \" + cls : \"\"), plate); put(l, x, y); return l; }\n\n// =====================================================================\n//  PANEL SECTIONS\n// =====================================================================\n// ---- CONTROLLERS\nsection(12, 66, 206, 484, \"CONTROLLERS\");\nknob(\"TUNE\", 66, 148, 27, { nums: [\"-\", \"0\", \"+\"], detent: true, label: \"TUNE\" });\nknob(\"GLIDE\", 66, 270, 27, { nums: \"dial\", label: \"GLIDE\" });\nknob(\"MODMIX\", 66, 384, 27, { nums: \"dial\", label: \"MODULATION MIX\", ly: 28 });\nlabel(66, 384 + 27 + 40, \"◀ OSC 3        NOISE ▶\", \"sm\");\nrocker(\"O3_CTRL\", 156, 148, { title: \"OSCILLATOR 3\\nCONTROL\", tcls: \"sm\" });\nrocker(\"OSC_MOD\", 156, 332, { title: \"OSCILLATOR\\nMODULATION\", tcls: \"sm\" });\nrocker(\"FIL_MOD\", 156, 420, { title: \"FILTER\\nMODULATION\", tcls: \"sm\" });\n\n// ---- OSCILLATOR BANK\nsection(214, 66, 626, 484, \"OSCILLATOR BANK\");\nlabel(306, 86, \"RANGE\", \"hd\"); label(432, 86, \"FREQUENCY\", \"hd\"); label(554, 86, \"WAVEFORM\", \"hd\");\nvar ROWY = [172, 296, 420];\nfor (var oi = 0; oi < 3; oi++) {\n  var oy = ROWY[oi], on = String(oi + 1);\n  label(240, oy - 10, \"OSC\\n\" + on, \"big\");\n  rotary6(\"O\" + on + \"_RANGE\", 306, oy, 22, RANGE_ITEMS);\n  if (oi === 0) { label(432, oy - 6, \"NO FREQUENCY\\nCONTROL\", \"sm\"); }\n  else knob(\"O\" + on + \"_FREQ\", 432, oy, 25, { nums: [\"-\", \"0\", \"+\"], detent: true });\n  rotary6(\"O\" + on + \"_WAVE\", 554, oy, 22, oi === 2 ? WAVE3 : WAVE12);\n}\n\n// ---- MIXER\nsection(634, 66, 878, 484, \"MIXER\");\nvar MIX = [[\"SW_O1\", \"VOL1\", \"OSCILLATOR 1\"], [\"SW_EXT\", \"VOLEXT\", \"EXTERNAL\\nINPUT\"], [\"SW_O2\", \"VOL2\", \"OSCILLATOR 2\"], [\"SW_NZ\", \"VOLNZ\", \"NOISE\"], [\"SW_O3\", \"VOL3\", \"OSCILLATOR 3\"]];\nvar MIXY = [134, 214, 294, 374, 454];\nMIX.forEach(function (m, i) {\n  rocker(m[0], 672, MIXY[i], {});\n  knob(m[1], 744, MIXY[i], 22, { nums: \"dial\" });\n  label(i === 1 || i === 3 ? 806 : 820, MIXY[i] - (m[2].indexOf(\"\\n\") >= 0 ? 12 : 5), m[2], \"big\");\n});\nvar lampOver = led(846, MIXY[1], \"\"); label(846, MIXY[1] + 12, \"OVERLOAD\", \"sm\");\nrocker(\"NZ_COLOR\", 846, MIXY[3], { caps: [\"PINK\", \"WHITE\"] });\n\n// ---- MODIFIERS\nsection(886, 66, 1380, 484, \"MODIFIERS\");\nlabel(1000, 84, \"FILTER\", \"hd\");\nrocker(\"KB1\", 934, 152, { title: \"KEYBOARD\\nCONTROL 1\", tcls: \"sm\" });\nrocker(\"KB2\", 996, 152, { title: \"KEYBOARD\\nCONTROL 2\", tcls: \"sm\" });\nknob(\"CUTOFF\", 1106, 152, 33, { nums: \"cut\", label: \"CUTOFF FREQUENCY\", ly: 21 });\nknob(\"EMPH\", 1216, 152, 26, { nums: \"dial\", label: \"EMPHASIS\", l