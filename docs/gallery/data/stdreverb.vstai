n,e){e.addEventListener(\"mousedown\",function(ev){on(n);ev.preventDefault();ev.stopPropagation()});e.addEventListener(\"mouseup\",function(){off(n)});e.addEventListener(\"mouseleave\",function(){off(n)});\ne.addEventListener(\"touchstart\",function(ev){on(n);ev.preventDefault()},{passive:false});e.addEventListener(\"touchend\",function(ev){off(n);ev.preventDefault()})})(n,e);\nKEYS[n]=e;kb.appendChild(e)}\nvar MAP=\"awsedftgyhujkolp;\".split(\"\");window.addEventListener(\"keydown\",function(e){if(e.repeat)return;var i=MAP.indexOf(e.key);if(i>=0)on(60+i)});\nwindow.addEventListener(\"keyup\",function(e){var i=MAP.indexOf(e.key);if(i>=0)off(60+i)})}\nfunction boot(){var rest=document.getElementById(\"rest\");\nGROUPS.forEach(function(g){var c=document.createElement(\"div\");c.className=\"g\";c.innerHTML=\"<h2>\"+g.title+\"</h2>\";\ng.items.forEach(function(it){\nif(it.k===\"knob\"){var ks=document.createElement(\"div\");ks.className=\"ks\";it.i.forEach(function(i,j){ks.appendChild(knob(i,it.labels&&it.labels[j]))});c.appendChild(ks)}\nelse if(it.k===\"seg\")c.appendChild(seg(it.i,it.label,it.opts,it.presets));\nelse if(it.k===\"tog\")c.appendChild(tog(it.i,it.label,it.text));\nelse if(it.k===\"bits\")c.appendChild(bits(it.i,it.label,it.opts))});\nrest.appendChild(c)});\nPARAMS.forEach(function(p,i){if(!(i in V))V[i]=p.def;host(\"setParam\",i,p.def)});\nbuildKb();\nif(window.vstai&&window.vstai.onDisplay)window.vstai.onDisplay(function(d){hasDisp=1;for(var i=0;i<16;i++)disp[i]=d[i]||0});\nif(window.vstai&&window.vstai.onParam)window.vstai.onParam(function(i,v){if(!(i in V))return;V[i]=+v;if(R[i])R[i]()});\nrequestAnimationFrame(draw)}\nif(window.vstai&&typeof window.vstai.onReady===\"function\")window.vstai.onReady(boot);else boot();\n})();\n</script></body></html>",
  "assembly": "// =====================================================================\n//  STDREVERB — Classic algorithmic reverb\n//  The textbook algorithmic reverb: a pre-delay feeds eight parallel damped feedback comb filters whose outputs run through four series allpass diffusers, with a slightly different set of lengths on the right channel for stereo width. Decay sets how long the tail rings, Damping rolls off the highs inside the loop so the tail darkens like a real room, Width blends the stereo image toward mono, and Low Cut and High Cut shape the wet signal. Smooth, dense and unfussy - the reverb you reach for first.\n//  (generated by factory/std/build.mjs from factory/std/fx-*.mjs — edit the definition, not this file)\n// =====================================================================\n// ---- Std prelude: shared helpers (pasted into every Std* effect by factory/std/build.mjs) ----\nconst MAX_FRAMES: i32 = 8192;\nconst MAX_CHANNELS: i32 = 2;\nconst MAX_PARAMS: i32 = 64;\nconst TWO_PI: f32 = 6.28318530717959;\nconst PI: f32 = 3.14159265358979;\n\nconst inBuf:  StaticArray<f32> = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\nconst outBuf: StaticArray<f32> = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\nconst params: StaticArray<f32> = new StaticArray<f32>(MAX_PARAMS);\nconst display: StaticArray<f32> = new StaticArray<f32>(16);\n\nlet sampleRate: f32 = 48000.0;\nlet hostPlaying: bool = false;\nlet hostBpm: f32 = 120.0;\nlet beatPos: f64 = 0.0;\nlet seed: u32 = 12345;\n\n@inline function clampf(x: f32, lo: f32, hi: f32): f32 { return x < lo ? lo : (x > hi ? hi : x); }\n@inline function minf(a: f32, b: f32): f32 { return a < b ? a : b; }\n@inline function maxf(a: f32, b: f32): f32 { return a > b ? a : b; }\n@inline function absf(x: f32): f32 { return x < 0.0 ? -x : x; }\n@inline function rnd(): f32 { seed = seed * 1664525 + 1013904223; return f32(seed >> 8) * (1.0 / 8388608.0) - 1.0; }\n// flush denormals out of feedback paths\n@inline function fz(x: f32): f32 { return (x > -1.0e-18 && x < 1.0e-18) ? 0.0 : x; }\n// exponential map: v in 0..1 -> lo..hi\n@inline function expMap(v: f32, lo: f32, hi: f32): f32 { return lo * f32(Mathf.pow(hi / lo, v)); }\n@inline function dbLin(db: f32): f32 { return f32(Mathf.pow(10.0, db * 0.05)); }\n@inline function linDb(x: f32): f32 { return 20.0 * f32(Mathf.log10(x + 1.0e-9)); }\n@inline function tanhf(x: f32): f32 { return f32(Mathf.tanh(x)); }\n// one-pole smoothing coefficient for a cutoff in Hz\n@inline function opK(hz: f32): f32 { return 1.0 - f32(Mathf.exp(-TWO_PI * clampf(hz, 1.0, sampleRate * 0.45) / sampleRate)); }\n// smoothing coefficient for a time constant in seconds\n@inline function tcK(sec: f32): f32 { return 1.0 - f32(Mathf.exp(-1.0 / (maxf(sec, 0.00002) * sampleRate))); }\n// soft output limiter: transparent below 0.8, rounds smoothly to 1.0\n@inline function softLim(x: f32): f32 {\n  const a: f32 = absf(x);\n  if (a < 0.8) return x;\n  const y: f32 = 0.8 + 0.2 * f32(Mathf.tanh((a - 0.8) * 5.0));\n  return x < 0.0 ? -y : y;\n}\n\n// power-of-two delay line with linear interpolation. base = start in buf, mask = len-1, wr = write index\n@inline function dlr(buf: StaticArray<f32>, base: i32, mask: i32, wr: i32, d: f32): f32 {\n  const p: f32 = f32(wr) - d;\n  const fl: f32 = f32(Mathf.floor(p));\n  const i0: i32 = i32(fl);\n  const fr: f32 = p - fl;\n  const a: f32 = buf[base + (i0 & mask)];\n  const b: f32 = buf[base + ((i0 + 1) & mask)];\n  return a + (b - a) * fr;\n}\n\n// RBJ biquad. coefficients stored normalised at cf[o..o+4] = b0 b1 b2 a1 a2\n// t: 0 LP, 1 HP, 2 BP (0 dB peak), 3 notch, 4 peaking, 5 low shelf, 6 high shelf, 7 allpass\nfunction bqSetSr(cf: StaticArray<f32>, o: i32, t: i32, f0: f32, q: f32, g: f32, sr: f32): void {\n  const fc: f32 = clampf(f0, 5.0, sr * 0.45);\n  const w0: f32 = TWO_PI * fc / sr;\n  const c: f32 = f32(Mathf.cos(w0));\n  const s: f32 = f32(Mathf.sin(w0));\n  const al: f32 = s / (2.0 * maxf(q, 0.05));\n  const A: f32 = f32(Mathf.pow(10.0, g / 40.0));\n  let b0: f32 = 1.0; let b1: f32 = 0.0; let b2: f32 = 0.0;\n  let a0: f32 = 1.0; let a1: f32 = 0.0; let a2: f32 = 0.0;\n  if (t == 0) { b0 = (1.0 - c) * 0.5; b1 = 1.0 - c; b2 = b0; a0 = 1.0 + al; a1 = -2.0 * c; a2 = 1.0 - al; }\n  else if (t == 1) { b0 = (1.0 + c) * 0.5; b1 = -(1.0 + c); b2 = b0; a0 = 1.0 + al; a1 = -2.0 * c; a2 = 1.0 - al; }\n  else if (t == 2) { b0 = al; b1 = 0.0; b2 = -al; a0 = 1.0 + al; a1 = -2.0 * c; a2 = 1.0 - al; }\n  else if (t == 3) { b0 = 1.0; b1 = -2.0 * c; b2 = 1.0; a0 = 1.0 + al; a1 = -2.0 * c; a2 = 1.0 - al; }\n  else if (t == 4) { b0 = 1.0 + al * A; b1 = -2.0 * c; b2 = 1.0 - al * A; a0 = 1.0 + al / A; a1 = -2.0 * c; a2 = 1.0 - al / A; }\n  else if (t == 5) {\n    const sa: f32 = 2.0 * f32(Mathf.sqrt(A)) * al;\n    b0 = A * ((A + 1.0) - (A - 1.0) * c + sa); b1 = 2.0 * A * ((A - 1.0) - (A + 1.0) * c); b2 = A * ((A + 1.0) - (A - 1.0) * c - sa);\n    a0 = (A + 1.0) + (A - 1.0) * c + sa; a1 = -2.0 * ((A - 1.0) + (A + 1.0) * c); a2 = (A + 1.0) + (A - 1.0) * c - sa;\n  } else if (t == 6) {\n    const sb: f32 = 2.0 * f32(Mathf.sqrt(A)) * al;\n    b0 = A * ((A + 1.0) + (A - 1.0) * c + sb); b1 = -2.0 * A * ((A - 1.0) + (A + 1.0) * c); b2 = A * ((A + 1.0) + (A - 1.0) * c - sb);\n    a0 = (A + 1.0) - (A - 1.0) * c + sb; a1 = 2.0 * ((A - 1.0) - (A + 1.0) * c); a2 = (A + 1.0) - (A - 1.0) * c - sb;\n  } else { b0 = 1.0 - al; b1 = -2.0 * c; b2 = 1.0 + al; a0 = 1.0 + al; a1 = -2.0 * c; a2 = 1.0 - al; }\n  const ia: f32 = 1.0 / a0;\n  cf[o] = b0 * ia; cf[o + 1] = b1 * ia; cf[o + 2] = b2 * ia; cf[o + 3] = a1 * ia; cf[o + 4] = a2 * ia;\n}\n@inline function bqSet(cf: StaticArray<f32>, o: i32, t: i32, f0: f32, q: f32, g: f32): void { bqSetSr(cf, o, t, f0, q, g, sampleRate); }\n// transposed direct form II; state z[s], z[s+1]\n@inline function bq(cf: StaticArray<f32>, o: i32, z: StaticArray<f32>, s: i32, x: f32): f32 {\n  const y: f32 = cf[o] * x + z[s];\n  z[s] = fz(cf[o + 1] * x - cf[o + 3] * y + z[s + 1]);\n  z[s + 1] = fz(cf[o + 2] * x - cf[o + 4] * y);\n  return y;\n}\n\nconst NUM_PARAMS: i32 = 8;\nconst P_DECAY: i32 = 0;\nconst P_DAMPING: i32 = 1;\nconst P_PREDELAY: i32 = 2;\nconst P_WIDTH: i32 = 3;\nconst P_LOWCUT: i32 = 4;\nconst P_HIGHCUT: i32 = 5;\nconst P_MIX: i32 = 6;\nconst P_OUTPUT: i32 = 7;\nfunction setDefaults(): void {\n  params[0] = 0.55;   // Decay\n  params[1] = 0.45;   // Damping\n  params[2] = 0.08;   // Pre-Delay\n  params[3] = 1.0;   // Width\n  params[4] = 0.1;   // Low Cut\n  params[5] = 0.9;   // High Cut\n  params[6] = 0.3;   // Mix\n  params[7] = 0.0;   // Output\n}\n\n\nconst CST: i32 = 8192; const AST: i32 = 4096;\nconst combBuf: StaticArray<f32> = new StaticArray<f32>(16 * 8192);\nconst apBuf: StaticArray<f32> = new StaticArray<f32>(8 * 4096);\nconst combLen: StaticArray<i32> = new StaticArray<i32>(16); const combIdx: StaticArray<i32> = new StaticArray<i32>(16);\nconst combLp: StaticArray<f32> = new StaticArray<f32>(16);\nconst apLen: StaticArray<i32> = new StaticArray<i32>(8); const apIdx: StaticArray<i32> = new StaticArray<i32>(8);\nconst preBuf: StaticArray<f32> = new StaticArray<f32>(65536); let preW: i32 = 0;\nconst CT: StaticArray<i32> = [1116, 1188, 1277, 1356, 1422, 1491, 1557, 1617];\nconst AT: StaticArray<i32> = [556, 441, 341, 225];\nconst wf: StaticArray<f32> = new StaticArray<f32>(4);\n\nexport function getInputPtr(): usize  { return changetype<usize>(inBuf); }\nexport function getOutputPtr(): usize { return changetype<usize>(outBuf); }\nexport function getParamsPtr(): usize { return changetype<usize>(params); }\nexport function getNumParams(): i32   { return NUM_PARAMS; }\nexport function getDisplayPtr(): usize { return changetype<usize>(display); }\nexport function transport(playing: i32, ppq: f64, bpm: f32): void {\n  hostPlaying = playing != 0; if (bpm > 20.0) hostBpm = bpm;\n  if (hostPlaying) beatPos = ppq;\n}\n\nexport function init(sr: f32, maxFrames: i32, numChannels: i32): void {\n  sampleRate = sr > 0.0 ? sr : 48000.0;\n  hostPlaying = false; hostBpm = 120.0; beatPos = 0.0; seed = 12345;\n  setDefaults();\n  for (let i = 0; i < 16; i++) display[i] = 0.0;\n  \n  const sc: f32 = sampleRate / 44100.0; const spread: i32 = i32(23.0 * sc + 0.5);\n  for (let i = 0; i < 16; i++) { combIdx[i] = 0; combLp[i] = 0.0; const k: i32 = i & 7; combLen[i] = min(CST - 2, i32(f32(CT[k]) * sc + 0.5) + (i >= 8 ? spread : 0)); }\n  for (let i = 0; i < 8; i++) { apIdx[i] = 0; const k: i32 = i & 3; apLen[i] = min(AST - 2, i32(f32(AT[k]) * sc + 0.5) + (i >= 4 ? spread : 0)); }\n  for (let i = 0; i < 16 * 8192; i++) combBuf[i] = 0.0;\n  for (let i = 0; i < 8 * 4096; i++) apBuf[i] = 0.0;\n  for (let i = 0; i < 65536; i++) preBuf[i] = 0.0;\n  preW = 0; for (let i = 0; i < 4; i++) wf[i] = 0.0;\n}\n\nexport function process(n: i32): void {\n  const sr: f32 = sampleRate;\n  let pkIn: f32 = 0.0; let pkOut: f32 = 0.0;\n  \n  const fbk: f32 = 0.7 + params[P_DECAY] * 0.28; const damp: f32 = params[P_DAMPING] * 0.6; const damp1: f32 = 1.0 - damp;\n  const pdN: i32 = i32(params[P_PREDELAY] * 0.2 * sr);\n  const wid: f32 = params[P_WIDTH]; const w1: f32 = 0.5 + 0.5 * wid; const w2: f32 = 0.5 - 0.5 * wid;\n  const hpK: f32 = opK(expMap(params[P_LOWCUT], 20.0, 800.0)); const lpK: f32 = opK(expMap(params[P_HIGHCUT], 1000.0, 20000.0));\n  const mix: f32 = params[P_MIX]; const outG: f32 = dbLin(params[P_OUTPUT]);\n  for (let f = 0; f < n; f++) {\n    const xl: f32 = inBuf[f]; const xr: f32 = inBuf[MAX_FRAMES + f];\n    let yl: f32 = xl; let yr: f32 = xr;\n    \n    \n  preBuf[preW] = (xl + xr) * 0.5; preW = (preW + 1) & 65535;\n  const inp: f32 = preBuf[(preW - 1 - pdN) & 65535] * 0.02;\n  let sumL: f32 = 0.0; let sumR: f32 = 0.0;\n  for (let i: i32 = 0; i < 8; i++) {\n    let idx: i32 = combIdx[i]; const yv: f32 = combBuf[i * 8192 + idx];\n    combLp[i] = fz(yv * damp1 + combLp[i] * damp); combBuf[i * 8192 + idx] = inp + combLp[i] * fbk;\n    idx++; if (idx >= combLen[i]) idx = 0; combIdx[i] = idx; sumL += yv;\n    const j: i32 = i + 8; let id2: i32 = combIdx[j]; const yr2: f32 = combBuf[j * 8192 + id2];\n    combLp[j] = fz(yr2 * damp1 + combLp[j] * damp); combBuf[j * 8192 + id2] = inp + combLp[j] * fbk;\n    id2++; if (id2 >= combLen[j]) id2 = 0; combIdx[j] = id2; sumR += yr2;\n  }\n  for (let j: i32 = 0; j < 4; j++) {\n    let ia: i32 = apIdx[j]; const ba: f32 = apBuf[j * 4096 + ia]; apBuf[j * 4096 + ia] = fz(sumL + ba * 0.5); sumL = ba - sumL;\n    ia++; if (ia >= apLen[j]) ia = 0; apIdx[j] = ia;\n    const k2: i32 = j + 4; let ib: i32 = apIdx[k2]; const bb: f32 = apBuf[k2 * 4096 + ib]; apBuf[k2 * 4096 + ib] = fz(sumR + bb * 0.5); sumR = bb - sumR;\n    ib++; if (ib >= apLen[k2]) ib = 0; apIdx[k2] = ib;\n  }\n  let wl: f32 = (sumL * w1 + sumR * w2) * 3.0; let wr: f32 = (sumR * w1 + sumL * w2) * 3.0;\n  wf[0] += hpK * (wl - wf[0]); wl -= wf[0]; wf[1] += hpK * (wr - wf[1]); wr -= wf[1];\n  wf[2] += lpK * (wl - wf[2]); wl = wf[2]; wf[3] += lpK * (wr - wf[3]); wr = wf[3];\n  yl = softLim((xl * (1.0 - mix) + wl * mix) * outG); yr = softLim((xr * (1.0 - mix) + wr * mix) * outG);\n    if (!(yl == yl)) yl = 0.0; if (!(yr == yr)) yr = 0.0;\n    outBuf[f] = yl; outBuf[MAX_FRAMES + f] = yr;\n    pkIn = maxf(pkIn, maxf(absf(xl), absf(xr))); pkOut = maxf(pkOut, maxf(absf(yl), absf(yr)));\n    \n  }\n  display[0] = maxf(display[0] * 0.8, clampf(pkOut, 0.0, 1.0));\n  display[1] = maxf(display[1] * 0.8, clampf(pkIn, 0.0, 1.0));\n  \n}\n",
