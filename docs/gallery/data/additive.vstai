  "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Additive</title>\n<style>\n  :root{ --ac:#3aa6e6; --ac2:#8fd0f0; --lcd:#b6e6ff; --panel1:#242c33; --panel2:#0b0f13; --ink:#e7eef4; --dim:#7d8b96; }\n  *{box-sizing:border-box; -webkit-user-select:none; user-select:none}\n  html,body{margin:0;min-height:100%}\n  body{font:11px/1.3 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",sans-serif;color:var(--ink);\n    background:radial-gradient(120% 90% at 50% -10%,#1c242b 0%,#0a0d10 60%,#050607 100%);\n    display:flex;align-items:flex-start;justify-content:center;padding:14px 6px}\n  .synth{display:flex;max-width:1460px;width:100%;border-radius:9px;overflow:hidden;\n    box-shadow:0 26px 60px rgba(0,0,0,.75), inset 0 1px 0 rgba(255,255,255,.05)}\n  .cheek{width:22px;flex:0 0 22px;background:linear-gradient(90deg,#20303a,#0d151b);\n    box-shadow:inset -3px 0 6px rgba(0,0,0,.6),inset 3px 0 3px rgba(255,255,255,.05)}\n  .core{flex:1;background:linear-gradient(180deg,var(--panel1),var(--panel2));padding:10px 12px 12px;min-width:0}\n  .head{display:flex;align-items:center;gap:14px;padding:2px 4px 9px;border-bottom:1px solid rgba(255,255,255,.09)}\n  .logo{font-size:23px;font-weight:800;letter-spacing:.06em;\n    background:linear-gradient(90deg,#eaf6ff,#3aa6e6);-webkit-background-clip:text;background-clip:text;color:transparent}\n  .logo b{color:var(--ac2);font-weight:800}\n  .tag{font-size:8.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--dim)}\n  .headfill{flex:1}\n  .spec{width:230px;height:44px;background:#06131c;border:1px solid #000;border-radius:5px;box-shadow:inset 0 2px 8px rgba(0,0,0,.8)}\n  .lcd{display:flex;align-items:center;gap:8px}\n  .lcd .what{font-size:8.5px;letter-spacing:.14em;color:var(--dim);text-transform:uppercase;max-width:110px;text-align:left}\n  .lcd .scr{min-width:120px;text-align:right;background:#06131c;border:1px solid #000;border-radius:5px;\n    padding:3px 9px;font:700 16px/1 \"Menlo\",\"Consolas\",monospace;color:var(--lcd);\n    text-shadow:0 0 7px rgba(58,166,230,.55);letter-spacing:.03em}\n  .rowlabel{font-size:9px;font-weight:700;letter-spacing:.2em;color:var(--ac);text-transform:uppercase;margin:9px 2px 1px;\n    border-left:3px solid var(--ac);padding-left:6px}\n  .row{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;align-items:stretch}\n  .sec{border:1px solid rgba(255,255,255,.12);border-radius:6px;padding:18px 7px 6px;position:relative;\n    background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,0));flex:0 0 auto}\n  .sec>b{position:absolute;top:0;left:0;right:0;padding:2px 7px;font-size:8px;font-weight:700;\n    letter-spacing:.1em;text-transform:uppercase;white-space:nowrap;border-radius:5px 5px 0 0;\n    background:linear-gradient(90deg,var(--ac),#1c6fa0);color:#04121a}\n  .sec.b>b{background:linear-gradient(90deg,var(--ac2),#3f89ad);color:#062230}\n  .sec.g>b{background:linear-gradient(90deg,#3a444d,#242c33);color:#cfe4f2}\n  .bank{display:flex;gap:4px 8px;align-items:flex-start;flex-wrap:wrap}\n  .col{display:flex;flex-direction:column;gap:6px;align-items:center;justify-content:flex-start}\n  .kn{display:flex;flex-direction:column;align-items:center;gap:4px;width:40px}\n  .kn .dial{position:relative;width:30px;height:30px;border-radius:50%;cursor:ns-resize;touch-action:none;\n    background:radial-gradient(60% 60% at 40% 32%,#3b444c,#181e23 70%,#0a0d10);border:1px solid #000;\n    box-shadow:0 2px 5px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,.12)}\n  .kn .lb{font-size:7px;letter-spacing:.02em;color:var(--dim);text-transform:uppercase;text-align:center;line-height:1.15;min-height:9px;max-width:40px}\n  .bt{display:flex;flex-direction:column;align-items:center;gap:3px;cursor:pointer;width:40px}\n  .bt .sq{width:26px;height:12px;border-radius:3px;border:1px solid #000;position:relative;\n    background:linear-gradient(180deg,#2b333a,#131820);box-shadow:0 2px 3px rgba(0,0,0,.55), inset 0 1px 0 rgba(255,255,255,.08)}\n  .bt .sq::after{content:\"\";position:absolute;top:-6px;left:50%;transform:translateX(-50%);width:6px;height:3.5px;border-radius:2px;background:#233;transition:.12s}\n  .bt.on .sq::after{background:var(--ac);box-shadow:0 0 7px var(--ac),0 0 13px rgba(58,166,230,.5)}\n  .bt.b.on .sq::after{background:var(--ac2);box-shadow:0 0 7px var(--ac2)}\n  .bt:active .sq{transform:translateY(1px)}\n  .bt .lb{font-size:7px;letter-spacing:.02em;color:var(--dim);text-transform:uppercase;text-align:center;white-space:nowrap}\n  .sel{display:flex;flex-direction:column;gap:2px;align-items:flex-start}\n  .sel>i{font-size:7px;letter-spacing:.05em;color:var(--dim);text-transform:uppercase;font-style:normal;margin-bottom:1px}\n  .sel .opt{display:flex;align-items:center;gap:4px;cursor:pointer;padding:0 1px}\n  .sel .led{width:6px;height:6px;border-radius:50%;background:#122731;border:1px solid #000;transition:.1s}\n  .sel .opt.on .led{background:var(--ac);box-shadow:0 0 6px var(--ac)}\n  .sel .opt span{font-size:7px;letter-spacing:.02em;color:var(--dim);text-transform:uppercase;white-space:nowrap}\n  .sel .opt.on span{color:#eaf6ff}\n  .lever{display:flex;flex-direction:column;align-items:center;gap:4px}\n  .lever .slot{width:70px;height:18px;border-radius:5px;background:#06131c;border:1px solid #000;\n    box-shadow:inset 0 2px 8px rgba(0,0,0,.9);position:relative;cursor:ew-resize;touch-action:none;overflow:hidden}\n  .lever .grip{position:absolute;top:2px;bottom:2px;width:18px;border-radius:3px;\n    background:linear-gradient(90deg,#3b444c 0 3px,#22282e 3px 6px);background-size:6px 100%;border:1px solid #000;left:26px}\n  .lever .lb{font-size:7px;letter-spacing:.08em;color:var(--dim);text-transform:uppercase}\n  .foot{margin-top:10px;padding-top:7px;border-top:1px solid rgba(255,255,255,.08);font-size:9px;color:#79857f;display:flex;gap:16px;flex-wrap:wrap}\n  .foot b{color:var(--ac);font-weight:600}\n</style></head><body>\n<div class=\"synth\">\n  <div class=\"cheek\"></div>\n  <div class=\"core\">\n    <div class=\"head\">\n      <div><div class=\"logo\">Additive</div><div class=\"tag\">Additive Synthesizer · Dual DHG · 128 partials</div></div>\n      <div class=\"headfill\"></div>\n      <canvas class=\"spec\" id=\"spec\" width=\"460\" height=\"88\"></canvas>\n      <div class=\"lcd\"><div class=\"what\" id=\"lcdWhat\">voice</div><div class=\"scr\" id=\"lcd\">K5 · SUM</div></div>\n    </div>\n\n    <div class=\"rowlabel\">Global &amp; Voice</div>\n    <div class=\"row\" id=\"rowGlobal\"></div>\n\n    <div class=\"rowlabel\">Source 1 — DHG spectrum / band envelopes / DDF / DDA</div>\n    <div class=\"row\" id=\"rowS1\"></div>\n\n    <div class=\"rowlabel\">Source 2 — DHG spectrum / band envelopes / DDF / DDA</div>\n    <div class=\"row\" id=\"rowS2\"></div>\n\n    <div class=\"rowlabel\">Modulation &amp; Performance</div>\n    <div class=\"row\" id=\"rowMod\"></div>\n\n    <div class=\"foot\">\n      <span><b>2 SOURCES</b> · 64 partials each summed by a sine bank</span>\n      <span><b>DHG</b> profile · tilt · odd/even · density · formant</span>\n      <span><b>BAND ENV</b> low / mid / high attack+decay morph the spectrum</span>\n      <span><b>DDF</b> spectral filter · <b>DDA</b> amplitude ADSR</span>\n    </div>\n  </div>\n  <div class=\"cheek\"></div>\n</div>\n<script>\n(function(){\n  \"use strict\";\n  var PD={};\n  function d(i,mn,mx,df){ PD[i]={min:mn,max:mx,def:df}; }\n  // source block: base = src*22\n  var S1=[0,0.1,0.0,0.7,0.3,0.4,0.35, 0.02,0.6,0.05,0.4,0.08,0.25, 0.7,0.2,0.3,0.05,0.5, 0.02,0.5,0.7,0.4];\n  var S2=[1,-0.1,0.4,0.5,0.5,0.5,0.25, 0.03,0.7,0.1,0.5,0.15,0.3, 0.6,0.25,0.25,0.08,0.5, 0.04,0.6,0.65,0.45];\n  function srcDefs(base,arr){\n    d(base+0,0,5,arr[0]); d(base+1,-1,1,arr[1]); d(base+2,-1,1,arr[2]); d(base+3,0,1,arr[3]);\n    d(base+4,0,1,arr[4]); d(base+5,0,1,arr[5]); d(base+6,0,1,arr[6]);\n    d(base+7,0,1,arr[7]); d(base+8,0,1,arr[8]); d(base+9,0,1,arr[9]); d(base+10,0,1,arr[10]); d(base+11,0,1,arr[11]); d(base+12,0,1,arr[12]);\n    d(base+13,0,1,arr[13]); d(base+14,0,1,arr[14]); d(base+15,-1,1,arr[15]); d(base+16,0,1,arr[16]); d(base+17,0,1,arr[17]);\n    d(base+18,0,1,arr[18]); d(base+19,0,1,arr[19]); d(base+20,0,1,arr[20]); d(base+21,0,1,arr[21]);\n  }\n  srcDefs(0,S1); srcDefs(22,S2);\n  d(44,0,15,5); d(45,0,1,0.5); d(46,-24,24,0); d(47,-1,1,0.08); d(48,-1,1,0); d(49,0,1,0);\n  d(50,-1,1,0); d(51,0,1,0.4); d(52,0,1,0.35); d(53,0,4,0); d(54,0,1,0.1); d(55,0,15,1);\n  d(56,0,1,0.4); d(57,0,12,2); d(58,-1,1,0); d(59,0,1,0); d(60,0,1,0); d(61,0,1,0.7);\n\n  var vals={}; for(var k in PD) vals[k]=PD[k].def;\n  var lcd,lcdWhat,listeners={};\n\n  function push(i,v,label,shown){\n    vals[i]=v;\n    if(window.vstai&&window.vstai.setParam) window.vstai.setParam(+i,v);\n    if(label!==undefined&&lcd){ lcdWhat.textContent=label; lcd.textContent=shown; }\n    var ls=listeners[i]; if(ls) for(var j=0;j<ls.length;j++) ls[j]();\n  }\n  function listen(i,fn){ (listeners[i]=listeners[i]||[]).push(fn); }\n  function getField(i,shift,width){ var m=(1<<width)-1; return (Math.round(vals[i])>>shift)&m; }\n  function setField(i,shift,width,val,label,shown){\n    var m=(1<<width)-1; var v=Math.round(vals[i]); v=(v&~(m<<shift))|((val&m)<<shift);\n    push(i,v,label,shown);\n  }\n  function el(tag,cls,parent){ var e=document.createElement(tag); if(cls)e.className=cls; if(parent)parent.appendChild(e); return e; }\n\n  function knob(parent,idx,label,fmt){\n    var p=PD[idx];\n    var box=el(\"div\",\"kn\",parent);\n    var dial=el(\"div\",\"dial\",box);\n    var ind=el(\"div\",\"\",dial);\n    ind.style.cssText=\"position:absolute;left:50%;top:3px;width:2px;height:10px;margin-left:-1px;background:var(--ac);border-radius:1px;transform-origin:50% 12px;box-shadow:0 0 5px var(--ac)\";\n    el(\"div\",\"lb\",box).textContent=label;\n    function norm(){ return (vals[idx]-p.min)/(p.max-p.min); }\n    function show(){ return fmt?fmt(vals[idx]):Math.round(norm()*127)+\"\"; }\n    function repaint(){ ind.style.transform=\"rotate(\"+(norm()*270-135)+\"deg)\"; }\n    function setN(nn){ nn=nn<0?0:(nn>1?1:nn); var v=p.min+(p.max-p.min)*nn;\n      if(p.min>=0&&p.max-p.min>=2&&(p.max-p.min)%1===0) v=Math.round(v);\n      push(idx,v,label,show()); repaint(); }\n    dial.addEventListener(\"pointerdown\",function(e){ dial._d=1; dial._y=e.clientY; dial._n=norm(); dial.setPointerCapture(e.pointerId); e.preventDefault(); });\n    dial.addEventListener(\"pointermove\",function(e){ if(!dial._d)return; setN(dial._n+(dial._y-e.clientY)/150); });\n    dial.addEventListener(\"pointerup\",function(){ dial._d=0; });\n    dial.addEventListener(\"pointercancel\",function(){ dial._d=0; });\n    dial.addEventListener(\"dblclick\",function(){ push(idx,p.def,label,show()); repaint(); });\n    dial.addEventListener(\"wheel\",function(e){ e.preventDefault(); setN(norm()+(e.deltaY<0?0.04:-0.04)); },{passive:false});\n    listen(idx,repaint); repaint();\n    return box;\n  }\n  function bitBtn(parent,idx,bit,label,cls){\n    var b=el(\"div\",\"bt\"+(cls?\" \"+cls:\"\"),parent);\n    el(\"div\",\"sq\",b); el(\"div\",\"lb\",b).textContent=label;\n    function paint(){ b.classList.toggle(\"on\",!!getField(idx,bit,1)); }\n    b.addEventListener(\"click\",function(){ var cur=getField(idx,bit,1); setField(idx,bit,1,cur?0:1,label,cur?\"Off\":\"On\"); });\n    listen(idx,paint); paint();\n    return b;\n  }\n  function pSelector(parent,title,idx,opts){\n    var s=el(\"div\",\"sel\",parent);\n    if(title){ el(\"i\",\"\",s).textContent=title; }\n    var rows=[];\n    function paint(){ var cur=Math.round(vals[idx]); for(var i=0;i<rows.length;i++) rows[i].classList.toggle(\"on\",i===cur); }\n    opts.forEach(function(o,i){ var r=el(\"div\",\"opt\",s); el(\"i\",\"led\",r); el(\"span\",\"\",r).textContent=o;\n      r.addEventListener(\"click\",function(){ push(idx,i,title,o); }); rows.push(r); });\n    listen(idx,paint); paint();\n    return s;\n  }\n  function lever(parent,idx,label,fmt){\n    var p=PD[idx];\n    var w=el(\"div\",\"lever\",parent);\n    var slot=el(\"div\",\"slot\",w); var grip=el(\"div\",\"grip\",slot);\n    el(\"div\",\"lb\",w).textContent=label;\n    var TRACK=70-18-4;\n    function norm(){ return (vals[idx]-p.min)/(p.max-p.min); }\n    function paint(){ grip.style.left=(2+norm()*TRACK)+\"px\"; }\n    function setN(nn){ nn=nn<0?0:(nn>1?1:nn); var v=p.min+(p.max-p.min)*nn;\n      push(idx,v,label,fmt?fmt(v):(v>=0?\"+\":\"\")+v.toFixed(2)); paint(); }\n    slot.addEventListener(\"pointerdown\",function(e){ slot._d=1; var r=slot.getBoundingClientRect(); setN((e.clientX-r.left-11)/TRACK); slot.setPointerCapture(e.pointerId); e.preventDefault(); });\n    slot.addEventListener(\"pointermove\",function(e){ if(!slot._d)return; var r=slot.getBoundingClientRect(); setN((e.clientX-r.left-11)/TRACK); });\n    slot.addEventListener(\"pointerup\",function(){ slot._d=0; });\n    slot.addEventListener(\"pointercancel\",function(){ slot._d=0; });\n    slot.addEventListener(\"dblclick\",function(){ push(idx,p.def,label,\"0\"); paint(); });\n    listen(idx,paint); paint();\n    return w;\n  }\n  function sec(row,name,cls){ var s=el(\"div\",\"sec \"+(cls||\"\"),row); el(\"b\",\"\",s).textContent=name; return el(\"div\",\"bank\",s); }\n  function col(parent){ return el(\"div\",\"col\",parent); }\n\n  lcd=document.getElementById(\"lcd\"); lcdWhat=document.getElementById(\"lcdWhat\");\n  var pct=function(v){ return Math.round(v*100)+\"\"; };\n  var bip=function(v){ return (v>=0?\"+\":\"\")+Math.round(v*100); };\n  var semi=function(v){ return (v>=0?\"+\":\"\")+Math.round(v)+\"st\"; };\n  var cent=function(v){ return (v>=0?\"+\":\"\")+Math.round(v*50)+\"c\"; };\n\n  // ---- Global & voice ----\n  var rG=document.getElementById(\"rowGlobal\");\n  var b=sec(rG,\"Mode\",\"g\");\n  var mc=col(b); bitBtn(mc,44,0,\"Full\"); bitBtn(mc,44,3,\"Legato\");\n  var mc2=col(b); bitBtn(mc2,44,1,\"LFOSync\",\"b\"); bitBtn(mc2,44,2,\"DDF Trk\",\"b\");\n  b=sec(rG,\"Mix / Tune\");\n  knob(b,45,\"S1◂▸S2\",pct); knob(b,46,\"S2 Semi\",function(v){return (v>=0?\"+\":\"\")+Math.round(v)+\"\";});\n  knob(b,47,\"S2 Fine\",cent); knob(b,48,\"M.Tune\",cent);\n  b=sec(rG,\"Voice\");\n  knob(b,49,\"Porta\",pct); knob(b,61,\"Volume\",pct);\n\n  // ---- Source strip builder ----\n  function srcRow(rowId,base,cls){\n    var row=document.getElementById(rowId);\n    var profs=[\"Saw\",\"Squr\",\"Puls\",\"Tri\",\"Orgn\",\"Reso\"];\n    var s=sec(row,\"DHG Profile\",cls);\n    var pc=col(s); pSelector(pc,\"Seed\",base+0,profs);\n    var k=col(s); knob(k,base+1,\"Tilt\",bip); knob(k,base+3,\"Density\",pct);\n    var k2=col(s); knob(k2,base+2,\"Odd/Evn\",bip);\n    s=sec(row,\"Formant (DFT)\",cls);\n    knob(s,base+4,\"Freq\",pct); knob(s,base+5,\"Width\",pct); knob(s,base+6,\"Amount\",pct);\n    s=sec(row,\"Band Env\",cls);\n    var lo=col(s); knob(lo,base+7,\"Lo Atk\"); knob(lo,base+8,\"Lo Dec\");\n    var mi=col(s); knob(mi,base+9,\"Mid Atk\"); knob(mi,base+10,\"Mid Dec\");\n    var hi=col(s); knob(hi,base+11,\"Hi Atk\"); knob(hi,base+12,\"Hi Dec\");\n    s=sec(row,\"DDF Filter\",cls);\n    var f1=col(s); knob(f1,base+13,\"Cutoff\",pct); knob(f1,base+14,\"Reso\",pct);\n    var f2=col(s); knob(f2,base+15,\"Env\",bip); knob(f2,base+16,\"Env Atk\");\n    var f3=col(s); knob(f3,base+17,\"Env Dec\");\n    s=sec(row,\"DDA Amp\",cls);\n    var a1=col(s); knob(a1,base+18,\"Attack\"); knob(a1,base+19,\"Decay\");\n    var a2=col(s); knob(a2,base+20,\"Sustain\"); knob(a2,base+21,\"Release\");\n  }\n  srcRow(\"rowS1\",0,\"\");\n  srcRow(\"rowS2\",22,\"b\");\n\n  // ---- Modulation & performance ----\n  var rM=document.getElementById(\"rowMod\");\n  b=sec(rM,\"Pitch Env (DFG)\",\"g\");\n  knob(b,50,\"Amount\",bip); knob(b,51,\"Rate\",pct);\n  b=sec(rM,\"LFO\");\n  knob(b,52,\"Rate\",pct); knob(b,54,\"Depth\",pct);\n  var ls=col(b); pSelector(ls,\"Shape\",53,[\"Tri\",\"SawDn\",\"Ramp\",\"Squr\",\"Rand\"]);\n  var ld=col(b); bitBtn(ld,55,0,\"Pitch\"); bitBtn(ld,55,1,\"Spec\");\n  var ld2=col(b); bitBtn(ld2,55,2,\"Amp\",\"b\"); bitBtn(ld2,55,3,\"Form\",\"b\");\n  b=sec(rM,\"Keyboard\");\n  knob(b,56,\"DDF KTrk\",pct); knob(b,57,\"Bend Rng\",function(v){return Math.round(v)+\"st\";});\n  b=sec(rM,\"Performance\",\"b\");\n  var pw=col(b); lever(pw,58,\"Pitch\"); lever(pw,59,\"Mod\");\n  var pw2=col(b); lever(pw2,60,\"Aftertch\",pct);\n\n  // ---- harmonic spectrum display (mirrors the DSP base spectrum) ----\n  var cv=document.getElementById(\"spec\"), cx=cv?cv.getContext(\"2d\"):null;\n  var NH=40;\n  function buildSpec(base){\n    var prof=Math.round(vals[base+0]), tilt=vals[base+1], oe=vals[base+2], dens=vals[base+3];\n    var ff=vals[base+4], fw=vals[base+5], fa=vals[base+6];\n    var activeN=2+dens*(NH-1), peak=1+ff*(NH-1), sig=1+fw*22, ts=2*sig*sig;\n    var a=[],sum=0;\n    for(var i=0;i<NH;i++){ var h=i+1,v=0;\n      if(prof===0)v=1/h; else if(prof===1)v=(h&1)?1/h:0; else if(prof===2)v=1/Math.sqrt(h);\n      else if(prof===3)v=(h&1)?1/(h*h):0;\n      else if(prof===4){ var isp=(h&(h-1))===0; v=isp?1/(1+Math.log2(h)):0.08/h; }\n      else v=(1/h)*(1+3*Math.exp(-((h-6)*(h-6))/10));\n      v*=Math.pow(h,tilt*1.5);\n      v*=(h&1)?Math.max(0,Math.min(2,1+oe)):Math.max(0,Math.min(2,1-oe));\n      v*=Math.max(0,Math.min(1,activeN-h+1));\n      if(fa>0){ var dd=h-peak; v*=1+fa*4*Math.exp(-(dd*dd)/ts); }\n      a.push(v); sum+=v;\n    }\n    var nrm=0.9/(sum>0.0001?sum:0.0001);\n    for(var j=0;j<NH;j++) a[j]*=nrm;\n    return a;\n  }\n  function drawSpec(){\n    if(!cx) return;\n    var W=cv.width,H=cv.height; cx.clearRect(0,0,W,H);\n    cx.fillStyle=\"#06131c\"; cx.fillRect(0,0,W,H);\n    var s1=buildSpec(0), s2=buildSpec(22);\n    var mx=0,i; for(i=0;i<NH;i++){ if(s1[i]>mx)mx=s1[i]; if(s2[i]>mx)mx=s2[i]; } if(mx<=0)mx=1;\n    var bw=W/NH;\n    function bars(arr,color){ cx.fillStyle=color;\n      for(var k=0;k<NH;k++){ var hh=(arr[k]/mx)*(H-4); cx.fillRect(k*bw+1,H-hh,bw-1.5,hh); } }\n    cx.globalAlpha=0.55; bars(s2,\"#8fd0f0\");\n    cx.globalAlpha=0.85; bars(s1,\"#3aa6e6\"); cx.globalAlpha=1;\n  }\n  if(cx){ for(var si=0;si<2;si++){ var bb=si*22; for(var q=0;q<7;q++) listen(bb+q,drawSpec); } drawSpec(); }\n\n  // push all defaults + follow host changes\n  function ready(){\n    for(var i in vals) if(window.vstai&&window.vstai.setParam) window.vstai.setParam(+i,vals[i]);\n    if(window.vstai&&window.vstai.onParam) window.vstai.onParam(function(i,v){\n      if(!(i in vals)) return; vals[i]=+v;\n      var ls=listeners[i]; if(ls) for(var j=0;j<ls.length;j++) ls[j]();\n    });\n    drawSpec();\n  }\n  if(window.vstai&&window.vstai.onReady) window.vstai.onReady(ready); else ready();\n})();\n</script>\n</body></html>\n",
  "assembly": "// =====================================================================\n//  ADDITIVE — a polyphonic additive (Fourier) synthesizer modelled on\n//  the Kawai K5 (Owner's Manual, read cover to cover).\n//\n//  Per voice: TWO independent additive SOURCES (S1/S2), each summing 64\n//  sinusoidal harmonics — echoing the K5's dual DHG that spreads 126\n//  harmonics over two halves.  The harmonic spectrum is sculpted by\n//  macro controls instead of 126 sliders:\n//    * PROFILE  seeds the harmonic bank (saw 1/n, square odd-1/n, pulse,\n//               triangle, organ octaves, resonant);\n//    * TILT     bipolar spectral slope (brightness);\n//    * ODD/EVEN partial balance;\n//    * DENSITY  how many partials sound;\n//    * FORMANT  DFT-style emphasis (peak harmonic, width, amount).\n//  The K5's four six-stage DHG amplitude envelopes are modelled as three\n//  HARMONIC BAND envelopes (low/mid/high attack+decay) so the spectrum\n//  morphs over the life of the note — the signature evolving K5 timbre.\n//  Each source then passes a DDF (spectral low-pass over the harmonic\n//  bank: cutoff, resonance, own attack/decay envelope, keyboard scaling)\n//  and a DDA (ADSR amplitude contour).  Global: a DFG pitch envelope, a\n//  shared LFO (tri/saw/ramp/square/random) routable to pitch, spectrum,\n//  amplitude and formant with key sync; S1/S2 balance, S2 coarse+detune\n//  (Twin-mode beating), master tune, portamento, pitch-bend wheel+range,\n//  mod-wheel vibrato, aftertouch pressure and volume.\n//\n//  Harmonic amplitudes are recomputed at CONTROL RATE (every 32 samples)\n//  and summed per-sample by a complex-recurrence sine bank, so 128\n//  partials over 6 voices stay real-time.  No samples, no host imports,\n//  allocation-free process().\n// =====================================================================\n\nconst MAX_FRAMES: i32 = 8192;\nconst MAX_CHANNELS: i32 = 2;\nconst MAX_PARAMS: i32 = 64;\nconst NUM_VOICES: i32 = 6;\nconst NUM_HARM: i32 = 64;\nconst CTRL: i32 = 32;          // control-rate block (samples)\n\nconst PI: f32 = 3.14159265358979;\nconst TWO_PI: f32 = 6.28318530717959;\n\nconst inBuf:  StaticArray<f32> = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\nconst outBuf: StaticArray<f32> = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\nconst params: StaticArray<f32> = new StaticArray<f32>(MAX_PARAMS);\n\nlet sampleRate: f32 = 48000.0;\n\n// ---- parameter indices (must match spec.json) -----------------------\n// source block: base = src*22\nconst PB_PROFILE: i32 = 0;\nconst PB_TILT: i32 = 1;\nconst PB_ODDEVEN: i32 = 2;\nconst PB_DENSITY: i32 = 3;\nconst PB_FFREQ: i32 = 4;\nconst PB_FWID: i32 = 5;\nconst PB_FAMT: i32 = 6;\nconst PB_LOA: i32 = 7;\nconst PB_LOD: i32 = 8;\nconst PB_MIDA: i32 = 9;\nconst PB_MIDD: i32 = 10;\nconst PB_HIA: i32 = 11;\nconst PB_HID: i32 = 12;\nconst PB_DDFCUT: i32 = 13;\nconst PB_DDFRES: i32 = 14;\nconst PB_DDFENV: i32 = 15;\nconst PB_DDFA: i32 = 16;\nconst PB_DDFD: i32 = 17;\nconst PB_DDAA: i32 = 18;\nconst PB_DDAD: i32 = 19;\nconst PB_DDAS: i32 = 20;\nconst PB_DDAR: i32 = 21;\nconst SRC_STRIDE: i32 = 22;\n\nconst P_FLAGS: i32 = 44;   // bit0 Full(1)/Twin(0), bit1 LFO keysync, bit2 DDF keytrack on, bit3 legato\nconst P_BAL: i32 = 45;\nconst P_S2COARSE: i32 = 46;\nconst P_S2DET: i32 = 47;\nconst P_MTUNE: i32 = 48;\nconst P_PORTA: i32 = 49;\nconst P_PENV: i32 = 50;\nconst P_PENVR: i32 = 51;\nconst P_LFORATE: i32 = 52;\nconst P_LFOSHP: i32 = 53;\nconst P_LFODEP: i32 = 54;\nconst P_LFODST: i32 = 55;   // bit0 pitch, bit1 spectrum, bit2 amp, bit3 formant\nconst P_DDFKT: i32 = 56;\nconst P_BENDR: i32 = 57;\nconst P_PWHEEL: i32 = 58;\nconst P_MODWHL: i32 = 59;\nconst P_AT: i32 = 60;\nconst P_VOL: i32 = 61;\n\n// ---- helpers ---------------------------------------------------------\n@inline function clampf(x: f32, lo: f32, hi: f32): f32 { return x < lo ? lo : (x > hi ? hi : x); }\n@inline function pget(i: i32): f32 { return params[i]; }\n@inline function pbits(i: i32): i32 { return i32(params[i] + (params[i] < 0.0 ? -0.5 : 0.5)); }\n@inline function envTime(n: f32): f32 { return 0.001 * Mathf.pow(10000.0, clampf(n, 0.0, 1.0)); } // 1ms..10s\n\nlet rngState: i32 = 0x2545f491;\n@inline function rngf(): f32 {\n  rngState ^= rngState << 13; rngState ^= rngState >>> 17; rngState ^= rngState << 5;\n  return f32(rngState & 0x7fffffff) / f32(0x3fffffff) - 1.0;\n}\n\n// band index for harmonic number h (1-based): low<=8, mid<=24, else high\n@inline function bandOf(h: i32): i32 { return h <= 8 ? 0 : (h <= 24 ? 1 : 2); }\n\n// ---- voice state -----------------------------------------------------\nconst vActive: StaticArray<i32> = new StaticArray<i32>(NUM_VOICES);\nconst vGate:   StaticArray<i32> = new StaticArray<i32>(NUM_VOICES);\nconst vNote:   StaticArray<i32> = new StaticArray<i32>(NUM_VOICES);\nconst vAge:    StaticArray<i32> = new StaticArray<i32>(NUM_VOICES);\nconst vVel:    StaticArray<f32> = new StaticArray<f32>(NUM_VOICES);\nconst vTarget: StaticArray<f32> = new StaticArray<f32>(NUM_VOICES); // target Hz (S1)\nconst vCur:    StaticArray<f32> = new StaticArray<f32>(NUM_VOICES); // glide Hz\nconst vGlideK: StaticArray<f32> = new StaticArray<f32>(NUM_VOICES);\nconst vPh1:    StaticArray<f32> = new StaticArray<f32>(NUM_VOICES);\nconst vPh2:    StaticArray<f32> = new StaticArray<f32>(NUM_VOICES);\n// per-source DDA env + stage\nconst vDda:    StaticArray<f32> = new StaticArray<f32>(2 * NUM_VOICES);\nconst vDdaSt:  StaticArray<i32> = new StaticArray<i32>(2 * NUM_VOICES);\n// per-source DDF env + stage (AD)\nconst vDdf:    StaticArray<f32> = new StaticArray<f32>(2 * NUM_VOICES);\nconst vDdfSt:  StaticArray<i32> = new StaticArray<i32>(2 * NUM_VOICES);\n// band env value + stage: index (src*3 + band)*NUM_VOICES + v\nconst vBand:   StaticArray<f32> = new StaticArray<f32>(2 * 3 * NUM_VOICES);\nconst vBandSt: StaticArray<i32> = new StaticArray<i32>(2 * 3 * NUM_VOICES);\n// per-voice pitch env (DFG)\nconst vPEnv:   StaticArray<f32> = new StaticArray<f32>(NUM_VOICES);\n// per-voice, per-source effective harmonic amplitudes (control-rate)\nconst effA1:   StaticArray<f32> = new StaticArray<f32>(NUM_VOICES * NUM_HARM);\nconst effA2:   StaticArray<f32> = new StaticArray<f32>(NUM_VOICES * NUM_HARM);\n\n// global base spectra (control-rate, shared)\nconst baseA1:  StaticArray<f32> = new StaticArray<f32>(NUM_HARM);\nconst baseA2:  StaticArray<f32> = new StaticArray<f32>(NUM_HARM);\n\nlet ageCounter: i32 = 0;\nlet lastPlayedHz: f32 = 261.63;\n\n// held-key list (mono/last-note not required; poly) — kept for legato/porta ref only\nlet lfoPhase: f32 = 0.0;\nlet lfoSH: f32 = 0.0;\nlet lfoVal: f32 = 0.0;   // bipolar -1..1\nlet lfoPos: f32 = 0.0;   // 0..1 (for tremolo)\n\nexport function init(sr: f32, maxFrames: i32, numChannels: i32): void {\n  sampleRate = sr > 0.0 ? sr : 48000.0;\n  for (let v = 0; v < NUM_VOICES; v++) {\n    vActive[v] = 0; vGate[v] = 0; vNote[v] = -1; vAge[v] = 0; vVel[v] = 0.0;\n    vTarget[v] = 261.63; vCur[v] = 261.63; vGlideK[v] = 1.0;\n    vPh1[v] = 0.0; vPh2[v] = 0.0; vPEnv[v] = 0.0;\n    for (let s = 0; s < 2; s++) { vDda[s * NUM_VOICES + v] = 0.0; vDdaSt[s * NUM_VOICES + v] = 0;\n      vDdf[s * NUM_VOICES + v] = 0.0; vDdfSt[s * NUM_VOICES + v] = 0; }\n    for (let b = 0; b < 6; b++) { vBand[b * NUM_VOICES + v] = 0.0; vBandSt[b * NUM_VOICES + v] = 0; }\n  }\n  for (let i = 0; i < NUM_VOICES * NUM_HARM; i++) { effA1[i] = 0.0; effA2[i] = 0.0; }\n  ageCounter = 0; lastPlayedHz = 261.63;\n  lfoPhase = 0.0; lfoSH = 0.0; lfoVal = 0.0; lfoPos = 0.0;\n\n  // musically sensible boot state (matches spec.json defaults)\n  params[0] = 0.0; params[1] = 0.1; params[2] = 0.0; params[3] = 0.7;\n  params[4] = 0.3; params[5] = 0.4; params[6] = 0.35;\n  params[7] = 0.02; params[8] = 0.6; params[9] = 0.05; params[10] = 0.4; params[11] = 0.08; params[12] = 0.25;\n  params[13] = 0.7; params[14] = 0.2; params[15] = 0.3; params[16] = 0.05; params[17] = 0.5;\n  params[18] = 0.02; params[19] = 0.5; params[20] = 0.7; params[21] = 0.4;\n  params[22] = 1.0; params[23] = -0.1; params[24] = 0.4; params[25] = 0.5;\n  params[26] = 0.5; params[27] = 0.5; params[28] = 0.25;\n  params[29] = 0.03; params[30] = 0.7; params[31] = 0.1; params[32] = 0.5; params[33] = 0.15; params[34] = 0.3;\n  params[35] = 0.6; params[36] = 0.25; params[37] = 0.25; params[38] = 0.08; params[39] = 0.5;\n  params[40] = 0.04; params[41] = 0.6; params[42] = 0.65; params[43] = 0.45;\n  params[P_FLAGS] = 5.0; params[P_BAL] = 0.5; params[P_S2COARSE] = 0.0; params[P_S2DET] = 0.08;\n  params[P_MTUNE] = 0.0; params[P_PORTA] = 0.0; params[P_PENV] = 0.0; params[P_PENVR] = 0.4;\n  params[P_LFORATE] = 0.35; params[P_LFOSHP] = 0.0; params[P_LFODEP] = 0.1; params[P_LFODST] = 1.0;\n  params[P_DDFKT] = 0.4; params[P_BENDR] = 2.0; params[P_PWHEEL] = 0.0; params[P_MODWHL] = 0.0;\n  params[P_AT] = 0.0; params[P_VOL] = 0.7;\n}\n\nexport function getInputPtr(): usize  { return changetype<usize>(inBuf); }\nexport function getOutputPtr(): usize { return changetype<usize>(outBuf); }\nexport function getParamsPtr(): usize { return changetype<usize>(params); }\nexport function getNumParams(): i32   { return 64; }\n\n// ---- glide -----------------------------------------------------------\nfunction computeGlideK(v: i32): void {\n  const porta: f32 = clampf(pget(P_PORTA), 0.0, 1.0);\n  vGlideK[v] = 1.0;\n  if (porta <= 0.0) { vCur[v] = vTarget[v]; return; }\n  if (vCur[v] <= 0.0) vCur[v] = vTarget[v];\n  if (vCur[v] == vTarget[v]) return;\n  const t: f32 = 0.005 + porta * porta * 3.0; // 5 ms .. 3 s\n  const nSmp: f32 = t * sampleRate;\n  const ratio: f32 = vTarget[v] / vCur[v];\n  vGlideK[v] = Mathf.pow(ratio, 1.0 / nSmp);\n}\n\nfunction allocVoice(): i32 {\n  for (let i = 0; i < NUM_VOICES; i++) if (vActive[i] == 0) return i;\n  let oldest: i32 = 0; let oa: i32 = vAge[0];\n  for (let i = 1; i < NUM_VOICES; i++) if (vAge[i] < oa) { oa = vAge[i]; oldest = i; }\n  return oldest;\n}\n\nexport function noteOn(id: i32, hz: f32, vel: f32): void {\n  if (hz <= 0.0) return;\n  const slot: i32 = allocVoice();\n  vNote[slot] = id;\n  vTarget[slot] = hz;\n  vCur[slot] = lastPlayedHz;\n  computeGlideK(slot);\n  vActive[slot] = 1; vGate[slot] = 1;\n  vVel[slot] = clampf(vel, 0.0, 1.0);\n  vAge[slot] = ageCounter++;\n  vPh1[slot] = 0.0; vPh2[slot] = 0.37;\n  vPEnv[slot] = 1.0;\n  for (let s = 0; s < 2; s++) {\n    vDda[s * NUM_VOICES + slot] = 0.0; vDdaSt[s * NUM_VOICES + slot] = 1;\n    vDdf[s * NUM_VOICES + slot] = 0.0; vDdfSt[s * NUM_VOICES + slot] = 1;\n  }\n  for (let b = 0; b < 6; b++) { vBand[b * NUM_VOICES + slot] = 0.0; vBandSt[b * NUM_VOICES + slot] = 0; }\n  lastPlayedHz = hz;\n}\n\nexport function noteOff(id: i32): void {\n  if (id < 0) return;\n  for (let i = 0; i < NUM_VOICES; i++) {\n    if (vActive[i] == 1 && vGate[i] == 1 && vNote[i] == id) {\n      vGate[i] = 0;\n      vDdaSt[0 * NUM_VOICES + i] = 4; vDdaSt[1 * NUM_VOICES + i] = 4;\n    }\n  }\n}\n\n// ---- LFO -------------------------------------------------------------\nfunction lfoShapeVal(shp: i32, ph: f32): f32 {\n  if (shp == 0) return ph < 0.5 ? ph * 4.0 - 1.0 : 3.0 - ph * 4.0; // triangle\n  if (shp == 1) return 1.0 - ph * 2.0;   // saw down\n  if (shp == 2) return ph * 2.0 - 1.0;   // ramp up\n  if (shp == 3) return ph < 0.5 ? 1.0 : -1.0; // square\n  return lfoSH;                          // random S&H\n}\n\n// ---- build the global base spectra (control rate) --------------------\nfunction buildBase(src: i32, dst: StaticArray<f32>, extraTilt: f32, extraForm: f32): void {\n  const base: i32 = src * SRC_STRIDE;\n  const prof: i32 = pbits(base + PB_PROFILE);\n  let tilt: f32 = clampf(pget(base + PB_TILT) + extraTilt, -1.5, 1.5);\n  const oe: f32 = clampf(pget(base + PB_ODDEVEN), -1.0, 1.0);\n  const dens: f32 = clampf(pget(base + PB_DENSITY), 0.0, 1.0);\n  const ffreq: f32 = clampf(pget(base + PB_FFREQ) + extraForm, 0.0, 1.0);\n  const fwid: f32 = clampf(pget(base + PB_FWID), 0.0, 1.0);\n  const famt: f32 = clampf(pget(base + PB_FAMT), 0.0, 1.0);\n\n  const activeN: f32 = 2.0 + dens * f32(NUM_HARM - 2);\n  const peak: f32 = 1.0 + ffreq * f32(NUM_HARM - 1);\n  const sigma: f32 = 1.0 + fwid * 22.0;\n  const twoSig2: f32 = 2.0 * sigma * sigma;\n\n  let sum: f32 = 0.0;\n  for (let i = 0; i < NUM_HARM; i++) {\n    const h: i32 = i + 1;\n    const hf: f32 = f32(h);\n    let a: f32 = 0.0;\n    // ---- seed by profile ----\n    if (prof == 0) {                 // saw 1/n\n      a = 1.0 / hf;\n    } else if (prof == 1) {          // square: odd 1/n\n      a = (h & 1) == 1 ? 1.0 / hf : 0.0;\n    } else if (prof == 2) {          // pulse / buzzy: 1/sqrt(n)\n      a = 1.0 / Mathf.sqrt(hf);\n    } else if (prof == 3) {          // triangle: odd 1/n^2\n      a = (h & 1) == 1 ? 1.0 / (hf * hf) : 0.0;\n    } else if (prof == 4) {          // organ: octaves emphasised\n      const l2: f32 = Mathf.log2(hf);\n      const isPow2: bool = (h & (h - 1)) == 0;\n      a = isPow2 ? 1.0 / (1.0 + l2) : 0.08 / hf;\n    } else {                         // resonant: 1/n with an inherent mid peak\n      a = (1.0 / hf) * (1.0 + 3.0 * Mathf.exp(-((hf - 6.0) * (hf - 6.0)) / 10.0));\n    }\n    // ---- spectral tilt (brightness slope) ----\n    a *= Mathf.pow(hf, tilt * 1.5);\n    // ---- odd/even balance ----\n    if ((h & 1) == 1) a *= clampf(1.0 + oe, 0.0, 2.0);\n    else              a *= clampf(1.0 - oe, 0.0, 2.0);\n    // ---- density taper ----\n    const taper: f32 = clampf(activeN - hf + 1.0, 0.0, 1.0);\n    a *= taper;\n    // ---- formant emphasis (DFT) ----\n    if (famt > 0.0) {\n      const d: f32 = hf - peak;\n      a *= 1.0 + famt * 4.0 * Mathf.exp(-(d * d) / twoSig2);\n    }\n    dst[i] = a;\n    sum += a;\n  }\n  // normalise so overall energy is bounded regardless of macro settings\n  const norm: f32 = 0.9 / (sum > 0.0001 ? sum : 0.0001);\n  for (let i = 0; i < NUM_HARM; i++) dst[i] *= norm;\n}\n\n// spectral low-pass weight for the DDF (harmonic-domain)\n@inline function ddfWeight(h: i32, cutN: f32, reso: f32): f32 {\n  const hf: f32 = f32(h);\n  let w: f32 = hf <= cutN ? 1.0 : Mathf.pow(cutN / hf, 3.5);\n  if (reso > 0.0) {\n    const d: f32 = hf - cutN;\n    w += reso * 1.6 * Mathf.exp(-(d * d) / 6.0);\n  }\n  return w;\n}\n\n// control-rate update for one active voice\nfunction updateVoice(v: i32, dt: f32): void {\n  const kt: i32 = (pbits(P_FLAGS) >> 2) & 1;\n  const ktAmt: f32 = clampf(pget(P_DDFKT), 0.0, 1.0);\n  const at: f32 = clampf(pget(P_AT), 0.0, 1.0);\n  const f0: f32 = vCur[v];\n  // keyboard-scaling factor for DDF cutoff (relative to a 261 Hz reference)\n  let ktShift: f32 = 0.0;\n  if (kt == 1) ktShift = ktAmt * (Mathf.log2(f0 / 261.63)) * 12.0; // harmonics of shift\n\n  for (let s = 0; s < 2; s++) {\n    const base: i32 = s * SRC_STRIDE;\n    const si: i32 = s * NUM_VOICES + v;\n    // --- DDA (ADSR) ---\n    let de: f32 = vDda[si]; let dst: i32 = vDdaSt[si];\n    const aT: f32 = envTime(pget(base + PB_DDAA));\n    const dT: f32 = envTime(pget(base + PB_DDAD));\n    const sL: f32 = clampf(pget(base + PB_DDAS), 0.0, 1.0);\n    const rT: f32 = envTime(pget(base + PB_DDAR));\n    if (dst == 1) { de += dt / aT; if (de >= 1.0) { de = 1.0; dst = 2; } }\n    else if (dst == 2) { de += (sL - de) * (1.0 - Mathf.exp(-dt * 5.0 / dT)); if (Mathf.abs(de - sL) < 0.001) dst = 3; }\n    else if (dst == 3) { de = sL; }\n    else if (dst == 4) { de += (0.0 - de) * (1.0 - Mathf.exp(-dt * 5.0 / rT)); }\n    vDda[si] = de; vDdaSt[si] = dst;\n    // --- DDF envelope (AD) ---\n    let fe: f32 = vDdf[si]; let fst: i32 = vDdfSt[si];\n    const faT: f32 = envTime(pget(base + PB_DDFA));\n    const fdT: f32 = envTime(pget(base + PB_DDFD));\n    if (fst == 1) { fe += dt / faT; if (fe >= 1.0) { fe = 1.0; fst = 2; } }\n    else if (fst == 2) { fe += (0.0 - fe) * (1.0 - Mathf.exp(-dt * 5.0 / fdT)); }\n    vDdf[si] = fe; vDdfSt[si] = fst;\n    // --- band envelopes (3) ---\n    for (let b = 0; b < 3; b++) {\n      const bi: i32 = (s * 3 + b) * NUM_VOICES + v;\n      let be: f32 = vBand[bi]; let bst: i32 = vBandSt[bi];\n      const baT: f32 = envTime(pget(base + PB_LOA + b * 2));\n      const bdT: f32 = envTime(pget(base + PB_LOD + b * 2));\n      if (bst == 0) { be += dt / baT; if (be >= 1.0) { be = 1.0; bst = 1; } }\n      else { be += (0.2 - be) * (1.0 - Mathf.exp(-dt * 4.0 / bdT)); } // decay to floor\n      vBand[bi] = be; vBandSt[bi] = bst;\n    }\n    // --- DDF cutoff (harmonic index) with env + keytrack + pressure ---\n    const cutKnob: f32 = clampf(pget(base + PB_DDFCUT), 0.0, 1.0);\n    const reso: f32 = clampf(pget(base + PB_DDFRES), 0.0, 1.0);\n    const envAmt: f32 = clampf(pget(base + PB_DDFENV), -1.0, 1.0);\n    let cutN: f32 = 1.0 + cutKnob * f32(NUM_HARM - 1);\n    cutN *= Mathf.pow(2.0, envAmt * fe * 2.0);       // env sweeps cutoff (±2 oct)\n    cutN *= Mathf.pow(2.0, (ktShift + at * 6.0) / 12.0); // keytrack + aftertouch open\n    if (cutN < 1.0) cutN = 1.0; if (cutN > f32(NUM_HARM)) cutN = f32(NUM_HARM);\n    // --- build effective harmonic amps for this voice/source ---\n    const baseArr: StaticArray<f32> = s == 0 ? baseA1 : baseA2;\n    const dstArr: StaticArray<f32> = s == 0 ? effA1 : effA2;\n    // nyquist harmonic limit for this source's fundamental (S2 may run up to ~2.2x)\n    const srcF0: f32 = s == 0 ? f0 : f0 * 2.2;\n    let maxH: i32 = i32(0.45 * sampleRate / (srcF0 > 1.0 ? srcF0 : 1.0));\n    if (maxH > NUM_HARM) maxH = NUM_HARM; if (maxH < 1) maxH = 1;\n    const bl: f32 = vBand[(s * 3 + 0) * NUM_VOICES + v];\n    const bm: f32 = vBand[(s * 3 + 1) * NUM_VOICES + v];\n    const bh: f32 = vBand[(s * 3 + 2) * NUM_VOICES + v];\n    const off: i32 = v * NUM_HARM;\n    for (let i = 0; i < NUM_HARM; i++) {\n      if (i >= maxH) { dstArr[off + i] = 0.0; continue; }\n      const h: i32 = i + 1;\n      const bandV: f32 = h <= 8 ? bl : (h <= 24 ? bm : bh);\n      dstArr[off + i] = baseArr[i] * bandV * ddfWeight(h, cutN, reso);\n    }\n  }\n}\n\n// ---- process ---------------------------------------------------------\nexport function process(n: i32): void {\n  const sr: f32 = sampleRate;\n  const dtCtrl: f32 = f32(CTRL) / sr;\n\n  // performance / global reads\n  const flags: i32 = pbits(P_FLAGS);\n  const full: i32 = flags & 1;\n  const keysync: i32 = (flags >> 1) & 1;\n  const bal: f32 = clampf(pget(P_BAL), 0.0, 1.0);\n  const gS1: f32 = Mathf.sqrt(1.0 - bal);\n  const gS2: f32 = Mathf.sqrt(bal);\n  const s2coarse: f32 = pget(P_S2COARSE);\n  const s2det: f32 = clampf(pget(P_S2DET), -1.0, 1.0);\n  const mtune: f32 = clampf(pget(P_MTUNE), -1.0, 1.0);\n  const penvAmt: f32 = clampf(pget(P_PENV), -1.0, 1.0);\n  const penvRate: f32 = clampf(pget(P_PENVR), 0.0, 1.0);\n  const lfoRate: f32 = clampf(pget(P_LFORATE), 0.0, 1.0);\n  const lfoShp: i32 = pbits(P_LFOSHP);\n  const lfoDep: f32 = clampf(pget(P_LFODEP), 0.0, 1.0);\n  const lfoDst: i32 = pbits(P_LFODST);\n  const bendR: f32 = clampf(pget(P_BENDR), 0.0, 12.0);\n  const pw: f32 = clampf(pget(P_PWHEEL), -1.0, 1.0);\n  const modw: f32 = clampf(pget(P_MODWHL), 0.0, 1.0);\n  const at: f32 = clampf(pget(P_AT), 0.0, 1.0);\n  const vol: f32 = clampf(pget(P_VOL), 0.0, 1.0);\n\n  // pitch multiplier common to all voices this block\n  const bendRatio: f32 = Mathf.pow(2.0, pw * bendR / 12.0);\n  const mtuneRatio: f32 = Mathf.pow(2.0, mtune / 12.0);\n  const s2Ratio: f32 = Mathf.pow(2.0, s2coarse / 12.0) * Mathf.pow(2.0, s2det * 50.0 / 1200.0) * (full == 1 ? 2.0 : 1.0);\n\n  const lfoInc: f32 = (0.03 + lfoRate * lfoRate * 24.0) / sr; // 0.03 .. ~24 Hz\n  const penvDecay: f32 = 1.0 - Mathf.exp(-dtCtrl * 4.0 / envTime(penvRate));\n\n  let ctrlCount: i32 = 0;\n\n  for (let i = 0; i < n; i++) {\n    // ---- control-rate updates ----\n    if (ctrlCount == 0) {\n      // advance LFO at control rate\n      lfoPhase += lfoInc * f32(CTRL);\n      if (lfoPhase >= 1.0) {\n        lfoPhase -= 1.0;\n        lfoSH = rngf();\n        if (keysync == 1) { /* retrig handled on noteOn only; keysync flag kept */ }\n      }\n      lfoPos = lfoPhase;\n      lfoVal = lfoShapeVal(lfoShp, lfoPhase);\n\n      // LFO → spectrum / formant folded into base spectra\n      const specMod: f32 = (lfoDst & 2) != 0 ? lfoVal * lfoDep * 0.8 : 0.0;\n      const formMod: f32 = (lfoDst & 8) != 0 ? lfoVal * lfoDep * 0.3 : 0.0;\n      const presTilt: f32 = at * 0.6; // aftertouch brightens\n      buildBase(0, baseA1, specMod + presTilt, formMod);\n      buildBase(1, baseA2, specMod + presTilt, formMod);\n\n      for (let v = 0; v < NUM_VOICES; v++) {\n        if (vActive[v] == 0) continue;\n        // pitch env decays 1 -> 0\n        vPEnv[v] += (0.0 - vPEnv[v]) * penvDecay;\n        updateVoice(v, dtCtrl);\n        // deactivate when both DDA released & silent\n        if (vGate[v] == 0) {\n          const d0: f32 = vDda[0 * NUM_VOICES + v];\n          const d1: f32 = vDda[1 * NUM_VOICES + v];\n          if (vDdaSt[0 * NUM_VOICES + v] == 4 && vDdaSt[1 * NUM_VOICES + v] == 4 && d0 < 0.0008 && d1 < 0.0008)\n            vActive[v] = 0;\n        }\n      }\n    }\n    ctrlCount++; if (ctrlCount >= CTRL) ctrlCount = 0;\n\n    // ---- per-sample synthesis ----\n    let outL: f32 = 0.0;\n    const vibDepth: f32 = lfoDep + modw * 0.6;\n    const pitchLfo: f32 = (lfoDst & 1) != 0 ? Mathf.pow(2.0, lfoVal * vibDepth * 2.0 / 12.0) : Mathf.pow(2.0, lfoVal * modw * 0.6 * 2.0 / 12.0);\n    const ampLfo: f32 = (lfoDst & 4) != 0 ? (1.0 - lfoDep * 0.5 * (0.5 + 0.5 * lfoVal)) : 1.0;\n\n    for (let v = 0; v < NUM_VOICES; v++) {\n      if (vActive[v] == 0) continue;\n      // glide\n      if (vGlideK[v] != 1.0) {\n        vCur[v] *= vGlideK[v];\n        if ((vGlideK[v] > 1.0 && vCur[v] >= vTarget[v]) || (vGlideK[v] < 1.0 && vCur[v] <= vTarget[v])) {\n          vCur[v] = vTarget[v]; vGlideK[v] = 1.0;\n        }\n      }\n      const pEnvRatio: f32 = Mathf.pow(2.0, penvAmt * vPEnv[v] * 24.0 / 12.0);\n      const f0: f32 = vCur[v] * mtuneRatio * bendRatio * pitchLfo * pEnvRatio;\n      const f1: f32 = f0;\n      const f2: f32 = f0 * s2Ratio;\n\n      // S1 harmonic sum via complex recurrence\n      const off: i32 = v * NUM_HARM;\n      let ph1: f32 = vPh1[v] + f1 / sr; ph1 -= Mathf.floor(ph1); vPh1[v] = ph1;\n      const a1: f32 = TWO_PI * ph1;\n      const c1: f32 = Mathf.cos(a1); const s1: f32 = Mathf.sin(a1);\n      let ch: f32 = c1; let sh: f32 = s1;\n      let acc1: f32 = effA1[off] * sh;\n      for (let h = 2; h <= NUM_HARM; h++) {\n        const nc: f32 = ch * c1 - sh * s1;\n        const ns: f32 = sh * c1 + ch * s1;\n        ch = nc; sh = ns;\n        acc1 += effA1[off + h - 1] * sh;\n      }\n      // S2 harmonic sum\n      let ph2: f32 = vPh2[v] + f2 / sr; ph2 -= Mathf.floor(ph2); vPh2[v] = ph2;\n      const a2: f32 = TWO_PI * ph2;\n      const c2: f32 = Mathf.cos(a2); const s2v: f32 = Mathf.sin(a2);\n      ch = c2; sh = s2v;\n      let acc2: f32 = effA2[off] * sh;\n      for (let h = 2; h <= NUM_HARM; h++) {\n        const nc: f32 = ch * c2 - sh * s2v;\n        const ns: f32 = sh * c2 + ch * s2v;\n        ch = nc; sh = ns;\n        acc2 += effA2[off + h - 1] * sh;\n      }\n      const e1: f32 = vDda[0 * NUM_VOICES + v];\n      const e2: f32 = vDda[1 * NUM_VOICES + v];\n      outL += acc1 * e1 * gS1 + acc2 * e2 * gS2;\n    }\n\n    outL *= ampLfo;\n    // master gain + soft clip\n    let s: f32 = outL * (vol * vol * 2.2);\n    s = Mathf.tanh(s);\n    outBuf[i] = s;\n    outBuf[MAX_FRAMES + i] = s;\n  }\n}\n",
  "publishedAt": 1751500800000
}