{
  "format": 1,
  "name": "Bit Crusher",
  "isInstrument": false,
  "explanation": "A lo-fi digital degrader that quantizes the signal to a variable bit depth and decimates it with a sample-and-hold to a lower effective sample rate, producing grit and aliasing. Controls: Bits, Downsample, Mix and Level.",
  "params": [
    {
      "name": "Bits",
      "index": 0,
      "min": 0,
      "max": 1,
      "default": 0.5
    },
    {
      "name": "Downsample",
      "index": 1,
      "min": 0,
      "max": 1,
      "default": 0.3
    },
    {
      "name": "Mix",
      "index": 2,
      "min": 0,
      "max": 1,
      "default": 1
    },
    {
      "name": "Level",
      "index": 3,
      "min": 0,
      "max": 1,
      "default": 0.7
    }
  ],
  "wasmBase64": "",
  "html": "<!doctype html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>\n/* ============================================================\n   BIT CRUSHER — 8-bit pixel-art lo-fi degrader.\n   Everything is built on a chunky pixel grid: blocky sliders,\n   a real-time quantized waveform canvas, dithered shadows,\n   scanlines, and a retro-game palette. No external assets.\n   ============================================================ */\n:root{\n  --ac:#7cff6b;        /* spec accent  */\n  --ac2:#b0ff9a;       /* spec accent2 */\n  --mag:#ff4ec7;       /* retro magenta accent for contrast */\n  --cyan:#3ad6ff;\n  --px:4px;            /* base pixel unit */\n  --ink:#0a160c;\n  --paper:#0d1a10;\n}\n*{box-sizing:border-box;margin:0;padding:0}\nhtml,body{height:100%}\nbody{\n  font-family:ui-monospace,\"Courier New\",monospace;\n  color:var(--ac2);\n  background:\n    /* dither field */\n    repeating-conic-gradient(#091308 0% 25%,#0b1a0d 0% 50%) 0 0/8px 8px,\n    radial-gradient(120% 90% at 50% -10%,#13301a 0%,#08130b 60%,#040906 100%);\n  display:flex;align-items:center;justify-content:center;\n  padding:18px;min-height:100vh;\n  image-rendering:pixelated;\n  -webkit-font-smoothing:none;\n}\n\n/* ---- the cabinet ------------------------------------------ */\n.cab{\n  position:relative;width:100%;max-width:540px;\n  background:linear-gradient(180deg,#10241410,#0a150c);\n  /* hard pixel border drawn with stacked box-shadows */\n  border:var(--px) solid #06100a;\n  box-shadow:\n    0 0 0 var(--px) #1d3d24,\n    0 0 0 calc(var(--px)*2) #06100a,\n    0 0 0 calc(var(--px)*3) #0c1f12,\n    calc(var(--px)*2) calc(var(--px)*2) 0 calc(var(--px)*2) #020604,\n    0 22px 60px rgba(0,0,0,.7);\n  padding:18px 18px 16px;\n  animation:boot .5s steps(4) both;\n}\n@keyframes boot{from{opacity:0;transform:translateY(8px) scale(.985)}to{opacity:1;transform:none}}\n\n/* scanline + flicker overlay */\n.cab::after{\n  content:\"\";position:absolute;inset:0;pointer-events:none;z-index:9;\n  background:repeating-linear-gradient(0deg,rgba(0,0,0,.22) 0 1px,transparent 1px 3px);\n  mix-blend-mode:multiply;animation:flick 5.5s steps(30) infinite;\n}\n@keyframes flick{0%,97%,100%{opacity:.55}98%{opacity:.38}99%{opacity:.62}}\n\n/* ---- title bar -------------------------------------------- */\n.head{display:flex;align-items:center;gap:10px;margin-bottom:14px}\n.logo{display:flex;flex-direction:column;line-height:1}\n.logo b{\n  font-size:21px;font-weight:800;letter-spacing:2px;text-transform:uppercase;\n  color:var(--ac);\n  text-shadow:var(--px) var(--px) 0 #063b1a, calc(var(--px)*2) calc(var(--px)*2) 0 #021c0c;\n  font-family:ui-monospace,monospace;\n}\n.logo b i{font-style:normal;color:var(--mag);text-shadow:var(--px) var(--px) 0 #4a0033}\n.logo small{font-size:9px;letter-spacing:4px;color:#4f8a5f;margin-top:5px}\n.pwr{margin-left:auto;display:flex;align-items:center;gap:7px;font-size:9px;letter-spacing:2px;color:#3f7a4f}\n.led{width:9px;height:9px;background:var(--ac);box-shadow:0 0 8px var(--ac),0 0 0 2px #063b1a;animation:blip 1.1s steps(2) infinite}\n@keyframes blip{0%,49%{opacity:1}50%,100%{opacity:.25}}\n\n/* ---- the crush display (waveform) ------------------------- */\n.screen{\n  position:relative;background:#020a05;\n  border:var(--px) solid #0a2914;\n  box-shadow:inset 0 0 0 2px #05130a, inset 0 0 26px rgba(0,40,10,.8);\n  padding:0;margin-bottom:14px;overflow:hidden;\n}\n.screen canvas{display:block;width:100%;height:118px;image-rendering:pixelated}\n/* readout chips over the screen */\n.hud{position:absolute;top:6px;left:7px;right:7px;display:flex;justify-content:space-between;\n  font-size:9px;letter-spacing:1px;color:#2fbf57;pointer-events:none;z-index:3;text-shadow:0 0 4px #0a3}\n.hud .r{color:var(--mag);text-shadow:0 0 4px #f0a}\n.crt-glow{position:absolute;inset:0;pointer-events:none;z-index:2;\n  background:radial-gradient(120% 80% at 50% 40%,transparent 55%,rgba(0,0,0,.55));}\n\n/* ---- control rack ----------------------------------------- */\n.rack{display:grid;grid-template-columns:1fr 1fr;gap:11px}\n.slot{\n  position:relative;background:#0a1810;\n  border:var(--px) solid #06100a;\n  box-shadow:inset 0 0 0 2px #102a18, inset 0 calc(var(--px)*-1) 0 #061309, 0 var(--px) 0 #03080500;\n  padding:9px 10px 10px;\n  animation:popin .45s steps(5) both;\n}\n.slot:nth-child(1){animation-delay:.05s}\n.slot:nth-child(2){animation-delay:.10s}\n.slot:nth-child(3){animation-delay:.15s}\n.slot:nth-child(4){animation-delay:.20s}\n@keyframes popin{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}\n.slot .top{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:8px}\n.slot .nm{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:#76c98a}\n.slot .vl{font-size:13px;font-weight:800;color:var(--ac);font-variant-numeric:tabular-nums;\n  text-shadow:0 0 6px rgba(124,255,107,.5)}\n.slot.drag{box-shadow:inset 0 0 0 2px var(--ac), inset 0 0 14px rgba(124,255,107,.25)}\n.slot.drag .nm{color:var(--ac2)}\n\n/* the BLOCKY pixel meter — a row of stacked LED bars the user drags */\n.meter{\n  position:relative;height:54px;cursor:ns-resize;user-select:none;touch-action:none;\n  background:\n    repeating-linear-gradient(90deg,#04100800 0 0),\n    #030c06;\n  border:2px solid #06120a;\n  box-shadow:inset 2px 2px 0 #02080500, inset 0 0 0 0 #000;\n  display:flex;align-items:flex-end;gap:2px;padding:3px;overflow:hidden;\n}\n/* segmented light columns (drawn purely in CSS, animated) */\n.meter .col{flex:1;display:flex;flex-direction:column-reverse;gap:2px;height:100%}\n.meter .col i{\n  display:block;flex:1;background:#0a1d10;border-radius:0;\n  box-shadow:inset 0 0 0 1px #04100800;transition:background .05s steps(2),box-shadow .05s;\n}\n.meter .col i.on{background:linear-gradient(180deg,var(--ac2),var(--ac));\n  box-shadow:0 0 6px rgba(124,255,107,.7),inset 0 0 0 1px #d6ffce}\n.meter .col i.hot{background:linear-gradient(180deg,#fff,var(--ac))}\n/* sweep glint */\n.meter::after{content:\"\";position:absolute;top:0;bottom:0;width:30%;left:-30%;z-index:4;pointer-events:none;\n  background:linear-gradient(90deg,transparent,rgba(180,255,154,.10),transparent);\n  animation:sweep 3.4s steps(20) infinite}\n@keyframes sweep{to{left:130%}}\n\n.hint{margin-top:11px;font-size:8.5px;letter-spacing:2px;color:#3f7a4f;text-align:center;\n  text-transform:uppercase}\n.hint b{color:var(--mag)}\n\n/* pixel grain pulse on the whole rack accent */\n@keyframes glitch{0%,92%,100%{transform:translate(0,0)}93%{transform:translate(-1px,0)}94%{transform:translate(1px,0)}95%{transform:translate(0,-1px)}}\n.logo b{animation:glitch 4s steps(1) infinite}\n</style>\n</head>\n<body>\n<div class=\"cab\">\n  <div class=\"head\">\n    <div class=\"logo\">\n      <b>BIT<i>CRUSH</i></b>\n      <small>8-BIT LO-FI DEGRADER</small>\n    </div>\n    <div class=\"pwr\"><span>SIG</span><span class=\"led\"></span></div>\n  </div>\n\n  <div class=\"screen\">\n    <div class=\"hud\"><span id=\"hudL\">DEPTH ·· bit</span><span class=\"r\" id=\"hudR\">SR ··· %</span></div>\n    <canvas id=\"scope\" width=\"256\" height=\"118\"></canvas>\n    <div class=\"crt-glow\"></div>\n  </div>\n\n  <div class=\"rack\" id=\"rack\"></div>\n\n  <div class=\"hint\">DRAG ▲▼ &nbsp;·&nbsp; <b>DOUBLE-CLICK</b> TO RESET &nbsp;·&nbsp; WHEEL FINE</div>\n</div>\n\n<script>\n(function(){\n  /* ---- params: re-read from spec (index/min/max/default) ---- */\n  var PARAMS=[\n    {name:\"Bits\",       index:0, min:0, max:1, def:0.5},\n    {name:\"Downsample\", index:1, min:0, max:1, def:0.3},\n    {name:\"Mix\",        index:2, min:0, max:1, def:1.0},\n    {name:\"Level\",      index:3, min:0, max:1, def:0.7}\n  ];\n  var COLS=14, ROWS=8;          /* meter pixel grid */\n  var state={};                 /* index -> value  */\n\n  function host(i,v){ if(window.vstai&&window.vstai.setParam) window.vstai.setParam(i,v); }\n\n  /* humanised display: Bits/Downsample as their musical meaning */\n  function fmt(p,v){\n    if(p.name===\"Bits\")       return (1+v*15).toFixed(1)+\" bit\";\n    if(p.name===\"Downsample\") return Math.round(v*100)+\" %\";\n    return Math.round(v*100)+\" %\";\n  }\n\n  var rack=document.getElementById('rack');\n  PARAMS.forEach(function(p){\n    state[p.index]=p.def;\n    var slot=document.createElement('div'); slot.className='slot';\n    slot.innerHTML='<div class=\"top\"><span class=\"nm\">'+p.name+'</span><span class=\"vl\"></span></div>'+\n                   '<div class=\"meter\"></div>';\n    var meter=slot.querySelector('.meter'), vl=slot.querySelector('.vl');\n    /* build column grid */\n    var cells=[];\n    for(var c=0;c<COLS;c++){\n      var col=document.createElement('div'); col.className='col';\n      var rowEls=[];\n      for(var r=0;r<ROWS;r++){ var i=document.createElement('i'); col.appendChild(i); rowEls.push(i); }\n      meter.appendChild(col); cells.push(rowEls);\n    }\n\n    function norm(){ return (state[p.index]-p.min)/(p.max-p.min||1); }\n    function paint(){\n      var n=norm();\n      vl.textContent=fmt(p,state[p.index]);\n      /* fill a staircase: each column lit up to n, with a little jitter for life */\n      var lit=n*ROWS;\n      for(var c=0;c<COLS;c++){\n        var h=lit;                                   // height in rows for this col\n        for(var r=0;r<ROWS;r++){\n          var el=cells[c][r];\n          var onF=(r<Math.floor(h));\n          var topRow=(r===Math.floor(h)&&(h-Math.floor(h))>0.001);\n          el.className = onF? 'on' : (topRow?'on hot':'');\n        }\n      }\n      host(p.index, state[p.index]);\n    }\n    function setN(n){ n=n<0?0:(n>1?1:n); state[p.index]=p.min+(p.max-p.min)*n; paint(); }\n\n    var dragN=0, dragY=0, active=false;\n    meter.addEventListener('pointerdown',function(e){\n      active=true; dragY=e.clientY; dragN=norm(); slot.classList.add('drag');\n      meter.setPointerCapture(e.pointerId); e.preventDefault();\n    });\n    meter.addEventListener('pointermove',function(e){\n      if(!active) return; setN(dragN+(dragY-e.clientY)/150);\n    });\n    function end(){ active=false; slot.classList.remove('drag'); }\n    meter.addEventListener('pointerup',end);\n    meter.addEventListener('pointercancel',end);\n    meter.addEventListener('dblclick',function(){ state[p.index]=p.def; paint(); });\n    meter.addEventListener('wheel',function(e){ e.preventDefault();\n      setN(norm()+(e.deltaY<0?0.02:-0.02)); },{passive:false});\n\n    p._paint=paint;\n    rack.appendChild(slot);\n  });\n\n  /* ===================================================================\n     LIVE CRUSH SCOPE — draws a sine that is quantized (Bits) and\n     sample-held (Downsample), Mix blends crushed vs clean, Level scales.\n     Pure rAF, blocky pixel rendering. This visually IS the effect.\n     =================================================================== */\n  var cv=document.getElementById('scope'), g=cv.getContext('2d');\n  var W=cv.width, H=cv.height, t=0;\n  var hudL=document.getElementById('hudL'), hudR=document.getElementById('hudR');\n\n  function px(){ return Math.max(2, Math.round(W/64)); } // chunky sample block width\n\n  function frame(){\n    requestAnimationFrame(frame);\n    t+=0.045;\n    var bits=state[0], ds=state[1], mix=state[2], lvl=state[3];\n\n    /* map controls to crusher params (mirrors the DSP description) */\n    var depth = 1 + bits*15;                 // 1..16 bit\n    var levels = Math.pow(2, depth);\n    var hold = 1 + Math.round(ds*22);        // sample-hold span in px-blocks\n    hudL.textContent='DEPTH '+depth.toFixed(1)+' bit';\n    hudR.textContent='SR '+Math.round((1-ds*0.94)*100)+' %';\n\n    g.clearRect(0,0,W,H);\n    /* faint grid */\n    g.strokeStyle='rgba(40,150,70,.10)'; g.lineWidth=1;\n    for(var x=0;x<=W;x+=px()*2){ g.beginPath(); g.moveTo(x+.5,0); g.lineTo(x+.5,H); g.stroke(); }\n    g.beginPath(); g.moveTo(0,H/2+.5); g.lineTo(W,H/2+.5);\n    g.strokeStyle='rgba(40,150,70,.18)'; g.stroke();\n\n    var bw=px();\n    var heldVal=0, heldClean=0, holdCount=0;\n    for(var i=0;i<W;i+=bw){\n      var phase=(i/W)*Math.PI*4 + t;\n      var clean=Math.sin(phase)*0.5 + Math.sin(phase*2)*0.18; // a touch of harmonic\n      clean=Math.max(-1,Math.min(1,clean));\n      /* sample-and-hold (downsample) */\n      if(holdCount<=0){ heldClean=clean; holdCount=hold; }\n      holdCount--;\n      var s=heldClean;\n      /* bit quantize */\n      var q=Math.round((s*0.5+0.5)*(levels-1))/(levels-1)*2-1;\n      /* mix crushed vs clean, then level */\n      var outV=(q*mix + clean*(1-mix))*lvl;\n\n      /* draw clean ghost (thin, dim) */\n      var yC=H/2 - clean*H*0.40;\n      g.fillStyle='rgba(58,214,255,.20)';\n      g.fillRect(i, Math.round(yC), bw-1, 2);\n\n      /* draw the crushed BLOCK */\n      var yQ=H/2 - outV*H*0.40;\n      var top=Math.min(H/2,yQ), bot=Math.max(H/2,yQ);\n      var grad=outV>=0?'rgba(124,255,107,':'rgba(255,78,199,';\n      g.fillStyle=grad+'.18)';\n      g.fillRect(i, top, bw-1, Math.max(1,bot-top));        // vertical column\n      g.fillStyle=grad+'1)';\n      g.fillRect(i, Math.round(yQ)-1, bw-1, 3);             // bright cap\n    }\n\n    /* quantization rungs (horizontal levels) — denser when more bits */\n    if(depth<8.5){\n      var visLevels=Math.min(levels,32);\n      g.strokeStyle='rgba(124,255,107,.07)';\n      for(var L=0;L<=visLevels;L++){\n        var yy=H/2 - ((L/visLevels)*2-1)*H*0.40;\n        g.beginPath(); g.moveTo(0,yy+.5); g.lineTo(W,yy+.5); g.stroke();\n      }\n    }\n  }\n  requestAnimationFrame(frame);\n\n  /* ---- host handshake: paint defaults & push every param ---- */\n  function ready(){\n    PARAMS.forEach(function(p){ p._paint(); });\n    // Follow param changes from outside the GUI — session restore, preset load, DAW\n    // automation. The host replays the restored values here right after we register,\n    // so every meter repaints to the saved sound instead of its default.\n    if(window.vstai&&window.vstai.onParam) window.vstai.onParam(function(i,v){\n      for(var k=0;k<PARAMS.length;k++){ if(PARAMS[k].index===i){ state[i]=+v; PARAMS[k]._paint(); break; } }\n    });\n  }\n  if(window.vstai&&window.vstai.onReady) window.vstai.onReady(ready); else ready();\n})();\n</script>\n<script data-vstai-sound-bar>\n(function () {\n  if (window.__vstaiSoundBarBuilt) return;\n  var POS_KEY = 'vstai.soundBar.pos', MIN_KEY = 'vstai.soundBar.min';\n  var tries = 0;\n\n  function store(k, v) { try { if (v == null) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) {} return null; }\n\n  function ready() {\n    var V = window.vstai;\n    return V && V.presets && typeof V.openBrowser === 'function' && typeof V.saveSound === 'function';\n  }\n\n  function boot() {\n    if (window.__vstaiSoundBarBuilt) return;\n    if (window.__vstaiNativeSoundBar) return;                       // the host draws its own bar\n    if (!ready()) { if (++tries < 40) setTimeout(boot, 150); return; }\n    if (document.querySelector('[data-vstai-sound]')) return;       // the GUI has its own control\n    window.__vstaiSoundBarBuilt = true;\n    build(window.vstai);\n  }\n\n  function build(V) {\n    var host = document.createElement('div');\n    host.id = 'vstai-sound-bar';\n    host.setAttribute('data-vstai-sound-bar-host', '');\n    host.style.cssText = 'position:fixed;top:8px;right:8px;z-index:2147483000;margin:0;padding:0;border:0';\n    var root = host.attachShadow({ mode: 'open' });\n    var css = document.createElement('style');\n    css.textContent = [\n      ':host{all:initial}*{box-sizing:border-box}',\n      '.bar{display:flex;align-items:center;gap:1px;height:26px;padding:0 3px;border-radius:13px;',\n      ' background:rgba(14,18,24,.86);border:1px solid rgba(255,255,255,.2);box-shadow:0 2px 10px rgba(0,0,0,.45);',\n      ' color:#e6e9ee;font:11px/1 -apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,sans-serif;',\n      ' opacity:.62;transition:opacity .12s;user-select:none;-webkit-user-select:none}',\n      '.bar:hover,.bar.drag{opacity:1}',\n      'button{font:inherit;color:inherit;background:transparent;border:0;border-radius:10px;height:20px;min-width:20px;padding:0 5px;cursor:pointer;line-height:20px}',\n      'button:hover{background:rgba(255,255,255,.14)}button:active{background:rgba(255,255,255,.24)}',\n      '.grip{cursor:grab;min-width:12px;padding:0 3px;color:#8a95a5;letter-spacing:-2px;touch-action:none}.drag .grip{cursor:grabbing}',\n      '.name{max-width:130px;min-width:46px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:center;font-weight:600}',\n      '.save{background:#6fd8bd;color:#06231c;font-weight:700;margin-left:2px}.save:hover{background:#85e3cc}',\n      '.arrow{font-size:15px;padding:0 4px}',\n      '.min .hide{display:none}'\n    ].join('');\n    root.appendChild(css);\n\n    function el(tag, cls, text, title) {\n      var e = document.createElement(tag);\n      if (cls) e.className = cls;\n      if (text != null) e.textContent = text;\n      if (title) e.title = title;\n      if (tag === 'button') e.type = 'button';\n      return e;\n    }\n    var bar = el('div', 'bar');\n    var grip = el('button', 'grip', '⋮⋮', 'Drag to move');\n    var prev = el('button', 'arrow hide', '‹', 'Previous sound');\n    var name = el('button', 'name hide', 'Sounds', 'Browse sounds: types, tags, favorites');\n    var next = el('button', 'arrow hide', '›', 'Next sound');\n    var save = el('button', 'save hide', 'Save', 'Save the current knob positions as a sound');\n    var fold = el('button', 'fold', '–', 'Fold away');\n    [grip, prev, name, next, save, fold].forEach(function (b) { bar.appendChild(b); });\n    root.appendChild(bar);\n\n    // The page behind must keep keyboard focus (typing piano) and never see our pointer traffic.\n    bar.addEventListener('mousedown', function (e) { e.preventDefault(); });\n    ['pointerdown', 'mousedown', 'touchstart', 'click', 'contextmenu'].forEach(function (t) {\n      bar.addEventListener(t, function (e) { e.stopPropagation(); });\n    });\n\n    prev.onclick = function () { V.prevPreset(); };\n    next.onclick = function () { V.nextPreset(); };\n    name.onclick = function () { V.openBrowser(); };\n    save.onclick = function () { V.saveSound(); };\n\n    function setMin(m) {\n      bar.className = 'bar' + (m ? ' min' : '');\n      fold.textContent = m ? '♫' : '–';\n      fold.title = m ? 'Show the sound bar' : 'Fold away';\n      store(MIN_KEY, m ? '1' : '0');\n      clamp();\n    }\n    fold.onclick = function () { setMin(bar.className.indexOf('min') < 0); };\n\n    // ---- position: drag by the grip, remember, keep on screen ----------------\n    function clamp() {\n      var r = host.getBoundingClientRect(), w = window.innerWidth, h = window.innerHeight;\n      var x = Math.min(Math.max(0, r.left), Math.max(0, w - r.width));\n      var y = Math.min(Math.max(0, r.top), Math.max(0, h - r.height));\n      if (host.style.left || host.style.right === 'auto') { host.style.left = x + 'px'; host.style.top = y + 'px'; host.style.right = 'auto'; }\n    }\n    function place(x, y) { host.style.left = x + 'px'; host.style.top = y + 'px'; host.style.right = 'auto'; clamp(); }\n    var drag = null;\n    grip.addEventListener('pointerdown', function (e) {\n      var r = host.getBoundingClientRect();\n      drag = { dx: e.clientX - r.left, dy: e.clientY - r.top };\n      bar.className += ' drag';\n      try { grip.setPointerCapture(e.pointerId); } catch (x) {}\n    });\n    grip.addEventListener('pointermove', function (e) { if (drag) place(e.clientX - drag.dx, e.clientY - drag.dy); });\n    function drop() {\n      if (!drag) return;\n      drag = null; bar.className = bar.className.replace(' drag', '');\n      var r = host.getBoundingClientRect(); store(POS_KEY, Math.round(r.left) + ',' + Math.round(r.top));\n    }\n    grip.addEventListener('pointerup', drop);\n    grip.addEventListener('pointercancel', drop);\n    window.addEventListener('resize', clamp);\n\n    document.documentElement.appendChild(host);\n    setMin(store(MIN_KEY) === '1');\n    var saved = (store(POS_KEY) || '').split(',');\n    if (saved.length === 2 && isFinite(+saved[0]) && isFinite(+saved[1])) place(+saved[0], +saved[1]);\n    else {\n      // No remembered spot: once the GUI has drawn, park the bar where it hides the least.\n      var settle = function () { if (!drag) autoPlace(); };\n      setTimeout(settle, 700); setTimeout(settle, 2500);\n    }\n\n    // The corner / edge whose pill-sized patch is mostly empty background: sample a grid of points and\n    // count how many land on something control-sized (a panel or the page itself counts as background).\n    function autoPlace() {\n      if (store(POS_KEY)) return;\n      var w = window.innerWidth, h = window.innerHeight, r = host.getBoundingClientRect(), bw = r.width, bh = r.height, m = 8;\n      if (!bw || !bh) return;\n      var cand = [[w - bw - m, m], [m, m], [(w - bw) / 2, m], [w - bw - m, h - bh - m], [m, h - bh - m], [(w - bw) / 2, h - bh - m]];\n      var prev = host.style.display; host.style.display = 'none';          // look at the GUI, not at ourselves\n      var best = -1, bestScore = 1e9;\n      for (var c = 0; c < cand.length; c++) {\n        var x0 = cand[c][0], y0 = cand[c][1], score = 0;\n        for (var gx = 0; gx < 8; gx++) for (var gy = 0; gy < 3; gy++) {\n          var e = document.elementFromPoint(x0 + (gx + .5) * bw / 8, y0 + (gy + .5) * bh / 3);\n          if (!e || e === document.body || e === document.documentElement) continue;\n          var b = e.getBoundingClientRect();\n          if (b.width * b.height < .3 * w * h) score++;                        // a control-sized thing is under here\n        }\n        score += c * .01;                                                      // ties keep the earlier (top-right first) choice\n        if (score < bestScore) { bestScore = score; best = c; }\n      }\n      host.style.display = prev;\n      var cur = bestScore;\n      if (best > 0 || cur >= 1) place(cand[best][0], cand[best][1]);\n      host.__placed = best;\n    }\n\n    // ---- the name follows the loaded sound ------------------------------------\n    function show(d) {\n      var n = '';\n      for (var i = 0; i < d.entries.length; i++) if (d.entries[i].id === d.current) n = d.entries[i].name;\n      name.textContent = n || 'Sounds';\n      name.title = n ? n + ' – browse sounds' : 'Browse sounds: types, tags, favorites';\n    }\n    V.presets.onChange(show);\n    V.presets.list().catch(function () {});\n  }\n\n  // Give the GUI time to build itself first: one that makes its own sound control (data-vstai-sound)\n  // does it while loading, and the bar must see that before deciding to show up.\n  function later() { setTimeout(boot, 350); }\n  if (document.readyState === 'complete') later(); else window.addEventListener('load', later);\n})();\n</script>\n</body>\n</html>\n",
  "assembly": "// =====================================================================\n//  BIT CRUSHER — lo-fi bit-depth quantizer + sample-rate decimator\n//  Two classic digital-degradation stages in series: an amplitude\n//  quantizer that rounds the signal to a variable bit depth (1..16),\n//  and a sample-and-hold decimator that drops the effective sample\n//  rate by an integer divisor (1..50) to introduce aliasing/grit.\n//  A dry/wet Mix blends in the clean signal and Level trims output.\n//  Pure algorithm, no samples.\n// =====================================================================\n\nconst MAX_FRAMES: i32 = 8192;\nconst MAX_CHANNELS: i32 = 2;\nconst MAX_PARAMS: i32 = 64;\n\nconst inBuf:  StaticArray<f32> = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\nconst outBuf: StaticArray<f32> = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\nconst params: StaticArray<f32> = new StaticArray<f32>(MAX_PARAMS);\n\nlet sampleRate: f32 = 48000.0;\nlet channels: i32 = 2;\n\n// per-channel decimator state: how many samples since last hold, and the held value\nconst holdCount: StaticArray<f32> = new StaticArray<f32>(MAX_CHANNELS);\nconst holdVal:   StaticArray<f32> = new StaticArray<f32>(MAX_CHANNELS);\n\nconst P_BITS: i32 = 0;        // 0..1 -> bit depth 16..1 (more crush as it rises... see mapping)\nconst P_DOWNSAMPLE: i32 = 1;  // 0..1 -> rate divisor 1..50\nconst P_MIX: i32 = 2;         // 0..1 dry/wet\nconst P_LEVEL: i32 = 3;       // 0..1 -> 0..1.2 output\n\nexport function init(sr: f32, maxFrames: i32, numChannels: i32): void {\n  sampleRate = sr > 0.0 ? sr : 48000.0;\n  channels = numChannels < MAX_CHANNELS ? numChannels : MAX_CHANNELS;\n  for (let c = 0; c < MAX_CHANNELS; c++) { holdCount[c] = 1.0e9; holdVal[c] = 0.0; }\n  params[P_BITS] = 0.5; params[P_DOWNSAMPLE] = 0.3; params[P_MIX] = 1.0; params[P_LEVEL] = 0.7;\n}\n\nexport function getInputPtr(): usize  { return changetype<usize>(inBuf); }\nexport function getOutputPtr(): usize { return changetype<usize>(outBuf); }\nexport function getParamsPtr(): usize { return changetype<usize>(params); }\nexport function getNumParams(): i32   { return 4; }\n\n@inline function clampf(x: f32, lo: f32, hi: f32): f32 { return x < lo ? lo : (x > hi ? hi : x); }\n\nexport function process(n: i32): void {\n  const bitsN: f32 = clampf(params[P_BITS], 0.0, 1.0);\n  const dsN: f32   = clampf(params[P_DOWNSAMPLE], 0.0, 1.0);\n  const mix: f32   = clampf(params[P_MIX], 0.0, 1.0);\n  const level: f32 = clampf(params[P_LEVEL], 0.0, 1.0) * 1.2;\n\n  // Bit depth: control 0 -> 16 bits (clean), control 1 -> 1 bit (max crush).\n  // bits in [1,16]. Quantization step = 2 / (2^bits - 1) over a [-1,1] range.\n  const bits: f32 = 16.0 - bitsN * 15.0;        // 16 .. 1\n  const levels: f32 = Mathf.pow(2.0, bits) - 1.0; // 2^bits - 1, >= 1\n  const safeLevels: f32 = levels < 1.0 ? 1.0 : levels;\n  const stepInv: f32 = safeLevels * 0.5;          // x*stepInv then round then /stepInv\n  const step: f32 = 1.0 / stepInv;\n\n  // Downsample divisor: 1..50 (integer sample-and-hold period).\n  let divisor: f32 = 1.0 + Mathf.round(dsN * 49.0); // 1 .. 50\n  if (divisor < 1.0) divisor = 1.0;\n\n  for (let c = 0; c < channels; c++) {\n    const base: i32 = c * MAX_FRAMES;\n    let hc: f32 = holdCount[c];\n    let hv: f32 = holdVal[c];\n    for (let f = 0; f < n; f++) {\n      const x: f32 = inBuf[base + f];\n\n      // --- sample-and-hold decimator ---\n      hc = hc + 1.0;\n      if (hc >= divisor) {\n        hc = 0.0;\n        hv = x;          // latch a new sample\n      }\n      let s: f32 = hv;\n\n      // --- bit-depth quantizer ---\n      // clamp to [-1,1] so quantization grid is well defined, then round to nearest step\n      const cs: f32 = clampf(s, -1.0, 1.0);\n      const q: f32 = f32(Mathf.round(cs * stepInv) * step);\n\n      // dry/wet + output level\n      const wet: f32 = q;\n      const y: f32 = f32((x * (1.0 - mix) + wet * mix) * level);\n      outBuf[base + f] = clampf(y, -1.2, 1.2);\n    }\n    holdCount[c] = hc;\n    holdVal[c] = hv;\n  }\n}\n",
  "publishedAt": 1751000024000
}