  "html": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Cartridge Four</title>\n<style>\n:root{--a:#ff6b6b;--a2:#ffd0c2;--pn:#231416;--ink:#f7e6e2;--dim:#b08f8a;--ln:rgba(255,107,107,.16)}\n*{box-sizing:border-box}html,body{margin:0;background:radial-gradient(120% 80% at 50% 0%,#3a1a1e,#12080a 65%);color:var(--ink);font:12px/1.3 -apple-system,\"Segoe UI\",Helvetica,sans-serif;min-height:100%}\n#app{max-width:1040px;margin:0 auto;padding:12px}\nh1{margin:0 0 8px;font-size:18px;letter-spacing:.3em;font-weight:300;color:var(--a2)}h1 small{letter-spacing:.15em;color:var(--dim);font-size:10px;margin-left:10px}\ncanvas{width:100%;height:130px;display:block;background:#0d0507;border:1px solid var(--ln);border-radius:8px}\n.row{display:grid;gap:8px;margin-top:8px}.r3{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}\n.g{background:var(--pn);border:1px solid var(--ln);border-radius:10px;padding:8px 10px}\n.g h2{margin:0 0 6px;font-size:9px;letter-spacing:.25em;color:var(--a);font-weight:600}\n.ks{display:grid;grid-template-columns:repeat(auto-fill,minmax(54px,1fr));gap:6px 2px;margin-top:6px}\n.tg{display:flex;flex-wrap:wrap;gap:4px;align-items:center;margin-bottom:2px}.tg span{font-size:8px;letter-spacing:.2em;color:var(--dim);width:74px}\n.tg button{background:#1b0f11;color:var(--dim);border:1px solid var(--ln);border-radius:5px;padding:5px 7px;font:600 9px/1 inherit;letter-spacing:.1em;cursor:pointer}\n.tg button.on{background:var(--a);color:#1c0a0c;border-color:var(--a)}\n.k{display:flex;flex-direction:column;align-items:center;user-select:none;touch-action:none;cursor:ns-resize}\n.k svg{width:40px;height:40px}.k .n{font-size:9px;color:var(--dim);text-align:center;margin-top:1px}.k .v{font-size:9px;color:var(--a2)}\n#kb{position:relative;height:76px;margin-top:8px;user-select:none;touch-action:none}\n.w{position:absolute;top:0;height:100%;background:linear-gradient(#fbeeea,#d9b5ae);border:1px solid #12080a;border-radius:0 0 4px 4px}.w.on,.w.dz.on{background:var(--a)}\n.w.dz{background:linear-gradient(#f3c7bf,#c98d84)}.b{position:absolute;top:0;height:58%;background:linear-gradient(#3a2226,#170b0d);border-radius:0 0 3px 3px;z-index:2}.b.on{background:var(--a)}\n</style></head><body><div id=\"app\"><h1>CARTRIDGE FOUR<small>8-BIT CONSOLE VOICE</small></h1><canvas id=\"cv\"></canvas><div class=\"row r3\" id=\"voices\"></div><div class=\"row r3\" id=\"rest\"></div><div id=\"kb\"></div></div>\n<script>\n(function(){\nvar PARAMS=[{\"name\": \"Channel Mode\", \"index\": 0, \"min\": 0, \"max\": 1, \"default\": 0, \"step\": 1}, {\"name\": \"Drum Zone\", \"index\": 1, \"min\": 0, \"max\": 1, \"default\": 1, \"step\": 1}, {\"name\": \"Console\", \"index\": 2, \"min\": 0, \"max\": 2, \"default\": 1, \"step\": 1}, {\"name\": \"Period Quantize\", \"index\": 3, \"min\": 0, \"max\": 1, \"default\": 1, \"step\": 1}, {\"name\": \"Smooth\", \"index\": 4, \"min\": 0, \"max\": 1, \"default\": 0.25}, {\"name\": \"Pulse 1 Duty\", \"index\": 5, \"min\": 0, \"max\": 3, \"default\": 1, \"step\": 1}, {\"name\": \"Pulse 1 Volume\", \"index\": 6, \"min\": 0, \"max\": 15, \"default\": 11, \"step\": 1}, {\"name\": \"Pulse 1 Decay Env\", \"index\": 7, \"min\": 0, \"max\": 1, \"default\": 1, \"step\": 1}, {\"name\": \"Pulse 1 Decay Rate\", \"index\": 8, \"min\": 0, \"max\": 15, \"default\": 6, \"step\": 1}, {\"name\": \"Pulse 1 Loop\", \"index\": 9, \"min\": 0, \"max\": 1, \"default\": 0, \"step\": 1}, {\"name\": \"Pulse 2 Duty\", \"index\": 10, \"min\": 0, \"max\": 3, \"default\": 2, \"step\": 1}, {\"name\": \"Pulse 2 Volume\", \"index\": 11, \"min\": 0, \"max\": 15, \"default\": 8, \"step\": 1}, {\"name\": \"Pulse 2 Decay Env\", \"index\": 12, \"min\": 0, \"max\": 1, \"default\": 1, \"step\": 1}, {\"name\": \"Pulse 2 Decay Rate\", \"index\": 13, \"min\": 0, \"max\": 15, \"default\": 6, \"step\": 1}, {\"name\": \"Pulse 2 Loop\", \"index\": 14, \"min\": 0, \"max\": 1, \"default\": 0, \"step\": 1}, {\"name\": \"Pulse 2 Detune\", \"index\": 15, \"min\": 0, \"max\": 1, \"default\": 0.6}, {\"name\": \"Duty Animation\", \"index\": 16, \"min\": 0, \"max\": 3, \"default\": 0, \"step\": 1}, {\"name\": \"Sweep\", \"index\": 17, \"min\": -7, \"max\": 7, \"default\": 0, \"step\": 1}, {\"name\": \"Sweep Rate\", \"index\": 18, \"min\": 0, \"max\": 7, \"default\": 3, \"step\": 1}, {\"name\": \"Vibrato\", \"index\": 19, \"min\": 0, \"max\": 1, \"default\": 0.15}, {\"name\": \"Vibrato Rate\", \"index\": 20, \"min\": 0, \"max\": 1, \"default\": 0.4}, {\"name\": \"Vibrato Delay\", \"index\": 21, \"min\": 0, \"max\": 1, \"default\": 0.4}, {\"name\": \"Triangle Level\", \"index\": 22, \"min\": 0, \"max\": 1, \"default\": 1}, {\"name\": \"Triangle Octave\", \"index\": 23, \"min\": -2, \"max\": 0, \"default\": -1, \"step\": 1}, {\"name\": \"Triangle Length\", \"index\": 24, \"min\": 0, \"max\": 1, \"default\": 0}, {\"name\": \"Noise Level\", \"index\": 25, \"min\": 0, \"max\": 15, \"default\": 3, \"step\": 1}, {\"name\": \"Noise Period\", \"index\": 26, \"min\": 0, \"max\": 15, \"default\": 6, \"step\": 1}, {\"name\": \"Noise Short Mode\", \"index\": 27, \"min\": 0, \"max\": 1, \"default\": 0, \"step\": 1}, {\"name\": \"Noise Decay\", \"index\": 28, \"min\": 0, \"max\": 15, \"default\": 3, \"step\": 1}, {\"name\": \"Noise Key Track\", \"index\": 29, \"min\": 0, \"max\": 1, \"default\": 0, \"step\": 1}, {\"name\": \"DPCM Level\", \"index\": 30, \"min\": 0, \"max\": 1, \"default\": 0.8}, {\"name\": \"DPCM Rate\", \"index\": 31, \"min\": 0, \"max\": 1, \"default\": 0.6}, {\"name\": \"Arp Chord\", \"index\": 32, \"min\": 0, \"max\": 6, \"default\": 0, \"step\": 1}, {\"name\": \"Arp Speed\", \"index\": 33, \"min\": 0, \"max\": 1, \"default\": 0.5}, {\"name\": \"Release\", \"index\": 34, \"min\": 0, \"max\": 1, \"default\": 0.15}, {\"name\": \"Velocity Sens\", \"index\": 35, \"min\": 0, \"max\": 1, \"default\": 0.5}, {\"name\": \"Bend Range\", \"index