  "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>FM Tines</title>\n<style>\n  :root{ --ac:#39d98a; --ac2:#2aa3ff; --lcd:#8affc0; --panel1:#20242a; --panel2:#0c0e11; --ink:#e9efe9; --dim:#7f8a84; }\n  *{box-sizing:border-box; -webkit-user-select:none; user-select:none}\n  html,body{margin:0;min-height:100%}\n  body{font:11px/1.3 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",sans-serif;color:var(--ink);\n    background:radial-gradient(120% 90% at 50% -10%,#1b1f24 0%,#08090b 60%,#040405 100%);\n    display:flex;align-items:flex-start;justify-content:center;padding:14px 6px}\n  .synth{display:flex;max-width:1420px;width:100%;border-radius:9px;overflow:hidden;\n    box-shadow:0 26px 60px rgba(0,0,0,.75), inset 0 1px 0 rgba(255,255,255,.05)}\n  .cheek{width:22px;flex:0 0 22px;background:linear-gradient(90deg,#26140c,#160b06);\n    box-shadow:inset -3px 0 6px rgba(0,0,0,.6),inset 3px 0 3px rgba(255,255,255,.05)}\n  .core{flex:1;background:linear-gradient(180deg,var(--panel1),var(--panel2));padding:10px 12px 12px;min-width:0}\n  .head{display:flex;align-items:center;gap:14px;padding:2px 4px 9px;border-bottom:1px solid rgba(255,255,255,.09)}\n  .logo{font-size:23px;font-weight:800;letter-spacing:.04em;\n    background:linear-gradient(90deg,#eafff2,#39d98a);-webkit-background-clip:text;background-clip:text;color:transparent}\n  .logo b{color:var(--ac2);font-weight:800}\n  .tag{font-size:8.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--dim)}\n  .headfill{flex:1}\n  .lcd{display:flex;align-items:center;gap:8px}\n  .lcd .what{font-size:8.5px;letter-spacing:.14em;color:var(--dim);text-transform:uppercase;max-width:110px;text-align:left}\n  .lcd .scr{min-width:120px;text-align:right;background:#08150e;border:1px solid #000;border-radius:5px;\n    padding:3px 9px;font:700 16px/1 \"Menlo\",\"Consolas\",monospace;color:var(--lcd);\n    text-shadow:0 0 7px rgba(57,217,138,.55);letter-spacing:.03em}\n  .rowlabel{font-size:9px;font-weight:700;letter-spacing:.2em;color:var(--ac);text-transform:uppercase;margin:9px 2px 1px;\n    border-left:3px solid var(--ac);padding-left:6px}\n  .row{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;align-items:stretch}\n  .sec{border:1px solid rgba(255,255,255,.12);border-radius:6px;padding:18px 7px 6px;position:relative;\n    background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,0));flex:0 0 auto}\n  .sec>b{position:absolute;top:0;left:0;right:0;padding:2px 7px;font-size:8px;font-weight:700;\n    letter-spacing:.1em;text-transform:uppercase;white-space:nowrap;border-radius:5px 5px 0 0;\n    background:linear-gradient(90deg,var(--ac),#1f9c63);color:#04120a}\n  .sec.b>b{background:linear-gradient(90deg,var(--ac2),#1b5f92);color:#fff}\n  .sec.op>b{background:linear-gradient(90deg,#3a4048,#20242a);color:#cfe8da}\n  .bank{display:flex;gap:4px 8px;align-items:flex-start;flex-wrap:wrap}\n  .col{display:flex;flex-direction:column;gap:6px;align-items:center;justify-content:flex-start}\n  /* knob */\n  .kn{display:flex;flex-direction:column;align-items:center;gap:4px;width:40px}\n  .kn .dial{position:relative;width:30px;height:30px;border-radius:50%;cursor:ns-resize;touch-action:none;\n    background:radial-gradient(60% 60% at 40% 32%,#3a3f3c,#181b19 70%,#0a0b0b);border:1px solid #000;\n    box-shadow:0 2px 5px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,.12)}\n  .kn .lb{font-size:7px;letter-spacing:.02em;color:var(--dim);text-transform:uppercase;text-align:center;line-height:1.15;min-height:9px;max-width:40px}\n  /* led button */\n  .bt{display:flex;flex-direction:column;align-items:center;gap:3px;cursor:pointer;width:38px}\n  .bt .sq{width:24px;height:12px;border-radius:3px;border:1px solid #000;position:relative;\n    background:linear-gradient(180deg,#2a2f2c,#141613);box-shadow:0 2px 3px rgba(0,0,0,.55), inset 0 1px 0 rgba(255,255,255,.08)}\n  .bt .sq::after{content:\"\";position:absolute;top:-6px;left:50%;transform:translateX(-50%);width:6px;height:3.5px;border-radius:2px;background:#233;transition:.12s}\n  .bt.on .sq::after{background:var(--ac);box-shadow:0 0 7px var(--ac),0 0 13px rgba(57,217,138,.5)}\n  .bt.b.on .sq::after{background:var(--ac2);box-shadow:0 0 7px var(--ac2)}\n  .bt:active .sq{transform:translateY(1px)}\n  .bt .lb{font-size:7px;letter-spacing:.02em;color:var(--dim);text-transform:uppercase;text-align:center;white-space:nowrap}\n  /* selector (LED ladder) */\n  .sel{display:flex;flex-direction:column;gap:2px;align-items:flex-start}\n  .sel>i{font-size:7px;letter-spacing:.05em;color:var(--dim);text-transform:uppercase;font-style:normal;margin-bottom:1px}\n  .sel .opt{display:flex;align-items:center;gap:4px;cursor:pointer;padding:0 1px}\n  .sel .led{width:6px;height:6px;border-radius:50%;background:#12211a;border:1px solid #000;transition:.1s}\n  .sel .opt.on .led{background:var(--ac);box-shadow:0 0 6px var(--ac)}\n  .sel .opt span{font-size:7px;letter-spacing:.02em;color:var(--dim);text-transform:uppercase;white-space:nowrap}\n  .sel .opt.on span{color:#eafff2}\n  /* bipolar lever */\n  .lever{display:flex;flex-direction:column;align-items:center;gap:4px}\n  .lever .slot{width:84px;height:20px;border-radius:5px;background:#07100b;border:1px solid #000;\n    box-shadow:inset 0 2px 8px rgba(0,0,0,.9);position:relative;cursor:ew-resize;touch-action:none;overflow:hidden}\n  .lever .grip{position:absolute;top:2px;bottom:2px;width:22px;border-radius:3px;\n    background:linear-gradient(90deg,#3a403c 0 3px,#22241f 3px 6px);background-size:6px 100%;\n    border:1px solid #000;left:31px}\n  .lever .lb{font-size:7px;letter-spacing:.08em;color:var(--dim);text-transform:uppercase}\n  /* algorithm widget */\n  .algo{display:flex;flex-direction:column;gap:6px;align-items:center}\n  .algo .top{display:flex;align-items:center;gap:8px}\n  .algo .num{min-width:74px;text-align:center;background:#08150e;border:1px solid #000;border-radius:5px;\n    padding:4px 8px;font:700 15px/1 \"Menlo\",\"Consolas\",monospace;color:var(--lcd);text-shadow:0 0 6px rgba(57,217,138,.5)}\n  .algo .step{width:22px;height:22px;border-radius:5px;border:1px solid #000;background:linear-gradient(180deg,#2c322e,#151815);\n    color:var(--ink);font-size:14px;line-height:1;display:flex;align-items:center;justify-content:center;cursor:pointer}\n  .algo .step:active{transform:translateY(1px)}\n  .algo .diag{display:flex;gap:4px}\n  .algo .ob{width:20px;height:20px;border-radius:4px;border:1px solid #000;display:flex;align-items:center;justify-content:center;\n    font-size:9px;font-weight:700;color:#0a0b0b;background:#20242a;position:relative}\n  .algo .ob.car{background:linear-gradient(180deg,var(--ac),#1f9c63);color:#04120a}\n  .algo .ob.mod{background:linear-gradient(180deg,#41474d,#2a2e33);color:#cfe8da}\n  .algo .ob .fb{position:absolute;top:-6px;right:-4px;font-size:8px;color:var(--ac2)}\n  .foot{margin-top:10px;padding-top:7px;border-top:1px solid rgba(255,255,255,.08);font-size:9px;color:#79857f;display:flex;gap:16px;flex-wrap:wrap}\n  .foot b{color:var(--ac);font-weight:600}\n</style></head><body>\n<div class=\"synth\">\n  <div class=\"cheek\"></div>\n  <div class=\"core\">\n    <div class=\"head\">\n      <div><div class=\"logo\">FM<b>·</b>Tines</div><div class=\"tag\">6-operator FM · 32 algorithms</div></div>\n      <div class=\"headfill\"></div>\n      <div class=\"lcd\"><div class=\"what\" id=\"lcdWhat\">voice</div><div class=\"scr\" id=\"lcd\">DX · FM</div></div>\n    </div>\n\n    <div class=\"rowlabel\">Algorithm &amp; Global</div>\n    <div class=\"row\" id=\"rowTop\"></div>\n\n    <div class=\"rowlabel\">Operators (carrier = green, modulator = grey)</div>\n    <div class=\"row\" id=\"rowOps\"></div>\n\n    <div class=\"rowlabel\">LFO &amp; Modulation</div>\n    <div class=\"row\" id=\"rowLfo\"></div>\n\n    <div class=\"rowlabel\">Pitch EG &amp; Performance</div>\n    <div class=\"row\" id=\"rowPerf\"></div>\n\n    <div class=\"foot\">\n      <span><b>6 OPERATORS</b> each with ratio / level / detune / A-D-S-R</span>\n      <span><b>32 ALGORITHMS</b> — carrier &amp; modulator routing + feedback op</span>\n      <span><b>LFO</b> tri/saw/square/sine/S&amp;H · PMD vibrato · AMD tremolo</span>\n      <span><b>PITCH EG</b> · mod-wheel / breath / after-touch &rarr; pitch / amp / EG-bias</span>\n    </div>\n  </div>\n  <div class=\"cheek\"></div>\n</div>\n<script>\n(function(){\n  \"use strict\";\n  var PD = {};\n  function d(i,mn,mx,df){ PD[i]={min:mn,max:mx,def:df}; }\n  // operators 0-41 : ratio, level, detune, atk, dec, sus, rel  (x6)\n  var opDef=[[1,.99,0,.01,.55,.28,.35],[14,.62,0,.005,.30,0,.30],[1,.70,.22,.01,.60,.30,.40],\n             [1,.45,0,.01,.50,.15,.40],[1,.55,-.22,.02,.70,.35,.45],[1,.32,0,.01,.40,.10,.40]];\n  for(var o=0;o<6;o++){ var b0=o*7; var dd=opDef[o];\n    d(b0+0,.5,32,dd[0]); d(b0+1,0,1,dd[1]); d(b0+2,-1,1,dd[2]);\n    d(b0+3,0,1,dd[3]); d(b0+4,0,1,dd[4]); d(b0+5,0,1,dd[5]); d(b0+6,0,1,dd[6]); }\n  d(42,0,31,4); d(43,0,7,3); d(44,0,4095,63); d(45,0,16383,32);\n  d(46,0,1,.35); d(47,0,1,0); d(48,0,1,.10); d(49,0,1,0); d(50,0,5,4); d(51,0,7,3); d(52,0,3,0);\n  d(53,-1,1,0); d(54,0,1,.5);\n  d(55,-24,24,0); d(56,-1,1,0); d(57,0,1,.10); d(58,0,12,2);\n  d(59,-1,1,0); d(60,0,1,0); d(61,0,1,0); d(62,0,1,0); d(63,0,1,.70);\n\n  // DX7 algorithm table (slot 0..5 = OP6..OP1). byte: bit0-1 outbus(0=carrier), bit6 feedback.\n  var ALG=[0xc1,0x11,0x11,0x14,0x01,0x14, 0x01,0x11,0x11,0x14,0xc1,0x14, 0xc1,0x11,0x14,0x01,0x11,0x14,\n    0xc1,0x11,0x94,0x01,0x11,0x14, 0xc1,0x14,0x01,0x14,0x01,0x14, 0xc1,0x94,0x01,0x14,0x01,0x14,\n    0xc1,0x11,0x05,0x14,0x01,0x14, 0x01,0x11,0xc5,0x14,0x01,0x14, 0x01,0x11,0x05,0x14,0xc1,0x14,\n    0x01,0x05,0x14,0xc1,0x11,0x14, 0xc1,0x05,0x14,0x01,0x11,0x14, 0x01,0x05,0x05,0x14,0xc1,0x14,\n    0xc1,0x05,0x05,0x14,0x01,0x14, 0xc1,0x05,0x11,0x14,0x01,0x14, 0x01,0x05,0x11,0x14,0xc1,0x14,\n    0xc1,0x11,0x02,0x25,0x05,0x14, 0x01,0x11,0x02,0x25,0xc5,0x14, 0x01,0x11,0x11,0xc5,0x05,0x14,\n    0xc1,0x14,0x14,0x01,0x11,0x14, 0x01,0x05,0x14,0xc1,0x14,0x14, 0x01,0x14,0x14,0xc1,0x14,0x14,\n    0xc1,0x14,0x14,0x14,0x01,0x14, 0xc1,0x14,0x14,0x01,0x14,0x04, 0xc1,0x14,0x14,0x14,0x04,0x04,\n    0xc1,0x14,0x14,0x04,0x04,0x04, 0xc1,0x05,0x14,0x01,0x14,0x04, 0x01,0x05,0x14,0xc1,0x14,0x04,\n    0x04,0xc1,0x11,0x14,0x01,0x14, 0xc1,0x14,0x01,0x14,0x04,0x04, 0x04,0xc1,0x11,0x14,0x04,0x04,\n    0xc1,0x14,0x04,0x04,0x04,0x04, 0xc4,0x04,0x04,0x04,0x04,0x04];\n\n  var vals={}; for(var k in PD) vals[k]=PD[k].def;\n  var lcd, lcdWhat, listeners={};\n\n  function push(i,v,label,shown){\n    vals[i]=v;\n    if(window.vstai&&window.vstai.setParam) window.vstai.setParam(+i,v);\n    if(label!==undefined&&lcd){ lcdWhat.textContent=label; lcd.textContent=shown; }\n    var ls=listeners[i]; if(ls) for(var j=0;j<ls.length;j++) ls[j]();\n  }\n  function listen(i,fn){ (listeners[i]=listeners[i]||[]).push(fn); }\n  function getField(i,shift,width){ var m=(1<<width)-1; return (Math.round(vals[i])>>shift)&m; }\n  function setField(i,shift,width,val,label,shown){\n    var m=(1<<width)-1; var v=Math.round(vals[i]); v=(v&~(m<<shift))|((val&m)<<shift);\n    push(i,v,label,shown);\n  }\n  function el(tag,cls,parent){ var e=document.createElement(tag); if(cls)e.className=cls; if(parent)parent.appendChild(e); return e; }\n\n  function knob(parent,idx,label,fmt){\n    var p=PD[idx];\n    var box=el(\"div\",\"kn\",parent);\n    var dial=el(\"div\",\"dial\",box);\n    var ind=el(\"div\",\"\",dial);\n    ind.style.cssText=\"position:absolute;left:50%;top:3px;width:2px;height:10px;margin-left:-1px;background:var(--ac);border-radius:1px;transform-origin:50% 12px;box-shadow:0 0 5px var(--ac)\";\n    el(\"div\",\"lb\",box).textContent=label;\n    function norm(){ return (vals[idx]-p.min)/(p.max-p.min); }\n    function show(){ return fmt?fmt(vals[idx]):Math.round(norm()*127)+\"\"; }\n    function repaint(){ ind.style.transform=\"rotate(\"+(norm()*270-135)+\"deg)\"; }\n    function setN(nn){ nn=nn<0?0:(nn>1?1:nn); var v=p.min+(p.max-p.min)*nn;\n      if(p.min>=0&&p.max-p.min>=2&&(p.max-p.min)%1===0) v=Math.round(v);\n      push(idx,v,label,show()); repaint(); }\n    dial.addEventListener(\"pointerdown\",function(e){ dial._d=1; dial._y=e.clientY; dial._n=norm(); dial.setPointerCapture(e.pointerId); e.preventDefault(); });\n    dial.addEventListener(\"pointermove\",function(e){ if(!dial._d)return; setN(dial._n+(dial._y-e.clientY)/150); });\n    dial.addEventListener(\"pointerup\",function(){ dial._d=0; });\n    dial.addEventListener(\"pointercancel\",function(){ dial._d=0; });\n    dial.addEventListener(\"dblclick\",function(){ push(idx,p.def,label,show()); repaint(); });\n    dial.addEventListener(\"wheel\",function(e){ e.preventDefault(); setN(norm()+(e.deltaY<0?0.04:-0.04)); },{passive:false});\n    listen(idx,repaint); repaint();\n    return box;\n  }\n\n  function bitBtn(parent,idx,bit,label,cls){\n    var b=el(\"div\",\"bt\"+(cls?\" \"+cls:\"\"),parent);\n    el(\"div\",\"sq\",b); el(\"div\",\"lb\",b).textContent=label;\n    function paint(){ b.classList.toggle(\"on\",!!getField(idx,bit,1)); }\n    b.addEventListener(\"click\",function(){ var cur=getField(idx,bit,1); setField(idx,bit,1,cur?0:1,label,cur?\"Off\":\"On\"); });\n    listen(idx,paint); paint();\n    return b;\n  }\n\n  function pSelector(parent,title,idx,opts){\n    var s=el(\"div\",\"sel\",parent);\n    if(title){ el(\"i\",\"\",s).textContent=title; }\n    var rows=[];\n    function paint(){ var cur=Math.round(vals[idx]); for(var i=0;i<rows.length;i++) rows[i].classList.toggle(\"on\",i===cur); }\n    opts.forEach(function(o,i){ var r=el(\"div\",\"opt\",s); el(\"i\",\"led\",r); el(\"span\",\"\",r).textContent=o;\n      r.addEventListener(\"click\",function(){ push(idx,i,title,o); }); rows.push(r); });\n    listen(idx,paint); paint();\n    return s;\n  }\n\n  function lever(parent,idx,label,fmt){\n    var p=PD[idx];\n    var w=el(\"div\",\"lever\",parent);\n    var slot=el(\"div\",\"slot\",w); var grip=el(\"div\",\"grip\",slot);\n    el(\"div\",\"lb\",w).textContent=label;\n    var TRACK=84-22-4;\n    function norm(){ return (vals[idx]-p.min)/(p.max-p.min); }\n    function paint(){ grip.style.left=(2+norm()*TRACK)+\"px\"; }\n    function setN(nn){ nn=nn<0?0:(nn>1?1:nn); var v=p.min+(p.max-p.min)*nn;\n      push(idx,v,label,fmt?fmt(v):(v>=0?\"+\":\"\")+v.toFixed(2)); paint(); }\n    slot.addEventListener(\"pointerdown\",function(e){ slot._d=1; var r=slot.getBoundingClientRect(); setN((e.clientX-r.left-13)/TRACK); slot.setPointerCapture(e.pointerId); e.preventDefault(); });\n    slot.addEventListener(\"pointermove\",function(e){ if(!slot._d)return; var r=slot.getBoundingClientRect(); setN((e.clientX-r.left-13)/TRACK); });\n    slot.addEventListener(\"pointerup\",function(){ slot._d=0; });\n    slot.addEventListener(\"pointercancel\",function(){ slot._d=0; });\n    slot.addEventListener(\"dblclick\",function(){ push(idx,p.def,label,\"0\"); paint(); });\n    listen(idx,paint); paint();\n    return w;\n  }\n\n  function algoWidget(parent){\n    var wrap=el(\"div\",\"algo\",parent);\n    var top=el(\"div\",\"top\",wrap);\n    var dn=el(\"div\",\"step\",top); dn.textContent=\"‹\";\n    var num=el(\"div\",\"num\",top);\n    var up=el(\"div\",\"step\",top); up.textContent=\"›\";\n    var diag=el(\"div\",\"diag\",wrap);\n    var boxes=[];\n    for(var op=0;op<6;op++){ var ob=el(\"div\",\"ob\",diag); ob.textContent=(op+1);\n      var fb=el(\"span\",\"fb\",ob); fb.textContent=\"↺\"; fb.style.display=\"none\"; boxes.push({ob:ob,fb:fb}); }\n    function paint(){\n      var a=Math.round(vals[42]); num.textContent=\"ALG \"+(a+1);\n      for(var slot=0;slot<6;slot++){ var op=5-slot; var byte=ALG[a*6+slot];\n        var car=(byte&3)===0; var bx=boxes[op];\n        bx.ob.className=\"ob \"+(car?\"car\":\"mod\");\n        bx.fb.style.display=(byte&0x40)?\"block\":\"none\"; }\n    }\n    function stepA(delta){ var a=Math.round(vals[42])+delta; if(a<0)a=0; if(a>31)a=31; push(42,a,\"algorithm\",\"ALG \"+(a+1)); }\n    dn.addEventListener(\"click\",function(){ stepA(-1); });\n    up.addEventListener(\"click\",function(){ stepA(1); });\n    listen(42,paint); paint();\n    return wrap;\n  }\n\n  function sec(row,name,cls){ var s=el(\"div\",\"sec \"+(cls||\"\"),row); el(\"b\",\"\",s).textContent=name; return el(\"div\",\"bank\",s); }\n  function col(parent){ return el(\"div\",\"col\",parent); }\n\n  lcd=document.getElementById(\"lcd\"); lcdWhat=document.getElementById(\"lcdWhat\");\n  var pct=function(v){ return Math.round(v*100)+\"\"; };\n  var ratioFmt=function(v){ return v.toFixed(2); };\n  var semiFmt=function(v){ return (v>=0?\"+\":\"\")+Math.round(v); };\n\n  // ---- Algorithm & global ----\n  var rowTop=document.getElementById(\"rowTop\");\n  var b=sec(rowTop,\"Algorithm\",\"b\"); algoWidget(b);\n  b=sec(rowTop,\"FB / FM\"); knob(b,43,\"Feedback\",function(v){return Math.round(v)+\"\";});\n  b=sec(rowTop,\"Master\");\n  knob(b,63,\"Volume\",pct); knob(b,55,\"Transpose\",semiFmt); knob(b,56,\"Tune\",function(v){return (v>=0?\"+\":\"\")+Math.round(v*75)+\"c\";});\n\n  // ---- 6 operator strips ----\n  var rowOps=document.getElementById(\"rowOps\");\n  function opStrip(op){\n    var base=op*7;\n    var s=sec(rowOps,\"OP \"+(op+1),\"op\");\n    var c1=col(s);\n    var sw=col(c1);\n    bitBtn(sw,44,op,\"On\"); bitBtn(sw,44,op+6,\"Fixed\",\"b\");\n    knob(c1,base+0,\"Ratio\",ratioFmt);\n    var c2=col(s); knob(c2,base+1,\"Level\",pct); knob(c2,base+2,\"Detune\",function(v){return (v>=0?\"+\":\"\")+Math.round(v*14)+\"c\";});\n    var c3=col(s); knob(c3,base+3,\"A\"); knob(c3,base+4,\"D\");\n    var c4=col(s); knob(c4,base+5,\"S\"); knob(c4,base+6,\"R\");\n  }\n  for(var op=0;op<6;op++) opStrip(op);\n\n  // ---- LFO & modulation ----\n  var rowLfo=document.getElementById(\"rowLfo\");\n  b=sec(rowLfo,\"LFO\");\n  knob(b,46,\"Speed\",pct); knob(b,47,\"Delay\",pct); knob(b,48,\"PMD\",pct); knob(b,49,\"AMD\",pct);\n  var wcol=col(b); pSelector(wcol,\"Wave\",50,[\"Tri\",\"SawDn\",\"SawUp\",\"Sqr\",\"Sine\",\"S&H\"]);\n  var scol=col(b); bitBtn(scol,45,3,\"KeySync\"); bitBtn(scol,45,4,\"OscSync\",\"b\");\n  b=sec(rowLfo,\"Mod Sens\",\"b\");\n  var ps=col(b); pSelector(ps,\"Pitch 0-7\",51,[\"0\",\"1\",\"2\",\"3\",\"4\",\"5\",\"6\",\"7\"]);\n  var as=col(b); pSelector(as,\"Amp 0-3\",52,[\"0\",\"1\",\"2\",\"3\"]);\n  b=sec(rowLfo,\"Pitch EG\");\n  var pe=col(b); lever(pe,53,\"Amount\",function(v){return (v>=0?\"+\":\"\")+(v*24).toFixed(0)+\"st\";});\n  knob(b,54,\"Rate\",pct);\n\n  // ---- Performance ----\n  var rowPerf=document.getElementById(\"rowPerf\");\n  b=sec(rowPerf,\"Voice Mode\");\n  var vm=col(b); bitBtn(vm,45,0,\"Mono\"); bitBtn(vm,45,1,\"Porta\");\n  var vg=col(b); bitBtn(vg,45,2,\"Gliss\",\"b\");\n  knob(b,57,\"P.Time\",pct); knob(b,58,\"Bend\",function(v){return Math.round(v)+\"st\";});\n\n  b=sec(rowPerf,\"Performance\",\"b\");\n  var pw=col(b); lever(pw,59,\"Pitch Whl\"); lever(pw,60,\"Mod Whl\",pct);\n  var pw2=col(b); lever(pw2,61,\"Breath\",pct); lever(pw2,62,\"Aftertch\",pct);\n\n  b=sec(rowPerf,\"MW →\");\n  var m1=col(b); bitBtn(m1,45,5,\"Pitch\"); bitBtn(m1,45,6,\"Amp\"); bitBtn(m1,45,7,\"EGbias\");\n  b=sec(rowPerf,\"BR →\");\n  var m2=col(b); bitBtn(m2,45,8,\"Pitch\"); bitBtn(m2,45,9,\"Amp\"); bitBtn(m2,45,10,\"EGbias\");\n  b=sec(rowPerf,\"AT →\");\n  var m3=col(b); bitBtn(m3,45,11,\"Pitch\"); bitBtn(m3,45,12,\"Amp\"); bitBtn(m3,45,13,\"EGbias\");\n\n  // push all defaults to the engine once the host is ready\n  function ready(){\n    for(var i in vals) if(window.vstai&&window.vstai.setParam) window.vstai.setParam(+i,vals[i]);\n    // Follow host-side changes (session restore, preset load, DAW automation).\n    if(window.vstai&&window.vstai.onParam) window.vstai.onParam(function(i,v){\n      if(!(i in vals)) return; vals[i]=+v;\n      var ls=listeners[i]; if(ls) for(var j=0;j<ls.length;j++) ls[j]();\n    });\n  }\n  if(window.vstai&&window.vstai.onReady) window.vstai.onReady(ready); else ready();\n})();\n</script>\n</body></html>\n",
  "assembly": "// =====================================================================\n//  FM TINES — a 16-voice polyphonic 6-operator FM synthesizer modelled\n//  on the YAMAHA DX7 (Operating Manual, read cover to cover).\n//\n//  A real FM tone generator (manual pp.9-16): six sine OPERATORS, each\n//  with pitch (ratio or fixed), OUTPUT LEVEL, DETUNE and a 4-stage A-D-S-R\n//  envelope (a musical compaction of the DX7 R1-4/L1-4 EG). The 32\n//  ALGORITHMS (p.11, exact DX7 routing table) wire the operators into\n//  carrier/modulator topologies; carriers sum to the output, modulators\n//  phase-modulate their targets, and one operator per algorithm has\n//  FEEDBACK (p.13). A global LFO (p.13: 6 waves, speed/delay/PMD/AMD/\n//  key-sync) plus pitch/amp MOD SENSITIVITY (p.14) drive vibrato/tremolo;\n//  a PITCH EG (p.17) bends the attack; performance section (pp.6-8):\n//  transpose, master tune, poly/mono, portamento (fingered/full-time,\n//  glissando), pitch-bend range + wheel, and mod-wheel / breath /\n//  after-touch each routable to pitch / amplitude / EG bias.\n//\n//  Switch groups are bit-packed into Op Mask + Switch Mask; the GUI\n//  decodes them. Pure algorithm, no imports, alloc-free process().\n// =====================================================================\n\nconst MAX_FRAMES: i32 = 8192;\nconst MAX_CHANNELS: i32 = 2;\nconst MAX_PARAMS: i32 = 64;\nconst NUM_VOICES: i32 = 16;\nconst NOPS: i32 = 6;\nconst NV6: i32 = NUM_VOICES * NOPS;   // per-voice-per-operator state\nconst HELD_MAX: i32 = 24;\n\nconst PI: f32 = 3.14159265358979;\nconst TWO_PI: f32 = 6.28318530717959;\nconst FM_INDEX: f32 = 6.2;   // radians of phase-mod per unit modulator signal\n\nconst inBuf:  StaticArray<f32> = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\nconst outBuf: StaticArray<f32> = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\nconst params: StaticArray<f32> = new StaticArray<f32>(MAX_PARAMS);\n\nlet sampleRate: f32 = 48000.0;\n\n// ---- parameter indices (must match spec.json) ------------------------\n// per-operator block: 7 params (ratio,level,detune,atk,dec,sus,rel)\nconst OP_STRIDE: i32 = 7;\nconst O_RATIO: i32 = 0; const O_LEVEL: i32 = 1; const O_DETUNE: i32 = 2;\nconst O_ATK: i32 = 3; const O_DEC: i32 = 4; const O_SUS: i32 = 5; const O_REL: i32 = 6;\n\nconst P_ALGO: i32 = 42;\nconst P_FEEDBACK: i32 = 43;\nconst P_OPMASK: i32 = 44;     // bits0-5 op enable, bits6-11 op fixed-freq\nconst P_SWMASK: i32 = 45;     // routing/mode switches (see bits below)\nconst P_LFOSPEED: i32 = 46;\nconst P_LFODELAY: i32 = 47;\nconst P_LFOPMD: i32 = 48;\nconst P_LFOAMD: i32 = 49;\nconst P_LFOWAVE: i32 = 50;\nconst P_PMODSENS: i32 = 51;\nconst P_AMODSENS: i32 = 52;\nconst P_PEGAMT: i32 = 53;\nconst P_PEGRATE: i32 = 54;\nconst P_TRANSPOSE: i32 = 55;\nconst P_TUNE: i32 = 56;\nconst P_PORTA: i32 = 57;\nconst P_BENDRANGE: i32 = 58;\nconst P_PITCHWHEEL: i32 = 59;\nconst P_MODWHEEL: i32 = 60;\nconst P_BREATH: i32 = 61;\nconst P_AFTERTOUCH: i32 = 62;\nconst P_VOLUME: i32 = 63;\n\nconst NUM_PARAMS: i32 = 64;\n\n// switch mask bits (P_SWMASK)\nconst SW_MONO: i32 = 1;        // bit0 1=mono 0=poly\nconst SW_PORTA_ON: i32 = 2;    // bit1 portamento on\nconst SW_GLISS: i32 = 4;       // bit2 glissando (stepped)\nconst SW_LFO_KEYSYNC: i32 = 8; // bit3 LFO retriggers on key\nconst SW_OSC_SYNC: i32 = 16;   // bit4 oscillators reset phase on key\nconst SW_MW_PITCH: i32 = 32;   // bit5 mod wheel -> pitch (LFO vibrato depth)\nconst SW_MW_AMP: i32 = 64;     // bit6 mod wheel -> amplitude (LFO tremolo)\nconst SW_MW_EGB: i32 = 128;    // bit7 mod wheel -> EG bias (brightness)\nconst SW_BR_PITCH: i32 = 256;  // bit8 breath -> pitch\nconst SW_BR_AMP: i32 = 512;    // bit9 breath -> amplitude\nconst SW_BR_EGB: i32 = 1024;   // bit10 breath -> EG bias\nconst SW_AT_PITCH: i32 = 2048; // bit11 after-touch -> pitch\nconst SW_AT_AMP: i32 = 4096;   // bit12 after-touch -> amplitude\nconst SW_AT_EGB: i32 = 8192;   // bit13 after-touch -> EG bias\n\n// ---- helpers ---------------------------------------------------------\n@inline function clampf(x: f32, lo: f32, hi: f32): f32 { return x < lo ? lo : (x > hi ? hi : x); }\n@inline function pget(i: i32): f32 { return params[i]; }\n@inline function pbits(i: i32): i32 { return i32(params[i] + 0.5); }\n\nlet rngState: i32 = 0x2545f491;\n@inline function rngf(): f32 {\n  rngState ^= rngState << 13; rngState ^= rngState >>> 17; rngState ^= rngState << 5;\n  return f32(rngState & 0x7fffffff) / f32(0x3fffffff) - 1.0;\n}\n\n// envelope knob -> seconds (exponential). Attack ~1ms..4s ; Dec/Rel ~3ms..12s\n@inline function atkTime(nn: f32): f32 { return 0.001 * f32(Mathf.pow(4000.0, clampf(nn, 0.0, 1.0))); }\n@inline function decTime(nn: f32): f32 { return 0.003 * f32(Mathf.pow(4000.0, clampf(nn, 0.0, 1.0))); }\n\n// ---- the 32 DX7 algorithms (Dexed/DX7 ROM bit-bus encoding) ----------\n//  array index 0..5 = operators OP6,OP5,OP4,OP3,OP2,OP1 (slot -> op = 5-slot)\n//  byte: bits0-1 out bus (0=main output), bit2 add-to-bus, bits4-5 in bus,\n//        bit6 feedback-in (this op is the feedback operator).\nconst ALG: StaticArray<i32> = new StaticArray<i32>(32 * 6);\n\nfunction initAlgorithms(): void {\n  const t: i32[] = [\n    0xc1,0x11,0x11,0x14,0x01,0x14,  // 1\n    0x01,0x11,0x11,0x14,0xc1,0x14,  // 2\n    0xc1,0x11,0x14,0x01,0x11,0x14,  // 3\n    0xc1,0x11,0x94,0x01,0x11,0x14,  // 4\n    0xc1,0x14,0x01,0x14,0x01,0x14,  // 5\n    0xc1,0x94,0x01,0x14,0x01,0x14,  // 6\n    0xc1,0x11,0x05,0x14,0x01,0x14,  // 7\n    0x01,0x11,0xc5,0x14,0x01,0x14,  // 8\n    0x01,0x11,0x05,0x14,0xc1,0x14,  // 9\n    0x01,0x05,0x14,0xc1,0x11,0x14,  // 10\n    0xc1,0x05,0x14,0x01,0x11,0x14,  // 11\n    0x01,0x05,0x05,0x14,0xc1,0x14,  // 12\n    0xc1,0x05,0x05,0x14,0x01,0x14,  // 13\n    0xc1,0x05,0x11,0x14,0x01,0x14,  // 14\n    0x01,0x05,0x11,0x14,0xc1,0x14,  // 15\n    0xc1,0x11,0x02,0x25,0x05,0x14,  // 16\n    0x01,0x11,0x02,0x25,0xc5,0x14,  // 17\n    0x01,0x11,0x11,0xc5,0x05,0x14,  // 18\n    0xc1,0x14,0x14,0x01,0x11,0x14,  // 19\n    0x01,0x05,0x14,0xc1,0x14,0x14,  // 20\n    0x01,0x14,0x14,0xc1,0x14,0x14,  // 21\n    0xc1,0x14,0x14,0x14,0x01,0x14,  // 22\n    0xc1,0x14,0x14,0x01,0x14,0x04,  // 23\n    0xc1,0x14,0x14,0x14,0x04,0x04,  // 24\n    0xc1,0x14,0x14,0x04,0x04,0x04,  // 25\n    0xc1,0x05,0x14,0x01,0x14,0x04,  // 26\n    0x01,0x05,0x14,0xc1,0x14,0x04,  // 27\n    0x04,0xc1,0x11,0x14,0x01,0x14,  // 28\n    0xc1,0x14,0x01,0x14,0x04,0x04,  // 29\n    0x04,0xc1,0x11,0x14,0x04,0x04,  // 30\n    0xc1,0x14,0x04,0x04,0x04,0x04,  // 31\n    0xc4,0x04,0x04,0x04,0x04,0x04   // 32\n  ];\n  for (let i = 0; i < 32 * 6; i++) ALG[i] = t[i];\n}\n\n// ---- voice state -----------------------------------------------------\nconst vActive: StaticArray<i32> = new StaticArray<i32>(NUM_VOICES);\nconst vGate:   StaticArray<i32> = new StaticArray<i32>(NUM_VOICES);\nconst vNote:   StaticArray<i32> = new StaticArray<i32>(NUM_VOICES);\nconst vAge:    StaticArray<i32> = new StaticArray<i32>(NUM_VOICES);\nconst vVel:    StaticArray<f32> = new StaticArray<f32>(NUM_VOICES);\nconst vCur:    StaticArray<f32> = new StaticArray<f32>(NUM_VOICES); // glide current Hz\nconst vTarget: StaticArray<f32> = new StaticArray<f32>(NUM_VOICES);\nconst vPeg:    StaticArray<f32> = new StaticArray<f32>(NUM_VOICES); // pitch EG value (semitones)\n\n// per-operator state (index vo = v*6 + op)\nconst oPhase: StaticArray<f32> = new StaticArray<f32>(NV6);\nconst oEnv:   StaticArray<f32> = new StaticArray<f32>(NV6);\nconst oStage: StaticArray<i32> = new StaticArray<i32>(NV6); // 0 idle,1 atk,2 dec/sus,3 rel\nconst oFb1:   StaticArray<f32> = new StaticArray<f32>(NV6); // feedback memory\nconst oFb2:   StaticArray<f32> = new StaticArray<f32>(NV6);\n\nconst hId: StaticArray<i32> = new StaticArray<i32>(HELD_MAX);\nlet hCount: i32 = 0;\nlet ageCounter: i32 = 1;\nlet lastPlayedHz: f32 = 261.63;\n\n// global LFO\nlet lfoPhase: f32 = 0.0;\nlet lfoSH: f32 = 0.0;      // sample & hold value\nlet lfoDelay: f32 = 1.0;   // delay ramp 0..1\n\n// ---- init ------------------------------------------------------------\nexport function init(sr: f32, maxFrames: i32, numChannels: i32): void {\n  sampleRate = sr > 0.0 ? sr : 48000.0;\n  initAlgorithms();\n\n  for (let v = 0; v < NUM_VOICES; v++) {\n    vActive[v] = 0; vGate[v] = 0; vNote[v] = -1; vAge[v] = 0; vVel[v] = 0.8;\n    vCur[v] = 261.63; vTarget[v] = 261.63; vPeg[v] = 0.0;\n  }\n  for (let i = 0; i < NV6; i++) {\n    oPhase[i] = 0.0; oEnv[i] = 0.0; oStage[i] = 0; oFb1[i] = 0.0; oFb2[i] = 0.0;\n  }\n  hCount = 0; ageCounter = 1; lastPlayedHz = 261.63;\n  lfoPhase = 0.0; lfoSH = 0.0; lfoDelay = 1.0;\n\n  // boot defaults = spec.json (host may render before pushing params)\n  // operators (7 each): ratio, level, detune, atk, dec, sus, rel\n  setOp(0, 1.0,  0.99, 0.0,  0.01, 0.55, 0.28, 0.35);\n  setOp(1, 14.0, 0.62, 0.0,  0.005,0.30, 0.0,  0.30);\n  setOp(2, 1.0,  0.70, 0.22, 0.01, 0.60, 0.30, 0.40);\n  setOp(3, 1.0,  0.45, 0.0,  0.01, 0.50, 0.15, 0.40);\n  setOp(4, 1.0,  0.55, -0.22,0.02, 0.70, 0.35, 0.45);\n  setOp(5, 1.0,  0.32, 0.0,  0.01, 0.40, 0.10, 0.40);\n  params[P_ALGO] = 4.0; params[P_FEEDBACK] = 3.0;\n  params[P_OPMASK] = 63.0; params[P_SWMASK] = 32.0;\n  params[P_LFOSPEED] = 0.35; params[P_LFODELAY] = 0.0;\n  params[P_LFOPMD] = 0.10; params[P_LFOAMD] = 0.0; params[P_LFOWAVE] = 4.0;\n  params[P_PMODSENS] = 3.0; params[P_AMODSENS] = 0.0;\n  params[P_PEGAMT] = 0.0; params[P_PEGRATE] = 0.5;\n  params[P_TRANSPOSE] = 0.0; params[P_TUNE] = 0.0; params[P_PORTA] = 0.10;\n  params[P_BENDRANGE] = 2.0; params[P_PITCHWHEEL] = 0.0;\n  params[P_MODWHEEL] = 0.0; params[P_BREATH] = 0.0; params[P_AFTERTOUCH] = 0.0;\n  params[P_VOLUME] = 0.70;\n}\n\nfunction setOp(op: i32, ratio: f32, level: f32, detune: f32, a: f32, d: f32, s: f32, r: f32): void {\n  const b = op * OP_STRIDE;\n  params[b + O_RATIO] = ratio; params[b + O_LEVEL] = level; params[b + O_DETUNE] = detune;\n  params[b + O_ATK] = a; params[b + O_DEC] = d; params[b + O_SUS] = s; params[b + O_REL] = r;\n}\n\nexport function getInputPtr(): usize  { return changetype<usize>(inBuf); }\nexport function getOutputPtr(): usize { return changetype<usize>(outBuf); }\nexport function getParamsPtr(): usize { return changetype<usize>(params); }\nexport function getNumParams(): i32   { return NUM_PARAMS; }\n\n// ---- voice allocation ------------------------------------------------\nfunction allocVoice(): i32 {\n  for (let i = 0; i < NUM_VOICES; i++) if (vActive[i] == 0) return i;\n  let oldest: i32 = 0; let oa: i32 = vAge[0];\n  for (let i = 1; i < NUM_VOICES; i++) if (vAge[i] < oa) { oa = vAge[i]; oldest = i; }\n  return oldest;\n}\n\nfunction heldAdd(id: i32): void {\n  for (let i = 0; i < hCount; i++) if (hId[i] == id) return;\n  if (hCount < HELD_MAX) { hId[hCount] = id; hCount++; }\n}\nfunction heldRemove(id: i32): void {\n  for (let i = 0; i < hCount; i++) if (hId[i] == id) {\n    for (let j = i + 1; j < hCount; j++) hId[j - 1] = hId[j];\n    hCount--; return;\n  }\n}\nfunction anyActive(): i32 {\n  for (let i = 0; i < NUM_VOICES; i++) if (vActive[i] == 1) return 1;\n  return 0;\n}\n\nexport function noteOn(id: i32, hz: f32, vel: f32): void {\n  if (hz <= 0.0) return;\n  const mono: i32 = (pbits(P_SWMASK) & SW_MONO) != 0 ? 1 : 0;\n  const wasSilent: i32 = anyActive() == 0 ? 1 : 0;\n  heldAdd(id);\n\n  let slot: i32 = -1;\n  if (mono == 1) {\n    for (let i = 0; i < NUM_VOICES; i++) if (vActive[i] == 1) { slot = i; break; }\n  } else {\n    for (let i = 0; i < NUM_VOICES; i++) if (vActive[i] == 1 && vNote[i] == id) { slot = i; break; }\n  }\n  if (slot < 0) slot = allocVoice();\n  const wasIdle: i32 = vActive[slot] == 0 ? 1 : 0;\n\n  vNote[slot] = id;\n  vTarget[slot] = hz;\n  vVel[slot] = clampf(vel, 0.0, 1.0);\n\n  const portaOn: i32 = (pbits(P_SWMASK) & SW_PORTA_ON) != 0 ? 1 : 0;\n  if (portaOn == 1) { if (wasIdle == 1 || mono == 1) vCur[slot] = lastPlayedHz; }\n  else vCur[slot] = hz;\n\n  // pitch EG initial offset (semitones), decays to 0\n  vPeg[slot] = clampf(pget(P_PEGAMT), -1.0, 1.0) * 24.0;\n\n  // (re)trigger operator envelopes\n  const oscSync: i32 = (pbits(P_SWMASK) & SW_OSC_SYNC) != 0 ? 1 : 0;\n  for (let op = 0; op < NOPS; op++) {\n    const vo = slot * NOPS + op;\n    oStage[vo] = 1;\n    if (wasIdle == 1) { oEnv[vo] = 0.0; oFb1[vo] = 0.0; oFb2[vo] = 0.0; }\n    if (oscSync == 1) oPhase[vo] = 0.0;\n  }\n  vActive[slot] = 1; vGate[slot] = 1; vAge[slot] = ageCounter++;\n  lastPlayedHz = hz;\n\n  // LFO key sync / delay restart\n  if ((pbits(P_SWMASK) & SW_LFO_KEYSYNC) != 0) lfoPhase = 0.0;\n  if (wasSilent == 1) lfoDelay = 0.0;\n}\n\nexport function noteOff(id: i32): void {\n  if (id < 0) return;\n  heldRemove(id);\n  const mono: i32 = (pbits(P_SWMASK) & SW_MONO) != 0 ? 1 : 0;\n  if (mono == 1 && hCount > 0) {\n    // mono legato: fall back to the most-recent still-held key\n    const nid = hId[hCount - 1];\n    for (let i = 0; i < NUM_VOICES; i++) if (vActive[i] == 1) {\n      vNote[i] = nid; vTarget[i] = 440.0 * f32(Mathf.pow(2.0, f32(nid - 69) / 12.0));\n      return;\n    }\n  }\n  for (let i = 0; i < NUM_VOICES; i++) {\n    if (vActive[i] == 1 && vGate[i] == 1 && vNote[i] == id) {\n      vGate[i] = 0;\n      for (let op = 0; op < NOPS; op++) oStage[i * NOPS + op] = 3;\n    }\n  }\n}\n\n// operator fixed-frequency mapping: ratio knob -> Hz (~20..2000 Hz)\n@inline function fixedHz(ratio: f32): f32 {\n  return 20.0 * f32(Mathf.pow(2.0, clampf(ratio, 0.5, 32.0) * 0.22));\n}\n\n// LFO waveform (0 tri,1 saw dn,2 saw up,3 square,4 sine,5 S&H), phase 0..1\n@inline function lfoWave(w: i32, ph: f32): f32 {\n  if (w == 0) return 1.0 - 4.0 * Mathf.abs(ph - 0.5);          // triangle\n  if (w == 1) return 1.0 - 2.0 * ph;                           // saw down\n  if (w == 2) return 2.0 * ph - 1.0;                           // saw up\n  if (w == 3) return ph < 0.5 ? 1.0 : -1.0;                    // square\n  if (w == 4) return Mathf.sin(TWO_PI * ph);                   // sine\n  return lfoSH;                                                 // sample & hold\n}\n\n// per-op cached params (module scope so process() stays alloc-free)\nconst ratios  = new StaticArray<f32>(6);\nconst levels  = new StaticArray<f32>(6);\nconst detCents= new StaticArray<f32>(6);\nconst atkIncA = new StaticArray<f32>(6);\nconst decKA   = new StaticArray<f32>(6);\nconst susLA   = new StaticArray<f32>(6);\nconst relKA   = new StaticArray<f32>(6);\nconst fixedMode = new StaticArray<i32>(6);\n\n// =====================================================================\n//  PROCESS\n// =====================================================================\nexport function process(n: i32): void {\n  const sr: f32 = sampleRate;\n\n  let algIdx: i32 = pbits(P_ALGO); if (algIdx < 0) algIdx = 0; if (algIdx > 31) algIdx = 31;\n  const algBase: i32 = algIdx * 6;\n  const opMask: i32 = pbits(P_OPMASK);\n  const swMask: i32 = pbits(P_SWMASK);\n\n  const fbAmt: f32 = clampf(pget(P_FEEDBACK), 0.0, 7.0) / 7.0 * 3.3;\n\n  // count carriers for output normalisation\n  let nCar: i32 = 0;\n  for (let slot = 0; slot < 6; slot++) {\n    const op = 5 - slot;\n    if ((opMask & (1 << op)) == 0) continue;\n    if ((ALG[algBase + slot] & 0x03) == 0) nCar++;\n  }\n  if (nCar < 1) nCar = 1;\n  const carScale: f32 = 0.9 / f32(Mathf.sqrt(f32(nCar)));\n\n  for (let op = 0; op < 6; op++) {\n    const b = op * OP_STRIDE;\n    ratios[op] = clampf(pget(b + O_RATIO), 0.5, 32.0);\n    levels[op] = clampf(pget(b + O_LEVEL), 0.0, 1.0);\n    detCents[op] = clampf(pget(b + O_DETUNE), -1.0, 1.0) * 14.0; // +/-14 cents\n    atkIncA[op] = 1.0 / (atkTime(pget(b + O_ATK)) * sr);\n    decKA[op] = 1.0 - f32(Mathf.exp(-4.0 / (decTime(pget(b + O_DEC)) * sr)));\n    susLA[op] = clampf(pget(b + O_SUS), 0.0, 1.0);\n    relKA[op] = 1.0 - f32(Mathf.exp(-4.0 / (decTime(pget(b + O_REL)) * sr)));\n    fixedMode[op] = (opMask & (1 << (op + 6))) != 0 ? 1 : 0;\n  }\n\n  // global controls\n  const transpose: f32 = f32(pbits(P_TRANSPOSE));\n  const tuneSemi: f32 = clampf(pget(P_TUNE), -1.0, 1.0) * 0.75; // +/-75 cents\n  const bendSemi: f32 = clampf(pget(P_PITCHWHEEL), -1.0, 1.0) * f32(pbits(P_BENDRANGE));\n  const pModSens: f32 = clampf(pget(P_PMODSENS), 0.0, 7.0) / 7.0;\n  const aModSens: f32 = clampf(pget(P_AMODSENS), 0.0, 3.0) / 3.0;\n  const pmd: f32 = clampf(pget(P_LFOPMD), 0.0, 1.0);\n  const amd: f32 = clampf(pget(P_LFOAMD), 0.0, 1.0);\n  const lfoWaveN: i32 = pbits(P_LFOWAVE);\n  const lfoHz: f32 = 0.1 * f32(Mathf.pow(300.0, clampf(pget(P_LFOSPEED), 0.0, 1.0)));\n  const lfoInc: f32 = lfoHz / sr;\n  const delaySec: f32 = 0.002 + clampf(pget(P_LFODELAY), 0.0, 1.0) * 4.0;\n  const delayInc: f32 = 1.0 / (delaySec * sr);\n\n  // controller routing\n  const mw: f32 = clampf(pget(P_MODWHEEL), 0.0, 1.0);\n  const br: f32 = clampf(pget(P_BREATH), 0.0, 1.0);\n  const at: f32 = clampf(pget(P_AFTERTOUCH), 0.0, 1.0);\n  let ctlPitch: f32 = 0.0, ctlAmp: f32 = 0.0, ctlEgb: f32 = 0.0;\n  if ((swMask & SW_MW_PITCH) != 0) ctlPitch += mw;\n  if ((swMask & SW_BR_PITCH) != 0) ctlPitch += br;\n  if ((swMask & SW_AT_PITCH) != 0) ctlPitch += at;\n  if ((swMask & SW_MW_AMP) != 0) ctlAmp += mw;\n  if ((swMask & SW_BR_AMP) != 0) ctlAmp += br;\n  if ((swMask & SW_AT_AMP) != 0) ctlAmp += at;\n  if ((swMask & SW_MW_EGB) != 0) ctlEgb += mw;\n  if ((swMask & SW_BR_EGB) != 0) ctlEgb += br;\n  if ((swMask & SW_AT_EGB) != 0) ctlEgb += at;\n  const egBias: f32 = clampf(ctlEgb, 0.0, 3.0) * 0.25; // brightness/level lift\n\n  const portaOn: i32 = (swMask & SW_PORTA_ON) != 0 ? 1 : 0;\n  const glissOn: i32 = (swMask & SW_GLISS) != 0 ? 1 : 0;\n  const portaT: f32 = clampf(pget(P_PORTA), 0.0, 1.0);\n  const pegRateK: f32 = 1.0 - f32(Mathf.exp(-4.0 / (decTime(pget(P_PEGRATE)) * sr)));\n\n  const vol: f32 = clampf(pget(P_VOLUME), 0.0, 1.0);\n  const outGain: f32 = vol * vol * 1.05;\n\n  for (let f = 0; f < n; f++) {\n    // ---- global LFO advance ----\n    lfoPhase += lfoInc; if (lfoPhase >= 1.0) { lfoPhase -= 1.0; lfoSH = rngf(); }\n    if (lfoDelay < 1.0) { lfoDelay += delayInc; if (lfoDelay > 1.0) lfoDelay = 1.0; }\n    const lfo: f32 = lfoWave(lfoWaveN, lfoPhase) * lfoDelay;\n\n    // LFO -> pitch (vibrato) depth in semitones; controllers add on top\n    const pitchModDepth: f32 = pmd * pModSens + ctlPitch;\n    const lfoPitchSemi: f32 = lfo * pitchModDepth * 2.0;\n    // LFO -> amplitude (tremolo) depth; controllers add on top\n    const ampModDepth: f32 = amd * (0.34 + 0.66 * aModSens) + ctlAmp;\n    const ampGainMod: f32 = 1.0 - clampf(ampModDepth, 0.0, 1.0) * 0.5 * (0.5 + 0.5 * lfo);\n\n    let outMono: f32 = 0.0;\n\n    for (let v = 0; v < NUM_VOICES; v++) {\n      if (vActive[v] == 0) continue;\n\n      // portamento glide\n      let cur: f32 = vCur[v]; const tgt: f32 = vTarget[v];\n      if (portaOn == 1 && cur != tgt) {\n        const secPerOct: f32 = 0.004 * f32(Mathf.pow(700.0, portaT));\n        const step: f32 = f32(Mathf.pow(2.0, 1.0 / (secPerOct * sr)));\n        if (tgt > cur) { cur *= step; if (cur > tgt) cur = tgt; }\n        else { cur /= step; if (cur < tgt) cur = tgt; }\n        vCur[v] = cur;\n      } else if (portaOn == 0 && cur != tgt) { cur = tgt; vCur[v] = tgt; }\n      let noteHz: f32 = cur;\n      if (portaOn == 1 && glissOn == 1) {\n        const semi: f32 = Mathf.round(12.0 * f32(Mathf.log2(noteHz / 261.63)));\n        noteHz = 261.63 * f32(Mathf.pow(2.0, semi / 12.0));\n      }\n\n      // pitch EG decays toward 0\n      let peg: f32 = vPeg[v];\n      if (peg > 0.0001 || peg < -0.0001) { peg += (0.0 - peg) * pegRateK; vPeg[v] = peg; }\n      else { peg = 0.0; vPeg[v] = 0.0; }\n\n      const vel: f32 = vVel[v];\n      const velGain: f32 = 0.30 + 0.70 * vel;\n\n      // total pitch offset for this voice (semitones)\n      const pitchSemi: f32 = transpose + tuneSemi + bendSemi + lfoPitchSemi + peg;\n      const pitchMul: f32 = f32(Mathf.pow(2.0, pitchSemi / 12.0));\n\n      // ---- FM operator graph ----\n      let bus1: f32 = 0.0, bus2: f32 = 0.0;\n      let carrierSum: f32 = 0.0;\n      let carEnvSum: f32 = 0.0;\n\n      for (let slot = 0; slot < 6; slot++) {\n        const op = 5 - slot;\n        const vo = v * NOPS + op;\n        const byte = ALG[algBase + slot];\n\n        // envelope\n        let e: f32 = oEnv[vo]; const st = oStage[vo];\n        if (st == 1) { e += atkIncA[op]; if (e >= 1.0) { e = 1.0; oStage[vo] = 2; } }\n        else if (st == 2) { e += (susLA[op] - e) * decKA[op]; }\n        else if (st == 3) { e += (0.0 - e) * relKA[op]; if (e <= 0.0003) e = 0.0; }\n        oEnv[vo] = e;\n\n        const enabled: i32 = (opMask & (1 << op)) != 0 ? 1 : 0;\n        const lvl: f32 = enabled == 0 ? 0.0 : clampf(levels[op] * velGain + egBias, 0.0, 1.4);\n\n        // frequency\n        let opHz: f32;\n        if (fixedMode[op] == 1) opHz = fixedHz(ratios[op]);\n        else opHz = noteHz * ratios[op];\n        opHz *= pitchMul * f32(Mathf.pow(2.0, detCents[op] / 1200.0));\n        let inc: f32 = opHz / sr; if (inc > 0.5) inc = 0.5; if (inc < 0.0) inc = 0.0;\n        let ph: f32 = oPhase[vo] + inc; if (ph >= 1.0) ph -= f32(i32(ph)); oPhase[vo] = ph;\n\n        // modulation input (radians)\n        const inbus = (byte >> 4) & 0x03;\n        let modr: f32 = inbus == 1 ? bus1 : (inbus == 2 ? bus2 : 0.0);\n        if ((byte & 0x40) != 0) modr += fbAmt * (oFb1[vo] + oFb2[vo]) * 0.5;\n\n        const s: f32 = Mathf.sin(TWO_PI * ph + modr);\n        const opSig: f32 = lvl * e * s;\n\n        if ((byte & 0x40) != 0) { oFb2[vo] = oFb1[vo]; oFb1[vo] = opSig; }\n\n        const outbus = byte & 0x03;\n        if (outbus == 0) {\n          carrierSum += opSig;               // carrier -> output\n          carEnvSum += e * f32(enabled);\n        } else {\n          const contrib: f32 = opSig * FM_INDEX;\n          const add: i32 = (byte & 0x04) != 0 ? 1 : 0;\n          if (outbus == 1) { if (add == 1) bus1 += contrib; else bus1 = contrib; }\n          else { if (add == 1) bus2 += contrib; else bus2 = contrib; }\n        }\n      }\n\n      outMono += carrierSum * ampGainMod;\n\n      // free voice when released and carriers silent\n      if (vGate[v] == 0 && carEnvSum <= 0.0004) vActive[v] = 0;\n    }\n\n    const sample: f32 = f32(Mathf.tanh(outMono * carScale * outGain));\n    outBuf[f] = sample;\n    outBuf[MAX_FRAMES + f] = sample;\n  }\n}\n",
  "publishedAt": 1751500800000
}