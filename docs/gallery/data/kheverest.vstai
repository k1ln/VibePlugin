  "html": "<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>KHeverest</title>\n<style>:root{--u:1px;color-scheme:dark}\n*{box-sizing:border-box}\nhtml,body{margin:0;height:100%;background:#0b0b0c;overflow:hidden;font-family:\"Helvetica Neue\",Helvetica,Arial,sans-serif;color:#ddd;user-select:none;-webkit-user-select:none}\n#wrap{position:relative;width:100vw;height:100vh;overflow:hidden}\n#stage{position:absolute;left:0;top:0;width:1018px;height:536px;transform-origin:0 0;background:#0d0d0e}\n.cheek{position:absolute;top:0;bottom:0;width:34px;background:\n repeating-linear-gradient(90deg,rgba(0,0,0,.22) 0 1px,transparent 1px 5px),\n repeating-linear-gradient(92deg,rgba(255,220,170,.06) 0 2px,transparent 2px 9px),\n linear-gradient(180deg,#3a2314,#4d2f1b 40%,#3b2315);}\n.cheek.l{left:0;box-shadow:inset -3px 0 5px rgba(0,0,0,.6)}\n.cheek.r{right:0;box-shadow:inset 3px 0 5px rgba(0,0,0,.6)}\n#plate{position:absolute;left:34px;top:13px;width:950px;height:510px;background:linear-gradient(180deg,#19191b,#121214);box-shadow:0 0 0 1px #000,0 2px 14px rgba(0,0,0,.8)}\n/* header / footer */\n.logo{position:absolute;left:8px;top:7px;font-weight:800;letter-spacing:2.6px;font-size:15px;color:#f2f2f2;display:flex;align-items:center;gap:7px}\n.logo svg{width:20px;height:18px}\n.wm{position:absolute;right:10px;top:3px;font-weight:900;font-size:25px;letter-spacing:5px;color:#f4f4f4;font-stretch:expanded;transform:scaleX(1.14);transform-origin:right center}\n.foot{position:absolute;top:490px;font-size:8.5px;font-weight:800;letter-spacing:.7px;color:#eee}\n.foot.l{left:8px}.foot.r{right:10px}\n/* sections */\n.sec{position:absolute;border:1px solid #4a4b50;background:rgba(255,255,255,.012)}\n.sec>.st{position:absolute;left:4px;top:2px;font-size:7.5px;font-weight:800;letter-spacing:.3px;color:#f0f0f0;text-transform:uppercase}\n.sec>.ar{position:absolute;right:3px;top:1px;font-size:7px;color:#777}\n.lb{position:absolute;font-size:6.6px;color:#e6e6e8;text-align:center;white-space:nowrap;transform:translateX(-50%);font-weight:500;letter-spacing:.1px}\n.lb.l{transform:none}\n.br{position:absolute;height:5px;border:1px solid #8a8b90;border-top:0;border-radius:0 0 2px 2px;opacity:.8}\n/* knobs */\n.kw{position:absolute;touch-action:none;cursor:ns-resize}\n.kw svg{display:block;overflow:visible}\n.kw .dot{fill:#dcdcde}\n.kw .ptr{stroke:#fff;stroke-width:1.9;stroke-linecap:round}\n.kw:hover .ptr{stroke:#fff}\n.kw.act .rim{stroke:#4cc9ff}\n/* LEDs and buttons */\n.led{position:absolute;width:4.5px;height:3.4px;background:#3a1512;border-radius:1px}\n.led.on{background:#ff4c3b;box-shadow:0 0 4px #ff2f1c,0 0 1px #ffb0a8}\n.ll{position:absolute;font-size:6.4px;color:#e2e2e4;white-space:nowrap;line-height:7px}\n.btn{position:absolute;border-radius:2px;cursor:pointer;touch-action:none;background:linear-gradient(180deg,#4d4e53,#2b2c30);border:1px solid #0a0a0b;box-shadow:inset 0 1px 0 rgba(255,255,255,.18),0 1px 2px rgba(0,0,0,.7)}\n.btn.w{background:linear-gradient(180deg,#f3f3f3,#bdbdc0);box-shadow:inset 0 -1px 0 rgba(0,0,0,.25),0 1px 2px rgba(0,0,0,.7)}\n.btn:active,.btn.dn{filter:brightness(.82);transform:translateY(.6px)}\n.btn.glow{box-shadow:0 0 7px 1px rgba(255,76,59,.75),inset 0 0 6px rgba(255,76,59,.7);background:linear-gradient(180deg,#5a2a26,#2d1412)}\n.btn.sq{border-radius:3px}\n.btn.on{background:linear-gradient(180deg,#fff,#d8d8da);box-shadow:0 0 6px rgba(255,255,255,.35)}\n.btn .t{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:6px;color:#222;font-weight:700;pointer-events:none}\n.btn:not(.w) .t{color:#ddd}\n/* faders */\n.fd{position:absolute;touch-action:none;cursor:ns-resize}\n.fd .slot{position:absolute;left:50%;top:0;bottom:0;width:3px;margin-left:-1.5px;background:#000;border-radius:2px;box-shadow:0 0 0 1px #2c2d31}\n.fd .tick{position:absolute;left:0;width:7px;height:1px;background:#8d8e93}\n.fd .cap{position:absolute;left:50%;width:15px;height:8px;margin-left:-7.5px;margin-top:-4px;background:linear-gradient(180deg,#5d5e63,#242529);border:1px solid #050506;border-radius:1.5px;box-shadow:0 1px 2px #000}\n.fd .cap:after{content:\"\";position:absolute;left:1px;right:1px;top:3px;height:1px;background:#f2f2f2}\n/* OLED */\n#oled{position:absolute;background:#020204;border:2px solid #202226;border-radius:2px;box-shadow:inset 0 0 12px rgba(120,170,255,.08)}\n#oled .scr{position:absolute;inset:3px 4px;font-family:Menlo,Consolas,\"Courier New\",monospace;font-size:10.6px;line-height:15px;color:#e9f3ff;text-shadow:0 0 3px rgba(150,190,255,.7);white-space:pre;letter-spacing:.2px;background-image:radial-gradient(rgba(0,0,0,.55) 38%,transparent 42%);background-size:2px 2px;background-blend-mode:multiply}\n#oled .ol{height:15px;overflow:hidden}\n#oled .ol.sel{background:rgba(190,215,255,.16)}\n#oled .fld{cursor:pointer}\n#oled .fld.sf{background:#e9f3ff;color:#020204;text-shadow:none}\n.enc{position:absolute;touch-action:none;cursor:ns-resize}\n.enc svg{display:block}\n/* keyboard drawer */\n#keys{position:fixed;left:0;right:0;bottom:0;height:116px;background:#0b0b0c;border-top:1px solid #3a3b3f;display:flex;align-items:stretch}\n#keys[hidden]{display:none}\n#keys .ctl{flex:0 0 230px;width:230px;display:flex;gap:8px;padding:8px;align-items:stretch;color:#cfcfd2;font-size:8px}\n#keys .whl{position:relative;flex:0 0 30px;margin-bottom:14px;width:30px;background:linear-gradient(90deg,#111,#2b2c30 50%,#111);border:1px solid #000;border-radius:4px;touch-action:none;cursor:ns-resize}\n#keys .whl i{position:absolute;left:0;right:0;height:10px;background:#d2d2d6;opacity:.9;border-radius:2px;margin-top:-5px}\n#keys .whl b{position:absolute;left:0;right:0;bottom:-11px;text-align:center;font-weight:600;font-size:7px;color:#aaa}\n#keys .sl{display:flex;flex-direction:column;justify-content:space-between;font-size:7.5px;gap:3px;flex:1}\n#keys .sl label{display:flex;align-items:center;gap:4px}\n#keys .sl input{flex:1;height:8px}\n#keys .kb{position:relative;flex:1;margin:6px 8px 6px 0}\n#keys .wk{position:absolute;top:0;bottom:0;background:linear-gradient(180deg,#f4f4f2,#cfcfcc);border:1px solid #333;border-radius:0 0 3px 3px;touch-action:none}\n#keys .bk{position:absolute;top:0;height:62%;background:linear-gradient(180deg,#333,#050505);border:1px solid #000;border-radius:0 0 2px 2px;z-index:2;touch-action:none}\n#keys .wk.hit{background:#8fd4ff}#keys .bk.hit{background:#2b7aa8}\n#kbBtn{position:absolute}\n/* matrix editor */\n#matrix{position:fixed;inset:22px;background:rgba(10,10,12,.97);border:1px solid #55565b;border-radius:4px;overflow:auto;padding:12px;font-size:11px;z-index:20}\n#matrix h3{margin:0 0 8px;font-size:12px;letter-spacing:1px}\n#matrix table{border-collapse:collapse;width:100%}\n#matrix td,#matrix th{padding:2px 5px;border-bottom:1px solid #222;text-align:left;font-weight:500}\n#matrix select{background:#17181a;color:#e6e6e8;border:1px solid #3a3b3f;font-size:10.5px;padding:1px}\n#matrix input[type=range]{width:150px}\n#matrix .x{position:absolute;right:12px;top:10px}\n#matrix button,#saveDlg button{background:#2b2c30;color:#eee;border:1px solid #4a4b50;border-radius:3px;padding:3px 9px;font-size:10px;cursor:pointer}\n#saveDlg{position:fixed;inset:0;background:rgba(0,0,0,.6);display:flex;align-items:center;justify-content:center;z-index:30}\n#saveDlg[hidden]{display:none}\n#saveDlg>div{background:#18191b;border:1px solid #55565b;padding:14px;display:flex;gap:8px;align-items:center;font-size:11px}\n#saveDlg input{background:#050506;border:1px solid #3a3b3f;color:#fff;padding:4px 6px;font-size:11px}\n</style></head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <radialGradient id=\"kgBody\" cx=\"40%\" cy=\"32%\" r=\"75%\"><stop offset=\"0\" stop-color=\"#5a5b60\"/><stop offset=\".55\" stop-color=\"#1d1e21\"/><stop offset=\"1\" stop-color=\"#08080a\"/></radialGradient>\n  <radialGradient id=\"kgTop\" cx=\"38%\" cy=\"30%\" r=\"80%\"><stop offset=\"0\" stop-color=\"#3c3d42\"/><stop offset=\"1\" stop-color=\"#101113\"/></radialGradient>\n  <linearGradient id=\"kgEdge\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#8d8f96\"/><stop offset=\".5\" stop-color=\"#2a2b2f\"/><stop offset=\"1\" stop-color=\"#000\"/></linearGradient>\n</defs></svg>\n<div id=\"wrap\"><div id=\"stage\">\n  <div class=\"cheek l\"></div><div class=\"cheek r\"></div>\n  <div id=\"plate\"></div>\n</div></div>\n<div id=\"keys\" hidden></div>\n<div id=\"matrix\" hidden></div>\n<div id=\"saveDlg\" hidden><div><b>Save patch</b><input id=\"saveName\" maxlength=\"20\" placeholder=\"Patch name\"><button id=\"saveOk\">Save</button><button id=\"saveNo\">Cancel</button></div></div>\n<script>\nvar DATA={\"params\":[{\"key\":\"VOL\",\"name\":\"Master Volume\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0.75,\"steps\":0,\"fmt\":\"pct\",\"slot\":0,\"mult\":1,\"direct\":true,\"tip\":\"Master volume (front panel MASTER knob).\",\"kind\":\"\"},{\"key\":\"WHEEL_MOD\",\"name\":\"Mod Wheel\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0,\"steps\":0,\"fmt\":\"pct\",\"slot\":1,\"mult\":1,\"direct\":true,\"tip\":\"Mod wheel (also MIDI CC1). Matrix source ModWheel.\",\"kind\":\"\"},{\"key\":\"WHEEL_BEND\",\"name\":\"Pitch Wheel\",\"curve\":\"lin\",\"min\":-1,\"max\":1,\"def\":0,\"steps\":0,\"fmt\":\"bip\",\"slot\":2,\"mult\":1,\"direct\":true,\"tip\":\"Pitch wheel (also MIDI pitch bend). Range = each oscillator's BendRange. Matrix sources BndWhl+/-.\",\"kind\":\"\"},{\"key\":\"EXPR1\",\"name\":\"Expression Pedal 1\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0,\"steps\":0,\"fmt\":\"pct\",\"slot\":3,\"mult\":1,\"direct\":true,\"tip\":\"Pedal 1 / expression (also MIDI CC11). Matrix source ExprPED1.\",\"kind\":\"\"},{\"key\":\"EXPR2\",\"name\":\"Expression Pedal 2\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0,\"steps\":0,\"fmt\":\"pct\",\"slot\":4,\"mult\":1,\"direct\":true,\"tip\":\"Pedal 2 / breath (also MIDI CC2). Matrix source BrthPED2.\",\"kind\":\"\"},{\"key\":\"AFTERT\",\"name\":\"Aftertouch\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0,\"steps\":33,\"fmt\":\"pct\",\"slot\":51,\"mult\":35,\"direct\":false,\"tip\":\"Manual aftertouch (adds to MIDI channel/poly pressure). Matrix source AftTouch.\",\"kind\":\"\"},{\"key\":\"CVIN\",\"name\":\"CV Mod In\",\"curve\":\"lin\",\"min\":-1,\"max\":1,\"def\":0,\"steps\":33,\"fmt\":\"bip\",\"slot\":51,\"mult\":1155,\"direct\":false,\"tip\":\"Emulates the rear CV MOD input (adds to the instrument's audio input, low-passed). Matrix source CV +/-.\",\"kind\":\"\"},{\"key\":\"ANIM\",\"name\":\"Animate\",\"curve\":\"int\",\"min\":0,\"max\":7,\"def\":0,\"steps\":8,\"fmt\":\"bits\",\"slot\":8,\"mult\":2097152,\"direct\":false,\"tip\":\"bit0 Animate 1 · bit1 Animate 2 · bit2 Hold (latches the Animate buttons).\",\"kind\":\"\"},{\"key\":\"O1_RANGE\",\"name\":\"Range\",\"curve\":\"int\",\"min\":0,\"max\":3,\"def\":1,\"steps\":4,\"fmt\":[\"16'\",\"8'\",\"4'\",\"2'\"],\"slot\":17,\"mult\":2097152,\"direct\":false,\"tip\":\"Organ-stop range. 8' = concert pitch (A3 = 440 Hz).\",\"kind\":\"\"},{\"key\":\"O1_COARSE\",\"name\":\"Coarse\",\"curve\":\"lin\",\"min\":-12,\"max\":12,\"def\":0,\"steps\":49,\"fmt\":\"st\",\"slot\":32,\"mult\":274625,\"direct\":false,\"tip\":\"Pitch ±1 octave (half-semitone steps; use Fine for the rest).\",\"kind\":\"\"},{\"key\":\"O1_FINE\",\"name\":\"Fine\",\"curve\":\"lin\",\"min\":-100,\"max\":100,\"def\":0,\"steps\":101,\"fmt\":\"ct\",\"slot\":26,\"mult\":127,\"direct\":false,\"tip\":\"Pitch ±100 cents.\",\"kind\":\"\"},{\"key\":\"O1_WAVE\",\"name\":\"Wave\",\"curve\":\"int\",\"min\":0,\"max\":4,\"def\":2,\"steps\":5,\"fmt\":[\"Sine\",\"Triangle\",\"Saw\",\"Pulse\",\"more\"],\"slot\":6,\"mult\":3261249,\"direct\":false,\"tip\":\"Sine / triangle / sawtooth / pulse, or 'more' = one of the wavetables.\",\"kind\":\"\"},{\"key\":\"O1_MORE\",\"name\":\"WaveMore\",\"curve\":\"int\",\"min\":0,\"max\":158,\"def\":0,\"steps\":159,\"fmt\":\"wt\",\"slot\":5,\"mult\":51456,\"direct\":false,\"tip\":\"Wavetable used when Wave = more (Shape Amount sweeps the five waveforms of the table).\",\"kind\":\"\"},{\"key\":\"O1_ENV2\",\"name\":\"Mod Env 2 Depth\",\"curve\":\"lin\",\"min\":-63,\"max\":63,\"def\":0,\"steps\":65,\"fmt\":\"sgn\",\"slot\":28,\"mult\":7921,\"direct\":false,\"tip\":\"Pitch modulation by Mod Envelope 2.\",\"kind\":\"\"},{\"key\":\"O1_LFO2\",\"name\":\"LFO 2 Depth\",\"curve\":\"lin\",\"min\":-127,\"max\":127,\"def\":0,\"steps\":129,\"fmt\":\"sgn\",\"slot\":6,\"mult\":25281,\"direct\":false,\"tip\":\"Pitch modulation by LFO 2 (finer resolution at low values).\",\"kind\":\"\"},{\"key\":\"O1_SRC\",\"name\":\"Shape Source\",\"curve\":\"int\",\"min\":0,\"max\":2,\"def\":0,\"steps\":3,\"fmt\":[\"Manual\",\"Mod Env 1\",\"LFO 1\"],\"slot\":46,\"mult\":2481997,\"direct\":false,\"tip\":\"Which of the three additive shape sources the SHAPE AMOUNT knob edits (all three always act).\",\"kind\":\"\"},{\"key\":\"O1_SHAPE\",\"name\":\"Shape: Manual\",\"curve\":\"int\",\"min\":-63,\"max\":63,\"def\":0,\"steps\":127,\"fmt\":\"sgn\",\"slot\":25,\"mult\":1,\"direct\":false,\"tip\":\"Manual shape: PW on pulse, distortion on sine, symmetry on triangle, fold/pulse on saw, position in the table on 'more'.\",\"kind\":\"\"},{\"key\":\"O1_SHENV\",\"name\":\"Shape: Mod Env 1\",\"curve\":\"lin\",\"min\":-63,\"max\":63,\"def\":0,\"steps\":65,\"fmt\":\"sgn\",\"slot\":29,\"mult\":1,\"direct\":false,\"tip\":\"Mod Env 1 → shape.\",\"kind\":\"\"},{\"key\":\"O1_SHLFO\",\"name\":\"Shape: LFO 1\",\"curve\":\"lin\",\"min\":-63,\"max\":63,\"def\":0,\"steps\":65,\"fmt\":\"sgn\",\"slot\":29,\"mult\":65,\"direct\":false,\"tip\":\"LFO 1 → shape.\",\"kind\":\"\"},{\"key\":\"O1_VSYNC\",\"name\":\"Vsync\",\"curve\":\"int\",\"min\":0,\"max\":127,\"def\":0,\"steps\":128,\"fmt\":\"n127\",\"slot\":8,\"mult\":1,\"direct\":false,\"tip\":\"Virtual-oscillator hard sync. Multiples of 16 are musical harmonics.\",\"kind\":\"\"},{\"key\":\"O1_SAWD\",\"name\":\"SawDense\",\"curve\":\"lin\",\"min\":0,\"max\":127,\"def\":0,\"steps\":64,\"fmt\":\"n127\",\"slot\":35,\"mult\":65,\"direct\":false,\"tip\":\"Two extra detuned virtual saws (sawtooth only).\",\"kind\":\"\"},{\"key\":\"O1_DDET\",\"name\":\"DenseDet\",\"curve\":\"lin\",\"min\":0,\"max\":127,\"def\":64,\"steps\":64,\"fmt\":\"n127\",\"slot\":35,\"mult\":4160,\"direct\":false,\"tip\":\"Detune of the density saws.\",\"kind\":\"\"},{\"key\":\"O1_FIXED\",\"name\":\"FixedNote\",\"curve\":\"int\",\"min\":0,\"max\":88,\"def\":0,\"steps\":89,\"fmt\":\"fixnote\",\"slot\":27,\"mult\":10201,\"direct\":false,\"tip\":\"Off, or every key plays this single note (C#-2 … E5).\",\"kind\":\"\"},{\"key\":\"O1_BEND\",\"name\":\"BendRange\",\"curve\":\"int\",\"min\":-24,\"max\":24,\"def\":12,\"steps\":49,\"fmt\":\"st\",\"slot\":33,\"mult\":274625,\"direct\":false,\"tip\":\"Pitch-wheel range in semitones (negative reverses).\",\"kind\":\"\"},{\"key\":\"O2_RANGE\",\"name\":\"Range\",\"curve\":\"int\",\"min\":0,\"max\":3,\"def\":1,\"steps\":4,\"fmt\":[\"16'\",\"8'\",\"4'\",\"2'\"],\"slot\":18,\"mult\":2097152,\"direct\":false,\"tip\":\"Organ-stop range. 8' = concert pitch (A3 = 440 Hz).\",\"kind\":\"\"},{\"key\":\"O2_COARSE\",\"name\":\"Coarse\",\"curve\":\"lin\",\"min\":-12,\"max\":12,\"def\":0,\"steps\":49,\"fmt\":\"st\",\"slot\":34,\"mult\":274625,\"direct\":false,\"tip\":\"Pitch ±1 octave (half-semitone steps; use Fine for the rest).\",\"kind\":\"\"},{\"key\":\"O2_FINE\",\"name\":\"Fine\",\"curve\":\"lin\",\"min\":-100,\"max\":100,\"def\":0,\"steps\":101,\"fmt\":\"ct\",\"slot\":26,\"mult\":12827,\"direct\":false,\"tip\":\"Pitch ±100 cents.\",\"kind\":\"\"},{\"key\":\"O2_WAVE\",\"name\":\"Wave\",\"curve\":\"int\",\"min\":0,\"max\":4,\"def\":2,\"steps\":5,\"fmt\":[\"Sine\",\"Triangle\",\"Saw\",\"Pulse\",\"more\"],\"slot\":12,\"mult\":2097152,\"direct\":false,\"tip\":\"Sine / triangle / sawtooth / pulse, or 'more' = one of t