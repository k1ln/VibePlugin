{"format":1,"name":"rainbow","assembly":"const MAX_FRAMES: i32 = 8192;\nconst MAX_CHANNELS: i32 = 2;\nconst MAX_PARAMS: i32 = 64;\nconst NUM_VOICES: i32 = 8;\n\nconst inBuf = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\nconst outBuf = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\nconst params = new StaticArray<f32>(MAX_PARAMS);\n\nconst TWO_PI: f32 = 6.2831853;\n\nlet sampleRate: f32 = 44100;\nlet lfoPhase: f32 = 0;\nlet nextSteal: i32 = 0;\n\nconst vActive = new StaticArray<i32>(NUM_VOICES);\nconst vGate = new StaticArray<i32>(NUM_VOICES);\nconst vNote = new StaticArray<i32>(NUM_VOICES);\nconst vFreq = new StaticArray<f32>(NUM_VOICES);\nconst vVel = new StaticArray<f32>(NUM_VOICES);\nconst vEnv = new StaticArray<f32>(NUM_VOICES);\nconst vCar = new StaticArray<f32>(NUM_VOICES);\nconst vMod = new StaticArray<f32>(NUM_VOICES);\n\nfunction clampf(x: f32, lo: f32, hi: f32): f32 {\n  let y: f32 = x;\n  if (y < lo) y = lo;\n  if (y > hi) y = hi;\n  return f32(y);\n}\n\nexport function init(sr: f32, maxFrames: i32, ch: i32): void {\n  sampleRate = sr;\n  lfoPhase = 0;\n  nextSteal = 0;\n  for (let v = 0; v < NUM_VOICES; v++) {\n    vActive[v] = 0;\n    vGate[v] = 0;\n    vNote[v] = -1;\n    vFreq[v] = 440;\n    vVel[v] = 0;\n    vEnv[v] = 0;\n    vCar[v] = 0;\n    vMod[v] = 0;\n  }\n  params[0] = 0.6;   // level\n  params[1] = 2.0;   // ratio\n  params[2] = 3.0;   // index\n  params[3] = 0.01;  // attack (s)\n  params[4] = 0.4;   // release (s)\n  params[5] = 0.0;   // wobble\n}\n\nexport function getInputPtr(): usize { return changetype<usize>(inBuf); }\nexport function getOutputPtr(): usize { return changetype<usize>(outBuf); }\nexport function getParamsPtr(): usize { return changetype<usize>(params); }\nexport function getNumParams(): i32 { return 6; }\n\nexport function noteOn(id: i32, f: f32, v: f32): void {\n  let slot: i32 = -1;\n  for (let i = 0; i < NUM_VOICES; i++) {\n    if (vActive[i] != 0 && vNote[i] == id) {\n      slot = i;\n      break;\n    }\n  }\n  if (slot < 0) {\n    for (let i = 0; i < NUM_VOICES; i++) {\n      if (vActive[i] == 0) {\n        slot = i;\n        break;\n      }\n    }\n  }\n  if (slot < 0) {\n    slot = nextSteal;\n    nextSteal = (nextSteal + 1) % NUM_VOICES;\n  }\n  vActive[slot] = 1;\n  vGate[slot] = 1;\n  vNote[slot] = id;\n  vFreq[slot] = f;\n  vVel[slot] = clampf(v, 0.05, 1.0);\n}\n\nexport function noteOff(id: i32): void {\n  for (let i = 0; i < NUM_VOICES; i++) {\n    if (vActive[i] != 0 && vNote[i] == id) {\n      vGate[i] = 0;\n    }\n  }\n}\n\nexport function process(n: i32): void {\n  let frames: i32 = n;\n  if (frames > MAX_FRAMES) frames = MAX_FRAMES;\n\n  const level: f32 = clampf(params[0], 0.0, 1.0);\n  const ratio: f32 = clampf(params[1], 0.25, 16.0);\n  const index: f32 = clampf(params[2], 0.0, 12.0);\n  const attack: f32 = clampf(params[3], 0.001, 3.0);\n  const release: f32 = clampf(params[4], 0.01, 5.0);\n  const wobble: f32 = clampf(params[5], 0.0, 1.0);\n\n  const atkInc: f32 = f32(1.0) / (attack * sampleRate);\n  const relCoef: f32 = Mathf.exp(f32(-5.0) / (release * sampleRate));\n  const lfoInc: f32 = f32(5.0) / sampleRate;\n  const vibDepth: f32 = f32(0.03) * wobble;\n\n  for (let f = 0; f < frames; f++) {\n    outBuf[f] = 0;\n    outBuf[MAX_FRAMES + f] = 0;\n  }\n\n  for (let v = 0; v < NUM_VOICES; v++) {\n    if (vActive[v] == 0) continue;\n    let env: f32 = vEnv[v];\n    let car: f32 = vCar[v];\n    let mod: f32 = vMod[v];\n    const baseFreq: f32 = vFreq[v];\n    const vel: f32 = vVel[v];\n    const gate: i32 = vGate[v];\n\n    for (let f = 0; f < frames; f++) {\n      if (gate != 0) {\n        env = env + atkInc;\n        if (env > 1.0) env = 1.0;\n      } else {\n        env = env * relCoef;\n      }\n\n      const lfoPh: f32 = lfoPhase + lfoInc * f32(f);\n      const lfo: f32 = Mathf.sin(TWO_PI * lfoPh);\n      const fc: f32 = baseFreq * (f32(1.0) + vibDepth * lfo);\n      const fm: f32 = fc * ratio;\n\n      mod += fm / sampleRate;\n      if (mod >= 1.0) mod -= 1.0;\n      car += fc / sampleRate;\n      if (car >= 1.0) car -= 1.0;\n\n      const m: f32 = Mathf.sin(TWO_PI * mod);\n      const s: f32 = Mathf.sin(TWO_PI * car + index * env * m);\n      const o: f32 = f32(s * env * vel * level * 0.3);\n      outBuf[f] += o;\n      outBuf[MAX_FRAMES + f] += o;\n    }\n\n    vEnv[v] = env;\n    vCar[v] = car;\n    vMod[v] = mod;\n    if (gate == 0 && env < 0.0001) {\n      vActive[v] = 0;\n      vEnv[v] = 0;\n    }\n  }\n\n  lfoPhase += lfoInc * f32(frames);\n  while (lfoPhase >= 1.0) lfoPhase -= 1.0;\n\n  for (let f = 0; f < frames; f++) {\n    outBuf[f] = clampf(outBuf[f], -1.0, 1.0);\n    outBuf[MAX_FRAMES + f] = clampf(outBuf[MAX_FRAMES + f], -1.0, 1.0);\n  }\n}\n","html":"<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Rainbow FM</title>\n<style>\n  * { box-sizing: border-box; }\n\n  body {\n    margin: 0;\n    padding: 12px;\n    min-height: 100vh;\n    background: #14101e;\n    color: #fff;\n    font-family: \"Comic Sans MS\", \"Trebuchet MS\", sans-serif;\n    overflow-x: hidden;\n    user-select: none;\n    -webkit-user-select: none;\n  }\n\n  .panel {\n    max-width: 640px;\n    margin: 0 auto;\n    padding: 12px;\n    border-radius: 18px;\n    background: #1e1830;\n    border: 4px solid transparent;\n    background-image:\n      linear-gradient(#1e1830, #1e1830),\n      linear-gradient(90deg, #ff3b3b, #ff9f1c, #ffe94d, #3ddc5a, #2ec4ff, #6a5cff, #d64dff);\n    background-origin: border-box;\n    background-clip: padding-box, border-box;\n  }\n\n  h1 {\n    margin: 0 0 10px;\n    text-align: center;\n    font-size: 26px;\n    letter-spacing: 2px;\n    background: linear-gradient(90deg, #ff3b3b, #ff9f1c, #ffe94d, #3ddc5a, #2ec4ff, #6a5cff, #d64dff);\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n  }\n\n  .knobs {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));\n    gap: 10px;\n    margin-bottom: 14px;\n  }\n\n  .knob-wrap {\n    text-align: center;\n    font-size: 12px;\n  }\n\n  .knob {\n    width: 58px;\n    height: 58px;\n    margin: 0 auto 4px;\n    border-radius: 50%;\n    position: relative;\n    cursor: ns-resize;\n    touch-action: none;\n    border: 3px solid #0e0a18;\n  }\n\n  .knob::after {\n    content: \"\";\n    position: absolute;\n    left: 50%;\n    top: 4px;\n    width: 4px;\n    height: 22px;\n    margin-left: -2px;\n    border-radius: 2px;\n    background: #fff;\n    transform-origin: 50% 25px;\n    transform: rotate(var(--rot, 0deg));\n  }\n\n  .val { opacity: 0.8; font-size: 11px; }\n\n  .keyboard {\n    position: relative;\n    height: 150px;\n    display: flex;\n    border-radius: 8px;\n    overflow: hidden;\n  }\n\n  .key {\n    touch-action: none;\n  }\n\n  .key.white {\n    flex: 1;\n    background: #f6f3ff;\n    border: 1px solid #3a3050;\n    border-radius: 0 0 6px 6px;\n  }\n\n  .key.black {\n    position: absolute;\n    top: 0;\n    width: 6%;\n    height: 60%;\n    background: #17121f;\n    border: 1px solid #000;\n    border-radius: 0 0 5px 5px;\n    z-index: 2;\n  }\n\n  .key.white.down { background: var(--hue); }\n  .key.black.down { background: var(--hue); }\n\n  .hint {\n    margin-top: 8px;\n    text-align: center;\n    font-size: 11px;\n    opacity: 0.6;\n  }\n</style>\n</head>\n<body>\n<div class=\"panel\">\n  <h1>RAINBOW FM</h1>\n  <div class=\"knobs\" id=\"knobs\"></div>\n  <div class=\"keyboard\" id=\"keyboard\"></div>\n  <div class=\"hint\">Play with the mouse or type: A W S E D F T G Y H U J K O L P ;</div>\n</div>\n\n<script>\n  const CONTROLS = [\n    { name: 'Level',   index: 0, min: 0,     max: 1,  def: 0.6,  hue: 0,   fmt: v => Math.round(v * 100) + '%' },\n    { name: 'Ratio',   index: 1, min: 0.5,   max: 8,  def: 2,    hue: 40,  fmt: v => v.toFixed(2) + 'x' },\n    { name: 'Index',   index: 2, min: 0,     max: 10, def: 3,    hue: 70,  fmt: v => v.toFixed(1) },\n    { name: 'Attack',  index: 3, min: 0.001, max: 2,  def: 0.01, hue: 130, fmt: v => v.toFixed(3) + 's' },\n    { name: 'Release', index: 4, min: 0.02,  max: 3,  def: 0.4,  hue: 200, fmt: v => v.toFixed(2) + 's' },\n    { name: 'Wobble',  index: 5, min: 0,     max: 1,  def: 0,    hue: 290, fmt: v => Math.round(v * 100) + '%' }\n  ];\n\n  const BASE_NOTE = 60;\n  const LAST_NOTE = 76;\n\n  const KEY_MAP = {\n    KeyA: 0, KeyW: 1, KeyS: 2, KeyE: 3, KeyD: 4, KeyF: 5, KeyT: 6,\n    KeyG: 7, KeyY: 8, KeyH: 9, KeyU: 10, KeyJ: 11, KeyK: 12, KeyO: 13,\n    KeyL: 14, KeyP: 15, Semicolon: 16\n  };\n\n  const BLACK_PCS = [1, 3, 6, 8, 10];\n\n  function clamp(v, lo, hi) {\n    return Math.min(hi, Math.max(lo, v));\n  }\n\n  function makeKnob(ctrl, parent) {\n    let value = ctrl.def;\n\n    const wrap = document.createElement('div');\n    wrap.className = 'knob-wrap';\n\n    const knob = document.createElement('div');\n    knob.className = 'knob';\n    knob.setAttribute('data-param', String(ctrl.index));\n\n    const label = document.createElement('div');\n    label.textContent = ctrl.name;\n\n    const readout = document.createElement('div');\n    readout.className = 'val';\n\n    wrap.appendChild(knob);\n    wrap.appendChild(label);\n    wrap.appendChild(readout);\n    parent.appendChild(wrap);\n\n    function draw() {\n      const t = (value - ctrl.min) / (ctrl.max - ctrl.min);\n      knob.style.setProperty('--rot', (-135 + t * 270) + 'deg');\n      knob.style.background = 'conic-gradient(from 225deg, hsl(' + ctrl.hue + ',90%,60%) ' +\n        (t * 270) + 'deg, #2b2340 ' + (t * 270) + 'deg 270deg, transparent 270deg)';\n      readout.textContent = ctrl.fmt(value);\n    }\n\n    function set(v) {\n      value = clamp(v, ctrl.min, ctrl.max);\n      draw();\n      window.vstai.setParam(ctrl.index, value);\n    }\n\n    window.vstai.onParam((i, v) => {\n      if (i === ctrl.index) {\n        value = clamp(+v, ctrl.min, ctrl.max);\n        draw();\n      }\n    });\n\n    let startY = 0;\n    let startVal = 0;\n    let dragging = false;\n\n    knob.addEventListener('pointerdown', e => {\n      dragging = true;\n      startY = e.clientY;\n      startVal = value;\n      knob.setPointerCapture(e.pointerId);\n    });\n\n    knob.addEventListener('pointermove', e => {\n      if (!dragging) return;\n      const dy = startY - e.clientY;\n      set(startVal + (dy / 150) * (ctrl.max - ctrl.min));\n    });\n\n    knob.addEventListener('pointerup', () => { dragging = false; });\n    knob.addEventListener('pointercancel', () => { dragging = false; });\n    knob.addEventListener('dblclick', () => { set(ctrl.def); });\n\n    draw();\n    set(ctrl.def);\n  }\n\n  function buildKeyboard() {\n    const kb = document.getElementById('keyboard');\n    const keyEls = {};\n    const held = {};\n    let whiteCount = 0;\n\n    for (let n = BASE_NOTE; n <= LAST_NOTE; n++) {\n      if (BLACK_PCS.indexOf(n % 12) < 0) whiteCount++;\n    }\n\n    let whiteIdx = 0;\n    for (let n = BASE_NOTE; n <= LAST_NOTE; n++) {\n      const isBlack = BLACK_PCS.indexOf(n % 12) >= 0;\n      const el = document.createElement('div');\n      el.className = 'key ' + (isBlack ? 'black' : 'white');\n      el.style.setProperty('--hue', 'hsl(' + ((n - BASE_NOTE) * 22) % 360 + ',95%,58%)');\n\n      if (isBlack) {\n        el.style.left = (whiteIdx * (100 / whiteCount) - 3) + '%';\n      } else {\n        whiteIdx++;\n      }\n\n      keyEls[n] = el;\n      kb.appendChild(el);\n      wireKey(el, n);\n    }\n\n    function press(note) {\n      if (held[note]) return;\n      held[note] = true;\n      keyEls[note].classList.add('down');\n      window.vstai.noteOn(note, 0.8);\n    }\n\n    function release(note) {\n      if (!held[note]) return;\n      held[note] = false;\n      keyEls[note].classList.remove('down');\n      window.vstai.noteOff(note);\n    }\n\n    function wireKey(el, note) {\n      el.addEventListener('pointerdown', e => {\n        e.preventDefault();\n        el.setPointerCapture(e.pointerId);\n        press(note);\n      });\n      el.addEventListener('pointerup', () => release(note));\n      el.addEventListener('pointercancel', () => release(note));\n    }\n\n    const codeToNote = {};\n\n    function typingBlocked(e) {\n      if (e.metaKey || e.ctrlKey || e.altKey) return true;\n      const t = document.activeElement;\n      if (!t) return false;\n      const tag = t.tagName;\n      return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || t.isContentEditable;\n    }\n\n    window.addEventListener('keydown', e => {\n      if (!(e.code in KEY_MAP)) return;\n      if (typingBlocked(e)) return;\n      e.preventDefault();\n      if (e.repeat) return;\n      if (codeToNote[e.code] !== undefined) return;\n      const note = BASE_NOTE + KEY_MAP[e.code];\n      codeToNote[e.code] = note;\n      press(note);\n    });\n\n    window.addEventListener('keyup', e => {\n      if (!(e.code in KEY_MAP)) return;\n      const note = codeToNote[e.code];\n      if (note === undefined) return;\n      e.preventDefault();\n      delete codeToNote[e.code];\n      release(note);\n    });\n\n    window.addEventListener('blur', () => {\n      for (const code in codeToNote) {\n        release(codeToNote[code]);\n        delete codeToNote[code];\n      }\n    });\n  }\n\n  function start() {\n    const knobs = document.getElementById('knobs');\n    CONTROLS.forEach(c => makeKnob(c, knobs));\n    buildKeyboard();\n  }\n\n  function waitForHost() {\n    if (window.vstai && window.vstai.onParam) {\n      start();\n    } else {\n      setTimeout(waitForHost, 50);\n    }\n  }\n\n  waitForHost();\n</script>\n</body>\n</html>\n","wasmBase64":"","explanation":"An 8-voice 2-operator FM synth (sine carrier modulated by a sine at an adjustable ratio, index scaled by the envelope) with attack/release and a vibrato wobble. The GUI has a rainbow theme, conic-gradient knobs that follow host automation via onParam, and a rainbow-lit keyboard that is also playable from the typing keys.","isInstrument":true,"locked":false,"provider":"cloud","model":"claude-sonnet-5-5","effort":"medium","thinking":true,"promptHistory":["make a simple FM synth with funny rainbow design"],"params":[{"name":"Level","index":0,"min":0,"max":1,"default":0.6,"value":0.600000023841858},{"name":"Ratio","index":1,"min":0.5,"max":8,"default":2,"value":1.719140410423279},{"name":"Index","index":2,"min":0,"max":10,"default":3,"value":5.098697662353516},{"name":"Attack","index":3,"min":0.001,"max":2,"default":0.01,"value":1.478380084037781},{"name":"Release","index":4,"min":0.02,"max":3,"default":0.4,"value":3},{"name":"Wobble","index":5,"min":0,"max":1,"default":0,"value":1}],"presets":[],"revisions":[{"id":1,"parent":0,"prompt":"make a simple FM synth with funny rainbow design","assembly":"const MAX_FRAMES: i32 = 8192;\nconst MAX_CHANNELS: i32 = 2;\nconst MAX_PARAMS: i32 = 64;\nconst NUM_VOICES: i32 = 8;\n\nconst inBuf = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\nconst outBuf = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\nconst params = new StaticArray<f32>(MAX_PARAMS);\n\nconst TWO_PI: f32 = 6.2831853;\n\nlet sampleRate: f32 = 44100;\nlet lfoPhase: f32 = 0;\nlet nextSteal: i32 = 0;\n\nconst vActive = new StaticArray<i32>(NUM_VOICES);\nconst vGate = new StaticArray<i32>(NUM_VOICES);\nconst vNote = new StaticArray<i32>(NUM_VOICES);\nconst vFreq = new StaticArray<f32>(NUM_VOICES);\nconst vVel = new StaticArray<f32>(NUM_VOICES);\nconst vEnv = new StaticArray<f32>(NUM_VOICES);\nconst vCar = new StaticArray<f32>(NUM_VOICES);\nconst vMod = new StaticArray<f32>(NUM_VOICES);\n\nfunction clampf(x: f32, lo: f32, hi: f32): f32 {\n  let y: f32 = x;\n  if (y < lo) y = lo;\n  if (y > hi) y = hi;\n  return f32(y);\n}\n\nexport function init(sr: f32, maxFrames: i32, ch: i32): void {\n  sampleRate = sr;\n  lfoPhase = 0;\n  nextSteal = 0;\n  for (let v = 0; v < NUM_VOICES; v++) {\n    vActive[v] = 0;\n    vGate[v] = 0;\n    vNote[v] = -1;\n    vFreq[v] = 440;\n    vVel[v] = 0;\n    vEnv[v] = 0;\n    vCar[v] = 0;\n    vMod[v] = 0;\n  }\n  params[0] = 0.6;   // level\n  params[1] = 2.0;   // ratio\n  params[2] = 3.0;   // index\n  params[3] = 0.01;  // attack (s)\n  params[4] = 0.4;   // release (s)\n  params[5] = 0.0;   // wobble\n}\n\nexport function getInputPtr(): usize { return changetype<usize>(inBuf); }\nexport function getOutputPtr(): usize { return changetype<usize>(outBuf); }\nexport function getParamsPtr(): usize { return changetype<usize>(params); }\nexport function getNumParams(): i32 { return 6; }\n\nexport function noteOn(id: i32, f: f32, v: f32): void {\n  let slot: i32 = -1;\n  for (let i = 0; i < NUM_VOICES; i++) {\n    if (vActive[i] != 0 && vNote[i] == id) {\n      slot = i;\n      break;\n    }\n  }\n  if (slot < 0) {\n    for (let i = 0; i < NUM_VOICES; i++) {\n      if (vActive[i] == 0) {\n        slot = i;\n        break;\n      }\n    }\n  }\n  if (slot < 0) {\n    slot = nextSteal;\n    nextSteal = (nextSteal + 1) % NUM_VOICES;\n  }\n  vActive[slot] = 1;\n  vGate[slot] = 1;\n  vNote[slot] = id;\n  vFreq[slot] = f;\n  vVel[slot] = clampf(v, 0.05, 1.0);\n}\n\nexport function noteOff(id: i32): void {\n  for (let i = 0; i < NUM_VOICES; i++) {\n    if (vActive[i] != 0 && vNote[i] == id) {\n      vGate[i] = 0;\n    }\n  }\n}\n\nexport function process(n: i32): void {\n  let frames: i32 = n;\n  if (frames > MAX_FRAMES) frames = MAX_FRAMES;\n\n  const level: f32 = clampf(params[0], 0.0, 1.0);\n  const ratio: f32 = clampf(params[1], 0.25, 16.0);\n  const index: f32 = clampf(params[2], 0.0, 12.0);\n  const attack: f32 = clampf(params[3], 0.001, 3.0);\n  const release: f32 = clampf(params[4], 0.01, 5.0);\n  const wobble: f32 = clampf(params[5], 0.0, 1.0);\n\n  const atkInc: f32 = f32(1.0) / (attack * sampleRate);\n  const relCoef: f32 = Mathf.exp(f32(-5.0) / (release * sampleRate));\n  const lfoInc: f32 = f32(5.0) / sampleRate;\n  const vibDepth: f32 = f32(0.03) * wobble;\n\n  for (let f = 0; f < frames; f++) {\n    outBuf[f] = 0;\n    outBuf[MAX_FRAMES + f] = 0;\n  }\n\n  for (let v = 0; v < NUM_VOICES; v++) {\n    if (vActive[v] == 0) continue;\n    let env: f32 = vEnv[v];\n    let car: f32 = vCar[v];\n    let mod: f32 = vMod[v];\n    const baseFreq: f32 = vFreq[v];\n    const vel: f32 = vVel[v];\n    const gate: i32 = vGate[v];\n\n    for (let f = 0; f < frames; f++) {\n      if (gate != 0) {\n        env = env + atkInc;\n        if (env > 1.0) env = 1.0;\n      } else {\n        env = env * relCoef;\n      }\n\n      const lfoPh: f32 = lfoPhase + lfoInc * f32(f);\n      const lfo: f32 = Mathf.sin(TWO_PI * lfoPh);\n      const fc: f32 = baseFreq * (f32(1.0) + vibDepth * lfo);\n      const fm: f32 = fc * ratio;\n\n      mod += fm / sampleRate;\n      if (mod >= 1.0) mod -= 1.0;\n      car += fc / sampleRate;\n      if (car >= 1.0) car -= 1.0;\n\n      const m: f32 = Mathf.sin(TWO_PI * mod);\n      const s: f32 = Mathf.sin(TWO_PI * car + index * env * m);\n      const o: f32 = f32(s * env * vel * level * 0.3);\n      outBuf[f] += o;\n      outBuf[MAX_FRAMES + f] += o;\n    }\n\n    vEnv[v] = env;\n    vCar[v] = car;\n    vMod[v] = mod;\n    if (gate == 0 && env < 0.0001) {\n      vActive[v] = 0;\n      vEnv[v] = 0;\n    }\n  }\n\n  lfoPhase += lfoInc * f32(frames);\n  while (lfoPhase >= 1.0) lfoPhase -= 1.0;\n\n  for (let f = 0; f < frames; f++) {\n    outBuf[f] = clampf(outBuf[f], -1.0, 1.0);\n    outBuf[MAX_FRAMES + f] = clampf(outBuf[MAX_FRAMES + f], -1.0, 1.0);\n  }\n}\n","html":"<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Rainbow FM</title>\n<style>\n  * { box-sizing: border-box; }\n\n  body {\n    margin: 0;\n    padding: 12px;\n    min-height: 100vh;\n    background: #14101e;\n    color: #fff;\n    font-family: \"Comic Sans MS\", \"Trebuchet MS\", sans-serif;\n    overflow-x: hidden;\n    user-select: none;\n    -webkit-user-select: none;\n  }\n\n  .panel {\n    max-width: 640px;\n    margin: 0 auto;\n    padding: 12px;\n    border-radius: 18px;\n    background: #1e1830;\n    border: 4px solid transparent;\n    background-image:\n      linear-gradient(#1e1830, #1e1830),\n      linear-gradient(90deg, #ff3b3b, #ff9f1c, #ffe94d, #3ddc5a, #2ec4ff, #6a5cff, #d64dff);\n    background-origin: border-box;\n    background-clip: padding-box, border-box;\n  }\n\n  h1 {\n    margin: 0 0 10px;\n    text-align: center;\n    font-size: 26px;\n    letter-spacing: 2px;\n    background: linear-gradient(90deg, #ff3b3b, #ff9f1c, #ffe94d, #3ddc5a, #2ec4ff, #6a5cff, #d64dff);\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n  }\n\n  .knobs {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));\n    gap: 10px;\n    margin-bottom: 14px;\n  }\n\n  .knob-wrap {\n    text-align: center;\n    font-size: 12px;\n  }\n\n  .knob {\n    width: 58px;\n    height: 58px;\n    margin: 0 auto 4px;\n    border-radius: 50%;\n    position: relative;\n    cursor: ns-resize;\n    touch-action: none;\n    border: 3px solid #0e0a18;\n  }\n\n  .knob::after {\n    content: \"\";\n    position: absolute;\n    left: 50%;\n    top: 4px;\n    width: 4px;\n    height: 22px;\n    margin-left: -2px;\n    border-radius: 2px;\n    background: #fff;\n    transform-origin: 50% 25px;\n    transform: rotate(var(--rot, 0deg));\n  }\n\n  .val { opacity: 0.8; font-size: 11px; }\n\n  .keyboard {\n    position: relative;\n    height: 150px;\n    display: flex;\n    border-radius: 8px;\n    overflow: hidden;\n  }\n\n  .key {\n    touch-action: none;\n  }\n\n  .key.white {\n    flex: 1;\n    background: #f6f3ff;\n    border: 1px solid #3a3050;\n    border-radius: 0 0 6px 6px;\n  }\n\n  .key.black {\n    position: absolute;\n    top: 0;\n    width: 6%;\n    height: 60%;\n    background: #17121f;\n    border: 1px solid #000;\n    border-radius: 0 0 5px 5px;\n    z-index: 2;\n  }\n\n  .key.white.down { background: var(--hue); }\n  .key.black.down { background: var(--hue); }\n\n  .hint {\n    margin-top: 8px;\n    text-align: center;\n    font-size: 11px;\n    opacity: 0.6;\n  }\n</style>\n</head>\n<body>\n<div class=\"panel\">\n  <h1>RAINBOW FM</h1>\n  <div class=\"knobs\" id=\"knobs\"></div>\n  <div class=\"keyboard\" id=\"keyboard\"></div>\n  <div class=\"hint\">Play with the mouse or type: A W S E D F T G Y H U J K O L P ;</div>\n</div>\n\n<script>\n  const CONTROLS = [\n    { name: 'Level',   index: 0, min: 0,     max: 1,  def: 0.6,  hue: 0,   fmt: v => Math.round(v * 100) + '%' },\n    { name: 'Ratio',   index: 1, min: 0.5,   max: 8,  def: 2,    hue: 40,  fmt: v => v.toFixed(2) + 'x' },\n    { name: 'Index',   index: 2, min: 0,     max: 10, def: 3,    hue: 70,  fmt: v => v.toFixed(1) },\n    { name: 'Attack',  index: 3, min: 0.001, max: 2,  def: 0.01, hue: 130, fmt: v => v.toFixed(3) + 's' },\n    { name: 'Release', index: 4, min: 0.02,  max: 3,  def: 0.4,  hue: 200, fmt: v => v.toFixed(2) + 's' },\n    { name: 'Wobble',  index: 5, min: 0,     max: 1,  def: 0,    hue: 290, fmt: v => Math.round(v * 100) + '%' }\n  ];\n\n  const BASE_NOTE = 60;\n  const LAST_NOTE = 76;\n\n  const KEY_MAP = {\n    KeyA: 0, KeyW: 1, KeyS: 2, KeyE: 3, KeyD: 4, KeyF: 5, KeyT: 6,\n    KeyG: 7, KeyY: 8, KeyH: 9, KeyU: 10, KeyJ: 11, KeyK: 12, KeyO: 13,\n    KeyL: 14, KeyP: 15, Semicolon: 16\n  };\n\n  const BLACK_PCS = [1, 3, 6, 8, 10];\n\n  function clamp(v, lo, hi) {\n    return Math.min(hi, Math.max(lo, v));\n  }\n\n  function makeKnob(ctrl, parent) {\n    let value = ctrl.def;\n\n    const wrap = document.createElement('div');\n    wrap.className = 'knob-wrap';\n\n    const knob = document.createElement('div');\n    knob.className = 'knob';\n    knob.setAttribute('data-param', String(ctrl.index));\n\n    const label = document.createElement('div');\n    label.textContent = ctrl.name;\n\n    const readout = document.createElement('div');\n    readout.className = 'val';\n\n    wrap.appendChild(knob);\n    wrap.appendChild(label);\n    wrap.appendChild(readout);\n    parent.appendChild(wrap);\n\n    function draw() {\n      const t = (value - ctrl.min) / (ctrl.max - ctrl.min);\n      knob.style.setProperty('--rot', (-135 + t * 270) + 'deg');\n      knob.style.background = 'conic-gradient(from 225deg, hsl(' + ctrl.hue + ',90%,60%) ' +\n        (t * 270) + 'deg, #2b2340 ' + (t * 270) + 'deg 270deg, transparent 270deg)';\n      readout.textContent = ctrl.fmt(value);\n    }\n\n    function set(v) {\n      value = clamp(v, ctrl.min, ctrl.max);\n      draw();\n      window.vstai.setParam(ctrl.index, value);\n    }\n\n    window.vstai.onParam((i, v) => {\n      if (i === ctrl.index) {\n        value = clamp(+v, ctrl.min, ctrl.max);\n        draw();\n      }\n    });\n\n    let startY = 0;\n    let startVal = 0;\n    let dragging = false;\n\n    knob.addEventListener('pointerdown', e => {\n      dragging = true;\n      startY = e.clientY;\n      startVal = value;\n      knob.setPointerCapture(e.pointerId);\n    });\n\n    knob.addEventListener('pointermove', e => {\n      if (!dragging) return;\n      const dy = startY - e.clientY;\n      set(startVal + (dy / 150) * (ctrl.max - ctrl.min));\n    });\n\n    knob.addEventListener('pointerup', () => { dragging = false; });\n    knob.addEventListener('pointercancel', () => { dragging = false; });\n    knob.addEventListener('dblclick', () => { set(ctrl.def); });\n\n    draw();\n    set(ctrl.def);\n  }\n\n  function buildKeyboard() {\n    const kb = document.getElementById('keyboard');\n    const keyEls = {};\n    const held = {};\n    let whiteCount = 0;\n\n    for (let n = BASE_NOTE; n <= LAST_NOTE; n++) {\n      if (BLACK_PCS.indexOf(n % 12) < 0) whiteCount++;\n    }\n\n    let whiteIdx = 0;\n    for (let n = BASE_NOTE; n <= LAST_NOTE; n++) {\n      const isBlack = BLACK_PCS.indexOf(n % 12) >= 0;\n      const el = document.createElement('div');\n      el.className = 'key ' + (isBlack ? 'black' : 'white');\n      el.style.setProperty('--hue', 'hsl(' + ((n - BASE_NOTE) * 22) % 360 + ',95%,58%)');\n\n      if (isBlack) {\n        el.style.left = (whiteIdx * (100 / whiteCount) - 3) + '%';\n      } else {\n        whiteIdx++;\n      }\n\n      keyEls[n] = el;\n      kb.appendChild(el);\n      wireKey(el, n);\n    }\n\n    function press(note) {\n      if (held[note]) return;\n      held[note] = true;\n      keyEls[note].classList.add('down');\n      window.vstai.noteOn(note, 0.8);\n    }\n\n    function release(note) {\n      if (!held[note]) return;\n      held[note] = false;\n      keyEls[note].classList.remove('down');\n      window.vstai.noteOff(note);\n    }\n\n    function wireKey(el, note) {\n      el.addEventListener('pointerdown', e => {\n        e.preventDefault();\n        el.setPointerCapture(e.pointerId);\n        press(note);\n      });\n      el.addEventListener('pointerup', () => release(note));\n      el.addEventListener('pointercancel', () => release(note));\n    }\n\n    const codeToNote = {};\n\n    function typingBlocked(e) {\n      if (e.metaKey || e.ctrlKey || e.altKey) return true;\n      const t = document.activeElement;\n      if (!t) return false;\n      const tag = t.tagName;\n      return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || t.isContentEditable;\n    }\n\n    window.addEventListener('keydown', e => {\n      if (!(e.code in KEY_MAP)) return;\n      if (typingBlocked(e)) return;\n      e.preventDefault();\n      if (e.repeat) return;\n      if (codeToNote[e.code] !== undefined) return;\n      const note = BASE_NOTE + KEY_MAP[e.code];\n      codeToNote[e.code] = note;\n      press(note);\n    });\n\n    window.addEventListener('keyup', e => {\n      if (!(e.code in KEY_MAP)) return;\n      const note = codeToNote[e.code];\n      if (note === undefined) return;\n      e.preventDefault();\n      delete codeToNote[e.code];\n      release(note);\n    });\n\n    window.addEventListener('blur', () => {\n      for (const code in codeToNote) {\n        release(codeToNote[code]);\n        delete codeToNote[code];\n      }\n    });\n  }\n\n  function start() {\n    const knobs = document.getElementById('knobs');\n    CONTROLS.forEach(c => makeKnob(c, knobs));\n    buildKeyboard();\n  }\n\n  function waitForHost() {\n    if (window.vstai && window.vstai.onParam) {\n      start();\n    } else {\n      setTimeout(waitForHost, 50);\n    }\n  }\n\n  waitForHost();\n</script>\n</body>\n</html>\n","explanation":"An 8-voice 2-operator FM synth (sine carrier modulated by a sine at an adjustable ratio, index scaled by the envelope) with attack/release and a vibrato wobble. The GUI has a rainbow theme, conic-gradient knobs that follow host automation via onParam, and a rainbow-lit keyboard that is also playable from the typing keys.","provider":"cloud","model":"claude-sonnet-5-5","wasmBase64":"","isInstrument":false,"timestamp":1792536902409,"params":[{"name":"Level","index":0,"min":0,"max":1,"default":0.6,"value":0.6},{"name":"Ratio","index":1,"min":0.5,"max":8,"default":2,"value":2},{"name":"Index","index":2,"min":0,"max":10,"default":3,"value":3},{"name":"Attack","index":3,"min":0.001,"max":2,"default":0.01,"value":0.01},{"name":"Release","index":4,"min":0.02,"max":3,"default":0.4,"value":0.4},{"name":"Wobble","index":5,"min":0,"max":1,"default":0,"value":0}]}],"activeRevision":1,"nextRevisionId":2,"publishedAt":1792537002122}