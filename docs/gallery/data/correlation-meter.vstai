{
  "format": 1,
  "name": "Correlation Meter",
  "isInstrument": false,
  "explanation": "A phase/correlation meter with a live goniometer. Correlation is a running coefficient (exponential moving averages of L*R, L^2, R^2): +1 fully correlated (mono-safe), 0 uncorrelated, -1 fully out of phase (will cancel to silence in mono). Goniometer mode plots the standard 45-degree-rotated Mid/Side basis (mono collapses to a vertical line); Lissajous mode plots raw L/R (mono draws a diagonal instead). The meter always analyzes the true, pre-sum stereo signal - Mono Check only changes what you HEAR (sums L+R to both channels) so you can audition mono compatibility while still watching the real stereo relationship causing whatever you hear.",
  "params": [
    {
      "name": "Mono Check",
      "index": 0,
      "min": 0,
      "max": 1,
      "default": 0
    },
    {
      "name": "Ballistics",
      "index": 1,
      "min": 0,
      "max": 1,
      "default": 0.4
    },
    {
      "name": "Mode",
      "index": 2,
      "min": 0,
      "max": 1,
      "default": 0
    },
    {
      "name": "Freeze",
      "index": 3,
      "min": 0,
      "max": 1,
      "default": 0
    }
  ],
  "wasmBase64": "",
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Correlation Meter</title>\n<style>\n  :root {\n    --accent: #7ee0ff; --accent2: #d8f7ff;\n    --bg0: #050a0c; --bg1: #0a161a;\n    --ink: #eafcff; --ink-dim: #6d95a0;\n    --panel: rgba(12, 28, 32, 0.6); --stroke: rgba(126, 224, 255, 0.18);\n    --ok: #6fcf97; --warn: #f2c94c; --bad: #eb5757;\n  }\n  * { box-sizing: border-box; }\n  html, body {\n    margin: 0; padding: 0; background: var(--bg0); color: var(--ink);\n    font-family: ui-sans-serif, -apple-system, \"Segoe UI\", system-ui, sans-serif;\n    -webkit-font-smoothing: antialiased;\n  }\n  .stage { min-height: 100vh; padding: 18px; background: linear-gradient(180deg, var(--bg1), var(--bg0) 70%); }\n  h1 { font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); margin: 0 0 14px; font-weight: 700; }\n  .layout { display: flex; gap: 12px; flex-wrap: wrap; }\n  .panel { background: var(--panel); border: 1px solid var(--stroke); border-radius: 12px; padding: 16px; backdrop-filter: blur(6px); }\n  #gonio { width: 260px; height: 260px; display: block; border-radius: 10px; background: #020508; }\n  .side { display: flex; flex-direction: column; gap: 12px; min-width: 200px; }\n  .corrRo .lbl { font-size: 10px; letter-spacing: 0.1em; color: var(--ink-dim); text-transform: uppercase; }\n  .corrRo .val { font-family: ui-monospace, \"SF Mono\", Menlo, monospace; font-size: 30px; font-weight: 700; margin-top: 2px; }\n  .corrBar { width: 100%; height: 10px; border-radius: 5px; background: rgba(255,255,255,0.08); margin-top: 8px; position: relative; overflow: hidden; }\n  .corrBar .fill { position: absolute; top: 0; bottom: 0; left: 50%; background: var(--accent); }\n  .ctl { display: flex; flex-direction: column; gap: 4px; }\n  .ctl .lbl { font-size: 10px; letter-spacing: 0.08em; color: var(--ink-dim); text-transform: uppercase; }\n  input[type=\"range\"] { width: 100%; accent-color: var(--accent); }\n  .seg { display: flex; border: 1px solid var(--stroke); border-radius: 6px; overflow: hidden; width: fit-content; }\n  .seg button { background: transparent; border: none; color: var(--ink-dim); padding: 6px 10px; font-size: 11px; cursor: pointer; font-family: inherit; }\n  .seg button.on { background: var(--accent); color: #05282f; font-weight: 700; }\n  .tgBtn { background: rgba(126,224,255,0.1); border: 1px solid var(--stroke); color: var(--ink); border-radius: 6px; padding: 7px 12px; font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; cursor: pointer; font-family: inherit; width: fit-content; }\n  .tgBtn.on { background: var(--accent); color: #05282f; font-weight: 700; }\n</style>\n</head>\n<body>\n<div class=\"stage\">\n  <h1>Correlation Meter</h1>\n  <div class=\"layout\">\n    <div class=\"panel\"><canvas id=\"gonio\"></canvas></div>\n    <div class=\"panel side\">\n      <div class=\"corrRo\">\n        <div class=\"lbl\">Correlation</div>\n        <div class=\"val\" id=\"corrVal\">0.00</div>\n        <div class=\"corrBar\"><div class=\"fill\" id=\"corrFill\"></div></div>\n      </div>\n      <div class=\"ctl\"><div class=\"lbl\">Ballistics</div><input type=\"range\" id=\"ball\" min=\"0\" max=\"1\" step=\"0.001\" value=\"0.4\"></div>\n      <div class=\"ctl\"><div class=\"lbl\">Mode</div><div class=\"seg\" id=\"modeSeg\"></div></div>\n      <div class=\"ctl\"><button class=\"tgBtn\" id=\"monoBtn\">Mono Check</button></div>\n      <div class=\"ctl\"><button class=\"tgBtn\" id=\"freezeBtn\">Freeze</button></div>\n    </div>\n  </div>\n</div>\n<script>\n(function () {\n  var V = {};\n  function set(i, v) { V[i] = v; if (window.vstai && typeof window.vstai.setParam === \"function\") window.vstai.setParam(i, v); }\n\n  function buildSeg(host, idx, opts) {\n    host.innerHTML = \"\";\n    var btns = opts.map(function (label, k) {\n      var b = document.createElement(\"button\");\n      b.textContent = label;\n      b.onclick = function () { set(idx, k); refresh(); };\n      host.appendChild(b);\n      return b;\n    });\n    function refresh() { btns.forEach(function (b, k) { b.className = Math.round(V[idx]) === k ? \"on\" : \"\"; }); }\n    refresh();\n    return refresh;\n  }\n  function buildToggle(el, idx) {\n    el.onclick = function () { set(idx, V[idx] > 0.5 ? 0 : 1); refresh(); };\n    function refresh() { el.className = \"tgBtn\" + (V[idx] > 0.5 ? \" on\" : \"\"); }\n    refresh();\n    return refresh;\n  }\n\n  var refreshMode, refreshMono, refreshFreeze;\n  var hasDisp = false;\n  var disp = new Array(16).fill(0);\n\n  var cv = document.getElementById(\"gonio\");\n  var cx = cv.getContext(\"2d\");\n  function colorForCorr(c) {\n    if (c > 0.3) return \"var(--ok)\";\n    if (c > -0.3) return \"var(--warn)\";\n    return \"var(--bad)\";\n  }\n\n  function drawGonio() {\n    var dpr = window.devicePixelRatio || 1;\n    var W = cv.clientWidth, H = cv.clientHeight;\n    if (cv.width !== Math.round(W * dpr)) { cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr); }\n    cx.setTransform(dpr, 0, 0, dpr, 0, 0);\n    // phosphor persistence: partial-clear instead of full clear\n    cx.fillStyle = \"rgba(2,5,8,0.14)\";\n    cx.fillRect(0, 0, W, H);\n    // crosshair\n    cx.strokeStyle = \"rgba(126,224,255,0.15)\"; cx.lineWidth = 1;\n    cx.beginPath(); cx.moveTo(W / 2, 0); cx.lineTo(W / 2, H); cx.moveTo(0, H / 2); cx.lineTo(W, H / 2); cx.stroke();\n\n    if (!hasDisp) return;\n    var cx0 = W / 2, cy0 = H / 2, s = Math.min(W, H) * 0.46;\n    cx.fillStyle = \"#7ee0ff\";\n    for (var k = 0; k < 7; k++) {\n      var x = disp[1 + k * 2], y = disp[2 + k * 2];\n      var px = cx0 + x * s, py = cy0 - y * s;\n      cx.beginPath(); cx.arc(px, py, 2, 0, 6.2832); cx.fill();\n    }\n  }\n\n  function tick() {\n    if (hasDisp) {\n      var c = disp[0];\n      document.getElementById(\"corrVal\").textContent = c.toFixed(2);\n      document.getElementById(\"corrVal\").style.color = colorForCorr(c);\n      var fill = document.getElementById(\"corrFill\");\n      var pct = Math.abs(c) * 50;\n      fill.style.width = pct + \"%\";\n      fill.style.left = c >= 0 ? \"50%\" : (50 - pct) + \"%\";\n      fill.style.background = colorForCorr(c);\n    }\n    drawGonio();\n    requestAnimationFrame(tick);\n  }\n\n  function boot() {\n    set(0, 0); set(1, 0.4); set(2, 0); set(3, 0);\n    document.getElementById(\"ball\").addEventListener(\"input\", function (e) { set(1, +e.target.value); });\n    refreshMode = buildSeg(document.getElementById(\"modeSeg\"), 2, [\"GONIO\", \"LISSAJOUS\"]);\n    refreshMono = buildToggle(document.getElementById(\"monoBtn\"), 0);\n    refreshFreeze = buildToggle(document.getElementById(\"freezeBtn\"), 3);\n\n    if (window.vstai && window.vstai.onParam) window.vstai.onParam(function (i, v) {\n      V[i] = +v;\n      if (i === 1) document.getElementById(\"ball\").value = v;\n      if (i === 2 && refreshMode) refreshMode();\n      if (i === 0 && refreshMono) refreshMono();\n      if (i === 3 && refreshFreeze) refreshFreeze();\n    });\n    if (window.vstai && window.vstai.onDisplay) window.vstai.onDisplay(function (d) {\n      hasDisp = true;\n      for (var i = 0; i < 16; i++) disp[i] = d[i] || 0;\n    });\n    requestAnimationFrame(tick);\n  }\n\n  if (window.vstai && typeof window.vstai.onReady === \"function\") window.vstai.onReady(boot);\n  else boot();\n})();\n</script>\n</body>\n</html>\n",
  "assembly": "// =====================================================================\n//  CORRELATION METER — a phase/correlation meter with a live goniometer.\n//  Correlation is a running Pearson-style coefficient from exponential\n//  moving averages of L*R, L^2 and R^2: corr = E[LR]/sqrt(E[L^2]*E[R^2]).\n//  The goniometer packs ~7 evenly-spaced (X,Y) sample pairs per block\n//  into the getDisplayPtr() telemetry channel for the GUI to accumulate\n//  into a fading-trail scatter plot - Goniometer mode uses the standard\n//  45-degree-rotated Mid/Side basis (X=Side, Y=Mid, so mono collapses to\n//  a vertical line); Lissajous mode plots raw L/R (mono draws a 45-degree\n//  diagonal instead). The meter always analyzes the true, pre-sum L/R\n//  signal - Mono Check only changes what you HEAR (sums L+R to both\n//  output channels), not what the meter measures, so you can audition\n//  mono compatibility while still seeing the real stereo relationship\n//  that's causing it.\n//  Original implementation, no code or samples borrowed.\n// =====================================================================\nconst MAX_FRAMES: i32 = 8192;\nconst MAX_CHANNELS: i32 = 2;\nconst MAX_PARAMS: i32 = 64;\n\nconst inBuf:  StaticArray<f32> = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\nconst outBuf: StaticArray<f32> = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\nconst params: StaticArray<f32> = new StaticArray<f32>(MAX_PARAMS);\nconst display: StaticArray<f32> = new StaticArray<f32>(16);\n\nconst P_MONO:  i32 = 0;\nconst P_BALL:  i32 = 1;\nconst P_MODE:  i32 = 2;   // 0 goniometer (M/S), 1 lissajous (L/R)\nconst P_FREEZE:i32 = 3;\nconst NUM_PARAMS: i32 = 4;\n\n@inline function clampf(x: f32, lo: f32, hi: f32): f32 { return x < lo ? lo : (x > hi ? hi : x); }\n\nlet sampleRate: f32 = 48000.0;\nlet channels: i32 = 2;\n\nlet emaLR: f32 = 0.0;\nlet emaLL: f32 = 0.0;\nlet emaRR: f32 = 0.0;\nlet correlation: f32 = 0.0;\n\nconst NPTS: i32 = 7;\n\nexport function init(sr: f32, maxFrames: i32, numChannels: i32): void {\n  sampleRate = sr > 0.0 ? sr : 48000.0;\n  channels = numChannels < MAX_CHANNELS ? numChannels : MAX_CHANNELS;\n  emaLR = 0.0; emaLL = 0.0; emaRR = 0.0; correlation = 0.0;\n  for (let k = 0; k < 16; k++) display[k] = 0.0;\n\n  params[P_MONO] = 0.0; params[P_BALL] = 0.4; params[P_MODE] = 0.0; params[P_FREEZE] = 0.0;\n}\n\nexport function getInputPtr(): usize  { return changetype<usize>(inBuf); }\nexport function getOutputPtr(): usize { return changetype<usize>(outBuf); }\nexport function getParamsPtr(): usize { return changetype<usize>(params); }\nexport function getNumParams(): i32   { return NUM_PARAMS; }\nexport function getDisplayPtr(): usize { return changetype<usize>(display); }\n\nexport function process(n: i32): void {\n  const monoCheck: bool = params[P_MONO] > 0.5;\n  const ballN: f32 = clampf(params[P_BALL], 0.0, 1.0);\n  const mode: bool = params[P_MODE] > 0.5;   // false = goniometer, true = lissajous\n  const frozen: bool = params[P_FREEZE] > 0.5;\n\n  const ballCoef: f32 = f32(1.0 - Mathf.exp(-1.0 / ((0.01 + ballN * 0.4) * sampleRate)));\n  const stride: i32 = n / NPTS > 0 ? n / NPTS : 1;\n\n  let ptIdx: i32 = 0;\n\n  for (let i = 0; i < n; i++) {\n    const l: f32 = inBuf[i];\n    const r: f32 = channels > 1 ? inBuf[MAX_FRAMES + i] : l;\n\n    if (monoCheck) { const mid: f32 = (l + r) * 0.5; outBuf[i] = mid; outBuf[MAX_FRAMES + i] = mid; }\n    else { outBuf[i] = l; outBuf[MAX_FRAMES + i] = r; }\n\n    if (!frozen) {\n      emaLR = f32(emaLR + (l * r - emaLR) * ballCoef);\n      emaLL = f32(emaLL + (l * l - emaLL) * ballCoef);\n      emaRR = f32(emaRR + (r * r - emaRR) * ballCoef);\n      const denom: f32 = f32(Mathf.sqrt(emaLL * emaRR) + 0.0000001);\n      correlation = clampf(emaLR / denom, -1.0, 1.0);\n\n      if (i % stride == 0 && ptIdx < NPTS) {\n        let x: f32; let y: f32;\n        if (mode) { x = l; y = r; }\n        else { x = f32((l - r) * 0.70710678); y = f32((l + r) * 0.70710678); }\n        const base: i32 = 1 + ptIdx * 2;\n        display[base] = clampf(x, -1.0, 1.0);\n        display[base + 1] = clampf(y, -1.0, 1.0);\n        ptIdx += 1;\n      }\n    }\n  }\n\n  display[0] = correlation;\n}\n",
  "publishedAt": 1790030100000
}