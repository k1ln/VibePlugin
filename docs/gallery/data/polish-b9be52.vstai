{"format":1,"name":"Polish","assembly":"const MAX_FRAMES: i32 = 8192;\r\nconst MAX_CHANNELS: i32 = 2;\r\nconst MAX_PARAMS: i32 = 64;\r\n\r\nconst inBuf  = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\r\nconst outBuf = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\r\nconst params = new StaticArray<f32>(MAX_PARAMS);\r\nconst display = new StaticArray<f32>(16);\r\n\r\nconst TWO_PI: f32 = 6.2831855;\r\n\r\n// Per-preset voicing tables: A GLUE, B PUNCH, C AIR, D LOUD\r\nconst pRatio:    StaticArray<f32> = [2.5, 3.5, 3.0, 6.0];     // compressor ratio\r\nconst pAttack:   StaticArray<f32> = [15.0, 30.0, 8.0, 3.0];   // attack ms\r\nconst pRelease:  StaticArray<f32> = [150.0, 120.0, 100.0, 60.0]; // release ms\r\nconst pDriveDb:  StaticArray<f32> = [8.0, 10.0, 8.0, 14.0];   // max input drive (dB)\r\nconst pThrRange: StaticArray<f32> = [14.0, 16.0, 14.0, 20.0]; // threshold travel (dB)\r\nconst pMakeupDb: StaticArray<f32> = [3.0, 3.5, 3.0, 5.0];     // max makeup gain (dB)\r\nconst pSatK:     StaticArray<f32> = [0.8, 1.6, 1.2, 3.5];     // saturation amount\r\nconst pLowAmt:   StaticArray<f32> = [0.05, 0.35, 0.10, 0.30]; // low body boost\r\nconst pHighAmt:  StaticArray<f32> = [0.15, 0.05, 0.55, 0.30]; // high air boost\r\n\r\nlet sampleRate: f32 = 44100;\r\nlet channels: i32 = 2;\r\nlet env: f32 = 0;\r\nlet smAmt: f32 = 0.5;\r\nlet cLo: f32 = 0.025;\r\nlet cHi: f32 = 0.5;\r\nlet meterL: f32 = 0;\r\nlet meterR: f32 = 0;\r\nlet meterGr: f32 = 0;\r\nconst lpLo = new StaticArray<f32>(MAX_CHANNELS);\r\nconst lpHi = new StaticArray<f32>(MAX_CHANNELS);\r\n\r\nexport function init(sr: f32, maxFrames: i32, ch: i32): void {\r\n  sampleRate = sr;\r\n  channels = ch < MAX_CHANNELS ? ch : MAX_CHANNELS;\r\n  env = 0;\r\n  smAmt = 0.5;\r\n  meterL = 0;\r\n  meterR = 0;\r\n  meterGr = 0;\r\n  for (let c = 0; c < MAX_CHANNELS; c++) {\r\n    lpLo[c] = 0;\r\n    lpHi[c] = 0;\r\n  }\r\n  cLo = f32(1.0) - Mathf.exp(f32(-TWO_PI * 180.0) / sampleRate);\r\n  cHi = f32(1.0) - Mathf.exp(f32(-TWO_PI * 5000.0) / sampleRate);\r\n  params[0] = 0.5; // amount\r\n  params[1] = 0.0; // preset (0..3)\r\n}\r\n\r\nexport function getInputPtr(): usize   { return changetype<usize>(inBuf); }\r\nexport function getOutputPtr(): usize  { return changetype<usize>(outBuf); }\r\nexport function getParamsPtr(): usize  { return changetype<usize>(params); }\r\nexport function getNumParams(): i32    { return 2; }\r\nexport function getDisplayPtr(): usize { return changetype<usize>(display); }\r\n\r\nfunction satClip(x: f32, k: f32): f32 {\r\n  const y: f32 = f32(x / Mathf.sqrt(f32(1.0) + k * x * x));\r\n  return f32(y * Mathf.sqrt(f32(1.0) + k));\r\n}\r\n\r\nexport function process(n: i32): void {\r\n  let a: f32 = params[0];\r\n  if (a < 0) a = 0;\r\n  if (a > 1) a = 1;\r\n\r\n  let p: i32 = i32(params[1] + 0.5);\r\n  if (p < 0) p = 0;\r\n  if (p > 3) p = 3;\r\n\r\n  const ratio: f32 = pRatio[p];\r\n  const slope: f32 = f32(1.0) - f32(1.0) / ratio;\r\n  const attC: f32 = f32(Mathf.exp(f32(-1.0) / (sampleRate * pAttack[p] * f32(0.001))));\r\n  const relC: f32 = f32(Mathf.exp(f32(-1.0) / (sampleRate * pRelease[p] * f32(0.001))));\r\n  const driveDb: f32 = pDriveDb[p];\r\n  const thrRange: f32 = pThrRange[p];\r\n  const makeupDb: f32 = pMakeupDb[p];\r\n  const satK: f32 = pSatK[p];\r\n  const loAmt: f32 = pLowAmt[p];\r\n  const hiAmt: f32 = pHighAmt[p];\r\n  const smC: f32 = 0.002;\r\n  const ceil: f32 = 0.891;\r\n\r\n  let pkL: f32 = 0;\r\n  let pkR: f32 = 0;\r\n  let grMax: f32 = 0;\r\n\r\n  for (let f = 0; f < n; f++) {\r\n    smAmt = f32(smAmt + smC * (a - smAmt));\r\n    const sa: f32 = smAmt;\r\n\r\n    const inL: f32 = inBuf[f];\r\n    const inR: f32 = channels > 1 ? inBuf[MAX_FRAMES + f] : inL;\r\n\r\n    // tone shaping (low body + high air), scaled by amount\r\n    lpLo[0] = f32(lpLo[0] + cLo * (inL - lpLo[0]));\r\n    lpHi[0] = f32(lpHi[0] + cHi * (inL - lpHi[0]));\r\n    lpLo[1] = f32(lpLo[1] + cLo * (inR - lpLo[1]));\r\n    lpHi[1] = f32(lpHi[1] + cHi * (inR - lpHi[1]));\r\n    const toneL: f32 = f32(inL + sa * (loAmt * lpLo[0] + hiAmt * (inL - lpHi[0])));\r\n    const toneR: f32 = f32(inR + sa * (loAmt * lpLo[1] + hiAmt * (inR - lpHi[1])));\r\n\r\n    // drive\r\n    const driveG: f32 = f32(Mathf.pow(f32(10.0), sa * driveDb / f32(20.0)));\r\n    const dL: f32 = f32(toneL * driveG);\r\n    const dR: f32 = f32(toneR * driveG);\r\n\r\n    // linked peak detector\r\n    const pk: f32 = Mathf.max(Mathf.abs(dL), Mathf.abs(dR));\r\n    if (pk > env) {\r\n      env = f32(attC * env + (f32(1.0) - attC) * pk);\r\n    } else {\r\n      env = f32(relC * env + (f32(1.0) - relC) * pk);\r\n    }\r\n\r\n    const envDb: f32 = f32(20.0 * Mathf.log10(env + f32(0.000000001)));\r\n    const thrDb: f32 = f32(-sa * thrRange);\r\n    const over: f32 = f32(envDb - thrDb);\r\n    let gr: f32 = 0;\r\n    if (over > 3.0) {\r\n      gr = f32(slope * over);\r\n    } else if (over > -3.0) {\r\n      const kx: f32 = f32(over + 3.0);\r\n      gr = f32(slope * kx * kx / 12.0);\r\n    }\r\n    if (gr > grMax) grMax = gr;\r\n\r\n    const gainDb: f32 = f32(-gr + makeupDb * sa);\r\n    const gain: f32 = f32(Mathf.pow(f32(10.0), gainDb / f32(20.0)));\r\n\r\n    // saturation + ceiling\r\n    const k: f32 = f32(satK * sa + 0.0001);\r\n    let oL: f32 = f32(satClip(f32(dL * gain), k) * ceil);\r\n    let oR: f32 = f32(satClip(f32(dR * gain), k) * ceil);\r\n    if (oL > 1.0) oL = 1.0;\r\n    if (oL < -1.0) oL = -1.0;\r\n    if (oR > 1.0) oR = 1.0;\r\n    if (oR < -1.0) oR = -1.0;\r\n\r\n    outBuf[f] = oL;\r\n    outBuf[MAX_FRAMES + f] = oR;\r\n\r\n    const aL: f32 = Mathf.abs(oL);\r\n    const aR: f32 = Mathf.abs(oR);\r\n    if (aL > pkL) pkL = aL;\r\n    if (aR > pkR) pkR = aR;\r\n  }\r\n\r\n  meterL = Mathf.max(pkL, f32(meterL * 0.9));\r\n  meterR = Mathf.max(pkR, f32(meterR * 0.9));\r\n  meterGr = Mathf.max(grMax, f32(meterGr * 0.9));\r\n  display[0] = meterL;\r\n  display[1] = meterR;\r\n  display[2] = meterGr;\r\n}","html":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"utf-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n<title>Polish</title>\r\n<style>\r\n  :root {\r\n    --bg: #0e1319;\r\n    --panel: #141a22;\r\n    --well: #0b1016;\r\n    --line: #232c38;\r\n    --text: #dfe5ec;\r\n    --text2: #98a3b1;\r\n    --muted: #64707f;\r\n    --accent: #e9c46a;\r\n    --accent-glow: rgba(233, 196, 106, 0.35);\r\n  }\r\n\r\n  * { box-sizing: border-box; }\r\n\r\n  html, body {\r\n    margin: 0;\r\n    height: 100%;\r\n    background:\r\n      radial-gradient(120% 90% at 50% 0%, #17202b 0%, var(--bg) 60%);\r\n    color: var(--text);\r\n    font-family: ui-sans-serif, -apple-system, \"Segoe UI\", system-ui, sans-serif;\r\n    font-variant-numeric: tabular-nums;\r\n    overflow: hidden;\r\n  }\r\n\r\n  .app {\r\n    display: flex;\r\n    flex-direction: column;\r\n    height: 100%;\r\n    min-height: 420px;\r\n    padding: 14px;\r\n    gap: 12px;\r\n  }\r\n\r\n  /* ---------- header ---------- */\r\n  header {\r\n    display: grid;\r\n    grid-template-columns: 1fr auto 1fr;\r\n    align-items: center;\r\n    gap: 12px;\r\n    padding: 10px 16px;\r\n    background: var(--panel);\r\n    border: 1px solid var(--line);\r\n    border-radius: 12px;\r\n    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04) inset, 0 8px 24px rgba(0, 0, 0, 0.35);\r\n  }\r\n\r\n  .brand { display: flex; align-items: center; gap: 12px; min-width: 0; }\r\n\r\n  .logo {\r\n    width: 30px;\r\n    height: 30px;\r\n    border-radius: 8px;\r\n    background: conic-gradient(from 210deg, #8a6d22, var(--accent), #fff3c9, var(--accent), #8a6d22);\r\n    box-shadow: 0 0 14px var(--accent-glow);\r\n    flex: none;\r\n  }\r\n\r\n  .title {\r\n    font-size: 18px;\r\n    font-weight: 700;\r\n    letter-spacing: 0.32em;\r\n    text-transform: uppercase;\r\n  }\r\n\r\n  .tagline {\r\n    font-size: 10px;\r\n    letter-spacing: 0.14em;\r\n    text-transform: uppercase;\r\n    color: var(--muted);\r\n    margin-top: 2px;\r\n  }\r\n\r\n  .soundbar { display: flex; align-items: center; gap: 6px; }\r\n\r\n  .sb-btn {\r\n    height: 28px;\r\n    min-width: 28px;\r\n    padding: 0 10px;\r\n    border-radius: 7px;\r\n    border: 1px solid var(--line);\r\n    background: linear-gradient(#1a222c, #141a22);\r\n    color: var(--text2);\r\n    font: inherit;\r\n    font-size: 11px;\r\n    letter-spacing: 0.12em;\r\n    text-transform: uppercase;\r\n    cursor: pointer;\r\n    transition: color 0.15s, border-color 0.15s, box-shadow 0.15s;\r\n  }\r\n\r\n  .sb-btn:hover { color: var(--text); border-color: #36424f; }\r\n\r\n  .sb-name {\r\n    width: 190px;\r\n    text-align: left;\r\n    background: var(--well);\r\n    color: var(--text);\r\n    overflow: hidden;\r\n    text-overflow: ellipsis;\r\n    white-space: nowrap;\r\n  }\r\n\r\n  .sb-save { color: var(--accent); border-color: rgba(233, 196, 106, 0.4); }\r\n  .sb-save:hover { box-shadow: 0 0 12px var(--accent-glow); color: #fff3c9; }\r\n\r\n  .outmeter { justify-self: end; display: flex; flex-direction: column; gap: 5px; width: 150px; }\r\n\r\n  .outmeter .lbl {\r\n    font-size: 9px;\r\n    letter-spacing: 0.16em;\r\n    text-transform: uppercase;\r\n    color: var(--muted);\r\n  }\r\n\r\n  .bar {\r\n    position: relative;\r\n    height: 7px;\r\n    border-radius: 4px;\r\n    background: var(--well);\r\n    border: 1px solid var(--line);\r\n    overflow: hidden;\r\n  }\r\n\r\n  .bar i {\r\n    position: absolute;\r\n    left: 0;\r\n    top: 0;\r\n    bottom: 0;\r\n    width: 0%;\r\n    background: linear-gradient(90deg, #4fae96, var(--accent) 80%, #ff8a5c);\r\n  }\r\n\r\n  /* ---------- main panel ---------- */\r\n  main {\r\n    flex: 1;\r\n    min-height: 0;\r\n    display: grid;\r\n    grid-template-columns: 1fr 74px;\r\n    gap: 12px;\r\n  }\r\n\r\n  .panel {\r\n    position: relative;\r\n    background: var(--panel);\r\n    border: 1px solid var(--line);\r\n    border-radius: 12px;\r\n    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04) inset, 0 8px 24px rgba(0, 0, 0, 0.3);\r\n    display: flex;\r\n    flex-direction: column;\r\n    min-height: 0;\r\n  }\r\n\r\n  .panel-head {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 10px;\r\n    padding: 12px 16px 0;\r\n    font-size: 11px;\r\n    letter-spacing: 0.2em;\r\n    text-transform: uppercase;\r\n    color: var(--text2);\r\n  }\r\n\r\n  .panel-head .num { color: var(--muted); }\r\n\r\n  .pill {\r\n    margin-left: auto;\r\n    padding: 2px 8px;\r\n    border-radius: 999px;\r\n    border: 1px solid rgba(233, 196, 106, 0.45);\r\n    color: var(--accent);\r\n    font-size: 9px;\r\n    letter-spacing: 0.16em;\r\n  }\r\n\r\n  .stage {\r\n    flex: 1;\r\n    min-height: 0;\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n    justify-content: center;\r\n    gap: 10px;\r\n    padding: 6px 16px 16px;\r\n  }\r\n\r\n  /* ---------- the knob ---------- */\r\n  .knob {\r\n    position: relative;\r\n    width: clamp(150px, 36vh, 250px);\r\n    aspect-ratio: 1;\r\n    cursor: ns-resize;\r\n    touch-action: none;\r\n    user-select: none;\r\n    outline: none;\r\n  }\r\n\r\n  .knob svg { width: 100%; height: 100%; overflow: visible; display: block; }\r\n  .knob:hover .arc, .knob.drag .arc { filter: drop-shadow(0 0 6px var(--accent-glow)); }\r\n  .knob:focus-visible .disc { stroke: var(--accent); }\r\n\r\n  .readout {\r\n    font-size: 26px;\r\n    font-weight: 600;\r\n    letter-spacing: 0.04em;\r\n    color: var(--text);\r\n  }\r\n\r\n  .klabel {\r\n    font-size: 10px;\r\n    letter-spacing: 0.28em;\r\n    text-transform: uppercase;\r\n    color: var(--text2);\r\n    margin-top: -4px;\r\n  }\r\n\r\n  /* ---------- presets ---------- */\r\n  .presets { display: flex; gap: 10px; margin-top: 4px; }\r\n\r\n  .pbtn {\r\n    width: clamp(62px, 9vw, 86px);\r\n    padding: 9px 0 8px;\r\n    border-radius: 10px;\r\n    border: 1px solid var(--line);\r\n    background: linear-gradient(#19212b, #121820);\r\n    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.05) inset;\r\n    color: var(--text2);\r\n    font: inherit;\r\n    cursor: pointer;\r\n    transition: all 0.15s;\r\n  }\r\n\r\n  .pbtn:hover { color: var(--text); border-color: #36424f; }\r\n\r\n  .pbtn b { display: block; font-size: 17px; letter-spacing: 0.1em; }\r\n\r\n  .pbtn span {\r\n    display: block;\r\n    margin-top: 2px;\r\n    font-size: 8px;\r\n    letter-spacing: 0.18em;\r\n    text-transform: uppercase;\r\n    color: var(--muted);\r\n  }\r\n\r\n  .pbtn.on {\r\n    color: #1a1405;\r\n    background: linear-gradient(#f3d98c, var(--accent));\r\n    border-color: #f6dd96;\r\n    box-shadow: 0 0 16px var(--accent-glow), 0 1px 0 rgba(255, 255, 255, 0.5) inset;\r\n  }\r\n\r\n  .pbtn.on span { color: #5c4712; }\r\n\r\n  /* ---------- gain reduction meter ---------- */\r\n  .gr .stage { padding: 6px 10px 14px; gap: 8px; }\r\n\r\n  .grtrack {\r\n    position: relative;\r\n    flex: 1;\r\n    width: 16px;\r\n    min-height: 60px;\r\n    border-radius: 8px;\r\n    background: var(--well);\r\n    border: 1px solid var(--line);\r\n    overflow: hidden;\r\n  }\r\n\r\n  .grtrack i {\r\n    position: absolute;\r\n    left: 0;\r\n    right: 0;\r\n    top: 0;\r\n    height: 0%;\r\n    background: linear-gradient(#ffb86b, var(--accent));\r\n  }\r\n\r\n  .grval { font-size: 11px; color: var(--text2); }\r\n\r\n  .grtitle {\r\n    font-size: 9px;\r\n    letter-spacing: 0.2em;\r\n    text-transform: uppercase;\r\n    color: var(--muted);\r\n  }\r\n\r\n  @media (max-width: 620px) {\r\n    header { grid-template-columns: 1fr; justify-items: center; }\r\n    .outmeter { justify-self: center; }\r\n    .sb-name { width: 130px; }\r\n  }\r\n</style>\r\n</head>\r\n<body><div style=\"position:sticky;top:0;z-index:99;font:600 12px/1.45 system-ui,-apple-system,sans-serif;)\"\r\n        R\"HTML(color:#d3dcec;background:linear-gradient(180deg,#1b2435,#141a27);border-bottom:1px solid rgba(255,255,255,.1);)\"\r\n        R\"HTML(padding:9px 14px;text-align:center\">Style preview — a GUI example, not a real synth (no sound). Type a prompt and press Generate, or Load a .vstai, to make a working plugin.</div>\r\n<div class=\"app\">\r\n\r\n  <header>\r\n    <div class=\"brand\">\r\n      <div class=\"logo\"></div>\r\n      <div>\r\n        <div class=\"title\">Polish</div>\r\n        <div class=\"tagline\">One-knob loudness &amp; gloss</div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"soundbar\">\r\n      <button class=\"sb-btn\" id=\"sbPrev\" title=\"Previous sound\">&#9664;</button>\r\n      <button class=\"sb-btn sb-name\" id=\"sbName\" data-vstai-sound title=\"Open sound library\">Init Sound</button>\r\n      <button class=\"sb-btn\" id=\"sbNext\" title=\"Next sound\">&#9654;</button>\r\n      <button class=\"sb-btn sb-save\" id=\"sbSave\" title=\"Save this sound\">Save</button>\r\n    </div>\r\n\r\n    <div class=\"outmeter\">\r\n      <div class=\"lbl\">Output L</div>\r\n      <div class=\"bar\"><i id=\"mL\"></i></div>\r\n      <div class=\"lbl\">Output R</div>\r\n      <div class=\"bar\"><i id=\"mR\"></i></div>\r\n    </div>\r\n  </header>\r\n\r\n  <main>\r\n    <section class=\"panel\">\r\n      <div class=\"panel-head\">\r\n        <span class=\"num\">01</span><span>Polish</span>\r\n        <span class=\"pill\">ON</span>\r\n      </div>\r\n      <div class=\"stage\">\r\n        <div class=\"knob\" id=\"knob\" data-param=\"0\" tabindex=\"0\" role=\"slider\"\r\n             aria-label=\"Amount\" aria-valuemin=\"0\" aria-valuemax=\"100\">\r\n          <svg viewBox=\"0 0 200 200\">\r\n            <defs>\r\n              <radialGradient id=\"discGrad\" cx=\"50%\" cy=\"35%\" r=\"75%\">\r\n                <stop offset=\"0%\" stop-color=\"#2a3441\"/>\r\n                <stop offset=\"100%\" stop-color=\"#10161d\"/>\r\n              </radialGradient>\r\n            </defs>\r\n            <path id=\"track\" d=\"\" fill=\"none\" stroke=\"#2a3441\" stroke-width=\"5\" stroke-linecap=\"round\"/>\r\n            <path id=\"arc\" class=\"arc\" d=\"\" fill=\"none\" stroke=\"#e9c46a\" stroke-width=\"5\" stroke-linecap=\"round\"/>\r\n            <circle class=\"disc\" cx=\"100\" cy=\"100\" r=\"62\" fill=\"url(#discGrad)\" stroke=\"#2c3744\" stroke-width=\"2\"/>\r\n            <circle cx=\"100\" cy=\"100\" r=\"50\" fill=\"none\" stroke=\"rgba(255,255,255,0.05)\" stroke-width=\"1\"/>\r\n            <g id=\"pointer\">\r\n              <line x1=\"100\" y1=\"52\" x2=\"100\" y2=\"72\" stroke=\"#ffffff\" stroke-width=\"4\" stroke-linecap=\"round\"/>\r\n            </g>\r\n          </svg>\r\n        </div>\r\n        <div class=\"readout\" id=\"readout\">50%</div>\r\n        <div class=\"klabel\">Amount</div>\r\n\r\n        <div class=\"presets\" id=\"presets\">\r\n          <button class=\"pbtn\" data-i=\"0\"><b>A</b><span>Glue</span></button>\r\n          <button class=\"pbtn\" data-i=\"1\"><b>B</b><span>Punch</span></button>\r\n          <button class=\"pbtn\" data-i=\"2\"><b>C</b><span>Air</span></button>\r\n          <button class=\"pbtn\" data-i=\"3\"><b>D</b><span>Loud</span></button>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"panel gr\">\r\n      <div class=\"panel-head\" style=\"justify-content:center;padding:12px 6px 0;\">\r\n        <span class=\"num\">02</span>\r\n      </div>\r\n      <div class=\"stage\">\r\n        <div class=\"grtitle\">GR</div>\r\n        <div class=\"grtrack\"><i id=\"grBar\"></i></div>\r\n        <div class=\"grval\" id=\"grVal\">0.0 dB</div>\r\n      </div>\r\n    </section>\r\n  </main>\r\n</div>\r\n\r\n<script>\r\n  var AMOUNT_INDEX = 0;\r\n  var PRESET_INDEX = 1;\r\n  var AMOUNT_DEFAULT = 0.5;\r\n\r\n  function clamp(v, lo, hi) {\r\n    return Math.max(lo, Math.min(hi, v));\r\n  }\r\n\r\n  function whenHost(fn) {\r\n    if (window.vstai) {\r\n      fn();\r\n      return;\r\n    }\r\n    var tries = 0;\r\n    var timer = setInterval(function () {\r\n      tries++;\r\n      if (window.vstai) {\r\n        clearInterval(timer);\r\n        fn();\r\n      } else if (tries > 100) {\r\n        clearInterval(timer);\r\n      }\r\n    }, 50);\r\n  }\r\n\r\n  /* ---------- knob drawing ---------- */\r\n  var knobEl = document.getElementById('knob');\r\n  var trackEl = document.getElementById('track');\r\n  var arcEl = document.getElementById('arc');\r\n  var pointerEl = document.getElementById('pointer');\r\n  var readoutEl = document.getElementById('readout');\r\n\r\n  var amount = AMOUNT_DEFAULT;\r\n\r\n  function polar(angleDeg, r) {\r\n    var rad = angleDeg * Math.PI / 180;\r\n    return { x: 100 + r * Math.sin(rad), y: 100 - r * Math.cos(rad) };\r\n  }\r\n\r\n  function arcPath(fromDeg, toDeg, r) {\r\n    var s = polar(fromDeg, r);\r\n    var e = polar(toDeg, r);\r\n    var large = (toDeg - fromDeg) > 180 ? 1 : 0;\r\n    return 'M ' + s.x.toFixed(2) + ' ' + s.y.toFixed(2) +\r\n      ' A ' + r + ' ' + r + ' 0 ' + large + ' 1 ' + e.x.toFixed(2) + ' ' + e.y.toFixed(2);\r\n  }\r\n\r\n  trackEl.setAttribute('d', arcPath(-135, 135, 80));\r\n\r\n  function drawKnob() {\r\n    var angle = -135 + 270 * amount;\r\n    arcEl.setAttribute('d', amount > 0.003 ? arcPath(-135, angle, 80) : '');\r\n    pointerEl.setAttribute('transform', 'rotate(' + angle.toFixed(1) + ' 100 100)');\r\n    readoutEl.textContent = Math.round(amount * 100) + '%';\r\n    knobEl.setAttribute('aria-valuenow', Math.round(amount * 100));\r\n  }\r\n\r\n  function setAmount(v) {\r\n    amount = clamp(v, 0, 1);\r\n    drawKnob();\r\n    if (window.vstai) window.vstai.setParam(AMOUNT_INDEX, amount);\r\n  }\r\n\r\n  var dragging = false;\r\n  var dragY = 0;\r\n  var dragStart = 0;\r\n\r\n  knobEl.addEventListener('pointerdown', function (e) {\r\n    dragging = true;\r\n    dragY = e.clientY;\r\n    dragStart = amount;\r\n    knobEl.classList.add('drag');\r\n    knobEl.setPointerCapture(e.pointerId);\r\n    e.preventDefault();\r\n  });\r\n\r\n  knobEl.addEventListener('pointermove', function (e) {\r\n    if (!dragging) return;\r\n    var sens = e.shiftKey ? 600 : 200;\r\n    setAmount(dragStart + (dragY - e.clientY) / sens);\r\n  });\r\n\r\n  function endDrag() {\r\n    dragging = false;\r\n    knobEl.classList.remove('drag');\r\n  }\r\n\r\n  knobEl.addEventListener('pointerup', endDrag);\r\n  knobEl.addEventListener('pointercancel', endDrag);\r\n\r\n  knobEl.addEventListener('dblclick', function () {\r\n    setAmount(AMOUNT_DEFAULT);\r\n  });\r\n\r\n  knobEl.addEventListener('wheel', function (e) {\r\n    e.preventDefault();\r\n    setAmount(amount - Math.sign(e.deltaY) * 0.01);\r\n  }, { passive: false });\r\n\r\n  knobEl.addEventListener('keydown', function (e) {\r\n    if (e.key === 'ArrowUp' || e.key === 'ArrowRight') {\r\n      setAmount(amount + 0.02);\r\n      e.preventDefault();\r\n    } else if (e.key === 'ArrowDown' || e.key === 'ArrowLeft') {\r\n      setAmount(amount - 0.02);\r\n      e.preventDefault();\r\n    }\r\n  });\r\n\r\n  /* ---------- preset buttons ---------- */\r\n  var preset = 0;\r\n  var presetBtns = document.querySelectorAll('.pbtn');\r\n\r\n  function drawPresets() {\r\n    for (var i = 0; i < presetBtns.length; i++) {\r\n      var idx = parseInt(presetBtns[i].getAttribute('data-i'), 10);\r\n      presetBtns[i].classList.toggle('on', idx === preset);\r\n    }\r\n  }\r\n\r\n  function setPreset(i) {\r\n    preset = clamp(Math.round(i), 0, 3);\r\n    drawPresets();\r\n    if (window.vstai) window.vstai.setParam(PRESET_INDEX, preset);\r\n  }\r\n\r\n  for (var b = 0; b < presetBtns.length; b++) {\r\n    (function (btn) {\r\n      btn.setAttribute('data-param', String(PRESET_INDEX));\r\n      btn.addEventListener('click', function () {\r\n        setPreset(parseInt(btn.getAttribute('data-i'), 10));\r\n      });\r\n    })(presetBtns[b]);\r\n  }\r\n\r\n  /* ---------- meters ---------- */\r\n  var mL = document.getElementById('mL');\r\n  var mR = document.getElementById('mR');\r\n  var grBar = document.getElementById('grBar');\r\n  var grVal = document.getElementById('grVal');\r\n\r\n  var target = { l: 0, r: 0, gr: 0 };\r\n  var shown = { l: 0, r: 0, gr: 0 };\r\n\r\n  function toMeter(x) {\r\n    // map linear peak to a 0..1 dB-ish scale (-48 dB .. 0 dB)\r\n    if (x <= 0.0001) return 0;\r\n    var db = 20 * Math.log10(x);\r\n    return clamp((db + 48) / 48, 0, 1);\r\n  }\r\n\r\n  function frame() {\r\n    if (!document.hidden) {\r\n      shown.l += (target.l - shown.l) * 0.35;\r\n      shown.r += (target.r - shown.r) * 0.35;\r\n      shown.gr += (target.gr - shown.gr) * 0.3;\r\n      mL.style.width = (toMeter(shown.l) * 100).toFixed(1) + '%';\r\n      mR.style.width = (toMeter(shown.r) * 100).toFixed(1) + '%';\r\n      grBar.style.height = (clamp(shown.gr / 18, 0, 1) * 100).toFixed(1) + '%';\r\n      grVal.textContent = shown.gr.toFixed(1) + ' dB';\r\n    }\r\n    requestAnimationFrame(frame);\r\n  }\r\n\r\n  requestAnimationFrame(frame);\r\n\r\n  /* ---------- host wiring ---------- */\r\n  whenHost(function () {\r\n    window.vstai.onParam(function (index, value) {\r\n      if (index === AMOUNT_INDEX) {\r\n        amount = clamp(+value, 0, 1);\r\n        drawKnob();\r\n      } else if (index === PRESET_INDEX) {\r\n        preset = clamp(Math.round(+value), 0, 3);\r\n        drawPresets();\r\n      }\r\n    });\r\n\r\n    if (window.vstai.onDisplay) {\r\n      window.vstai.onDisplay(function (v) {\r\n        target.l = v[0] || 0;\r\n        target.r = v[1] || 0;\r\n        target.gr = v[2] || 0;\r\n      });\r\n    }\r\n\r\n    // sound bar\r\n    var nameBtn = document.getElementById('sbName');\r\n    nameBtn.addEventListener('click', function () {\r\n      if (window.vstai.openBrowser) window.vstai.openBrowser();\r\n    });\r\n    document.getElementById('sbPrev').addEventListener('click', function () {\r\n      if (window.vstai.prevPreset) window.vstai.prevPreset();\r\n    });\r\n    document.getElementById('sbNext').addEventListener('click', function () {\r\n      if (window.vstai.nextPreset) window.vstai.nextPreset();\r\n    });\r\n    document.getElementById('sbSave').addEventListener('click', function () {\r\n      if (window.vstai.saveSound) window.vstai.saveSound();\r\n    });\r\n\r\n    if (window.vstai.presets) {\r\n      window.vstai.presets.onChange(function (d) {\r\n        var name = 'Init Sound';\r\n        if (d && d.entries) {\r\n          for (var i = 0; i < d.entries.length; i++) {\r\n            if (d.entries[i].id === d.current) {\r\n              name = d.entries[i].name;\r\n              break;\r\n            }\r\n          }\r\n        }\r\n        nameBtn.textContent = name;\r\n      });\r\n      window.vstai.presets.list();\r\n    }\r\n\r\n    // push initial values (host replays restored values through onParam)\r\n    window.vstai.setParam(AMOUNT_INDEX, amount);\r\n    window.vstai.setParam(PRESET_INDEX, preset);\r\n  });\r\n\r\n  drawKnob();\r\n  drawPresets();\r\n</script>\r\n</body>\r\n</html>","wasmBase64":"","explanation":"","isInstrument":false,"locked":false,"provider":"cloud","model":"claude-sonnet-5-5","effort":"medium","thinking":true,"promptHistory":[],"params":[],"presets":[],"activeRevision":0,"nextRevisionId":2,"publishedAt":1793503164255}