{"format":1,"name":"gm","assembly":"const MAX_FRAMES: i32 = 8192;\nconst MAX_CHANNELS: i32 = 2;\nconst MAX_PARAMS: i32 = 64;\n\nconst inBuf  = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\nconst outBuf = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\nconst params = new StaticArray<f32>(MAX_PARAMS);\n\nlet sampleRate: f32 = 44100;\nlet phase1: f32 = 0;\nlet phase2: f32 = 0;\nlet targetFreq: f32 = 220;\nlet curFreq: f32 = 220;\nlet vel: f32 = 1;\nlet gate: i32 = 0;\nlet note: i32 = -1;\nlet hasPlayed: i32 = 0;\n\n// envelope: 0 idle, 1 attack, 2 decay, 3 sustain, 4 release\nlet stage: i32 = 0;\nlet env: f32 = 0;\n\n// ladder filter stages\nlet s1: f32 = 0;\nlet s2: f32 = 0;\nlet s3: f32 = 0;\nlet s4: f32 = 0;\n\nfunction clampf(x: f32, lo: f32, hi: f32): f32 {\n  if (x < lo) return lo;\n  if (x > hi) return hi;\n  return x;\n}\n\nfunction polyblep(t: f32, dt: f32): f32 {\n  if (t < dt) {\n    const x: f32 = t / dt;\n    return x + x - x * x - 1.0;\n  }\n  if (t > 1.0 - dt) {\n    const x: f32 = (t - 1.0) / dt;\n    return x * x + x + x + 1.0;\n  }\n  return 0.0;\n}\n\nfunction osc(wave: i32, ph: f32, dt: f32): f32 {\n  if (wave == 0) {\n    return (ph * 2.0 - 1.0) - polyblep(ph, dt);\n  }\n  if (wave == 1) {\n    let p2: f32 = ph + 0.5;\n    if (p2 >= 1.0) p2 -= 1.0;\n    const sq: f32 = ph < 0.5 ? 1.0 : -1.0;\n    return sq + polyblep(ph, dt) - polyblep(p2, dt);\n  }\n  return ph < 0.5 ? (4.0 * ph - 1.0) : (3.0 - 4.0 * ph);\n}\n\nfunction softClip(x: f32): f32 {\n  const c: f32 = clampf(x, -3.0, 3.0);\n  return c * (27.0 + c * c) / (27.0 + 9.0 * c * c);\n}\n\nexport function init(sr: f32, maxFrames: i32, ch: i32): void {\n  sampleRate = sr;\n  phase1 = 0;\n  phase2 = 0;\n  env = 0;\n  stage = 0;\n  gate = 0;\n  note = -1;\n  hasPlayed = 0;\n  s1 = 0;\n  s2 = 0;\n  s3 = 0;\n  s4 = 0;\n  params[0] = 0;     // osc1 wave\n  params[1] = 0;     // osc2 wave\n  params[2] = 0.1;   // osc2 detune (semitones)\n  params[3] = 0.5;   // osc mix\n  params[4] = 0.45;  // cutoff\n  params[5] = 0.35;  // resonance\n  params[6] = 0.5;   // env amount\n  params[7] = 0.01;  // attack\n  params[8] = 0.4;   // decay\n  params[9] = 0.6;   // sustain\n  params[10] = 0.3;  // release\n  params[11] = 0.0;  // glide\n  params[12] = 0.5;  // level\n}\n\nexport function getInputPtr(): usize  { return changetype<usize>(inBuf); }\nexport function getOutputPtr(): usize { return changetype<usize>(outBuf); }\nexport function getParamsPtr(): usize { return changetype<usize>(params); }\nexport function getNumParams(): i32   { return 13; }\n\nexport function noteOn(id: i32, f: f32, v: f32): void {\n  note = id;\n  targetFreq = f;\n  if (hasPlayed == 0) curFreq = f;\n  hasPlayed = 1;\n  vel = clampf(v, 0.0, 1.0);\n  gate = 1;\n  stage = 1;\n}\n\nexport function noteOff(id: i32): void {\n  if (id == note) {\n    gate = 0;\n    if (stage != 0) stage = 4;\n  }\n}\n\nexport function process(n: i32): void {\n  const w1: i32 = i32(clampf(params[0], 0, 2) + 0.5);\n  const w2: i32 = i32(clampf(params[1], 0, 2) + 0.5);\n  const detune: f32 = clampf(params[2], -12, 12);\n  const ratio2: f32 = Mathf.pow(2.0, detune / 12.0);\n  const mix: f32 = clampf(params[3], 0, 1);\n  const cutoff: f32 = clampf(params[4], 0, 1);\n  const res: f32 = clampf(params[5], 0, 1);\n  const envAmt: f32 = clampf(params[6], 0, 1);\n  const attack: f32 = clampf(params[7], 0.001, 5);\n  const decay: f32 = clampf(params[8], 0.005, 5);\n  const sustain: f32 = clampf(params[9], 0, 1);\n  const release: f32 = clampf(params[10], 0.005, 5);\n  const glide: f32 = clampf(params[11], 0, 2);\n  const level: f32 = clampf(params[12], 0, 1);\n\n  const attackRate: f32 = 1.0 / (attack * sampleRate);\n  const decayCoef: f32 = 1.0 - Mathf.exp(-4.0 / (decay * sampleRate));\n  const releaseCoef: f32 = 1.0 - Mathf.exp(-4.0 / (release * sampleRate));\n  let glideCoef: f32 = 1.0;\n  if (glide > 0.002) glideCoef = 1.0 - Mathf.exp(-1.0 / (glide * 0.25 * sampleRate));\n\n  const k: f32 = res * 3.9;\n  const maxFc: f32 = sampleRate * 0.45;\n\n  for (let f = 0; f < n; f++) {\n    // envelope\n    if (stage == 1) {\n      env += attackRate;\n      if (env >= 1.0) {\n        env = 1.0;\n        stage = 2;\n      }\n    } else if (stage == 2) {\n      env += (sustain - env) * decayCoef;\n      if (Mathf.abs(env - sustain) < 0.0005) stage = 3;\n    } else if (stage == 3) {\n      env = sustain;\n    } else if (stage == 4) {\n      env += (0.0 - env) * releaseCoef;\n      if (env < 0.0003) {\n        env = 0;\n        stage = 0;\n      }\n    }\n\n    // glide\n    curFreq += (targetFreq - curFreq) * glideCoef;\n\n    // oscillators\n    const inc1: f32 = clampf(curFreq / sampleRate, 0.00001, 0.45);\n    const inc2: f32 = clampf(inc1 * ratio2, 0.00001, 0.45);\n    phase1 += inc1;\n    if (phase1 >= 1.0) phase1 -= 1.0;\n    phase2 += inc2;\n    if (phase2 >= 1.0) phase2 -= 1.0;\n    const o1: f32 = osc(w1, phase1, inc1);\n    const o2: f32 = osc(w2, phase2, inc2);\n    const src: f32 = (o1 * (1.0 - mix) + o2 * mix) * 0.8;\n\n    // filter cutoff with envelope modulation\n    const mod: f32 = clampf(cutoff + envAmt * env * vel, 0, 1);\n    let fc: f32 = 20.0 * Mathf.pow(900.0, mod);\n    if (fc > maxFc) fc = maxFc;\n    const g: f32 = 1.0 - Mathf.exp(-6.2831853 * fc / sampleRate);\n\n    // moog-style ladder\n    const x: f32 = softClip(src * (1.0 + k * 0.4) - k * s4);\n    s1 += g * (x - s1);\n    s2 += g * (s1 - s2);\n    s3 += g * (s2 - s3);\n    s4 += g * (s3 - s4);\n\n    const amp: f32 = env * (0.5 + 0.5 * vel);\n    const out: f32 = clampf(s4 * amp * level * 1.6, -1.0, 1.0);\n    outBuf[f] = out;\n    outBuf[MAX_FRAMES + f] = out;\n  }\n}\n","html":"<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Grandma Clone</title>\n<style>\n  * { box-sizing: border-box; user-select: none; -webkit-user-select: none; }\n  html, body { margin: 0; background: #15110e; color: #e8d9bd; font-family: Helvetica, Arial, sans-serif; }\n  body { padding: 10px; overflow: auto; }\n  .panel { background: linear-gradient(#2b221a, #1d1712); border: 2px solid #3d2f22; border-radius: 8px; padding: 10px; max-width: 760px; margin: 0 auto; }\n  h1 { margin: 0 0 8px; font-size: 15px; letter-spacing: 3px; color: #f0a43a; text-transform: uppercase; }\n  h1 small { color: #8a7960; letter-spacing: 1px; font-size: 10px; }\n  .sections { display: flex; flex-wrap: wrap; gap: 8px; }\n  .section { border: 1px solid #44352a; border-radius: 6px; padding: 6px 8px 8px; background: #231b15; flex: 1 1 auto; }\n  .section h2 { margin: 0 0 6px; font-size: 10px; letter-spacing: 2px; color: #b49a73; text-transform: uppercase; }\n  .row { display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-end; }\n  .ctl { display: flex; flex-direction: column; align-items: center; width: 52px; }\n  .ctl label { font-size: 9px; color: #b9a98c; margin-top: 3px; text-transform: uppercase; letter-spacing: 1px; text-align: center; }\n  .ctl .val { font-size: 9px; color: #f0a43a; height: 11px; }\n  .knob { width: 40px; height: 40px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #5a4a3a, #1c1510); border: 2px solid #0c0907; position: relative; cursor: ns-resize; touch-action: none; }\n  .knob .tick { position: absolute; left: 50%; top: 3px; width: 3px; height: 14px; margin-left: -1.5px; background: #f0a43a; border-radius: 2px; transform-origin: 50% 17px; }\n  .wave { display: flex; flex-direction: column; gap: 3px; }\n  .wave .btns { display: flex; gap: 3px; }\n  .wave button { background: #33281f; color: #b9a98c; border: 1px solid #55432f; border-radius: 3px; font-size: 10px; padding: 4px 6px; cursor: pointer; }\n  .wave button.on { background: #f0a43a; color: #1a120a; border-color: #f0a43a; }\n  .kbwrap { margin-top: 10px; }\n  .keys { position: relative; height: 110px; background: #000; border-radius: 4px; overflow: hidden; touch-action: none; }\n  .key { position: absolute; top: 0; cursor: pointer; }\n  .key.white { background: linear-gradient(#f6ecd6, #d9cba9); border: 1px solid #5a4a34; height: 100%; z-index: 1; }\n  .key.black { background: linear-gradient(#3a3a3a, #0a0a0a); height: 62%; z-index: 2; border-radius: 0 0 3px 3px; border: 1px solid #000; }\n  .key.white.down { background: #f0a43a; }\n  .key.black.down { background: #c27a1a; }\n  .hint { font-size: 9px; color: #6f6150; margin-top: 4px; text-align: center; }\n</style>\n</head>\n<body>\n<div class=\"panel\">\n  <h1>Grandma <small>mono analog synth</small></h1>\n  <div class=\"sections\">\n    <div class=\"section\">\n      <h2>Oscillators</h2>\n      <div class=\"row\">\n        <div class=\"wave\" id=\"wave0\"></div>\n        <div class=\"wave\" id=\"wave1\"></div>\n        <div id=\"k2\"></div>\n        <div id=\"k3\"></div>\n        <div id=\"k11\"></div>\n      </div>\n    </div>\n    <div class=\"section\">\n      <h2>Filter</h2>\n      <div class=\"row\">\n        <div id=\"k4\"></div>\n        <div id=\"k5\"></div>\n        <div id=\"k6\"></div>\n      </div>\n    </div>\n    <div class=\"section\">\n      <h2>Envelope</h2>\n      <div class=\"row\">\n        <div id=\"k7\"></div>\n        <div id=\"k8\"></div>\n        <div id=\"k9\"></div>\n        <div id=\"k10\"></div>\n      </div>\n    </div>\n    <div class=\"section\">\n      <h2>Output</h2>\n      <div class=\"row\">\n        <div id=\"k12\"></div>\n      </div>\n    </div>\n  </div>\n  <div class=\"kbwrap\">\n    <div class=\"keys\" id=\"keys\"></div>\n    <div class=\"hint\">Play with mouse or computer keys A W S E D F T G Y H U J K O L P ;</div>\n  </div>\n</div>\n\n<script>\n  var KNOBS = [\n    { index: 2,  name: 'Detune', min: -12, max: 12, def: 0.1, fmt: function (v) { return v.toFixed(2) + ' st'; } },\n    { index: 3,  name: 'Mix',    min: 0,   max: 1,  def: 0.5, fmt: function (v) { return v.toFixed(2); } },\n    { index: 11, name: 'Glide',  min: 0,   max: 2,  def: 0,   fmt: function (v) { return v.toFixed(2) + ' s'; } },\n    { index: 4,  name: 'Cutoff', min: 0,   max: 1,  def: 0.45, fmt: function (v) { return v.toFixed(2); } },\n    { index: 5,  name: 'Reso',   min: 0,   max: 1,  def: 0.35, fmt: function (v) { return v.toFixed(2); } },\n    { index: 6,  name: 'Env Amt', min: 0,  max: 1,  def: 0.5, fmt: function (v) { return v.toFixed(2); } },\n    { index: 7,  name: 'Attack', min: 0.001, max: 2, def: 0.01, fmt: function (v) { return v.toFixed(3) + ' s'; } },\n    { index: 8,  name: 'Decay',  min: 0.01, max: 3, def: 0.4, fmt: function (v) { return v.toFixed(2) + ' s'; } },\n    { index: 9,  name: 'Sustain', min: 0,  max: 1,  def: 0.6, fmt: function (v) { return v.toFixed(2); } },\n    { index: 10, name: 'Release', min: 0.01, max: 3, def: 0.3, fmt: function (v) { return v.toFixed(2) + ' s'; } },\n    { index: 12, name: 'Level',  min: 0,   max: 1,  def: 0.5, fmt: function (v) { return v.toFixed(2); } }\n  ];\n\n  var values = {};\n  var painters = {};\n\n  function send(index, value) {\n    values[index] = value;\n    if (window.vstai && window.vstai.setParam) {\n      window.vstai.setParam(index, value);\n    }\n  }\n\n  function buildKnob(def) {\n    var host = document.getElementById('k' + def.index);\n    host.className = 'ctl';\n    host.innerHTML = '<div class=\"val\"></div><div class=\"knob\"><div class=\"tick\"></div></div><label>' + def.name + '</label>';\n    var knob = host.querySelector('.knob');\n    var tick = host.querySelector('.tick');\n    var val = host.querySelector('.val');\n    var norm = (def.def - def.min) / (def.max - def.min);\n\n    // visuals only: never pushes to the engine\n    function draw() {\n      var v = def.min + norm * (def.max - def.min);\n      tick.style.transform = 'rotate(' + (-135 + norm * 270) + 'deg)';\n      val.textContent = def.fmt(v);\n      return v;\n    }\n\n    // repaint from an external value, no setParam echo\n    painters[def.index] = function (value) {\n      var v = Number(value);\n      if (isNaN(v)) return;\n      norm = Math.max(0, Math.min(1, (v - def.min) / (def.max - def.min)));\n      values[def.index] = def.min + norm * (def.max - def.min);\n      draw();\n    };\n\n    knob.addEventListener('pointerdown', function (e) {\n      var startY = e.clientY;\n      var startNorm = norm;\n      knob.setPointerCapture(e.pointerId);\n\n      function move(ev) {\n        norm = Math.max(0, Math.min(1, startNorm + (startY - ev.clientY) / 150));\n        send(def.index, draw());\n      }\n\n      function up() {\n        knob.removeEventListener('pointermove', move);\n        knob.removeEventListener('pointerup', up);\n      }\n\n      knob.addEventListener('pointermove', move);\n      knob.addEventListener('pointerup', up);\n    });\n\n    knob.addEventListener('dblclick', function () {\n      norm = (def.def - def.min) / (def.max - def.min);\n      send(def.index, draw());\n    });\n\n    draw();\n    values[def.index] = def.def;\n  }\n\n  function buildWave(paramIndex, title) {\n    var host = document.getElementById('wave' + paramIndex);\n    var names = ['Saw', 'Sqr', 'Tri'];\n    host.innerHTML = '<div class=\"btns\"></div><label style=\"font-size:9px;color:#b9a98c;text-transform:uppercase;letter-spacing:1px;text-align:center\">' + title + '</label>';\n    var btns = host.querySelector('.btns');\n    var buttons = [];\n\n    // visuals only\n    function draw(i) {\n      for (var b = 0; b < buttons.length; b++) {\n        buttons[b].className = b === i ? 'on' : '';\n      }\n    }\n\n    function select(i) {\n      draw(i);\n      send(paramIndex, i);\n    }\n\n    painters[paramIndex] = function (value) {\n      var v = Number(value);\n      if (isNaN(v)) return;\n      var i = Math.max(0, Math.min(2, Math.round(v)));\n      values[paramIndex] = i;\n      draw(i);\n    };\n\n    names.forEach(function (n, i) {\n      var el = document.createElement('button');\n      el.textContent = n;\n      el.addEventListener('click', function () { select(i); });\n      btns.appendChild(el);\n      buttons.push(el);\n    });\n\n    draw(0);\n    values[paramIndex] = 0;\n  }\n\n  buildWave(0, 'Osc 1');\n  buildWave(1, 'Osc 2');\n  KNOBS.forEach(buildKnob);\n\n  function pushAll() {\n    for (var i in values) {\n      if (window.vstai && window.vstai.setParam) {\n        window.vstai.setParam(Number(i), values[i]);\n      }\n    }\n  }\n\n  function onHostParam(index, value) {\n    var p = painters[index];\n    if (p) p(value);\n  }\n\n  var paramHooked = false;\n\n  function hookParam() {\n    if (paramHooked) return;\n    if (window.vstai && window.vstai.onParam) {\n      window.vstai.onParam(onHostParam);\n      paramHooked = true;\n    }\n  }\n\n  function whenReady() {\n    if (window.vstai) {\n      hookParam();\n      pushAll();\n      if (window.vstai.onReady) {\n        window.vstai.onReady(function () {\n          hookParam();\n          pushAll();\n        });\n      }\n    } else {\n      setTimeout(whenReady, 50);\n    }\n  }\n  whenReady();\n\n  // ---------- keyboard ----------\n  var FIRST_NOTE = 48;\n  var LAST_NOTE = 76;\n  var keysEl = document.getElementById('keys');\n  var keyEls = {};\n  var isBlack = [0, 1, 0, 1, 0, 0, 1, 0, 1, 0, 1, 0];\n  var whiteCount = 0;\n\n  for (var n = FIRST_NOTE; n <= LAST_NOTE; n++) {\n    if (!isBlack[n % 12]) whiteCount++;\n  }\n\n  var whiteW = 100 / whiteCount;\n  var whiteIndex = 0;\n\n  for (var m = FIRST_NOTE; m <= LAST_NOTE; m++) {\n    var el = document.createElement('div');\n    el.dataset.note = m;\n    if (isBlack[m % 12]) {\n      el.className = 'key black';\n      el.style.left = (whiteIndex * whiteW - whiteW * 0.3) + '%';\n      el.style.width = (whiteW * 0.6) + '%';\n    } else {\n      el.className = 'key white';\n      el.style.left = (whiteIndex * whiteW) + '%';\n      el.style.width = whiteW + '%';\n      whiteIndex++;\n    }\n    keysEl.appendChild(el);\n    keyEls[m] = el;\n  }\n\n  var heldCount = {};\n\n  function press(note) {\n    if (heldCount[note]) return;\n    heldCount[note] = 1;\n    if (keyEls[note]) keyEls[note].classList.add('down');\n    if (window.vstai && window.vstai.noteOn) window.vstai.noteOn(note, 0.8);\n  }\n\n  function release(note) {\n    if (!heldCount[note]) return;\n    heldCount[note] = 0;\n    if (keyEls[note]) keyEls[note].classList.remove('down');\n    if (window.vstai && window.vstai.noteOff) window.vstai.noteOff(note);\n  }\n\n  var pointerNote = {};\n\n  keysEl.addEventListener('pointerdown', function (e) {\n    var t = e.target;\n    if (!t.dataset || t.dataset.note === undefined) return;\n    var note = Number(t.dataset.note);\n    pointerNote[e.pointerId] = note;\n    keysEl.setPointerCapture(e.pointerId);\n    press(note);\n  });\n\n  keysEl.addEventListener('pointermove', function (e) {\n    if (pointerNote[e.pointerId] === undefined) return;\n    var t = document.elementFromPoint(e.clientX, e.clientY);\n    if (!t || !t.dataset || t.dataset.note === undefined) return;\n    var note = Number(t.dataset.note);\n    if (note !== pointerNote[e.pointerId]) {\n      release(pointerNote[e.pointerId]);\n      pointerNote[e.pointerId] = note;\n      press(note);\n    }\n  });\n\n  function endPointer(e) {\n    if (pointerNote[e.pointerId] === undefined) return;\n    release(pointerNote[e.pointerId]);\n    delete pointerNote[e.pointerId];\n  }\n\n  keysEl.addEventListener('pointerup', endPointer);\n  keysEl.addEventListener('pointercancel', endPointer);\n\n  // computer keyboard (typing piano), base C4 = 60\n  var KEYMAP = {\n    KeyA: 0, KeyW: 1, KeyS: 2, KeyE: 3, KeyD: 4, KeyF: 5, KeyT: 6,\n    KeyG: 7, KeyY: 8, KeyH: 9, KeyU: 10, KeyJ: 11, KeyK: 12,\n    KeyO: 13, KeyL: 14, KeyP: 15, Semicolon: 16\n  };\n  var BASE_NOTE = 60;\n  var typingDown = {};\n\n  function typingBlocked(e) {\n    if (e.metaKey || e.ctrlKey || e.altKey) return true;\n    var a = document.activeElement;\n    if (a) {\n      var tag = a.tagName;\n      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || a.isContentEditable) return true;\n    }\n    return false;\n  }\n\n  window.addEventListener('keydown', function (e) {\n    if (typingBlocked(e)) return;\n    if (KEYMAP[e.code] === undefined) return;\n    e.preventDefault();\n    if (e.repeat || typingDown[e.code]) return;\n    var note = BASE_NOTE + KEYMAP[e.code];\n    typingDown[e.code] = note;\n    press(note);\n  });\n\n  window.addEventListener('keyup', function (e) {\n    if (KEYMAP[e.code] === undefined) return;\n    e.preventDefault();\n    if (typingDown[e.code] === undefined) return;\n    var note = typingDown[e.code];\n    delete typingDown[e.code];\n    release(note);\n  });\n\n  window.addEventListener('blur', function () {\n    for (var code in typingDown) {\n      release(typingDown[code]);\n    }\n    typingDown = {};\n  });\n</script>\n</body>\n</html>\n","wasmBase64":"","explanation":"Every knob and waveform selector now registers a painter, and a single window.vstai.onParam handler repaints the matching control from the host value without calling setParam (no echo). Drawing is split into visuals-only draw() functions; layout, assembly and parameter indices are unchanged.","isInstrument":true,"locked":false,"provider":"cloud","model":"claude-sonnet-5-5","effort":"medium","thinking":true,"promptHistory":["build a simple moog grandmother clone"],"params":[{"name":"Osc1 Wave (0 saw, 1 square, 2 tri)","index":0,"min":0,"max":2,"default":0,"value":0},{"name":"Osc2 Wave (0 saw, 1 square, 2 tri)","index":1,"min":0,"max":2,"default":0,"value":0},{"name":"Osc2 Detune (semitones)","index":2,"min":-12,"max":12,"default":0.1,"value":0.100000001490116},{"name":"Osc Mix","index":3,"min":0,"max":1,"default":0.5,"value":0.5},{"name":"Cutoff","index":4,"min":0,"max":1,"default":0.45,"value":0},{"name":"Resonance","index":5,"min":0,"max":1,"default":0.35,"value":0.349999994039536},{"name":"Filter Env Amount","index":6,"min":0,"max":1,"default":0.5,"value":0.5},{"name":"Attack","index":7,"min":0.001,"max":2,"default":0.01,"value":0.009999999776483},{"name":"Decay","index":8,"min":0.01,"max":3,"default":0.4,"value":0.400000005960464},{"name":"Sustain","index":9,"min":0,"max":1,"default":0.6,"value":0.600000023841858},{"name":"Release","index":10,"min":0.01,"max":3,"default":0.3,"value":0.173782005906105},{"name":"Glide","index":11,"min":0,"max":2,"default":0,"value":0},{"name":"Level","index":12,"min":0,"max":1,"default":0.5,"value":0.5}],"presets":[],"activeRevision":0,"nextRevisionId":2,"publishedAt":1792570180749}