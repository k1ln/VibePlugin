{
  "format": 1,
  "name": "De-Esser",
  "isInstrument": false,
  "explanation": "Tames harsh sibilance on vocals. A sidechain band-pass isolates the sibilant energy around the Frequency control and drives a fast compressor that ducks only the high band when it crosses Threshold, by up to Amount; the ducked highs recombine with the untouched body so the voice loses the harsh 'sss' without going dull. Mix blends against the dry signal.",
  "params": [
    {
      "name": "Frequency",
      "index": 0,
      "min": 0,
      "max": 1,
      "default": 0.45
    },
    {
      "name": "Threshold",
      "index": 1,
      "min": 0,
      "max": 1,
      "default": 0.45
    },
    {
      "name": "Amount",
      "index": 2,
      "min": 0,
      "max": 1,
      "default": 0.6
    },
    {
      "name": "Mix",
      "index": 3,
      "min": 0,
      "max": 1,
      "default": 1
    }
  ],
  "wasmBase64": "",
  "html": "<!doctype html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>\n  :root{\n    --ac:#9ad0e0;        /* cool aqua accent */\n    --ac2:#c0e0f0;       /* pale ice highlight */\n    --panel:#0e1820;\n    --panel2:#0a1219;\n    --glass:#10212c;\n    --ink:#dff2f8;\n    --dim:#7fa6b6;\n    --line:rgba(154,208,224,.16);\n  }\n\n  *{box-sizing:border-box}\n  html,body{height:100%}\n  body{\n    margin:0;\n    font:13px ui-sans-serif,-apple-system,\"Segoe UI\",system-ui,sans-serif;\n    color:var(--ink);\n    background:\n      radial-gradient(120% 80% at 50% -8%,#13303c 0%,#0a151d 52%,#060c11 100%);\n    display:flex;align-items:center;justify-content:center;\n    padding:20px;min-height:100%;\n    -webkit-font-smoothing:antialiased;\n  }\n\n  /* ===================== panel shell ===================== */\n  .unit{\n    position:relative;\n    width:min(640px,96vw);\n    border-radius:20px;\n    padding:20px 22px 22px;\n    background:\n      linear-gradient(165deg,#16252f 0%,var(--panel) 42%,var(--panel2) 100%);\n    box-shadow:\n      0 40px 90px -28px rgba(0,0,0,.82),\n      0 1px 0 rgba(255,255,255,.07) inset,\n      0 -28px 50px -30px rgba(0,0,0,.7) inset,\n      0 0 0 1px rgba(0,0,0,.5),\n      0 0 0 4px #0a141a;\n    animation:rise .7s cubic-bezier(.2,.85,.25,1) both;\n    overflow:hidden;\n  }\n  @keyframes rise{from{opacity:0;transform:translateY(22px) scale(.97)}to{opacity:1;transform:none}}\n\n  /* faint engraved grid texture */\n  .unit::before{\n    content:\"\";position:absolute;inset:0;border-radius:20px;pointer-events:none;\n    background:\n      repeating-linear-gradient(0deg,rgba(255,255,255,.018) 0 1px,transparent 1px 26px),\n      repeating-linear-gradient(90deg,rgba(255,255,255,.014) 0 1px,transparent 1px 26px);\n    mask:radial-gradient(120% 90% at 50% 0,#000 40%,transparent 100%);\n  }\n\n  /* ===================== header ===================== */\n  .head{display:flex;align-items:center;gap:14px;margin-bottom:16px;position:relative;z-index:2}\n  .logo{\n    width:42px;height:42px;flex:0 0 auto;border-radius:12px;\n    background:radial-gradient(120% 120% at 30% 20%,#1d4150,#0c1c25);\n    box-shadow:0 1px 0 rgba(255,255,255,.1) inset,0 0 0 1px var(--line),0 8px 18px -8px rgba(0,0,0,.7);\n    display:grid;place-items:center;\n  }\n  .title{line-height:1.05}\n  .title h1{\n    margin:0;font-size:18px;letter-spacing:.32em;font-weight:700;\n    text-transform:uppercase;\n    background:linear-gradient(180deg,#fff,var(--ac));\n    -webkit-background-clip:text;background-clip:text;color:transparent;\n  }\n  .title .sub{\n    font-size:9.5px;letter-spacing:.42em;text-transform:uppercase;color:var(--dim);\n    margin-top:3px;\n  }\n  .head .spacer{flex:1}\n  .gr-led{\n    display:flex;align-items:center;gap:7px;font-size:9px;letter-spacing:.25em;\n    text-transform:uppercase;color:var(--dim);\n  }\n  .led{\n    width:9px;height:9px;border-radius:50%;\n    background:radial-gradient(circle at 35% 30%,#1a2c34,#0a141a);\n    box-shadow:0 0 0 1px rgba(0,0,0,.6) inset;\n    transition:box-shadow .08s,background .08s;\n  }\n  .led.on{\n    background:radial-gradient(circle at 35% 30%,#dff6ff,var(--ac));\n    box-shadow:0 0 10px 2px rgba(154,208,224,.7),0 0 0 1px rgba(0,0,0,.4) inset;\n  }\n\n  /* ===================== spectrum / sibilance scope ===================== */\n  .scope{\n    position:relative;z-index:2;\n    height:128px;border-radius:14px;margin-bottom:18px;overflow:hidden;\n    background:linear-gradient(180deg,#0a151c,#070e13);\n    box-shadow:0 0 0 1px var(--line),0 16px 30px -22px #000 inset,0 1px 0 rgba(255,255,255,.04);\n  }\n  .scope svg{display:block;width:100%;height:100%}\n  .scope .cap{\n    position:absolute;left:12px;top:9px;font-size:9px;letter-spacing:.3em;\n    text-transform:uppercase;color:var(--dim);\n  }\n  .scope .duck{\n    position:absolute;right:12px;top:9px;font-size:9px;letter-spacing:.18em;\n    text-transform:uppercase;color:var(--ac2);font-variant-numeric:tabular-nums;\n  }\n\n  /* ===================== controls ===================== */\n  .rack{\n    position:relative;z-index:2;\n    display:grid;grid-template-columns:repeat(4,1fr);gap:14px;\n  }\n  @media(max-width:520px){.rack{grid-template-columns:repeat(2,1fr)}}\n\n  .cell{\n    border-radius:14px;padding:14px 10px 12px;text-align:center;\n    background:linear-gradient(170deg,#12222c,#0b151c);\n    box-shadow:0 0 0 1px var(--line),0 1px 0 rgba(255,255,255,.05) inset,0 14px 26px -22px #000;\n  }\n  .cell .lbl{\n    font-size:9.5px;letter-spacing:.28em;text-transform:uppercase;color:var(--dim);\n    margin-bottom:10px;\n  }\n  .knob{\n    --a:0;                /* -135..135 deg pointer angle, set by JS */\n    position:relative;width:84px;height:84px;margin:0 auto;cursor:ns-resize;\n    touch-action:none;user-select:none;\n  }\n  .knob svg{display:block;width:100%;height:100%;overflow:visible}\n  .knob .body{\n    filter:drop-shadow(0 8px 12px rgba(0,0,0,.55));\n  }\n  .knob:active{cursor:grabbing}\n  .val{\n    margin-top:9px;font-size:13px;font-weight:600;font-variant-numeric:tabular-nums;\n    color:var(--ink);letter-spacing:.02em;\n  }\n  .val small{color:var(--dim);font-weight:400;font-size:10px;margin-left:2px}\n\n  .hint{\n    position:relative;z-index:2;text-align:center;margin-top:14px;\n    font-size:9.5px;letter-spacing:.22em;text-transform:uppercase;color:rgba(127,166,182,.55);\n  }\n</style>\n</head>\n<body>\n  <div class=\"unit\">\n\n    <div class=\"head\">\n      <div class=\"logo\">\n        <!-- stylised \"sss\" caught in a net -->\n        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\">\n          <path d=\"M5 8c4-3 7 2 9-1\" stroke=\"#9ad0e0\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n          <path d=\"M5 13c4-3 7 2 9-1\" stroke=\"#c0e0f0\" stroke-width=\"1.7\" stroke-linecap=\"round\" opacity=\".75\"/>\n          <path d=\"M5 18c4-3 7 2 9-1\" stroke=\"#9ad0e0\" stroke-width=\"1.7\" stroke-linecap=\"round\" opacity=\".5\"/>\n          <circle cx=\"18.5\" cy=\"6\" r=\"2.4\" stroke=\"#c0e0f0\" stroke-width=\"1.4\"/>\n        </svg>\n      </div>\n      <div class=\"title\">\n        <h1>De-Esser</h1>\n        <div class=\"sub\">Sibilance Control</div>\n      </div>\n      <div class=\"spacer\"></div>\n      <div class=\"gr-led\"><span class=\"led\" id=\"led\"></span>Reduction</div>\n    </div>\n\n    <!-- spectrum scope with highlighted sibilant band + sss particles -->\n    <div class=\"scope\">\n      <div class=\"cap\">Sibilant Band</div>\n      <div class=\"duck\" id=\"duckTxt\">-0.0 dB</div>\n      <svg viewBox=\"0 0 600 128\" preserveAspectRatio=\"none\">\n        <defs>\n          <linearGradient id=\"bandG\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n            <stop offset=\"0\" stop-color=\"#9ad0e0\" stop-opacity=\".42\"/>\n            <stop offset=\"1\" stop-color=\"#9ad0e0\" stop-opacity=\"0\"/>\n          </linearGradient>\n          <linearGradient id=\"specG\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n            <stop offset=\"0\" stop-color=\"#c0e0f0\" stop-opacity=\".9\"/>\n            <stop offset=\"1\" stop-color=\"#3f6f82\" stop-opacity=\".25\"/>\n          </linearGradient>\n        </defs>\n        <!-- baseline grid -->\n        <g stroke=\"rgba(154,208,224,.10)\" stroke-width=\"1\">\n          <line x1=\"0\" y1=\"32\" x2=\"600\" y2=\"32\"/>\n          <line x1=\"0\" y1=\"64\" x2=\"600\" y2=\"64\"/>\n          <line x1=\"0\" y1=\"96\" x2=\"600\" y2=\"96\"/>\n        </g>\n        <!-- highlighted sibilant band (moves/scales with Frequency + ducking) -->\n        <rect id=\"band\" x=\"380\" y=\"0\" width=\"120\" height=\"128\" fill=\"url(#bandG)\"/>\n        <line id=\"bandEdgeL\" x1=\"380\" y1=\"0\" x2=\"380\" y2=\"128\" stroke=\"#9ad0e0\" stroke-width=\"1\" stroke-dasharray=\"3 4\" opacity=\".5\"/>\n        <line id=\"bandEdgeR\" x1=\"500\" y1=\"0\" x2=\"500\" y2=\"128\" stroke=\"#9ad0e0\" stroke-width=\"1\" stroke-dasharray=\"3 4\" opacity=\".5\"/>\n        <!-- animated spectrum curve -->\n        <path id=\"spec\" d=\"\" fill=\"url(#specG)\" stroke=\"#c0e0f0\" stroke-width=\"1.4\"/>\n        <!-- \"sss\" particles streaming + being ducked at the band -->\n        <g id=\"particles\"></g>\n      </svg>\n    </div>\n\n    <div class=\"rack\" id=\"rack\"></div>\n\n    <div class=\"hint\">Drag vertically &nbsp;·&nbsp; Double-click to reset</div>\n  </div>\n\n<script>\n(function(){\n  \"use strict\";\n\n  // ---- parameter map (indices MUST match assembly.ts P_*) ----\n  var PARAMS = [\n    { name:\"Frequency\", index:0, min:0, max:1, def:0.45, fmt:freqFmt },\n    { name:\"Threshold\", index:1, min:0, max:1, def:0.45, fmt:threshFmt },\n    { name:\"Amount\",    index:2, min:0, max:1, def:0.6,  fmt:amtFmt },\n    { name:\"Mix\",       index:3, min:0, max:1, def:1.0,  fmt:pctFmt }\n  ];\n\n  var state = PARAMS.map(function(p){ return p.def; });\n\n  // ---- value display formatters (norm 0..1 -> human) ----\n  function freqFmt(v){\n    var hz = 4000 + v*6000;\n    return { t:(hz/1000).toFixed(2), u:\"kHz\" };\n  }\n  function threshFmt(v){\n    var db = -50 + v*50;\n    return { t:db.toFixed(0), u:\"dB\" };\n  }\n  function amtFmt(v){\n    return { t:(v*24).toFixed(1), u:\"dB\" };\n  }\n  function pctFmt(v){\n    return { t:(v*100).toFixed(0), u:\"%\" };\n  }\n\n  // ---------------------------------------------------------------\n  //  host bridge\n  // ---------------------------------------------------------------\n  function push(i, v){\n    if (window.vstai && window.vstai.setParam) window.vstai.setParam(i, v);\n  }\n\n  // ---------------------------------------------------------------\n  //  knob factory — SVG arc + pointer, vertical drag\n  // ---------------------------------------------------------------\n  var SW = 270; // total sweep degrees\n\n  function makeKnob(p, idx){\n    var cell = document.createElement(\"div\");\n    cell.className = \"cell\";\n\n    var lbl = document.createElement(\"div\");\n    lbl.className = \"lbl\";\n    lbl.textContent = p.name;\n\n    var knob = document.createElement(\"div\");\n    knob.className = \"knob\";\n\n    knob.innerHTML =\n      '<svg viewBox=\"0 0 100 100\">' +\n        '<circle cx=\"50\" cy=\"50\" r=\"42\" fill=\"none\" stroke=\"rgba(154,208,224,.14)\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-dasharray=\"198 264\" transform=\"rotate(135 50 50)\"/>' +\n        '<circle class=\"arc\" cx=\"50\" cy=\"50\" r=\"42\" fill=\"none\" stroke=\"url(#kg'+idx+')\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-dasharray=\"0 264\" transform=\"rotate(135 50 50)\"/>' +\n        '<g class=\"body\">' +\n          '<circle cx=\"50\" cy=\"50\" r=\"30\" fill=\"#0c1a22\"/>' +\n          '<circle cx=\"50\" cy=\"50\" r=\"30\" fill=\"none\" stroke=\"rgba(255,255,255,.06)\" stroke-width=\"1\"/>' +\n          '<circle cx=\"50\" cy=\"46\" r=\"29\" fill=\"none\" stroke=\"rgba(255,255,255,.05)\" stroke-width=\"2\"/>' +\n        '</g>' +\n        '<g class=\"ptr\">' +\n          '<line x1=\"50\" y1=\"50\" x2=\"50\" y2=\"26\" stroke=\"#dff2f8\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>' +\n          '<circle cx=\"50\" cy=\"26\" r=\"2.6\" fill=\"#c0e0f0\"/>' +\n        '</g>' +\n        '<defs><linearGradient id=\"kg'+idx+'\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">' +\n          '<stop offset=\"0\" stop-color=\"#c0e0f0\"/><stop offset=\"1\" stop-color=\"#9ad0e0\"/>' +\n        '</linearGradient></defs>' +\n      '</svg>';\n\n    var val = document.createElement(\"div\");\n    val.className = \"val\";\n\n    cell.appendChild(lbl);\n    cell.appendChild(knob);\n    cell.appendChild(val);\n\n    var arc = knob.querySelector(\".arc\");\n    var ptr = knob.querySelector(\".ptr\");\n\n    function render(){\n      var v = state[idx];\n      var ang = -135 + v*SW;\n      ptr.setAttribute(\"transform\",\"rotate(\"+ang+\" 50 50)\");\n      arc.setAttribute(\"stroke-dasharray\", (v*198).toFixed(1)+\" 264\");\n      var f = p.fmt(v);\n      val.innerHTML = f.t + ' <small>'+f.u+'</small>';\n    }\n\n    // ---- drag handling ----\n    var dragging=false, startY=0, startV=0;\n    function onDown(e){\n      dragging=true;\n      startY = (e.touches? e.touches[0].clientY : e.clientY);\n      startV = state[idx];\n      knob.style.filter=\"brightness(1.18)\";\n      e.preventDefault();\n    }\n    function onMove(e){\n      if(!dragging) return;\n      var y = (e.touches? e.touches[0].clientY : e.clientY);\n      var dv = (startY - y)/200;            // 200px = full travel\n      var v = Math.max(0, Math.min(1, startV + dv));\n      state[idx]=v; render(); push(p.index, v);\n      e.preventDefault();\n    }\n    function onUp(){ dragging=false; knob.style.filter=\"\"; }\n\n    knob.addEventListener(\"mousedown\", onDown);\n    knob.addEventListener(\"touchstart\", onDown, {passive:false});\n    window.addEventListener(\"mousemove\", onMove);\n    window.addEventListener(\"touchmove\", onMove, {passive:false});\n    window.addEventListener(\"mouseup\", onUp);\n    window.addEventListener(\"touchend\", onUp);\n\n    // wheel fine-tune\n    knob.addEventListener(\"wheel\", function(e){\n      var v = Math.max(0,Math.min(1, state[idx] - Math.sign(e.deltaY)*0.02));\n      state[idx]=v; render(); push(p.index, v);\n      e.preventDefault();\n    }, {passive:false});\n\n    // double-click reset\n    knob.addEventListener(\"dblclick\", function(){\n      state[idx]=p.def; render(); push(p.index, p.def);\n    });\n\n    p._render = render;\n    return cell;\n  }\n\n  var rack = document.getElementById(\"rack\");\n  PARAMS.forEach(function(p, i){ rack.appendChild(makeKnob(p, i)); });\n\n  // ---------------------------------------------------------------\n  //  scope animation — spectrum + highlighted sibilant band + sss\n  // ---------------------------------------------------------------\n  var specEl  = document.getElementById(\"spec\");\n  var bandEl  = document.getElementById(\"band\");\n  var edgeL   = document.getElementById(\"bandEdgeL\");\n  var edgeR   = document.getElementById(\"bandEdgeR\");\n  var partG   = document.getElementById(\"particles\");\n  var duckTxt = document.getElementById(\"duckTxt\");\n  var led     = document.getElementById(\"led\");\n\n  var W=600, H=128, N=80;\n\n  // sss particle pool — little dashes that stream rightward into the band\n  var particles=[];\n  for(var i=0;i<14;i++){\n    var t=document.createElementNS(\"http://www.w3.org/2000/svg\",\"text\");\n    t.setAttribute(\"fill\",\"#c0e0f0\");\n    t.setAttribute(\"font-size\", (7+Math.random()*5).toFixed(0));\n    t.setAttribute(\"font-family\",\"ui-sans-serif,sans-serif\");\n    t.textContent=\"s\";\n    partG.appendChild(t);\n    particles.push({el:t, x:Math.random()*W, y:14+Math.random()*100, sp:0.8+Math.random()*1.4, base:0});\n  }\n\n  var phase=0;\n  var duckAmt=0;       // smoothed gain-reduction display 0..1\n\n  function bandX(){\n    // Frequency 0..1 maps centre 4..10kHz -> x along scope (log-ish feel)\n    var v = state[0];\n    var cx = 200 + v*320;          // band centre x\n    var halfW = 46;                 // visual band half-width\n    return { cx:cx, l:cx-halfW, r:cx+halfW };\n  }\n\n  function frame(){\n    if(document.hidden){ requestAnimationFrame(frame); return; }\n    phase += 0.045;\n\n    var b = bandX();\n    bandEl.setAttribute(\"x\", b.l.toFixed(1));\n    bandEl.setAttribute(\"width\", (b.r-b.l).toFixed(1));\n    edgeL.setAttribute(\"x1\", b.l.toFixed(1)); edgeL.setAttribute(\"x2\", b.l.toFixed(1));\n    edgeR.setAttribute(\"x1\", b.r.toFixed(1)); edgeR.setAttribute(\"x2\", b.r.toFixed(1));\n\n    // simulate sibilant energy: rises and falls; ducking responds to it\n    var sibDrive = 0.5 + 0.5*Math.sin(phase*1.7) * (0.6+0.4*Math.sin(phase*0.5));\n    var thr = state[1];                 // higher threshold -> harder to trigger\n    var over = Math.max(0, sibDrive - (0.25 + thr*0.6));\n    var targetDuck = Math.min(1, over*2.4) * state[2];   // scaled by Amount\n    targetDuck *= state[3];             // and by Mix\n    duckAmt += (targetDuck - duckAmt)*0.18;\n\n    // led + readout\n    if(duckAmt>0.04){ led.classList.add(\"on\"); } else { led.classList.remove(\"on\"); }\n    duckTxt.textContent = \"-\" + (duckAmt*24).toFixed(1) + \" dB\";\n\n    // build spectrum path: broadband hump + a sibilant peak inside the band\n    var d=\"M0 \"+H;\n    for(var k=0;k<=N;k++){\n      var x = k/N*W;\n      // base voice spectrum: energy tilts down with frequency\n      var nrm = x/W;\n      var voice = 0.55*Math.exp(-Math.pow((nrm-0.18)/0.16,2));   // body hump\n      var air   = 0.16*(1-nrm);\n      // sibilant peak sitting in the band, wobbling\n      var dist = (x - b.cx)/52;\n      var sib = sibDrive*0.7*Math.exp(-dist*dist);\n      // duck the sibilant peak when reducing\n      sib *= (1 - duckAmt*0.92);\n      var amp = voice + air + sib + 0.02*Math.sin(phase*3+ k*0.6);\n      var y = H - amp*H*0.92;\n      if(y<2)y=2; if(y>H)y=H;\n      d += \" L\"+x.toFixed(1)+\" \"+y.toFixed(1);\n    }\n    d += \" L\"+W+\" \"+H+\" Z\";\n    specEl.setAttribute(\"d\", d);\n\n    // animate sss particles: drift right, get \"caught\" (fade) in the band\n    for(var p=0;p<particles.length;p++){\n      var P=particles[p];\n      P.x += P.sp*(1.4 - duckAmt*0.9);\n      if(P.x>W){ P.x = -10; P.y = 14+Math.random()*100; }\n      var inBand = P.x > b.l && P.x < b.r;\n      var op;\n      if(inBand){\n        // caught & ducked: shrink + fade with reduction\n        op = 0.85*(1-duckAmt) + 0.05;\n        P.el.setAttribute(\"font-size\", (6 - duckAmt*3).toFixed(1));\n      } else {\n        op = 0.35;\n        P.el.setAttribute(\"font-size\",\"7\");\n      }\n      P.el.setAttribute(\"x\", P.x.toFixed(1));\n      P.el.setAttribute(\"y\", P.y.toFixed(1));\n      P.el.setAttribute(\"opacity\", op.toFixed(2));\n    }\n\n    requestAnimationFrame(frame);\n  }\n  requestAnimationFrame(frame);\n\n  // ---------------------------------------------------------------\n  //  init: render knobs + push defaults to engine\n  // ---------------------------------------------------------------\n  function start(){\n    PARAMS.forEach(function(p,i){\n      if(p._render) p._render();\n      push(p.index, state[i]);\n    });\n    // Follow param changes from outside the GUI — session restore, preset load, DAW\n    // automation. The host replays the restored values in here right after we register,\n    // so every knob repaints to the saved sound instead of its default.\n    if (window.vstai && window.vstai.onParam) window.vstai.onParam(function(i, v){\n      for (var k = 0; k < PARAMS.length; k++){\n        if (PARAMS[k].index === i){ state[k] = +v; if (PARAMS[k]._render) PARAMS[k]._render(); break; }\n      }\n    });\n  }\n\n  if (window.vstai && window.vstai.onReady) {\n    window.vstai.onReady(start);\n  } else {\n    start();\n  }\n})();\n</script>\n<script data-vstai-sound-bar>\n(function () {\n  if (window.__vstaiSoundBarBuilt) return;\n  var POS_KEY = 'vstai.soundBar.pos', MIN_KEY = 'vstai.soundBar.min';\n  var tries = 0;\n\n  function store(k, v) { try { if (v == null) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) {} return null; }\n\n  function ready() {\n    var V = window.vstai;\n    return V && V.presets && typeof V.openBrowser === 'function' && typeof V.saveSound === 'function';\n  }\n\n  function boot() {\n    if (window.__vstaiSoundBarBuilt) return;\n    if (window.__vstaiNativeSoundBar) return;                       // the host draws its own bar\n    if (!ready()) { if (++tries < 40) setTimeout(boot, 150); return; }\n    if (document.querySelector('[data-vstai-sound]')) return;       // the GUI has its own control\n    window.__vstaiSoundBarBuilt = true;\n    build(window.vstai);\n  }\n\n  function build(V) {\n    var host = document.createElement('div');\n    host.id = 'vstai-sound-bar';\n    host.setAttribute('data-vstai-sound-bar-host', '');\n    host.style.cssText = 'position:fixed;top:8px;right:8px;z-index:2147483000;margin:0;padding:0;border:0';\n    var root = host.attachShadow({ mode: 'open' });\n    var css = document.createElement('style');\n    css.textContent = [\n      ':host{all:initial}*{box-sizing:border-box}',\n      '.bar{display:flex;align-items:center;gap:1px;height:26px;padding:0 3px;border-radius:13px;',\n      ' background:rgba(14,18,24,.86);border:1px solid rgba(255,255,255,.2);box-shadow:0 2px 10px rgba(0,0,0,.45);',\n      ' color:#e6e9ee;font:11px/1 -apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,sans-serif;',\n      ' opacity:.62;transition:opacity .12s;user-select:none;-webkit-user-select:none}',\n      '.bar:hover,.bar.drag{opacity:1}',\n      'button{font:inherit;color:inherit;background:transparent;border:0;border-radius:10px;height:20px;min-width:20px;padding:0 5px;cursor:pointer;line-height:20px}',\n      'button:hover{background:rgba(255,255,255,.14)}button:active{background:rgba(255,255,255,.24)}',\n      '.grip{cursor:grab;min-width:12px;padding:0 3px;color:#8a95a5;letter-spacing:-2px;touch-action:none}.drag .grip{cursor:grabbing}',\n      '.name{max-width:130px;min-width:46px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:center;font-weight:600}',\n      '.save{background:#6fd8bd;color:#06231c;font-weight:700;margin-left:2px}.save:hover{background:#85e3cc}',\n      '.arrow{font-size:15px;padding:0 4px}',\n      '.min .hide{display:none}'\n    ].join('');\n    root.appendChild(css);\n\n    function el(tag, cls, text, title) {\n      var e = document.createElement(tag);\n      if (cls) e.className = cls;\n      if (text != null) e.textContent = text;\n      if (title) e.title = title;\n      if (tag === 'button') e.type = 'button';\n      return e;\n    }\n    var bar = el('div', 'bar');\n    var grip = el('button', 'grip', '⋮⋮', 'Drag to move');\n    var prev = el('button', 'arrow hide', '‹', 'Previous sound');\n    var name = el('button', 'name hide', 'Sounds', 'Browse sounds: types, tags, favorites');\n    var next = el('button', 'arrow hide', '›', 'Next sound');\n    var save = el('button', 'save hide', 'Save', 'Save the current knob positions as a sound');\n    var fold = el('button', 'fold', '–', 'Fold away');\n    [grip, prev, name, next, save, fold].forEach(function (b) { bar.appendChild(b); });\n    root.appendChild(bar);\n\n    // The page behind must keep keyboard focus (typing piano) and never see our pointer traffic.\n    bar.addEventListener('mousedown', function (e) { e.preventDefault(); });\n    ['pointerdown', 'mousedown', 'touchstart', 'click', 'contextmenu'].forEach(function (t) {\n      bar.addEventListener(t, function (e) { e.stopPropagation(); });\n    });\n\n    prev.onclick = function () { V.prevPreset(); };\n    next.onclick = function () { V.nextPreset(); };\n    name.onclick = function () { V.openBrowser(); };\n    save.onclick = function () { V.saveSound(); };\n\n    function setMin(m) {\n      bar.className = 'bar' + (m ? ' min' : '');\n      fold.textContent = m ? '♫' : '–';\n      fold.title = m ? 'Show the sound bar' : 'Fold away';\n      store(MIN_KEY, m ? '1' : '0');\n      clamp();\n    }\n    fold.onclick = function () { setMin(bar.className.indexOf('min') < 0); };\n\n    // ---- position: drag by the grip, remember, keep on screen ----------------\n    function clamp() {\n      var r = host.getBoundingClientRect(), w = window.innerWidth, h = window.innerHeight;\n      var x = Math.min(Math.max(0, r.left), Math.max(0, w - r.width));\n      var y = Math.min(Math.max(0, r.top), Math.max(0, h - r.height));\n      if (host.style.left || host.style.right === 'auto') { host.style.left = x + 'px'; host.style.top = y + 'px'; host.style.right = 'auto'; }\n    }\n    function place(x, y) { host.style.left = x + 'px'; host.style.top = y + 'px'; host.style.right = 'auto'; clamp(); }\n    var drag = null;\n    grip.addEventListener('pointerdown', function (e) {\n      var r = host.getBoundingClientRect();\n      drag = { dx: e.clientX - r.left, dy: e.clientY - r.top };\n      bar.className += ' drag';\n      try { grip.setPointerCapture(e.pointerId); } catch (x) {}\n    });\n    grip.addEventListener('pointermove', function (e) { if (drag) place(e.clientX - drag.dx, e.clientY - drag.dy); });\n    function drop() {\n      if (!drag) return;\n      drag = null; bar.className = bar.className.replace(' drag', '');\n      var r = host.getBoundingClientRect(); store(POS_KEY, Math.round(r.left) + ',' + Math.round(r.top));\n    }\n    grip.addEventListener('pointerup', drop);\n    grip.addEventListener('pointercancel', drop);\n    window.addEventListener('resize', clamp);\n\n    document.documentElement.appendChild(host);\n    setMin(store(MIN_KEY) === '1');\n    var saved = (store(POS_KEY) || '').split(',');\n    if (saved.length === 2 && isFinite(+saved[0]) && isFinite(+saved[1])) place(+saved[0], +saved[1]);\n    else {\n      // No remembered spot: once the GUI has drawn, park the bar where it hides the least.\n      var settle = function () { if (!drag) autoPlace(); };\n      setTimeout(settle, 700); setTimeout(settle, 2500);\n    }\n\n    // The corner / edge whose pill-sized patch is mostly empty background: sample a grid of points and\n    // count how many land on something control-sized (a panel or the page itself counts as background).\n    function autoPlace() {\n      if (store(POS_KEY)) return;\n      var w = window.innerWidth, h = window.innerHeight, r = host.getBoundingClientRect(), bw = r.width, bh = r.height, m = 8;\n      if (!bw || !bh) return;\n      var cand = [[w - bw - m, m], [m, m], [(w - bw) / 2, m], [w - bw - m, h - bh - m], [m, h - bh - m], [(w - bw) / 2, h - bh - m]];\n      var prev = host.style.display; host.style.display = 'none';          // look at the GUI, not at ourselves\n      var best = -1, bestScore = 1e9;\n      for (var c = 0; c < cand.length; c++) {\n        var x0 = cand[c][0], y0 = cand[c][1], score = 0;\n        for (var gx = 0; gx < 8; gx++) for (var gy = 0; gy < 3; gy++) {\n          var e = document.elementFromPoint(x0 + (gx + .5) * bw / 8, y0 + (gy + .5) * bh / 3);\n          if (!e || e === document.body || e === document.documentElement) continue;\n          var b = e.getBoundingClientRect();\n          if (b.width * b.height < .3 * w * h) score++;                        // a control-sized thing is under here\n        }\n        score += c * .01;                                                      // ties keep the earlier (top-right first) choice\n        if (score < bestScore) { bestScore = score; best = c; }\n      }\n      host.style.display = prev;\n      var cur = bestScore;\n      if (best > 0 || cur >= 1) place(cand[best][0], cand[best][1]);\n      host.__placed = best;\n    }\n\n    // ---- the name follows the loaded sound ------------------------------------\n    function show(d) {\n      var n = '';\n      for (var i = 0; i < d.entries.length; i++) if (d.entries[i].id === d.current) n = d.entries[i].name;\n      name.textContent = n || 'Sounds';\n      name.title = n ? n + ' – browse sounds' : 'Browse sounds: types, tags, favorites';\n    }\n    V.presets.onChange(show);\n    V.presets.list().catch(function () {});\n  }\n\n  // Give the GUI time to build itself first: one that makes its own sound control (data-vstai-sound)\n  // does it while loading, and the bar must see that before deciding to show up.\n  function later() { setTimeout(boot, 350); }\n  if (document.readyState === 'complete') later(); else window.addEventListener('load', later);\n})();\n</script>\n</body>\n</html>\n",
  "assembly": "// =====================================================================\n//  DE-ESSER — sibilance tamer for vocals\n//  A sidechain band-pass (~5-9 kHz, Frequency) isolates the sibilant\n//  energy; a fast peak follower drives a downward compressor that ducks\n//  ONLY the high band when it crosses Threshold, by up to Amount dB. The\n//  ducked high band is recombined with the untouched body (Linkwitz-style\n//  split), so vocals lose the harsh \"sss\" without going dull. Mix blends\n//  the processed signal against the dry input. Pure algorithm, no samples.\n// =====================================================================\n\nconst MAX_FRAMES: i32 = 8192;\nconst MAX_CHANNELS: i32 = 2;\nconst MAX_PARAMS: i32 = 64;\n\nconst inBuf:  StaticArray<f32> = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\nconst outBuf: StaticArray<f32> = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\nconst params: StaticArray<f32> = new StaticArray<f32>(MAX_PARAMS);\n\nlet sampleRate: f32 = 48000.0;\nlet channels: i32 = 2;\n\n// per-channel crossover state (one-pole low/high split for the audio path)\nconst splitLP: StaticArray<f32> = new StaticArray<f32>(MAX_CHANNELS); // low band (body)\n// per-channel sidechain band-pass state (low-pass then high-pass -> band)\nconst scLP: StaticArray<f32> = new StaticArray<f32>(MAX_CHANNELS);\nconst scHP: StaticArray<f32> = new StaticArray<f32>(MAX_CHANNELS);\n// per-channel envelope follower (linear amplitude of the sibilant band)\nconst env: StaticArray<f32> = new StaticArray<f32>(MAX_CHANNELS);\n\nconst P_FREQ: i32 = 0;   // 0..1 -> band centre 4000..10000 Hz\nconst P_THRESH: i32 = 1; // 0..1 -> threshold -50..0 dB\nconst P_AMOUNT: i32 = 2; // 0..1 -> max reduction 0..24 dB\nconst P_MIX: i32 = 3;    // 0..1 dry/wet\n\nexport function init(sr: f32, maxFrames: i32, numChannels: i32): void {\n  sampleRate = sr > 0.0 ? sr : 48000.0;\n  channels = numChannels < MAX_CHANNELS ? numChannels : MAX_CHANNELS;\n  for (let c = 0; c < MAX_CHANNELS; c++) {\n    splitLP[c] = 0.0;\n    scLP[c] = 0.0;\n    scHP[c] = 0.0;\n    env[c] = 0.0;\n  }\n  params[P_FREQ] = 0.45;   // ~6.7 kHz\n  params[P_THRESH] = 0.45; // ~ -27 dB\n  params[P_AMOUNT] = 0.6;  // ~14 dB max reduction\n  params[P_MIX] = 1.0;\n}\n\nexport function getInputPtr(): usize  { return changetype<usize>(inBuf); }\nexport function getOutputPtr(): usize { return changetype<usize>(outBuf); }\nexport function getParamsPtr(): usize { return changetype<usize>(params); }\nexport function getNumParams(): i32   { return 4; }\n\n@inline function clampf(x: f32, lo: f32, hi: f32): f32 { return x < lo ? lo : (x > hi ? hi : x); }\n\n// one-pole coefficient for a given corner frequency\n@inline function coeff(hz: f32, sr: f32): f32 {\n  const c: f32 = f32(1.0 - Mathf.exp(-2.0 * 3.14159265 * hz / sr));\n  return clampf(c, 0.0, 1.0);\n}\n\nexport function process(n: i32): void {\n  const freqN: f32 = clampf(params[P_FREQ], 0.0, 1.0);\n  const threshN: f32 = clampf(params[P_THRESH], 0.0, 1.0);\n  const amountN: f32 = clampf(params[P_AMOUNT], 0.0, 1.0);\n  const mix: f32 = clampf(params[P_MIX], 0.0, 1.0);\n\n  // sibilant band centre 4..10 kHz; the detector band-pass spans ~0.6x..1.6x of it\n  const centre: f32 = 4000.0 + freqN * 6000.0;\n  const bandLoHz: f32 = clampf(centre * 0.62, 1000.0, sampleRate * 0.45);\n  const bandHiHz: f32 = clampf(centre * 1.7, bandLoHz + 500.0, sampleRate * 0.49);\n\n  // audio-path crossover: split body (low) from highs at the band's lower edge\n  const xoverHz: f32 = bandLoHz;\n  const cXover: f32 = coeff(xoverHz, sampleRate);\n\n  // sidechain band-pass = LP(bandHi) then HP(bandLo)\n  const cScLP: f32 = coeff(bandHiHz, sampleRate);\n  const cScHP: f32 = coeff(bandLoHz, sampleRate);\n\n  // threshold in linear amplitude (-50..0 dB)\n  const threshDb: f32 = -50.0 + threshN * 50.0;\n  const threshLin: f32 = f32(Mathf.exp(threshDb * 0.11512925)); // 10^(dB/20)\n\n  // max reduction 0..24 dB -> minimum gain on the high band\n  const maxRedDb: f32 = amountN * 24.0;\n  const minGain: f32 = f32(Mathf.exp(-maxRedDb * 0.11512925));\n\n  // fast attack / moderate release envelope (ms -> per-sample coeff)\n  const atkCoeff: f32 = coeff(1000.0 / 0.5, sampleRate);  // ~0.5 ms attack\n  const relCoeff: f32 = coeff(1000.0 / 35.0, sampleRate); // ~35 ms release\n\n  for (let c = 0; c < channels; c++) {\n    const base: i32 = c * MAX_FRAMES;\n    let lpS: f32 = splitLP[c];\n    let scl: f32 = scLP[c];\n    let sch: f32 = scHP[c];\n    let e: f32 = env[c];\n\n    for (let f = 0; f < n; f++) {\n      const x: f32 = inBuf[base + f];\n\n      // --- audio-path split into body (low) + highs ---\n      lpS = lpS + cXover * (x - lpS);\n      const low: f32 = lpS;\n      const high: f32 = x - lpS;\n\n      // --- sidechain band-pass detector ---\n      scl = scl + cScLP * (x - scl); // low-pass\n      const bp: f32 = scl - sch;     // minus the high-passed running low\n      sch = sch + cScHP * (scl - sch);\n\n      // envelope follow the rectified band-pass\n      const rect: f32 = bp < 0.0 ? -bp : bp;\n      if (rect > e) e = e + atkCoeff * (rect - e);\n      else e = e + relCoeff * (rect - e);\n\n      // --- gain computer: downward compression above threshold ---\n      let g: f32 = 1.0;\n      if (e > threshLin && e > 0.0000001) {\n        // reduce proportionally to how far the band exceeds the threshold.\n        // ratio ~ infinity-ish: target the band down toward the threshold.\n        const desired: f32 = threshLin / e; // <1\n        g = desired < minGain ? minGain : desired;\n      }\n\n      const duckedHigh: f32 = high * g;\n      const wet: f32 = low + duckedHigh;\n      outBuf[base + f] = x * (1.0 - mix) + wet * mix;\n    }\n\n    splitLP[c] = lpS;\n    scLP[c] = scl;\n    scHP[c] = sch;\n    env[c] = e;\n  }\n}\n",
  "publishedAt": 1751000052000
}