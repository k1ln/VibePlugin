{"format":1,"name":"FM Emancipation","assembly":"const MAX_FRAMES: i32 = 8192;\nconst MAX_CHANNELS: i32 = 2;\nconst MAX_PARAMS: i32 = 64;\nconst NV: i32 = 8;\nconst inBuf = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\nconst outBuf = new StaticArray<f32>(MAX_FRAMES * MAX_CHANNELS);\nconst params = new StaticArray<f32>(MAX_PARAMS);\n\nconst ALG: string[] = [\n  '6>55>34>33>22>1;12',\n  '6>55>44>33>22>1;1',\n  '2>14>36>5;135',\n  '3>22>16>55>4;14',\n  '4>35>36>33>12>1;1',\n  ';123456',\n  '2>1;13456',\n  '6>55>4;1234',\n  '2*14>36>5;135',\n  '6>55>44>33*12>1;13',\n  '6*55>44>33>22>1;1',\n  '6>55*44>33>22*1;1',\n  '6>56*45>34>23>1;12',\n  '6>55>44>14>23>13>2;12',\n  '6>55*44>33*22>1;1',\n  '6*35*34>33>12>1;1',\n  '6>55>44*33>22>1;13',\n  '6>15>14>13>12>1;1',\n  '6>25>24>23>2;12',\n  '6*55*44*33*22*1;1'\n];\n\nconst fmMask = new StaticArray<i32>(120);\nconst amMask = new StaticArray<i32>(120);\nconst carMask = new StaticArray<i32>(20);\nconst carCnt = new StaticArray<i32>(20);\n\nlet sr: f32 = 44100;\nlet invSr: f32 = 1.0 / 44100.0;\nconst TWO_PI: f32 = 6.2831855;\n\nconst vAct = new StaticArray<i32>(NV);\nconst vNote = new StaticArray<i32>(NV);\nconst vGate = new StaticArray<i32>(NV);\nconst vAge = new StaticArray<i32>(NV);\nconst vFreq = new StaticArray<f32>(NV);\nconst vVel = new StaticArray<f32>(NV);\nconst vKt = new StaticArray<f32>(NV);\nconst pEnv = new StaticArray<f32>(NV);\nconst ph = new StaticArray<f32>(NV * 6);\nconst env = new StaticArray<f32>(NV * 6);\nconst stg = new StaticArray<i32>(NV * 6);\nconst fb1 = new StaticArray<f32>(NV * 6);\nconst fb2 = new StaticArray<f32>(NV * 6);\n\nconst outs = new StaticArray<f32>(6);\nconst ratioE = new StaticArray<f32>(6);\nconst rS = new StaticArray<f32>(6);\nconst lS = new StaticArray<f32>(6);\nconst aInc = new StaticArray<f32>(6);\nconst dC = new StaticArray<f32>(6);\nconst rC = new StaticArray<f32>(6);\nconst sus = new StaticArray<f32>(6);\nconst lvl = new StaticArray<f32>(6);\nconst fbA = new StaticArray<f32>(6);\nconst sp = new StaticArray<f32>(6);\nconst wv = new StaticArray<i32>(6);\n\nconst fmA = new StaticArray<f32>(MAX_FRAMES);\nconst amA = new StaticArray<f32>(MAX_FRAMES);\nconst vibA = new StaticArray<f32>(MAX_FRAMES);\nconst tremA = new StaticArray<f32>(MAX_FRAMES);\n\nlet lfoPh: f32 = 0;\nlet fmSm: f32 = 0;\nlet amSm: f32 = 0;\nlet volSm: f32 = 0.3;\nlet panSm: f32 = 0;\nlet widSm: f32 = 1;\nlet ageCtr: i32 = 0;\nlet primed: bool = false;\n\nfunction clampf(x: f32, lo: f32, hi: f32): f32 {\n  return x < lo ? lo : (x > hi ? hi : x);\n}\n\nfunction wave(t: i32, p0: f32): f32 {\n  const p: f32 = p0 - Mathf.floor(p0);\n  if (t == 0) return f32(Mathf.sin(p * TWO_PI));\n  if (t == 1) return p < 0.5 ? f32(4.0 * p - 1.0) : f32(3.0 - 4.0 * p);\n  if (t == 2) return f32(2.0 * p - 1.0);\n  if (t == 3) return p < 0.5 ? f32(1.0) : f32(-1.0);\n  return p < 0.5 ? f32(Mathf.sin(p * TWO_PI)) : f32(0.0);\n}\n\nfunction parseAlgs(): void {\n  for (let a: i32 = 0; a < 20; a++) {\n    const s: string = ALG[a];\n    const len: i32 = s.length;\n    let i: i32 = 0;\n    let cc: i32 = 0;\n    while (i < len) {\n      const c: i32 = s.charCodeAt(i);\n      if (c == 59) {\n        for (let j: i32 = i + 1; j < len; j++) {\n          const o: i32 = s.charCodeAt(j) - 49;\n          carMask[a] = carMask[a] | (1 << o);\n          cc++;\n        }\n        break;\n      }\n      const from: i32 = c - 49;\n      const kind: i32 = s.charCodeAt(i + 1);\n      const to: i32 = s.charCodeAt(i + 2) - 49;\n      if (kind == 62) {\n        fmMask[a * 6 + to] = fmMask[a * 6 + to] | (1 << from);\n      } else {\n        amMask[a * 6 + to] = amMask[a * 6 + to] | (1 << from);\n      }\n      i += 3;\n    }\n    carCnt[a] = cc < 1 ? 1 : cc;\n  }\n}\n\nfunction setDefaults(): void {\n  for (let o: i32 = 0; o < 6; o++) {\n    const b: i32 = o * 8;\n    const rt: i32 = o == 2 ? 3 : (o == 4 ? 2 : (o == 5 ? 7 : 1));\n    const lv: i32 = o == 0 ? 85 : (o == 1 ? 60 : (o == 2 ? 50 : (o == 3 ? 35 : (o == 4 ? 55 : 30))));\n    params[b] = f32(rt);\n    params[b + 1] = 0;\n    params[b + 2] = 0;\n    params[b + 3] = f32(lv);\n    params[b + 4] = 0.005;\n    params[b + 5] = 1.0;\n    params[b + 6] = 0.7;\n    params[b + 7] = 0.4;\n  }\n  params[48] = 0;\n  params[49] = 0;\n  params[50] = 3;\n  params[51] = 0.65;\n  params[52] = 1;\n  params[53] = 0.25;\n  params[54] = 0.7;\n  params[55] = 0.2;\n  params[56] = 4.5;\n  params[57] = 0;\n  params[58] = 0;\n  params[59] = 0;\n  params[60] = 0;\n  params[61] = -9;\n  params[62] = 0;\n  params[63] = 1;\n}\n\nexport function init(sampleRate: f32, maxFrames: i32, numChannels: i32): void {\n  sr = sampleRate;\n  invSr = f32(1.0) / sampleRate;\n  parseAlgs();\n  for (let i: i32 = 0; i < NV * 6; i++) {\n    ph[i] = 0; env[i] = 0; stg[i] = 0; fb1[i] = 0; fb2[i] = 0;\n  }\n  for (let v: i32 = 0; v < NV; v++) { vAct[v] = 0; vNote[v] = -1; vGate[v] = 0; vAge[v] = 0; pEnv[v] = 0; }\n  primed = false;\n  fxInit();\n  sp[0] = 0.0; sp[1] = 1.0; sp[2] = -1.0; sp[3] = 0.6; sp[4] = -0.6; sp[5] = 0.3;\n  setDefaults();\n  fmSm = 3 * 1; amSm = 0.65; volSm = 0.35; panSm = 0; widSm = 1; lfoPh = 0;\n}\n\nexport function getInputPtr(): usize { return changetype<usize>(inBuf); }\nexport function getOutputPtr(): usize { return changetype<usize>(outBuf); }\nexport function getParamsPtr(): usize { return changetype<usize>(params); }\nexport function getNumParams(): i32 { return 64; }\n\nexport function noteOn(id: i32, f: f32, v0: f32): void {\n  let v: f32 = v0 > 1.0 ? f32(v0 / 127.0) : v0;\n  v = clampf(v, 0.0, 1.0);\n  let slot: i32 = -1;\n  for (let k: i32 = 0; k < NV; k++) {\n    if (vAct[k] == 0) { slot = k; break; }\n  }\n  if (slot < 0) {\n    let best: i32 = 0x7fffffff;\n    for (let k: i32 = 0; k < NV; k++) {\n      if (vAge[k] < best) { best = vAge[k]; slot = k; }\n    }\n  }\n  const fresh: bool = vAct[slot] == 0;\n  vAct[slot] = 1;\n  vNote[slot] = id;\n  vGate[slot] = 1;\n  vFreq[slot] = f;\n  vVel[slot] = v;\n  vAge[slot] = ageCtr;\n  ageCtr++;\n  pEnv[slot] = 1.0;\n  const semis: f32 = f32(Mathf.log(f / 261.63) * 17.31234);\n  vKt[slot] = clampf(f32(1.0 - params[55] * semis / 36.0), 0.25, 2.0);\n  for (let o: i32 = 0; o < 6; o++) {\n    const i: i32 = slot * 6 + o;\n    if (fresh) { ph[i] = 0; env[i] = 0; fb1[i] = 0; fb2[i] = 0; }\n    stg[i] = 1;\n  }\n}\n\nexport function noteOff(id: i32): void {\n  for (let k: i32 = 0; k < NV; k++) {\n    if (vAct[k] != 0 && vGate[k] != 0 && vNote[k] == id) {\n      vGate[k] = 0;\n      for (let o: i32 = 0; o < 6; o++) {\n        const i: i32 = k * 6 + o;\n        if (stg[i] != 0) stg[i] = 3;\n      }\n    }\n  }\n}\n\nconst FXB: i32 = 4096;\nconst DLB: i32 = 131072;\nconst CMS: i32 = 3200;\nconst APS: i32 = 1400;\nconst FX_M49: i32 = 150760;\nconst FX_M59: i32 = 43726;\nconst chBuf = new StaticArray<f32>(FXB * 2);\nconst dlBuf = new StaticArray<f32>(DLB * 2);\nconst cmBuf = new StaticArray<f32>(CMS * 8);\nconst apBuf = new StaticArray<f32>(APS * 4);\nconst cmLen = new StaticArray<i32>(8);\nconst cmPos = new StaticArray<i32>(8);\nconst cmLp = new StaticArray<f32>(8);\nconst apLen = new StaticArray<i32>(4);\nconst apPos = new StaticArray<i32>(4);\nlet chPos: i32 = 0;\nlet dlPos: i32 = 0;\nlet chPh: f32 = 0;\nlet dlSm: f32 = 13000;\n\nfunction combBase(k: i32): i32 {\n  if (k == 0) return 1116;\n  if (k == 1) return 1188;\n  if (k == 2) return 1277;\n  return 1356;\n}\n\nfunction fxInit(): void {\n  for (let i: i32 = 0; i < FXB * 2; i++) chBuf[i] = 0;\n  for (let i: i32 = 0; i < DLB * 2; i++) dlBuf[i] = 0;\n  for (let i: i32 = 0; i < CMS * 8; i++) cmBuf[i] = 0;\n  for (let i: i32 = 0; i < APS * 4; i++) apBuf[i] = 0;\n  for (let c: i32 = 0; c < 2; c++) {\n    for (let k: i32 = 0; k < 4; k++) {\n      const idx: i32 = c * 4 + k;\n      let len: i32 = i32(f32(combBase(k) + c * 23) * sr / 44100.0);\n      if (len < 16) len = 16;\n      if (len > CMS - 1) len = CMS - 1;\n      cmLen[idx] = len;\n      cmPos[idx] = 0;\n      cmLp[idx] = 0;\n    }\n    for (let j: i32 = 0; j < 2; j++) {\n      const idx: i32 = c * 2 + j;\n      const b0: i32 = j == 0 ? 556 : 441;\n      let len: i32 = i32(f32(b0 + c * 23) * sr / 44100.0);\n      if (len < 8) len = 8;\n      if (len > APS - 1) len = APS - 1;\n      apLen[idx] = len;\n      apPos[idx] = 0;\n    }\n  }\n  chPos = 0;\n  dlPos = 0;\n  chPh = 0;\n  dlSm = f32(0.3 * sr);\n}\n\nfunction rdLine(buf: StaticArray<f32>, base: i32, size: i32, wp: i32, d: f32): f32 {\n  let rp: f32 = f32(f32(wp) - d);\n  if (rp < 0.0) rp = f32(rp + f32(size));\n  let i0: i32 = i32(Mathf.floor(rp));\n  const fr: f32 = f32(rp - f32(i0));\n  if (i0 >= size) i0 -= size;\n  if (i0 < 0) i0 += size;\n  let i1: i32 = i0 + 1;\n  if (i1 >= size) i1 -= size;\n  return f32(buf[base + i0] * (1.0 - fr) + buf[base + i1] * fr);\n}\n\nfunction combF(i: i32, x: f32, fb: f32): f32 {\n  const p: i32 = cmPos[i];\n  const idx: i32 = i * CMS + p;\n  const o: f32 = cmBuf[idx];\n  const lp: f32 = f32(o * 0.65 + cmLp[i] * 0.35);\n  cmLp[i] = lp;\n  cmBuf[idx] = f32(x + lp * fb);\n  let np: i32 = p + 1;\n  if (np >= cmLen[i]) np = 0;\n  cmPos[i] = np;\n  return o;\n}\n\nfunction allpF(i: i32, x: f32): f32 {\n  const p: i32 = apPos[i];\n  const idx: i32 = i * APS + p;\n  const bo: f32 = apBuf[idx];\n  apBuf[idx] = f32(x + bo * 0.5);\n  let np: i32 = p + 1;\n  if (np >= apLen[i]) np = 0;\n  apPos[i] = np;\n  return f32(bo - x);\n}\n\nfunction runFx(n: i32): void {\n  const e1: i32 = (i32(params[49] + 0.5) >> 5) ^ FX_M49;\n  const e2: i32 = (i32(params[59] + 0.5) >> 6) ^ FX_M59;\n  const chOn: bool = (e1 & 1) != 0;\n  const chRate: f32 = f32(f32((e1 >> 1) & 15) / 15.0);\n  const chDep: f32 = f32(f32((e1 >> 5) & 15) / 15.0);\n  const chMix: f32 = f32(f32((e1 >> 9) & 15) / 15.0);\n  const rvOn: bool = ((e1 >> 13) & 1) != 0;\n  const rvSize: f32 = f32(f32((e1 >> 14) & 15) / 15.0);\n  const dlOn: bool = (e2 & 1) != 0;\n  const dlT: f32 = f32((e2 >> 1) & 15);\n  const dlFbk: f32 = f32(f32((e2 >> 5) & 15) / 15.0 * 0.85);\n  const dlMix: f32 = f32(f32((e2 >> 9) & 15) / 15.0);\n  const rvMix: f32 = f32(f32((e2 >> 13) & 15) / 15.0);\n  if (!chOn && !dlOn && !rvOn) return;\n  const chInc: f32 = f32(f32(0.1 + chRate * 2.9) * invSr);\n  const chBase: f32 = f32(0.012 * sr);\n  const chDepS: f32 = f32((0.001 + 0.0065 * chDep) * sr);\n  const dlTarget: f32 = f32(f32(60.0 + dlT * 50.0) * 0.001 * sr);\n  const rvFb: f32 = f32(0.7 + rvSize * 0.28);\n  for (let f: i32 = 0; f < n; f++) {\n    let l: f32 = outBuf[f];\n    let r: f32 = outBuf[MAX_FRAMES + f];\n    if (chOn) {\n      chPh += chInc;\n      if (chPh >= 1.0) chPh -= 1.0;\n      const s1: f32 = f32(Mathf.sin(chPh * TWO_PI));\n      const s2: f32 = f32(Mathf.sin((chPh + 0.25) * TWO_PI));\n      chBuf[chPos] = l;\n      chBuf[FXB + chPos] = r;\n      const wl: f32 = rdLine(chBuf, 0, FXB, chPos, f32(chBase + chDepS * s1));\n      const wr: f32 = rdLine(chBuf, FXB, FXB, chPos, f32(chBase - chDepS * s2));\n      l = f32(l * (1.0 - 0.5 * chMix) + wl * chMix * 0.8);\n      r = f32(r * (1.0 - 0.5 * chMix) + wr * chMix * 0.8);\n      chPos++;\n      if (chPos >= FXB) chPos = 0;\n    }\n    if (dlOn) {\n      dlSm = f32(dlSm + 0.0005 * (dlTarget - dlSm));\n      const dd: f32 = dlSm < 2.0 ? f32(2.0) : dlSm;\n      const dL: f32 = rdLine(dlBuf, 0, DLB, dlPos, dd);\n      const dR: f32 = rdLine(dlBuf, DLB, DLB, dlPos, dd);\n      dlBuf[dlPos] = f32(l + dlFbk * dR);\n      dlBuf[DLB + dlPos] = f32(r + dlFbk * dL);\n      l = f32(l + dlMix * dL);\n      r = f32(r + dlMix * dR);\n      dlPos++;\n      if (dlPos >= DLB) dlPos = 0;\n    } else {\n      dlBuf[dlPos] = 0;\n      dlBuf[DLB + dlPos] = 0;\n      dlPos++;\n      if (dlPos >= DLB) dlPos = 0;\n    }\n    if (rvOn) {\n      const inp: f32 = f32((l + r) * 0.015);\n      let wl: f32 = 0.0;\n      let wr: f32 = 0.0;\n      for (let k: i32 = 0; k < 4; k++) {\n        wl += combF(k, inp, rvFb);\n        wr += combF(4 + k, inp, rvFb);\n      }\n      wl = allpF(0, wl);\n      wl = allpF(1, wl);\n      wr = allpF(2, wr);\n      wr = allpF(3, wr);\n      l = f32(l * (1.0 - 0.5 * rvMix) + wl * rvMix * 3.0);\n      r = f32(r * (1.0 - 0.5 * rvMix) + wr * rvMix * 3.0);\n    }\n    outBuf[f] = clampf(l, -2.0, 2.0);\n    outBuf[MAX_FRAMES + f] = clampf(r, -2.0, 2.0);\n  }\n}\n\nfunction trVal(): f32 {\n  const c: i32 = i32(params[59] + 0.5) & 63;\n  return f32(c <= 24 ? c : c - 64);\n}\n\nexport function process(n: i32): void {\n  synthProcess(n);\n  runFx(n);\n}\n\nfunction synthProcess(n: i32): void {\n  // Safety net: if the host left the parameter block zeroed (no valid ratios), restore audible defaults.\n  if (params[0] < 0.01 && params[8] < 0.01 && params[16] < 0.01 && params[24] < 0.01) {\n    setDefaults();\n  }\n  let alg: i32 = i32(params[49] + 0.5) & 31;\n  if (alg < 0) alg = 0;\n  if (alg > 19) alg = 19;\n  let pk: i32 = i32(params[48] + 0.5);\n  if (pk < 0) pk = 0;\n  for (let o: i32 = 0; o < 6; o++) {\n    wv[o] = pk % 5;\n    pk = pk / 5;\n  }\n  const pAmtC: i32 = pk % 25;\n  const pDecI: i32 = (pk / 25) % 40;\n  const pAmt: f32 = f32(pAmtC <= 12 ? pAmtC : pAmtC - 25);\n  const pSec: f32 = f32(f32(pDecI) * 0.05);\n  const pOn: bool = pDecI > 0 && pAmtC != 0;\n  const pDecay: f32 = pOn ? f32(Mathf.exp(f32(-1.0 * f32(n) * invSr / pSec))) : f32(0.0);\n\n  const amount: f32 = clampf(params[52], 0, 2);\n  const fmT: f32 = f32(clampf(params[50], 0, 10) * amount);\n  const amT: f32 = clampf(f32(clampf(params[51], 0, 1) * amount), 0, 1);\n  const fbG: f32 = f32(clampf(params[53], 0, 1) * 12.0);\n  const velT: f32 = clampf(params[54], 0, 1);\n  const semi: f32 = f32(clampf(trVal(), -24, 24) + clampf(params[60], -100, 100) * 0.01);\n  const tuneM: f32 = f32(Mathf.pow(2.0, semi / 12.0));\n  const volT: f32 = f32(Mathf.pow(10.0, clampf(params[61], -60, 6) / 20.0));\n  const panT: f32 = clampf(params[62], -1, 1);\n  const widT: f32 = clampf(params[63], 0, 2);\n  const lfoInc: f32 = f32(clampf(params[56], 0.01, 30) * invSr);\n  const vibC: f32 = f32(clampf(params[57], 0, 100) * 0.000578);\n  const trem: f32 = clampf(params[58], 0, 1);\n\n  for (let o: i32 = 0; o < 6; o++) {\n    const b: i32 = o * 8;\n    const rTgt: f32 = f32(clampf(params[b], 0.05, 32) * Mathf.pow(2.0, clampf(params[b + 1], -100, 100) / 1200.0) * tuneM);\n    const l: f32 = clampf(f32(params[b + 3] * 0.01), 0, 1);\n    const lTgt: f32 = f32(l * l);\n    if (!primed) {\n      rS[o] = rTgt;\n      lS[o] = lTgt;\n    } else {\n      rS[o] = f32(rS[o] + 0.4 * (rTgt - rS[o]));\n      lS[o] = f32(lS[o] + 0.4 * (lTgt - lS[o]));\n    }\n    ratioE[o] = rS[o];\n    lvl[o] = lS[o];\n    fbA[o] = f32(clampf(params[b + 2], 0, 1) * fbG);\n    const A: f32 = clampf(params[b + 4], 0.001, 10);\n    const D: f32 = clampf(params[b + 5], 0.005, 10);\n    const R: f32 = clampf(params[b + 7], 0.005, 10);\n    aInc[o] = f32(1.0 / (A * sr));\n    dC[o] = f32(1.0 - Mathf.exp(-4.6 / (D * sr)));\n    rC[o] = f32(1.0 - Mathf.exp(-4.6 / (R * sr)));\n    sus[o] = clampf(params[b + 6], 0, 1);\n  }\n  primed = true;\n\n  for (let f: i32 = 0; f < n; f++) {\n    fmSm = f32(fmSm + 0.003 * (fmT - fmSm));\n    amSm = f32(amSm + 0.003 * (amT - amSm));\n    lfoPh += lfoInc;\n    if (lfoPh >= 1.0) lfoPh -= 1.0;\n    const l: f32 = f32(Mathf.sin(lfoPh * TWO_PI));\n    fmA[f] = fmSm;\n    amA[f] = amSm;\n    vibA[f] = f32(1.0 + vibC * l);\n    tremA[f] = f32(1.0 - trem * (0.5 + 0.5 * l));\n    outBuf[f] = 0;\n    outBuf[MAX_FRAMES + f] = 0;\n  }\n\n  const carG: f32 = f32(0.6 / Mathf.sqrt(f32(carCnt[alg])));\n  const cm: i32 = carMask[alg];\n\n  for (let v: i32 = 0; v < NV; v++) {\n    if (vAct[v] == 0) continue;\n    let pm: f32 = 1.0;\n    if (pOn) pm = f32(Mathf.pow(2.0, f32(pAmt * pEnv[v] / 12.0)));\n    const fq: f32 = f32(vFreq[v] * pm);\n    const velG: f32 = f32(1.0 - velT + velT * vVel[v]);\n    const kt: f32 = vKt[v];\n    const sgn: f32 = (v & 1) == 0 ? f32(1.0) : f32(-1.0);\n    for (let f: i32 = 0; f < n; f++) {\n      const vm: f32 = vibA[f];\n      const fmI: f32 = f32(fmA[f] * 2.0);\n      const amd: f32 = amA[f];\n      let mid: f32 = 0.0;\n      let side: f32 = 0.0;\n      for (let oo: i32 = 5; oo >= 0; oo--) {\n        const i: i32 = v * 6 + oo;\n        let e: f32 = env[i];\n        let st: i32 = stg[i];\n        if (st == 1) {\n          e += aInc[oo];\n          if (e >= 1.0) { e = 1.0; st = 2; }\n        } else if (st == 2) {\n          e = f32(e + dC[oo] * (sus[oo] - e));\n        } else if (st == 3) {\n          e = f32(e - rC[oo] * e);\n          if (e < 0.0001) { e = 0.0; st = 0; }\n        }\n        env[i] = e;\n        stg[i] = st;\n        if (st == 0) { outs[oo] = 0.0; continue; }\n        let m: f32 = 0.0;\n        const fmk: i32 = fmMask[alg * 6 + oo];\n        if (fmk != 0) {\n          for (let p: i32 = oo + 1; p < 6; p++) {\n            if (((fmk >> p) & 1) != 0) m += outs[p];\n          }\n        }\n        const fbv: f32 = f32((fb1[i] + fb2[i]) * 0.5 * fbA[oo]);\n        const w: f32 = wave(wv[oo], f32(ph[i] + (m * fmI + fbv) * 0.15915494));\n        fb2[i] = fb1[i];\n        fb1[i] = w;\n        let a: f32 = f32(w * e * lvl[oo] * velG * kt);\n        const amk: i32 = amMask[alg * 6 + oo];\n        if (amk != 0) {\n          for (let p: i32 = oo + 1; p < 6; p++) {\n            if (((amk >> p) & 1) != 0) {\n              const mo: f32 = clampf(f32(outs[p] * 3.0), -1, 1);\n              a = f32(a * (1.0 - amd + amd * (0.5 + 0.5 * mo)));\n            }\n          }\n        }\n        outs[oo] = a;\n        if (((cm >> oo) & 1) != 0) {\n          mid += a;\n          side = f32(side + a * sp[oo] * sgn);\n        }\n        let np: f32 = f32(ph[i] + fq * ratioE[oo] * vm * invSr);\n        np = np - Mathf.floor(np);\n        ph[i] = np;\n      }\n      outBuf[f] = f32(outBuf[f] + mid * carG);\n      outBuf[MAX_FRAMES + f] = f32(outBuf[MAX_FRAMES + f] + side * carG);\n    }\n    pEnv[v] = f32(pEnv[v] * pDecay);\n    let any: i32 = 0;\n    for (let o: i32 = 0; o < 6; o++) {\n      if (stg[v * 6 + o] != 0) any = 1;\n    }\n    if (any == 0) vAct[v] = 0;\n  }\n\n  panSm = f32(panSm + 0.3 * (panT - panSm));\n  widSm = f32(widSm + 0.3 * (widT - widSm));\n  const ang: f32 = f32((panSm + 1.0) * 0.7853982);\n  const gl: f32 = f32(Mathf.cos(ang) * 1.4142135);\n  const gr: f32 = f32(Mathf.sin(ang) * 1.4142135);\n  for (let f: i32 = 0; f < n; f++) {\n    volSm = f32(volSm + 0.002 * (volT - volSm));\n    const k: f32 = f32(tremA[f] * volSm);\n    const m: f32 = f32(outBuf[f] * k);\n    const s: f32 = f32(outBuf[MAX_FRAMES + f] * k);\n    outBuf[f] = f32(Mathf.tanh(f32((m + widSm * s) * gl)));\n    outBuf[MAX_FRAMES + f] = f32(Mathf.tanh(f32((m - widSm * s) * gr)));\n  }\n}\n","html":"<!DOCTYPE html>\n<html lang='en'>\n<head>\n<meta charset='utf-8'>\n<meta name='viewport' content='width=device-width, initial-scale=1'>\n<title>FM Emancipation</title>\n<style>\n* { box-sizing: border-box; }\nhtml, body { margin: 0; height: 100%; overflow: hidden; background: #1a212b; color: #cfd8e3; font: 12px/1.4 -apple-system, 'Segoe UI', Inter, system-ui, sans-serif; -webkit-user-select: none; user-select: none; }\n.app { height: 100vh; display: flex; flex-direction: column; gap: 10px; padding: 12px 16px 6px; }\nheader { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; flex-wrap: wrap; }\nh1 { margin: 0; font-size: 32px; letter-spacing: -1px; color: #fff; line-height: 1; }\nh1 span { color: #6ab7ff; }\n.sub { margin-top: 8px; font-size: 10px; letter-spacing: 3px; color: #8794a6; }\n.info { display: flex; gap: 26px; font-family: 'Courier New', monospace; flex-wrap: wrap; }\n.info small { display: block; font-size: 10px; letter-spacing: 2px; color: #8794a6; }\n.info b { font-size: 14px; letter-spacing: 1px; color: #e6edf5; }\n.lcd { display: flex; flex-wrap: wrap; border: 2px solid #0d141b; outline: 1px solid #2f7fc0; border-radius: 4px; background: linear-gradient(#0f4a7a, #0a2f55); font-family: 'Courier New', monospace; color: #bfe3ff; }\n.lc { padding: 10px 16px; border-right: 1px solid #2f7fc0; }\n.lc:last-child { border-right: 0; }\n.cap { font-size: 10px; letter-spacing: 2px; color: #7fb8e6; }\n.prog { flex: 1.4 1 260px; position: relative; }\n.pname { font-size: 24px; font-weight: 700; margin: 10px 0 6px; color: #e8f6ff; }\n.pcat { font-size: 12px; }\n.pbtns { position: absolute; right: 14px; bottom: 10px; display: flex; gap: 6px; }\n.lbtn { width: 32px; height: 30px; background: #0b3157; border: 1px solid #2f7fc0; color: #bfe3ff; border-radius: 3px; cursor: pointer; font: inherit; font-size: 15px; }\n.lbtn:hover { background: #14538a; }\n.alg { flex: 1.2 1 280px; display: flex; gap: 16px; align-items: center; }\n.alg .num { font-size: 32px; font-weight: 700; color: #e8f6ff; }\n.alg .nm { font-size: 13px; margin-top: 4px; }\n.mini { width: 120px; height: 76px; }\n.opsl { flex: 1.6 1 380px; }\n.lvls { display: flex; justify-content: space-between; gap: 8px; margin-top: 4px; }\n.fc { display: flex; flex-direction: column; align-items: center; gap: 4px; flex: 1; }\n.fn { font-size: 12px; font-weight: 700; }\n.fd { position: relative; width: 20px; height: 76px; border: 1px solid #bcd6ee; border-radius: 5px; background: rgba(0,20,50,.5); cursor: pointer; touch-action: none; }\n.ff { display: none; }\n.fth { position: absolute; left: -5px; width: 28px; height: 9px; background: linear-gradient(#b8c4d2, #8794a6); border: 1px solid #0d141b; border-radius: 2px; }\n.fc .rd { font-size: 11px; color: #bfe3ff; }\n.tabs { display: flex; gap: 10px; flex-wrap: wrap; }\n.tab { appearance: none; background: linear-gradient(#2c3643, #232c38); border: 1px solid #3a4656; color: #aab5c3; font: inherit; font-size: 12px; font-weight: 700; letter-spacing: 2px; padding: 11px 20px; cursor: pointer; border-radius: 3px; text-transform: uppercase; }\n.tab i { font-style: normal; color: #6f7c8d; margin-right: 10px; font-size: 10px; }\n.tab.on { color: #fff; border-bottom: 3px solid #5eb4f5; background: linear-gradient(#34506d, #28384c); }\nmain { flex: 1; min-height: 0; overflow: auto; }\n.page { display: none; }\n.page.on { display: block; }\n.opgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); border: 1px solid #3a4656; background: #232c38; border-radius: 4px; }\n.opc { padding: 14px 16px; border-right: 1px solid #313d4b; }\n.oph { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }\n.oph b { font-size: 17px; letter-spacing: 2px; color: #e8eef5; }\n.badge { font-size: 8px; letter-spacing: 1px; padding: 3px 7px; border: 1px solid #4a5666; border-radius: 3px; color: #aab5c3; font-family: 'Courier New', monospace; }\n.badge.car { color: #8fd0ff; border-color: #5eb4f5; }\n.badge.am { color: #ffc46b; border-color: #c8944a; }\n.sl { margin-bottom: 10px; }\n.sl .t { display: flex; justify-content: space-between; color: #aeb9c7; margin-bottom: 4px; }\n.sl .t b { font-weight: 400; color: #e6edf5; font-variant-numeric: tabular-nums; }\ninput[type=range] { -webkit-appearance: none; appearance: none; width: 100%; height: 16px; background: transparent; margin: 0; }\ninput[type=range]::-webkit-slider-runnable-track { height: 3px; background: #0f151c; border-radius: 2px; }\ninput[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 14px; height: 16px; margin-top: -6px; background: linear-gradient(#aab4c0, #7d8896); border: 1px solid #0d1218; border-radius: 2px; }\ninput[type=range]::-moz-range-track { height: 3px; background: #0f151c; }\ninput[type=range]::-moz-range-thumb { width: 14px; height: 16px; background: #9aa5b2; border-radius: 2px; border: 1px solid #0d1218; }\nselect { width: 100%; background: #141b23; color: #e6edf5; border: 1px solid #455264; border-radius: 4px; padding: 7px 8px; font: inherit; font-size: 13px; margin-bottom: 12px; }\n.wl { color: #aeb9c7; margin-bottom: 5px; }\n.bottom { display: flex; flex-wrap: wrap; border: 1px solid #3a4656; background: #1f2731; border-radius: 4px; margin-top: 12px; }\n.bp { padding: 12px 16px; border-right: 1px solid #313d4b; flex: 1 1 auto; }\n.bp:last-child { border-right: 0; }\n.bp h3 { margin: 0 0 8px; font-size: 10px; letter-spacing: 2px; color: #8794a6; font-weight: 700; }\n.krow { display: flex; gap: 10px; flex-wrap: wrap; }\n.kc { display: flex; flex-direction: column; align-items: center; gap: 4px; width: 66px; }\n.kl { font-size: 11px; color: #cfd8e3; white-space: nowrap; }\n.knob { cursor: ns-resize; touch-action: none; }\n.kc .rd { background: #11171e; border: 1px solid #36424f; border-radius: 3px; min-width: 52px; text-align: center; padding: 3px 4px; font-family: 'Courier New', monospace; font-size: 11px; color: #e6edf5; }\n.envgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px; }\n.envp { border: 1px solid #3a4656; background: #232c38; border-radius: 4px; padding: 12px 16px; }\n.env { height: 80px; background: #0b1016; border: 1px solid #36424f; border-radius: 3px; margin-bottom: 12px; }\n.envsvg { width: 100%; height: 100%; display: block; }\n.envs { display: grid; grid-template-columns: 1fr 1fr; gap: 0 18px; }\n.algwrap { display: flex; flex-wrap: wrap; gap: 14px; }\n.big { flex: 0 0 360px; border: 1px solid #3a4656; background: #0e2e4f; border-radius: 4px; padding: 14px; color: #bfe3ff; font-family: 'Courier New', monospace; }\n.big .dg { height: 230px; margin-top: 8px; }\n.tiles { flex: 1 1 420px; display: grid; grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); gap: 8px; align-content: start; }\n.tile { border: 1px solid #3a4656; background: #232c38; border-radius: 4px; padding: 6px; cursor: pointer; }\n.tile:hover { border-color: #5eb4f5; }\n.tile.on { border-color: #5eb4f5; background: #1d3f63; }\n.tile .dg { height: 62px; }\n.tile .tn { font-size: 10px; margin-top: 4px; letter-spacing: 1px; color: #aab5c3; text-align: center; }\n.ph { border: 1px dashed #3a4656; border-radius: 4px; padding: 60px 20px; text-align: center; color: #8794a6; letter-spacing: 2px; }\nfooter { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; font-family: 'Courier New', monospace; font-size: 9px; letter-spacing: 1.5px; color: #7d8998; text-transform: uppercase; }\n.dock { position: relative; padding-top: 22px; }\n.kt { position: absolute; top: 0; right: 0; appearance: none; background: #232c38; border: 1px solid #3a4656; color: #cfd8e3; font: inherit; font-size: 10px; letter-spacing: 2px; padding: 2px 10px; border-radius: 3px; cursor: pointer; }\n.piano { position: relative; height: 70px; display: flex; border: 1px solid #0d141b; border-radius: 3px; overflow: hidden; background: #0a0c0e; }\n.piano.hide { display: none; }\n.wk { flex: 1; background: linear-gradient(#f4f5f6, #d4d8de); border-right: 1px solid #1d2125; cursor: pointer; }\n.wk.down { background: linear-gradient(#6ab7ff, #3a8fd8); }\n.bk { position: absolute; top: 0; width: 3.4%; height: 60%; background: linear-gradient(#2a2f35, #101316); z-index: 2; cursor: pointer; border: 1px solid #000; border-top: 0; border-radius: 0 0 3px 3px; }\n.bk.down { background: linear-gradient(#6ab7ff, #2f7fc0); }\n.fxwrap { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 12px; }\n.fxp { border: 1px solid #3a4656; background: #232c38; border-radius: 4px; padding: 12px 16px; }\n.fxh { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; padding: 8px 12px; border: 2px solid #0d141b; outline: 1px solid #2f7fc0; border-radius: 4px; background: linear-gradient(#0f4a7a, #0a2f55); font-family: 'Courier New', monospace; color: #bfe3ff; }\n.fxh b { font-size: 16px; letter-spacing: 2px; color: #e8f6ff; }\n.fxbtn { appearance: none; min-width: 96px; padding: 7px 10px; font: inherit; font-size: 10px; font-weight: 700; letter-spacing: 2px; color: #aab5c3; background: linear-gradient(#2c3643, #1d252f); border: 1px solid #3a4656; border-bottom: 3px solid #0d141b; border-radius: 3px; cursor: pointer; }\n.fxbtn:active { border-bottom-width: 1px; margin-top: 2px; }\n.fxbtn.on { color: #fff; background: linear-gradient(#34506d, #28384c); border-color: #5eb4f5; border-bottom-color: #2f7fc0; }\n.fxp .krow { justify-content: space-around; }\n.prgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 10px; }\n.pcard { border: 1px solid #3a4656; background: #232c38; border-radius: 4px; padding: 12px 14px; cursor: pointer; }\n.pcard:hover { border-color: #5eb4f5; }\n.pcard.on { border-color: #5eb4f5; background: #1d3f63; }\n.pcard b { display: block; font-size: 14px; letter-spacing: 1px; color: #e8eef5; margin-bottom: 4px; }\n.pcard span { font-family: 'Courier New', monospace; font-size: 10px; letter-spacing: 1px; color: #8794a6; }\n</style>\n</head>\n<body>\n<div class='app'>\n  <header>\n    <div>\n      <h1>FM <span>Emancipation</span></h1>\n      <div class='sub'>SIX OPERATORS · INFINITE EXPRESSION</div>\n    </div>\n    <div class='info'>\n      <div><small>ARCHITECTURE</small><b>FM × AM</b></div>\n      <div><small>ROUTING</small><b>20 ALGORITHMS</b></div>\n      <div><small>POLYPHONIC</small><b>DIGITAL INSTRUMENT</b></div>\n    </div>\n  </header>\n\n  <section class='lcd'>\n    <div class='lc prog'>\n      <div class='cap'>PROGRAM MEMORY</div>\n      <div class='pname'>Custom Sound</div>\n      <div class='pcat'>Edited program</div>\n      <div class='pbtns'>\n        <button class='lbtn' id='algPrev' title='Previous algorithm'>&#8249;</button>\n        <button class='lbtn' id='algNext' title='Next algorithm'>&#8250;</button>\n      </div>\n    </div>\n    <div class='lc alg'>\n      <div>\n        <div class='cap'>ALGORITHM</div>\n        <div class='num' id='algNum'>01</div>\n        <div class='nm' id='algName'>Twin Tines</div>\n        <div class='cap' id='algKind'>FM ROUTING</div>\n      </div>\n      <div class='mini' id='algMini'></div>\n    </div>\n    <div class='lc opsl'>\n      <div class='cap'>OPERATOR OUTPUT LEVELS</div>\n      <div class='lvls' id='lvls'></div>\n    </div>\n  </section>\n\n  <nav class='tabs' id='tabs'>\n    <button class='tab on' data-page='operators'><i>01</i>Operators</button>\n    <button class='tab' data-page='algorithm'><i>02</i>Algorithm</button>\n    <button class='tab' data-page='envelopes'><i>03</i>Envelopes</button>\n    <button class='tab' data-page='effects'><i>04</i>Effects</button>\n    <button class='tab' data-page='presets'><i>05</i>Presets</button>\n  </nav>\n\n  <main>\n    <div class='page on' id='page-operators'>\n      <div class='opgrid' id='opgrid'></div>\n      <div class='bottom'>\n        <div class='bp'><h3>MODULATION ENGINE</h3><div class='krow' id='k-mod'></div></div>\n        <div class='bp'><h3>PERFORMANCE &amp; MOTION</h3><div class='krow' id='k-perf'></div></div>\n        <div class='bp'><h3>MASTER OUTPUT</h3><div class='krow' id='k-master'></div></div>\n      </div>\n    </div>\n    <div class='page' id='page-algorithm'>\n      <div class='algwrap'>\n        <div class='big'>\n          <div class='cap'>SELECTED ALGORITHM</div>\n          <div style='font-size:22px;margin-top:6px' id='bigName'>01 Twin Tines</div>\n          <div class='cap' style='margin-top:4px'>BLUE = FM &nbsp; AMBER DASHED = AM &nbsp; BRIGHT BOX = CARRIER</div>\n          <div class='dg' id='bigDg'></div>\n        </div>\n        <div class='tiles' id='tiles'></div>\n      </div>\n    </div>\n    <div class='page' id='page-envelopes'>\n      <div class='envgrid' id='envgrid'></div>\n    </div>\n    <div class='page' id='page-effects'>\n      <div class='fxwrap' id='fxwrap'></div>\n    </div>\n    <div class='page' id='page-presets'>\n      <div class='prgrid' id='presetList'></div>\n    </div>\n  </main>\n\n  <footer>\n    <span>FM Emancipation / six-operator FM-AM synthesizer</span>\n    <span>Host MIDI · Automation · State recall</span>\n  </footer>\n\n  <div class='dock'>\n    <button class='kt' id='kt'>&#9662; KEYS</button>\n    <div class='piano' id='kbd'></div>\n  </div>\n</div>\n\n<script>\n'use strict';\n\nvar NAMES = ['Twin Tines', 'Full Stack', 'Triple Pairs', 'Bell Trio', 'Triple Tree', 'Additive Six', 'Organ Plus', 'Quad Bell', 'AM Pair EP', 'AM Hybrid', 'AM Head', 'AM Link', 'Dual Hybrid', 'Cross Quad', 'Pad Weave', 'AM Fan', 'Split Carrier', 'Fan In', 'Twin Stack', 'Full AM'];\nvar SPECS = [\n  '6>55>34>33>22>1;12',\n  '6>55>44>33>22>1;1',\n  '2>14>36>5;135',\n  '3>22>16>55>4;14',\n  '4>35>36>33>12>1;1',\n  ';123456',\n  '2>1;13456',\n  '6>55>4;1234',\n  '2*14>36>5;135',\n  '6>55>44>33*12>1;13',\n  '6*55>44>33>22>1;1',\n  '6>55*44>33>22*1;1',\n  '6>56*45>34>23>1;12',\n  '6>55>44>14>23>13>2;12',\n  '6>55*44>33*22>1;1',\n  '6*35*34>33>12>1;1',\n  '6>55>44*33>22>1;13',\n  '6>15>14>13>12>1;1',\n  '6>25>24>23>2;12',\n  '6*55*44*33*22*1;1'\n];\nvar WAVES = ['Sine', 'Triangle', 'Saw', 'Square', 'Half Sine'];\n\n/* Param 48 = waveform pack (base-5, 6 digits, 0..15624) + 15625 * pitch-env code.\n   Pitch-env code = amount (0..24; 13..24 mean -12..-1 semitones) + 25 * decay step (0..39, 50 ms each). */\nvar WPACK = 15625;\n\nfunction parseAlg(s) {\n  var fm = [];\n  var am = [];\n  var car = [];\n  var i = 0;\n  while (i < s.length) {\n    if (s[i] === ';') {\n      for (var j = i + 1; j < s.length; j++) {\n        car.push(+s[j]);\n      }\n      break;\n    }\n    var f = +s[i];\n    var k = s[i + 1];\n    var t = +s[i + 2];\n    if (k === '>') {\n      fm.push([f, t]);\n    } else {\n      am.push([f, t]);\n    }\n    i += 3;\n  }\n  return { fm: fm, am: am, car: car };\n}\n\nvar ALGS = SPECS.map(parseAlg);\n\n/* ---------- parameter store ---------- */\nvar vals = {};\nvar defs = {};\nvar subs = {};\nvar seen = {};\n\nfunction reg(i, d) {\n  defs[i] = d;\n  vals[i] = d;\n}\n\n(function () {\n  var R = [1, 1, 3, 1, 2, 7];\n  var L = [85, 60, 50, 35, 55, 30];\n  for (var o = 0; o < 6; o++) {\n    var b = o * 8;\n    reg(b, R[o]);\n    reg(b + 1, 0);\n    reg(b + 2, 0);\n    reg(b + 3, L[o]);\n    reg(b + 4, 0.005);\n    reg(b + 5, 1);\n    reg(b + 6, 0.7);\n    reg(b + 7, 0.4);\n  }\n  reg(48, 0);\n  reg(49, 0);\n  reg(50, 3);\n  reg(51, 0.65);\n  reg(52, 1);\n  reg(53, 0.25);\n  reg(54, 0.7);\n  reg(55, 0.2);\n  reg(56, 4.5);\n  reg(57, 0);\n  reg(58, 0);\n  reg(59, 0);\n  reg(60, 0);\n  reg(61, -9);\n  reg(62, 0);\n  reg(63, 1);\n})();\n\nfunction listen(i, fn) {\n  if (!subs[i]) subs[i] = [];\n  subs[i].push(fn);\n  fn(vals[i]);\n}\n\nfunction notify(i) {\n  (subs[i] || []).forEach(function (f) { f(vals[i]); });\n}\n\nfunction userSet(i, v) {\n  vals[i] = v;\n  notify(i);\n  if (window.vstai) window.vstai.setParam(i, v);\n}\n\nfunction whenReady(cb) {\n  function go() {\n    if (window.vstai.onReady) {\n      window.vstai.onReady(cb);\n    } else {\n      cb();\n    }\n  }\n  if (window.vstai) return go();\n  var t = setInterval(function () {\n    if (window.vstai) {\n      clearInterval(t);\n      go();\n    }\n  }, 25);\n}\n\nfunction noteOnH(n, v) {\n  if (window.vstai && window.vstai.noteOn) window.vstai.noteOn(n, v);\n}\n\nfunction noteOffH(n) {\n  if (window.vstai && window.vstai.noteOff) window.vstai.noteOff(n);\n}\n\n/* ---------- DOM helpers ---------- */\nfunction el(tag, cls, txt, parent) {\n  var e = document.createElement(tag);\n  if (cls) e.className = cls;\n  if (txt != null) e.textContent = txt;\n  if (parent) parent.appendChild(e);\n  return e;\n}\n\nfunction svgEl(tag, attrs, parent) {\n  var e = document.createElementNS('http://www.w3.org/2000/svg', tag);\n  for (var k in attrs) e.setAttribute(k, attrs[k]);\n  if (parent) parent.appendChild(e);\n  return e;\n}\n\nfunction clamp(v, a, b) {\n  return Math.max(a, Math.min(b, v));\n}\n\nfunction polar(deg, r) {\n  var a = deg * Math.PI / 180;\n  return [50 + r * Math.cos(a), 50 + r * Math.sin(a)];\n}\n\nfunction arcD(a, b, r) {\n  var s = polar(a, r);\n  var e = polar(b, r);\n  return 'M ' + s[0] + ' ' + s[1] + ' A ' + r + ' ' + r + ' 0 ' + (Math.abs(b - a) > 180 ? 1 : 0) + ' ' + (b > a ? 1 : 0) + ' ' + e[0] + ' ' + e[1];\n}\n\nfunction trim2(v) {\n  return String(+v.toFixed(2));\n}\n\n/* ---------- pitch envelope packed into param 48 ---------- */\nfunction pitchGet() {\n  var code = Math.floor(Math.round(vals[48]) / WPACK);\n  var c = code % 25;\n  return { amt: c <= 12 ? c : c - 25, dec: Math.floor(code / 25) % 40 };\n}\n\nfunction pitchSet(amt, dec) {\n  var wave = Math.round(vals[48]) % WPACK;\n  var code = Math.round(dec) * 25 + ((Math.round(amt) + 25) % 25);\n  userSet(48, wave + code * WPACK);\n}\n\n/* ---------- controls ---------- */\nfunction makeKnob(parent, i, label, min, max, fmt, o) {\n  o = o || {};\n  var get = o.get || function () { return vals[i]; };\n  var put = o.put || function (v) { userSet(i, v); };\n  var def = o.def != null ? o.def : defs[i];\n  var cell = el('div', 'kc', null, parent);\n  cell.setAttribute('data-param', i);\n  el('div', 'kl', label, cell);\n  var svg = svgEl('svg', { viewBox: '0 0 100 100', width: 54, height: 54, 'class': 'knob' }, cell);\n  svgEl('circle', { cx: 50, cy: 50, r: 30, fill: '#242d39', stroke: '#0b1016', 'stroke-width': 2 }, svg);\n  svgEl('path', { d: arcD(135, 405, 42), fill: 'none', stroke: '#0c1218', 'stroke-width': 6, 'stroke-linecap': 'round' }, svg);\n  var arc = svgEl('path', { fill: 'none', stroke: '#4ea8ee', 'stroke-width': 6, 'stroke-linecap': 'round' }, svg);\n  var ptr = svgEl('line', { stroke: '#f2f6fa', 'stroke-width': 4, 'stroke-linecap': 'round' }, svg);\n  var rd = el('div', 'rd', null, cell);\n\n  function toN(v) {\n    return o.log ? Math.log(v / min) / Math.log(max / min) : (v - min) / (max - min);\n  }\n\n  function fromN(n) {\n    return o.log ? min * Math.pow(max / min, n) : min + n * (max - min);\n  }\n\n  function draw(v) {\n    var n = clamp(toN(Math.max(v, o.log ? min : -1e9)), 0, 1);\n    var ang = 135 + n * 270;\n    var from = o.bi ? 270 : 135;\n    arc.setAttribute('d', arcD(from, ang, 42));\n    var p1 = polar(ang, 10);\n    var p2 = polar(ang, 27);\n    ptr.setAttribute('x1', p1[0]);\n    ptr.setAttribute('y1', p1[1]);\n    ptr.setAttribute('x2', p2[0]);\n    ptr.setAttribute('y2', p2[1]);\n    rd.textContent = fmt(v);\n  }\n\n  var drag = null;\n  svg.addEventListener('pointerdown', function (e) {\n    drag = { y: e.clientY, n: clamp(toN(get()), 0, 1) };\n    svg.setPointerCapture(e.pointerId);\n  });\n  svg.addEventListener('pointermove', function (e) {\n    if (!drag) return;\n    var n = clamp(drag.n + (drag.y - e.clientY) / (e.shiftKey ? 800 : 200), 0, 1);\n    var v = fromN(n);\n    if (o.step) v = Math.round(v / o.step) * o.step;\n    put(v);\n  });\n  svg.addEventListener('pointerup', function () { drag = null; });\n  svg.addEventListener('pointercancel', function () { drag = null; });\n  svg.addEventListener('dblclick', function () { put(def); });\n  listen(i, function () { draw(get()); });\n}\n\nfunction makeSlider(parent, i, label, min, max, fmt, o) {\n  o = o || {};\n  var w = el('div', 'sl', null, parent);\n  w.setAttribute('data-param', i);\n  var t = el('div', 't', null, w);\n  el('span', null, label, t);\n  var vb = el('b', null, '', t);\n  var inp = el('input', null, null, w);\n  inp.type = 'range';\n  if (o.log) {\n    inp.min = 0;\n    inp.max = 1000;\n    inp.step = 1;\n  } else {\n    inp.min = min;\n    inp.max = max;\n    inp.step = o.step || (max - min) / 1000;\n  }\n  inp.addEventListener('input', function () {\n    var x = +inp.value;\n    var v = o.log ? min * Math.pow(max / min, x / 1000) : x;\n    userSet(i, v);\n  });\n  inp.addEventListener('dblclick', function () { userSet(i, defs[i]); });\n  listen(i, function (v) {\n    inp.value = o.log ? 1000 * Math.log(Math.max(v, min) / min) / Math.log(max / min) : v;\n    vb.textContent = fmt(v);\n  });\n}\n\nfunction makeFader(parent, i, label) {\n  var c = el('div', 'fc', null, parent);\n  el('div', 'fn', label, c);\n  var tr = el('div', 'fd', null, c);\n  tr.setAttribute('data-param', i);\n  var th = el('div', 'fth', null, tr);\n  var rd = el('div', 'rd', null, c);\n  var down = false;\n\n  function setFrom(e) {\n    var r = tr.getBoundingClientRect();\n    var n = clamp(1 - (e.clientY - r.top) / r.height, 0, 1);\n    userSet(i, Math.round(n * 100));\n  }\n\n  tr.addEventListener('pointerdown', function (e) {\n    down = true;\n    tr.setPointerCapture(e.pointerId);\n    setFrom(e);\n  });\n  tr.addEventListener('pointermove', function (e) { if (down) setFrom(e); });\n  tr.addEventListener('pointerup', function () { down = false; });\n  tr.addEventListener('pointercancel', function () { down = false; });\n  tr.addEventListener('dblclick', function () { userSet(i, defs[i]); });\n  listen(i, function (v) {\n    var n = clamp(v / 100, 0, 1);\n    th.style.bottom = 'calc(' + (n * 100) + '% - 5px)';\n    rd.textContent = Math.round(v);\n  });\n}\n\nfunction makeWaveSelect(parent, o) {\n  var wl = el('div', 'wl', 'Waveform', parent);\n  var sel = el('select', null, null, parent);\n  sel.setAttribute('data-param', 48);\n  WAVES.forEach(function (w, k) {\n    var op = el('option', null, w, sel);\n    op.value = k;\n  });\n  var pw = Math.pow(5, o);\n  sel.addEventListener('change', function () {\n    var packed = Math.round(vals[48]);\n    var cur = Math.floor(packed / pw) % 5;\n    packed += (+sel.value - cur) * pw;\n    userSet(48, packed);\n  });\n  listen(48, function (v) {\n    sel.value = Math.floor(Math.round(v) / pw) % 5;\n  });\n}\n\n/* ---------- algorithm diagrams ---------- */\nfunction drawDiagram(parent, idx) {\n  parent.textContent = '';\n  var g = ALGS[idx];\n  var edges = g.fm.concat(g.am);\n  var depth = [0, 0, 0, 0, 0, 0, 0];\n  for (var p = 0; p < 6; p++) {\n    edges.forEach(function (e) {\n      if (depth[e[0]] < depth[e[1]] + 1) depth[e[0]] = depth[e[1]] + 1;\n    });\n  }\n  var maxD = 0;\n  var o;\n  for (o = 1; o <= 6; o++) maxD = Math.max(maxD, depth[o]);\n  var svg = svgEl('svg', { viewBox: '0 0 100 64', width: '100%', height: '100%' }, parent);\n  var pos = {};\n  for (var d = 0; d <= maxD; d++) {\n    var list = [];\n    for (o = 1; o <= 6; o++) {\n      if (depth[o] === d) list.push(o);\n    }\n    list.forEach(function (op, k) {\n      pos[op] = [100 * (k + 1) / (list.length + 1), maxD ? 50 - d * (40 / maxD) : 46];\n    });\n  }\n  edges.forEach(function (e, k) {\n    var isAm = k >= g.fm.length;\n    var a = pos[e[0]];\n    var b = pos[e[1]];\n    svgEl('line', { x1: a[0], y1: a[1] + 5, x2: b[0], y2: b[1] - 5, stroke: isAm ? '#ffc46b' : '#8fd0ff', 'stroke-width': 1.2, 'stroke-dasharray': isAm ? '2 1.5' : 'none' }, svg);\n  });\n  for (o = 1; o <= 6; o++) {\n    var isCar = g.car.indexOf(o) >= 0;\n    var q = pos[o];\n    if (isCar) {\n      svgEl('line', { x1: q[0], y1: q[1] + 5, x2: q[0], y2: 62, stroke: '#8fd0ff', 'stroke-width': 1.2 }, svg);\n    }\n    svgEl('rect', { x: q[0] - 6, y: q[1] - 5, width: 12, height: 10, rx: 1.5, fill: isCar ? '#2f7fc0' : '#123b63', stroke: '#8fd0ff', 'stroke-width': 0.8 }, svg);\n    var tx = svgEl('text', { x: q[0], y: q[1] + 2.4, 'text-anchor': 'middle', 'font-size': 6.5, fill: '#fff', 'font-family': 'Courier New, monospace' }, svg);\n    tx.textContent = o;\n  }\n  if (g.car.length) {\n    svgEl('line', { x1: 5, y1: 62, x2: 95, y2: 62, stroke: '#5eb4f5', 'stroke-width': 0.8 }, svg);\n  }\n}\n\nfunction roleOf(idx, o) {\n  var g = ALGS[idx];\n  if (g.car.indexOf(o) >= 0) return 'CARRIER';\n  var asFm = g.fm.some(function (e) { return e[0] === o; });\n  var asAm = g.am.some(function (e) { return e[0] === o; });\n  if (asAm && !asFm) return 'AM MOD';\n  return 'FM MOD';\n}\n\n/* ---------- envelope display ---------- */\nfunction makeEnv(parent, o) {\n  var b = o * 8;\n  var box = el('div', 'env', null, parent);\n  var svg = svgEl('svg', { viewBox: '0 0 200 80', preserveAspectRatio: 'none', 'class': 'envsvg' }, box);\n  var fill = svgEl('path', { fill: 'rgba(78,168,238,.16)', stroke: 'none' }, svg);\n  var line = svgEl('path', { fill: 'none', stroke: '#4ea8ee', 'stroke-width': 2, 'vector-effect': 'non-scaling-stroke' }, svg);\n\n  function nt(t) {\n    return Math.max(0, Math.log(t / 0.001) / Math.log(10000));\n  }\n\n  function draw() {\n    var a = vals[b + 4];\n    var d = vals[b + 5];\n    var s = vals[b + 6];\n    var r = vals[b + 7];\n    var wa = 8 + 50 * nt(a);\n    var wd = 8 + 50 * nt(d);\n    var wr = 8 + 50 * nt(r);\n    var hold = 30;\n    var k = 190 / (wa + wd + hold + wr);\n    var x0 = 5;\n    var y0 = 72;\n    var yt = 8;\n    var ys = 72 - 64 * s;\n    var x1 = x0 + wa * k;\n    var x2 = x1 + wd * k;\n    var x3 = x2 + hold * k;\n    var x4 = x3 + wr * k;\n    var path = 'M ' + x0 + ' ' + y0 + ' L ' + x1 + ' ' + yt + ' L ' + x2 + ' ' + ys + ' L ' + x3 + ' ' + ys + ' L ' + x4 + ' ' + y0;\n    line.setAttribute('d', path);\n    fill.setAttribute('d', path + ' Z');\n  }\n\n  [4, 5, 6, 7].forEach(function (q) { listen(b + q, draw); });\n}\n\n/* ---------- pitch envelope panel (Envelopes page) ---------- */\nfunction makePitchEnv(parent) {\n  var ep = el('div', 'envp', null, parent);\n  var eh = el('div', 'oph', null, ep);\n  el('b', null, 'PITCH ENV', eh);\n  el('span', 'badge car', 'ALL OPS', eh);\n  var box = el('div', 'env', null, ep);\n  var svg = svgEl('svg', { viewBox: '0 0 200 80', preserveAspectRatio: 'none', 'class': 'envsvg' }, box);\n  svgEl('line', { x1: 0, y1: 40, x2: 200, y2: 40, stroke: '#2a3340', 'stroke-width': 1, 'vector-effect': 'non-scaling-stroke' }, svg);\n  var line = svgEl('path', { fill: 'none', stroke: '#ffc46b', 'stroke-width': 2, 'vector-effect': 'non-scaling-stroke' }, svg);\n  listen(48, function () {\n    var p = pitchGet();\n    var y = 40 - p.amt * 2.8;\n    var w = 10 + p.dec * 4;\n    line.setAttribute('d', 'M 5 ' + y + ' C ' + (5 + w * 0.5) + ' ' + (40 + (y - 40) * 0.35) + ' ' + (5 + w) + ' 40 ' + (5 + w * 2.5) + ' 40 L 195 40');\n  });\n  var row = el('div', 'krow', null, ep);\n  makeKnob(row, 48, 'Pitch amt', -12, 12, function (v) { return Math.round(v) + ' st'; }, {\n    bi: true,\n    step: 1,\n    def: 0,\n    get: function () { return pitchGet().amt; },\n    put: function (v) { pitchSet(v, pitchGet().dec); }\n  });\n  makeKnob(row, 48, 'Pitch decay', 0, 1.95, function (v) { return v < 0.025 ? 'off' : Math.round(v * 1000) + ' ms'; }, {\n    step: 0.05,\n    def: 0,\n    get: function () { return pitchGet().dec * 0.05; },\n    put: function (v) { pitchSet(pitchGet().amt, Math.round(v / 0.05)); }\n  });\n}\n\n/* ---------- keyboard ---------- */\nvar kbdHost;\nvar heldCount = {};\n\nfunction keyEl(n) {\n  return kbdHost.querySelector('[data-note=\"' + n + '\"]');\n}\n\nfunction pressNote(n) {\n  heldCount[n] = (heldCount[n] || 0) + 1;\n  if (heldCount[n] === 1) {\n    noteOnH(n, 100);\n    var k = keyEl(n);\n    if (k) k.classList.add('down');\n  }\n}\n\nfunction releaseNote(n) {\n  if (!heldCount[n]) return;\n  heldCount[n]--;\n  if (heldCount[n] === 0) {\n    noteOffH(n);\n    var k = keyEl(n);\n    if (k) k.classList.remove('down');\n  }\n}\n\nfunction makeKeyboard(host) {\n  kbdHost = host;\n  var base = 48;\n  var octaves = 3;\n  var pattern = [0, 2, 4, 5, 7, 9, 11];\n  var blacks = { 1: 0, 3: 1, 6: 3, 8: 4, 10: 5 };\n  var whites = [];\n  for (var o = 0; o < octaves; o++) {\n    for (var q = 0; q < pattern.length; q++) whites.push(base + o * 12 + pattern[q]);\n  }\n  whites.forEach(function (n) {\n    var k = el('div', 'wk', null, host);\n    k.setAttribute('data-note', n);\n  });\n  var wpc = 100 / whites.length;\n  for (var oc = 0; oc < octaves; oc++) {\n    for (var semi in blacks) {\n      var n = base + oc * 12 + (+semi);\n      var k = el('div', 'bk', null, host);\n      k.setAttribute('data-note', n);\n      k.style.left = ((blacks[semi] + oc * 7 + 1) * wpc - 1.7) + '%';\n    }\n  }\n  var down = null;\n  host.addEventListener('pointerdown', function (e) {\n    var n = e.target.getAttribute && e.target.getAttribute('data-note');\n    if (n) {\n      if (down != null) releaseNote(down);\n      down = +n;\n      pressNote(down);\n      host.setPointerCapture(e.pointerId);\n    }\n  });\n  function rel() {\n    if (down == null) return;\n    releaseNote(down);\n    down = null;\n  }\n  host.addEventListener('pointerup', rel);\n  host.addEventListener('pointercancel', rel);\n  addEventListener('mouseup', rel, true);\n  addEventListener('blur', rel);\n\n  // collapsible keys\n  var kt = document.getElementById('kt');\n  function setCollapsed(c) {\n    host.classList.toggle('hide', c);\n    kt.textContent = (c ? '\\u25B8' : '\\u25BE') + ' KEYS';\n    try { localStorage.setItem('vstai.kbdCollapsed', c ? '1' : '0'); } catch (err) {}\n    dispatchEvent(new Event('resize'));\n  }\n  kt.addEventListener('click', function () { setCollapsed(!host.classList.contains('hide')); });\n  var c0 = false;\n  try { c0 = localStorage.getItem('vstai.kbdCollapsed') === '1'; } catch (err) {}\n  setCollapsed(c0);\n}\n\nvar KEYMAP = { KeyA: 0, KeyW: 1, KeyS: 2, KeyE: 3, KeyD: 4, KeyF: 5, KeyT: 6, KeyG: 7, KeyY: 8, KeyH: 9, KeyU: 10, KeyJ: 11, KeyK: 12, KeyO: 13, KeyL: 14, KeyP: 15, Semicolon: 16 };\nvar heldKeys = {};\n\naddEventListener('keydown', function (e) {\n  if (!(e.code in KEYMAP)) return;\n  if (e.metaKey || e.ctrlKey || e.altKey) return;\n  var t = e.target;\n  if (t && (t.isContentEditable || t.tagName === 'TEXTAREA' || (t.tagName === 'INPUT' && t.type !== 'range'))) return;\n  e.preventDefault();\n  if (e.repeat || heldKeys[e.code] != null) return;\n  var n = 60 + KEYMAP[e.code];\n  heldKeys[e.code] = n;\n  pressNote(n);\n});\n\naddEventListener('keyup', function (e) {\n  if (heldKeys[e.code] == null) return;\n  e.preventDefault();\n  releaseNote(heldKeys[e.code]);\n  delete heldKeys[e.code];\n});\n\naddEventListener('blur', function () {\n  for (var c in heldKeys) {\n    releaseNote(heldKeys[c]);\n    delete heldKeys[c];\n  }\n});\n\n/* ---------- packed values: alg + transpose + effects share params 49 and 59 ---------- */\nvar FXDEF = { 49: 150760, 59: 43726 };\nvar FXMUL = { 49: 32, 59: 64 };\n\nfunction algGet() {\n  return Math.round(vals[49]) % 32;\n}\n\nfunction algSet(a) {\n  var p = Math.round(vals[49]);\n  userSet(49, p - (p % 32) + a);\n}\n\nfunction tGet() {\n  var c = Math.round(vals[59]) % 64;\n  return c <= 24 ? c : c - 64;\n}\n\nfunction tSet(t) {\n  var p = Math.round(vals[59]);\n  t = Math.round(t);\n  userSet(59, p - (p % 64) + (t < 0 ? t + 64 : t));\n}\n\nfunction fxGet(i, shift, width) {\n  var e = Math.floor(Math.round(vals[i]) / FXMUL[i]) ^ FXDEF[i];\n  return (e >> shift) & ((1 << width) - 1);\n}\n\nfunction fxPut(i, shift, width, v) {\n  var p = Math.round(vals[i]);\n  var mul = FXMUL[i];\n  var low = p % mul;\n  var e = Math.floor(p / mul) ^ FXDEF[i];\n  var m = ((1 << width) - 1) << shift;\n  e = (e & ~m) | ((Math.round(v) << shift) & m);\n  userSet(i, (e ^ FXDEF[i]) * mul + low);\n}\n\nfunction fxToggle(parent, i, shift) {\n  var b = el('button', 'fxbtn', 'BYPASSED', parent);\n  b.setAttribute('data-param', i);\n  b.addEventListener('click', function () {\n    fxPut(i, shift, 1, fxGet(i, shift, 1) ? 0 : 1);\n  });\n  listen(i, function () {\n    var on = fxGet(i, shift, 1) === 1;\n    b.classList.toggle('on', on);\n    b.textContent = on ? 'ACTIVE' : 'BYPASSED';\n  });\n}\n\nfunction fxKnob(parent, i, label, shift, fmt) {\n  makeKnob(parent, i, label, 0, 15, fmt, {\n    step: 1,\n    def: (FXDEF[i] >> shift) & 15,\n    get: function () { return fxGet(i, shift, 4); },\n    put: function (v) { fxPut(i, shift, 4, v); }\n  });\n}\n\nfunction buildFx() {\n  var host = document.getElementById('fxwrap');\n  var pct = function (v) { return Math.round(v / 15 * 100) + '%'; };\n  var p, h, row;\n\n  p = el('div', 'fxp', null, host);\n  h = el('div', 'fxh', null, p);\n  el('b', null, 'CHORUS', h);\n  fxToggle(h, 49, 0);\n  row = el('div', 'krow', null, p);\n  fxKnob(row, 49, 'Rate', 1, function (v) { return (0.1 + v / 15 * 2.9).toFixed(1) + ' Hz'; });\n  fxKnob(row, 49, 'Depth', 5, pct);\n  fxKnob(row, 49, 'Mix', 9, pct);\n\n  p = el('div', 'fxp', null, host);\n  h = el('div', 'fxh', null, p);\n  el('b', null, 'DELAY', h);\n  fxToggle(h, 59, 0);\n  row = el('div', 'krow', null, p);\n  fxKnob(row, 59, 'Time', 1, function (v) { return (60 + v * 50) + ' ms'; });\n  fxKnob(row, 59, 'Feedback', 5, pct);\n  fxKnob(row, 59, 'Mix', 9, pct);\n\n  p = el('div', 'fxp', null, host);\n  h = el('div', 'fxh', null, p);\n  el('b', null, 'REVERB', h);\n  fxToggle(h, 49, 13);\n  row = el('div', 'krow', null, p);\n  fxKnob(row, 49, 'Size', 14, pct);\n  fxKnob(row, 59, 'Mix', 13, pct);\n}\n\n/* ---------- factory presets ---------- */\n/* op array: [ratio, fine ct, level, feedback, attack, decay, sustain, release, wave(0 sine,1 tri,2 saw,3 sq,4 half)] */\n/* PRESET BANK. To add a preset, append an object to this array. Format: { n: name, c: category, alg: 0-19, ops: [6 x [ratio, fine ct, level, feedback, attack, decay, sustain, release, wave 0-4]], m: [fmDepth, amDepth, amount, feedback, velocity, keytrack, lfoHz, vibrato, tremolo, volumeDb], fx: {ch,chR,chD,chM,rv,rvS,rvM,dl,dlT,dlF,dlM}, tr: transpose, pa/pd: pitch env }. Presets 1-8 are DX7-style electric pianos; 9-100 are added in later steps. */\nvar PRESETS = [\n  { n: 'DX Classic E.Piano', c: 'E.Piano', alg: 2,\n    ops: [[1,0,90,0,0.002,2.4,0,0.4,0],[14,0,52,0,0.001,0.18,0,0.12,0],[1,2,72,0,0.002,2.0,0,0.4,0],[1,0,58,0,0.002,1.2,0,0.3,0],[1,-2,50,0,0.002,1.6,0,0.35,0],[1,0,40,0.15,0.001,0.5,0,0.2,0]],\n    m: [3.2,0.2,1,0.1,0.8,0.5,4.5,0,0,-8], fx: { ch: 1, chR: 3, chD: 5, chM: 5 } },\n  { n: 'Bright Tine Rhodes', c: 'E.Piano', alg: 2,\n    ops: [[1,0,90,0,0.001,2.0,0,0.35,0],[14,0,62,0,0.001,0.12,0,0.08,0],[1,3,70,0,0.001,1.6,0,0.3,0],[1,0,64,0,0.001,0.9,0,0.25,0],[2,0,45,0,0.001,0.9,0,0.25,0],[7,0,38,0,0.001,0.2,0,0.1,0]],\n    m: [4.0,0.2,1,0.1,0.9,0.6,4.5,0,0,-9], fx: { ch: 1, chR: 2, chD: 4, chM: 4 } },\n  { n: 'Wurly Bark', c: 'E.Piano', alg: 2,\n    ops: [[1,0,88,0,0.002,1.4,0.05,0.25,0],[2,0,60,0.25,0.001,0.5,0.1,0.15,1],[1,4,66,0,0.002,1.2,0.05,0.25,0],[1,0,60,0.2,0.001,0.4,0.1,0.15,1],[2,-3,40,0,0.002,0.8,0,0.2,0],[3,0,34,0.3,0.001,0.3,0,0.15,0]],\n    m: [3.6,0.25,1,0.3,0.9,0.4,5.0,0,0,-8], fx: { ch: 1, chR: 4, 