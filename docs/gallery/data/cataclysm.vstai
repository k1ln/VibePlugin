  "html": "<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Cataclysm</title>\n<style>:root{--bg:#0b0b0f;--bg2:#101016;--pn:#16161d;--pn2:#1c1c25;--ln:rgba(255,255,255,.08);--ink:#e9e9ef;--dim:#8b8b99;--a:#ff4a3d;--a2:#ffb347;--hot:#ff2d55}\n*{box-sizing:border-box}\nhtml,body{margin:0;height:100%;background:radial-gradient(120% 90% at 50% -10%,#1b0f12 0%,var(--bg) 55%);color:var(--ink);font:12px/1.3 -apple-system,\"Segoe UI\",Helvetica,Arial,sans-serif;overflow:hidden}\n#app{display:flex;flex-direction:column;height:100%;min-width:760px}\nbutton,select{font:inherit;color:inherit}\n/* ---------- header ---------- */\n#top{display:flex;align-items:center;gap:14px;padding:8px 14px 6px;border-bottom:1px solid var(--ln);background:linear-gradient(180deg,rgba(255,74,61,.10),rgba(0,0,0,0))}\n#logo{font-weight:800;letter-spacing:.42em;font-size:19px;color:var(--a);text-shadow:0 0 18px rgba(255,74,61,.45);white-space:nowrap}\n#logo small{display:block;font-weight:500;letter-spacing:.22em;font-size:8px;color:var(--dim);text-shadow:none;margin-top:2px}\n#pre{display:flex;align-items:center;gap:6px;flex:1;min-width:0}\n#pre select{flex:1;min-width:120px;max-width:300px;background:var(--pn2);border:1px solid var(--ln);border-radius:6px;padding:6px 8px}\n.btn{background:var(--pn2);border:1px solid var(--ln);border-radius:6px;padding:6px 9px;cursor:pointer;font-weight:600;font-size:10px;letter-spacing:.08em;color:var(--ink);white-space:nowrap}\n.btn:hover{border-color:var(--a)}\n.btn.on{background:var(--a);color:#150a0a;border-color:var(--a)}\n#dirty{font-size:9px;color:var(--a2);min-width:40px}\n#chaos{display:flex;align-items:center;gap:5px;color:var(--dim);font-size:9px;letter-spacing:.1em}\n#chaos input{width:70px;accent-color:var(--a)}\n#master{display:flex;align-items:center;gap:8px}\n.meter{position:relative;width:8px;height:44px;background:#07070a;border:1px solid var(--ln);border-radius:3px;overflow:hidden}\n.meter i{position:absolute;left:0;right:0;bottom:0;background:linear-gradient(0deg,#3fdc6c,#ffd23f 70%,#ff2d55);height:0}\n.meter.gr i{top:0;bottom:auto;background:linear-gradient(180deg,#ffb347,#ff4a3d)}\n/* ---------- layer strip ---------- */\n#layers{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:6px;padding:6px 14px;border-bottom:1px solid var(--ln)}\n.ch{display:flex;align-items:center;gap:6px;background:var(--pn);border:1px solid var(--ln);border-radius:8px;padding:4px 6px;border-top:2px solid var(--c)}\n.ch{min-width:0;gap:5px}\n.ch .lt{display:flex;flex-direction:column;gap:3px;align-items:flex-start;width:44px;flex:none}\n.ch .nm{font-size:9px;letter-spacing:.16em;font-weight:700;color:var(--c)}\n.ch .k{width:42px}.ch .k svg{width:31px;height:31px}.ch .k .n{height:11px;font-size:8px}.ch .k .v{font-size:8px}\n.ch .mt{width:6px;height:36px;background:#07070a;border-radius:3px;position:relative;overflow:hidden;flex:none}\n.ch .mt i{position:absolute;left:0;right:0;bottom:0;height:0;background:var(--c)}\n.ch .mb{background:none;border:1px solid var(--ln);border-radius:4px;color:var(--dim);font-size:8px;font-weight:700;padding:2px 4px;cursor:pointer}\n.ch .mb.on{background:#ff2d55;color:#fff;border-color:#ff2d55}\n.ch .ks{display:flex;gap:0;margin-left:auto}\n/* ---------- tabs ---------- */\n#tabs{display:flex;gap:2px;padding:6px 14px 0;border-bottom:1px solid var(--ln);overflow-x:auto}\n#tabs button{background:none;border:0;border-bottom:2px solid transparent;color:var(--dim);padding:7px 10px;font-weight:700;font-size:10px;letter-spacing:.14em;cursor:pointer;white-space:nowrap}\n#tabs button:hover{color:var(--ink)}\n#tabs button.on{color:var(--ink);border-bottom-color:var(--a)}\n/* ---------- content ---------- */\n#content{flex:1;overflow:auto;padding:10px 14px 12px}\n.vizrow{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:8px;margin-bottom:8px}\n.viz{background:#09090d;border:1px solid var(--ln);border-radius:8px;position:relative;overflow:hidden}\n.viz canvas{display:block;width:100%;height:118px}\n.viz .cap{position:absolute;left:8px;top:5px;font-size:8px;letter-spacing:.2em;color:var(--dim);pointer-events:none}\n.viz .rd{position:absolute;right:8px;top:5px;font-size:9px;color:var(--a2);pointer-events:none;font-variant-numeric:tabular-nums}\n.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:8px;align-items:start}\n.sec{background:var(--pn);border:1px solid var(--ln);border-radius:10px;padding:8px 10px 6px}\n.sec h2{margin:0 0 7px;font-size:9px;letter-spacing:.24em;color:var(--a);font-weight:700}\n.ctls{display:flex;flex-wrap:wrap;gap:6px 4px}\n.k{display:flex;flex-direction:column;align-items:center;width:58px;user-select:none;touch-action:none;cursor:ns-resize}\n.k svg{width:40px;height:40px;display:block}\n.k .n{font-size:9px;color:var(--dim);text-align:center;margin-top:1px;line-height:1.1;height:20px;overflow:hidden}\n.k .v{font-size:9px;color:var(--a2);font-variant-numeric:tabular-nums;white-space:nowrap}\n.k:hover .n{color:var(--ink)}\n.row{display:flex;align-items:center;gap:5px;flex-wrap:wrap;width:100%}\n.row .lb{font-size:9px;letter-spacing:.14em;color:var(--dim);min-width:62px}\n.seg{display:flex;flex-wrap:wrap;gap:3px}\n.seg button,.tgl{background:var(--pn2);border:1px solid var(--ln);border-radius:5px;padding:4px 7px;font-size:9px;font-weight:700;letter-spacing:.06em;color:var(--dim);cursor:pointer}\n.seg button.on,.tgl.on{background:var(--a);border-color:var(--a);color:#160b0b}\n.seg button:hover,.tgl:hover{color:var(--ink)}\n.seg button.on:hover,.tgl.on:hover{color:#160b0b}\nselect.dd{background:var(--pn2);border:1px solid var(--ln);border-radius:5px;padding:4px 5px;font-size:10px;max-width:150px}\n/* ---------- mod matrix ---------- */\n.mx{width:100%;border-collapse:collapse}\n.mx td{padding:3px 4px;vertical-align:middle}\n.mx td.i{color:var(--dim);font-size:9px;width:16px}\n.mx input[type=range]{width:100%;accent-color:var(--a)}\n.mx .amt{font-size:9px;color:var(--a2);width:42px;text-align:right;font-variant-numeric:tabular-nums}\n/* ---------- pads ---------- */\n#pads{display:grid;grid-template-columns:repeat(16,1fr);gap:4px;padding:6px 14px 8px;border-top:1px solid var(--ln);background:var(--bg2)}\n.pad{height:34px;background:var(--pn2);border:1px solid var(--ln);border-radius:6px;color:var(--dim);font-size:9px;font-weight:700;cursor:pointer;position:relative;user-select:none;touch-action:none}\n.pad small{display:block;font-size:7px;opacity:.7}\n.pad.hit{background:var(--a);color:#150a0a;border-color:var(--a)}\n#hint{position:absolute;right:16px;bottom:52px;background:#000c;border:1px solid var(--ln);border-radius:8px;padding:8px 10px;max-width:340px;font-size:11px;display:none;z-index:9}\n::-webkit-scrollbar{width:9px;height:9px}::-webkit-scrollbar-thumb{background:#2a2a35;border-radius:5px}\n\n@media(max-width:920px){#layers{grid-template-columns:repeat(3,minmax(0,1fr))}}\n@media(max-width:1040px){#chaos{display:none}}\n.vizrow.sm{grid-template-columns:repeat(4,minmax(0,1fr))}.vizrow.sm .viz canvas{height:84px}\n@media(max-width:900px){.vizrow.sm{grid-template-columns:repeat(2,minmax(0,1fr))}}\n</style></head>\n<body>\n<div id=\"app\">\n  <div id=\"top\">\n    <div id=\"logo\">CATACLYSM<small>MASTER DRUM SYNTHESIZER · 6 SOURCES · 257 CONTROLS</small></div>\n    <div id=\"pre\">\n      <button class=\"btn\" id=\"pPrev\" title=\"Previous preset\">◀</button>\n      <select id=\"pSel\" title=\"Factory presets\"></select>\n      <button class=\"btn\" id=\"pNext\" title=\"Next preset\">▶</button>\n      <span id=\"dirty\"></span>\n      <button class=\"btn\" id=\"bInit\" title=\"Back to the Init kick\">INIT</button>\n      <button class=\"btn\" id=\"bRnd\" title=\"Randomise the patch by the CHAOS amount (levels, pans and output are kept)\">RANDOM</button>\n      <button class=\"btn\" id=\"bMod\" title=\"Fill the mod matrix with random routings\">RND MOD</button>\n      <span id=\"chaos\">CHAOS <input type=\"range\" id=\"chaosAmt\" min=\"5\" max=\"100\" value=\"35\"></span>\n      <button class=\"btn\" id=\"bHelp\" title=\"What is all this?\">?</button>\n    </div>\n    <div id=\"master\">\n      <div class=\"meter\" id=\"mL\" title=\"Output L\"><i></i></div><div class=\"meter\" id=\"mR\" title=\"Output R\"><i></i></div>\n      <div class=\"meter gr\" id=\"mGr\" title=\"Compressor gain reduction\"><i></i></div>\n    </div>\n  </div>\n  <div id=\"layers\"></div>\n  <div id=\"tabs\"></div>\n  <div id=\"content\"></div>\n  <div id=\"pads\"></div>\n  <div id=\"hint\"></div>\n</div>\n<script>\nvar DATA={\"params\":[{\"key\":\"ROOT\",\"name\":\"Root Note\",\"tab\":\"hit\",\"sec\":\"TRIGGER\",\"curve\":\"int\",\"min\":12,\"max\":72,\"def\":36,\"steps\":61,\"fmt\":\"note\",\"slot\":34,\"mult\":274625,\"direct\":false,\"tip\":\"The MIDI note that plays every layer at its set pitch.\",\"kind\":\"\",\"silent\":false},{\"key\":\"TUNE\",\"name\":\"Master Tune\",\"tab\":\"hit\",\"sec\":\"TRIGGER\",\"curve\":\"lin\",\"min\":-24,\"max\":24,\"def\":0,\"steps\":193,\"fmt\":\"st\",\"slot\":7,\"mult\":257,\"direct\":false,\"tip\":\"Transposes every layer.\",\"kind\":\"\",\"silent\":false},{\"key\":\"BEND\",\"name\":\"Bend Range\",\"tab\":\"hit\",\"sec\":\"TRIGGER\",\"curve\":\"int\",\"min\":0,\"max\":24,\"def\":2,\"steps\":25,\"fmt\":\"int\",\"slot\":56,\"mult\":858,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"POLY\",\"name\":\"Voices\",\"tab\":\"hit\",\"sec\":\"TRIGGER\",\"curve\":\"int\",\"min\":1,\"max\":4,\"def\":2,\"steps\":4,\"fmt\":\"int\",\"slot\":10,\"mult\":3652264,\"direct\":false,\"tip\":\"1 = mono (each hit chokes the last).\",\"kind\":\"\",\"silent\":false},{\"key\":\"GATE\",\"name\":\"Note-Off\",\"tab\":\"hit\",\"sec\":\"TRIGGER\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":0,\"steps\":2,\"fmt\":[\"one-shot\",\"gate\"],\"slot\":8,\"mult\":7189057,\"direct\":false,\"tip\":\"Gate: releasing the key fades the hit.\",\"kind\":\"\",\"silent\":false},{\"key\":\"REL\",\"name\":\"Release\",\"tab\":\"hit\",\"sec\":\"TRIGGER\",\"curve\":\"exp\",\"min\":1,\"max\":2000,\"def\":40,\"steps\":78,\"fmt\":\"ms\",\"slot\":22,\"mult\":1,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"HUMAN\",\"name\":\"Humanize\",\"tab\":\"hit\",\"sec\":\"TRIGGER\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0,\"steps\":33,\"fmt\":\"pct\",\"slot\":4,\"mult\":481401,\"direct\":false,\"tip\":\"Random pitch / decay / level / detune per hit.\",\"kind\":\"\",\"silent\":false},{\"key\":\"VEL_AMP\",\"name\":\"→ Level\",\"tab\":\"hit\",\"sec\":\"VELOCITY\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0.7,\"steps\":33,\"fmt\":\"pct\",\"slot\":22,\"mult\":474552,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"VEL_PITCH\",\"name\":\"→ Pitch\",\"tab\":\"hit\",\"sec\":\"VELOCITY\",\"curve\":\"lin\",\"min\":0,\"max\":24,\"def\":0,\"steps\":49,\"fmt\":\"st\",\"slot\":33,\"mult\":283075,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"VEL_DEC\",\"name\":\"→ Decay\",\"tab\":\"hit\",\"sec\":\"VELOCITY\",\"curve\":\"lin\",\"min\":-1,\"max\":1,\"def\":0,\"steps\":33,\"fmt\":\"bip\",\"slot\":23,\"mult\":474552,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"VEL_BRT\",\"name\":\"→ Bright\",\"tab\":\"hit\",\"sec\":\"VELOCITY\",\"curve\":\"lin\",\"min\":-1,\"max\":1,\"def\":0,\"steps\":33,\"fmt\":\"bip\",\"slot\":24,\"mult\":474552,\"direct\":false,\"tip\":\"Opens filters, boosts click / FM index / drive with velocity.\",\"kind\":\"\",\"silent\":false},{\"key\":\"RAT_N\",\"name\":\"Repeats\",\"tab\":\"hit\",\"sec\":\"RATCHET · FLAM · ROLL\",\"curve\":\"int\",\"min\":1,\"max\":32,\"def\":1,\"steps\":32,\"fmt\":\"int\",\"slot\":21,\"mult\":518319,\"direct\":false,\"tip\":\"Re-fires the whole hit this many times.\",\"kind\":\"\",\"silent\":false},{\"key\":\"RAT_SYNC\",\"name\":\"Rate Sync\",\"tab\":\"hit\",\"sec\":\"RATCHET · FLAM · ROLL\",\"curve\":\"int\",\"min\":0,\"max\":7,\"def\":0,\"steps\":8,\"fmt\":[\"free\",\"1/8\",\"1/16\",\"1/32\",\"1/64\",\"1/8T\",\"1/16T\",\"1/32T\"],\"slot\":49,\"mult\":1830609,\"direct\":false,\"tip\":\"Locks repeats to the DAW tempo.\",\"kind\":\"\",\"silent\":false},{\"key\":\"RAT_TIME\",\"name\":\"Spacing\",\"tab\":\"hit\",\"sec\":\"RATCHET · FLAM · ROLL\",\"curve\":\"exp\",\"min\":1.5,\"max\":500,\"def\":60,\"steps\":116,\"fmt\":\"ms\",\"slot\":14,\"mult\":1,\"direct\":false,\"tip\":\"Down to 1.5 ms the repeats fuse into a buzzing pitch.\",\"kind\":\"\",\"silent\":false},{\"key\":\"RAT_VEL\",\"name\":\"Level Slope\",\"tab\":\"hit\",\"sec\":\"RATCHET · FLAM · ROLL\",\"curve\":\"lin\",\"min\":-1,\"max\":1,\"def\":-0.2,\"steps\":41,\"fmt\":\"bip\",\"slot\":28,\"mult\":389017,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"RAT_PITCH\",\"name\":\"Pitch Step\",\"tab\":\"hit\",\"sec\":\"RATCHET · FLAM · ROLL\",\"curve\":\"lin\",\"min\":-12,\"max\":12,\"def\":0,\"steps\":79,\"fmt\":\"st\",\"slot\":21,\"mult\":6561,\"direct\":false,\"tip\":\"Added per repeat: rising or falling rolls.\",\"kind\":\"\",\"silent\":false},{\"key\":\"RAT_RAND\",\"name\":\"Time Jitter\",\"tab\":\"hit\",\"sec\":\"RATCHET · FLAM · ROLL\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0,\"steps\":33,\"fmt\":\"pct\",\"slot\":25,\"mult\":474552,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"RAT_PROB\",\"name\":\"Probability\",\"tab\":\"hit\",\"sec\":\"RATCHET · FLAM · ROLL\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":1,\"steps\":33,\"fmt\":\"pct\",\"slot\":26,\"mult\":474552,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"MAC1\",\"name\":\"Macro 1\",\"tab\":\"hit\",\"sec\":\"MACROS (AUTOMATABLE)\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0,\"steps\":0,\"fmt\":\"pct\",\"slot\":0,\"mult\":1,\"direct\":true,\"tip\":\"A real DAW parameter. Route it anywhere in the MOD matrix.\",\"kind\":\"\",\"silent\":false},{\"key\":\"MAC2\",\"name\":\"Macro 2\",\"tab\":\"hit\",\"sec\":\"MACROS (AUTOMATABLE)\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0,\"steps\":0,\"fmt\":\"pct\",\"slot\":1,\"mult\":1,\"direct\":true,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"MAC3\",\"name\":\"Macro 3\",\"tab\":\"hit\",\"sec\":\"MACROS (AUTOMATABLE)\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0,\"steps\":0,\"fmt\":\"pct\",\"slot\":2,\"mult\":1,\"direct\":true,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"MAC4\",\"name\":\"Macro 4\",\"tab\":\"hit\",\"sec\":\"MACROS (AUTOMATABLE)\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0,\"steps\":0,\"fmt\":\"pct\",\"slot\":3,\"mult\":1,\"direct\":true,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"T_LEV\",\"name\":\"Tone\",\"tab\":\"tone\",\"sec\":\"OSCILLATOR\",\"curve\":\"lin\",\"min\":-60,\"max\":12,\"def\":0,\"steps\":73,\"fmt\":\"db\",\"slot\":28,\"mult\":1,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":true},{\"key\":\"T_PAN\",\"name\":\"Tone Pan\",\"tab\":\"tone\",\"sec\":\"OSCILLATOR\",\"curve\":\"lin\",\"min\":-1,\"max\":1,\"def\":0,\"steps\":41,\"fmt\":\"pan\",\"slot\":29,\"mult\":389017,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"T_SHAPE\",\"name\":\"Shape\",\"tab\":\"tone\",\"sec\":\"OSCILLATOR\",\"curve\":\"lin\",\"min\":0,\"max\":3,\"def\":0,\"steps\":73,\"fmt\":\"wave\",\"slot\":28,\"mult\":73,\"direct\":false,\"tip\":\"Sine → triangle → saw → square (continuous).\",\"kind\":\"\",\"silent\":false},{\"key\":\"T_PW\",\"name\":\"Pulse Width\",\"tab\":\"tone\",\"sec\":\"OSCILLATOR\",\"curve\":\"lin\",\"min\":0.02,\"max\":0.5,\"def\":0.5,\"steps\":33,\"fmt\":\"pct\",\"slot\":27,\"mult\":474552,\"direct\":false,\"tip\":\"Narrows the square part.\",\"kind\":\"\",\"silent\":false},{\"key\":\"T_FOLD\",\"name\":\"Fold\",\"tab\":\"tone\",\"sec\":\"OSCILLATOR\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0,\"steps\":49,\"fmt\":\"pct\",\"slot\":42,\"mult\":1,\"direct\":false,\"tip\":\"Wavefolder: up to 8 folds.\",\"kind\":\"\",\"silent\":false},{\"key\":\"T_FB\",\"name\":\"Feedback\",\"tab\":\"tone\",\"sec\":\"OSCILLATOR\",\"curve\":\"lin\",\"min\":0,\"max\":2,\"def\":0,\"steps\":65,\"fmt\":\"val\",\"slot\":33,\"mult\":67,\"direct\":false,\"tip\":\"Oscillator phase feedback: sine → raspy → noise.\",\"kind\":\"\",\"silent\":false},{\"key\":\"T_SYNC\",\"name\":\"Hard Sync\",\"tab\":\"tone\",\"sec\":\"OSCILLATOR\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":0,\"steps\":2,\"fmt\":[\"off\",\"on\"],\"slot\":42,\"mult\":5764801,\"direct\":false,\"tip\":\"\",\"kind\":\"tog\",\"silent\":false},{\"key\":\"T_SYNCR\",\"name\":\"Sync Ratio\",\"tab\":\"tone\",\"sec\":\"OSCILLATOR\",\"curve\":\"exp\",\"min\":1,\"max\":16,\"def\":2.5,\"steps\":78,\"fmt\":\"x\",\"slot\":22,\"mult\":78,\"direct\":false,\"tip\":\"Slave/master ratio; sweep it with the pitch envelope for a screaming tone.\",\"kind\":\"\",\"silent\":false},{\"key\":\"T_SUB\",\"name\":\"Sub\",\"tab\":\"tone\",\"sec\":\"OSCILLATOR\",\"curve\":\"lin\",\"min\":-60,\"max\":6,\"def\":-60,\"steps\":67,\"fmt\":\"db\",\"slot\":33,\"mult\":1,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":true},{\"key\":\"T_SUBOCT\",\"name\":\"Sub Octave\",\"tab\":\"tone\",\"sec\":\"OSCILLATOR\",\"curve\":\"int\",\"min\":0,\"max\":1,\"def\":0,\"steps\":2,\"fmt\":[\"-1\",\"-2\"],\"slot\":43,\"mult\":5764801,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"T_PITCH\",\"name\":\"Pitch\",\"tab\":\"tone\",\"sec\":\"PITCH\",\"curve\":\"exp\",\"min\":8,\"max\":8000,\"def\":52,\"steps\":801,\"fmt\":\"hz\",\"slot\":4,\"mult\":1,\"direct\":false,\"tip\":\"Frequency at the Root Note.\",\"kind\":\"\",\"silent\":false},{\"key\":\"T_KT\",\"name\":\"Key Track\",\"tab\":\"tone\",\"sec\":\"PITCH\",\"curve\":\"lin\",\"min\":0,\"max\":1.5,\"def\":1,\"steps\":4,\"fmt\":\"kt\",\"slot\":46,\"mult\":3634322,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"T_PE1_AMT\",\"name\":\"Env 1 Amt\",\"tab\":\"tone\",\"sec\":\"PITCH\",\"curve\":\"lin\",\"min\":-120,\"max\":120,\"def\":30,\"steps\":481,\"fmt\":\"st\",\"slot\":5,\"mult\":1,\"direct\":false,\"tip\":\"Pitch envelope 1: starts this many semitones away, glides home.\",\"kind\":\"\",\"silent\":false},{\"key\":\"T_PE1_TIME\",\"name\":\"Env 1 Time\",\"tab\":\"tone\",\"sec\":\"PITCH\",\"curve\":\"exp\",\"min\":0.1,\"max\":4000,\"def\":80,\"steps\":161,\"fmt\":\"ms\",\"slot\":9,\"mult\":169,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"T_PE1_CRV\",\"name\":\"Env 1 Curve\",\"tab\":\"tone\",\"sec\":\"PITCH\",\"curve\":\"lin\",\"min\":-1,\"max\":1,\"def\":0,\"steps\":21,\"fmt\":\"bip\",\"slot\":57,\"mult\":1,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"T_PE2_AMT\",\"name\":\"Env 2 Amt\",\"tab\":\"tone\",\"sec\":\"PITCH\",\"curve\":\"lin\",\"min\":-120,\"max\":120,\"def\":0,\"steps\":193,\"fmt\":\"st\",\"slot\":7,\"mult\":49601,\"direct\":false,\"tip\":\"Second, slower pitch envelope (the 'sigh').\",\"kind\":\"\",\"silent\":false},{\"key\":\"T_PE2_TIME\",\"name\":\"Env 2 Time\",\"tab\":\"tone\",\"sec\":\"PITCH\",\"curve\":\"exp\",\"min\":0.1,\"max\":4000,\"def\":400,\"steps\":129,\"fmt\":\"ms\",\"slot\":11,\"mult\":1,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"T_TENS\",\"name\":\"Tension\",\"tab\":\"tone\",\"sec\":\"PITCH\",\"curve\":\"lin\",\"min\":0,\"max\":24,\"def\":0,\"steps\":49,\"fmt\":\"st\",\"slot\":42,\"mult\":49,\"direct\":false,\"tip\":\"Membrane tension modulation: pitch rises with amplitude, settles as the head rings down.\",\"kind\":\"\",\"silent\":false},{\"key\":\"T_ATT\",\"name\":\"Attack\",\"tab\":\"tone\",\"sec\":\"AMP ENVELOPE\",\"curve\":\"exp\",\"min\":0.01,\"max\":200,\"def\":0.01,\"steps\":61,\"fmt\":\"ms\",\"slot\":35,\"mult\":274625,\"direct\":false,\"tip\":\"Fade-in. 0.01 ms = instant.\",\"kind\":\"\",\"silent\":false},{\"key\":\"T_DEC\",\"name\":\"Decay\",\"tab\":\"tone\",\"sec\":\"AMP ENVELOPE\",\"curve\":\"exp\",\"min\":2,\"max\":12000,\"def\":380,\"steps\":129,\"fmt\":\"ms\",\"slot\":11,\"mult\":129,\"direct\":false,\"tip\":\"Time to fall 60 dB.\",\"kind\":\"\",\"silent\":false},{\"key\":\"T_CRV\",\"name\":\"Curve\",\"tab\":\"tone\",\"sec\":\"AMP ENVELOPE\",\"curve\":\"lin\",\"min\":-1,\"max\":1,\"def\":0,\"steps\":21,\"fmt\":\"bip\",\"slot\":57,\"mult\":21,\"direct\":false,\"tip\":\"<0 snaps down then lingers; >0 holds then drops (gate-like).\",\"kind\":\"\",\"silent\":false},{\"key\":\"T_TAIL\",\"name\":\"Tail\",\"tab\":\"tone\",\"sec\":\"AMP ENVELOPE\",\"curve\":\"lin\",\"min\":-60,\"max\":0,\"def\":-60,\"steps\":31,\"fmt\":\"db\",\"slot\":17,\"mult\":531441,\"direct\":false,\"tip\":\"Second, slower decay layered under the main one (the 'boom').\",\"kind\":\"\",\"silent\":true},{\"key\":\"T_TAILT\",\"name\":\"Tail Time\",\"tab\":\"tone\",\"sec\":\"AMP ENVELOPE\",\"curve\":\"exp\",\"min\":20,\"max\":20000,\"def\":1500,\"steps\":81,\"fmt\":\"ms\",\"slot\":5,\"mult\":173641,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"F_LEV\",\"name\":\"FM\",\"tab\":\"fm\",\"sec\":\"OPERATORS\",\"curve\":\"lin\",\"min\":-60,\"max\":12,\"def\":-60,\"steps\":73,\"fmt\":\"db\",\"slot\":28,\"mult\":5329,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":true},{\"key\":\"F_PAN\",\"name\":\"FM Pan\",\"tab\":\"fm\",\"sec\":\"OPERATORS\",\"curve\":\"lin\",\"min\":-1,\"max\":1,\"def\":0,\"steps\":41,\"fmt\":\"pan\",\"slot\":30,\"mult\":389017,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"F_FREQ\",\"name\":\"Carrier\",\"tab\":\"fm\",\"sec\":\"OPERATORS\",\"curve\":\"exp\",\"min\":20,\"max\":8000,\"def\":180,\"steps\":361,\"fmt\":\"hz\",\"slot\":5,\"mult\":481,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"F_KT\",\"name\":\"Key Track\",\"tab\":\"fm\",\"sec\":\"OPERATORS\",\"curve\":\"lin\",\"min\":0,\"max\":1.5,\"def\":1,\"steps\":4,\"fmt\":\"kt\",\"slot\":48,\"mult\":2825761,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"F_FOLLOW\",\"name\":\"Follow Tone Env\",\"tab\":\"fm\",\"sec\":\"OPERATORS\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":1,\"steps\":33,\"fmt\":\"pct\",\"slot\":49,\"mult\":1681,\"direct\":false,\"tip\":\"How much of Tone pitch envelope 1 the carrier inherits.\",\"kind\":\"\",\"silent\":false},{\"key\":\"F_MRATIO\",\"name\":\"Mod Ratio\",\"tab\":\"fm\",\"sec\":\"OPERATORS\",\"curve\":\"exp\",\"min\":0.125,\"max\":32,\"def\":1.41,\"steps\":193,\"fmt\":\"ratio\",\"slot\":8,\"mult\":1,\"direct\":false,\"tip\":\"Non-integer ratios give bells, clanks and toms.\",\"kind\":\"\",\"silent\":false},{\"key\":\"F_DET\",\"name\":\"Mod Detune\",\"tab\":\"fm\",\"sec\":\"OPERATORS\",\"curve\":\"lin\",\"min\":-100,\"max\":100,\"def\":0,\"steps\":81,\"fmt\":\"ct\",\"slot\":17,\"mult\":1,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"F_MWAVE\",\"name\":\"Mod Wave\",\"tab\":\"fm\",\"sec\":\"OPERATORS\",\"curve\":\"int\",\"min\":0,\"max\":3,\"def\":0,\"steps\":4,\"fmt\":[\"sine\",\"tri\",\"square\",\"noise\"],\"slot\":55,\"mult\":1185921,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"F_MODE\",\"name\":\"Mode\",\"tab\":\"fm\",\"sec\":\"OPERATORS\",\"curve\":\"int\",\"min\":0,\"max\":2,\"def\":0,\"steps\":3,\"fmt\":[\"FM\",\"ring\",\"AM\"],\"slot\":9,\"mult\":4380649,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"F_IDX\",\"name\":\"Index\",\"tab\":\"fm\",\"sec\":\"INDEX\",\"curve\":\"lin\",\"min\":0,\"max\":48,\"def\":3,\"steps\":78,\"fmt\":\"val\",\"slot\":22,\"mult\":6084,\"direct\":false,\"tip\":\"Modulation depth in radians. Beyond ~10 it is pure noise-like grit.\",\"kind\":\"\",\"silent\":false},{\"key\":\"F_IDXT\",\"name\":\"Index Decay\",\"tab\":\"fm\",\"sec\":\"INDEX\",\"curve\":\"exp\",\"min\":0.5,\"max\":4000,\"def\":90,\"steps\":129,\"fmt\":\"ms\",\"slot\":11,\"mult\":16641,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"F_IDXC\",\"name\":\"Index Curve\",\"tab\":\"fm\",\"sec\":\"INDEX\",\"curve\":\"lin\",\"min\":-1,\"max\":1,\"def\":0,\"steps\":21,\"fmt\":\"bip\",\"slot\":57,\"mult\":441,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"F_FB\",\"name\":\"Feedback\",\"tab\":\"fm\",\"sec\":\"INDEX\",\"curve\":\"lin\",\"min\":0,\"max\":2,\"def\":0,\"steps\":65,\"fmt\":\"val\",\"slot\":33,\"mult\":4355,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"F_ATT\",\"name\":\"Attack\",\"tab\":\"fm\",\"sec\":\"AMP ENVELOPE\",\"curve\":\"exp\",\"min\":0.01,\"max\":200,\"def\":0.01,\"steps\":61,\"fmt\":\"ms\",\"slot\":36,\"mult\":274625,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"F_DEC\",\"name\":\"Decay\",\"tab\":\"fm\",\"sec\":\"AMP ENVELOPE\",\"curve\":\"exp\",\"min\":2,\"max\":12000,\"def\":250,\"steps\":129,\"fmt\":\"ms\",\"slot\":12,\"mult\":1,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"F_CRV\",\"name\":\"Curve\",\"tab\":\"fm\",\"sec\":\"AMP ENVELOPE\",\"curve\":\"lin\",\"min\":-1,\"max\":1,\"def\":0,\"steps\":21,\"fmt\":\"bip\",\"slot\":57,\"mult\":9261,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"M_LEV\",\"name\":\"Modal\",\"tab\":\"modal\",\"sec\":\"RESONATOR\",\"curve\":\"lin\",\"min\":-60,\"max\":12,\"def\":-60,\"steps\":73,\"fmt\":\"db\",\"slot\":29,\"mult\":1,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":true},{\"key\":\"M_WIDTH\",\"name\":\"Stereo Spread\",\"tab\":\"modal\",\"sec\":\"RESONATOR\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0.5,\"steps\":33,\"fmt\":\"pct\",\"slot\":49,\"mult\":55473,\"direct\":false,\"tip\":\"Alternate modes are panned left / right.\",\"kind\":\"\",\"silent\":false},{\"key\":\"M_PITCH\",\"name\":\"Pitch\",\"tab\":\"modal\",\"sec\":\"RESONATOR\",\"curve\":\"exp\",\"min\":15,\"max\":4000,\"def\":180,\"steps\":601,\"fmt\":\"hz\",\"slot\":4,\"mult\":801,\"direct\":false,\"tip\":\"Lowest mode.\",\"kind\":\"\",\"silent\":false},{\"key\":\"M_KT\",\"name\":\"Key Track\",\"tab\":\"modal\",\"sec\":\"RESONATOR\",\"curve\":\"lin\",\"min\":0,\"max\":1.5,\"def\":1,\"steps\":4,\"fmt\":\"kt\",\"slot\":57,\"mult\":4084101,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"M_FOLLOW\",\"name\":\"Follow Tone Env\",\"tab\":\"modal\",\"sec\":\"RESONATOR\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0,\"steps\":33,\"fmt\":\"pct\",\"slot\":50,\"mult\":1,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"M_MAT\",\"name\":\"Material\",\"tab\":\"modal\",\"sec\":\"RESONATOR\",\"curve\":\"lin\",\"min\":0,\"max\":5,\"def\":1,\"steps\":101,\"fmt\":\"mat\",\"slot\":15,\"mult\":103,\"direct\":false,\"tip\":\"String · Membrane · Plate · Bar · Bell · Junk — morphs continuously.\",\"kind\":\"\",\"silent\":false},{\"key\":\"M_STR\",\"name\":\"Stretch\",\"tab\":\"modal\",\"sec\":\"RESONATOR\",\"curve\":\"lin\",\"min\":-0.5,\"max\":1.5,\"def\":0,\"steps\":81,\"fmt\":\"val\",\"slot\":17,\"mult\":81,\"direct\":false,\"tip\":\"Inharmonicity: >0 spreads the modes apart (stiffer), <0 squeezes them.\",\"kind\":\"\",\"silent\":false},{\"key\":\"M_NUM\",\"name\":\"Modes\",\"tab\":\"modal\",\"sec\":\"RESONATOR\",\"curve\":\"int\",\"min\":1,\"max\":12,\"def\":8,\"steps\":12,\"fmt\":\"int\",\"slot\":14,\"mult\":1230644,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"M_DEC\",\"name\":\"Decay\",\"tab\":\"modal\",\"sec\":\"DAMPING\",\"curve\":\"exp\",\"min\":5,\"max\":20000,\"def\":300,\"steps\":161,\"fmt\":\"ms\",\"slot\":9,\"mult\":27209,\"direct\":false,\"tip\":\"Ring time of the lowest mode.\",\"kind\":\"\",\"silent\":false},{\"key\":\"M_TILT\",\"name\":\"Damping Tilt\",\"tab\":\"modal\",\"sec\":\"DAMPING\",\"curve\":\"lin\",\"min\":-1,\"max\":3,\"def\":1,\"steps\":81,\"fmt\":\"val\",\"slot\":17,\"mult\":6561,\"direct\":false,\"tip\":\"Higher modes die faster (>0, wood and skin) or ring longer (<0, metal).\",\"kind\":\"\",\"silent\":false},{\"key\":\"M_POS\",\"name\":\"Strike Pos\",\"tab\":\"modal\",\"sec\":\"EXCITATION\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0.3,\"steps\":65,\"fmt\":\"pct\",\"slot\":34,\"mult\":1,\"direct\":false,\"tip\":\"Where the stick lands: nodes of modes cancel them.\",\"kind\":\"\",\"silent\":false},{\"key\":\"M_BRT\",\"name\":\"Brightness\",\"tab\":\"modal\",\"sec\":\"EXCITATION\",\"curve\":\"lin\",\"min\":-1,\"max\":3,\"def\":0.6,\"steps\":81,\"fmt\":\"val\",\"slot\":18,\"mult\":1,\"direct\":false,\"tip\":\"Tilt of the excitation spectrum across the modes.\",\"kind\":\"\",\"silent\":false},{\"key\":\"M_SPREAD\",\"name\":\"Detune Spread\",\"tab\":\"modal\",\"sec\":\"EXCITATION\",\"curve\":\"lin\",\"min\":0,\"max\":200,\"def\":0,\"steps\":65,\"fmt\":\"ct\",\"slot\":34,\"mult\":65,\"direct\":false,\"tip\":\"Random detune per mode per hit.\",\"kind\":\"\",\"silent\":false},{\"key\":\"M_EXCN\",\"name\":\"Exciter Noise\",\"tab\":\"modal\",\"sec\":\"EXCITATION\",\"curve\":\"lin\",\"min\":0,\"max\":1,\"def\":0.2,\"steps\":33,\"fmt\":\"pct\",\"slot\":50,\"mult\":33,\"direct\":false,\"tip\":\"0 = a single impulse (stick), 1 = a noise burst (brush).\",\"kind\":\"\",\"silent\":false},{\"key\":\"M_EXCL\",\"name\":\"Exciter Length\",\"tab\":\"modal\",\"sec\":\"EXCITATION\",\"curve\":\"exp\",\"min\":0.05,\"max\":30,\"def\":1,\"steps\":81,\"fmt\":\"ms\",\"slot\":18,\"mult\":81,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"M_EXCLP\",\"name\":\"Exciter Tone\",\"tab\":\"modal\",\"sec\":\"EXCITATION\",\"curve\":\"exp\",\"min\":100,\"max\":20000,\"def\":6000,\"steps\":78,\"fmt\":\"hz\",\"slot\":23,\"mult\":1,\"direct\":false,\"tip\":\"\",\"kind\":\"\",\"silent\":false},{\"key\":\"M_TENS\",\"name\":\"Tension\",\"tab\":\"modal\",\"sec\":\"NONLINEARITY\",\"curve\":\"lin\",\"min\":0,\"max\":36,\"def\":0,\"steps\":73,\"fmt\":\"st\",\"slot\":29,\"mult\":73,\"direct\":false,\"tip\":\"Pitch rises with the resonator's amplitude (real membranes do this).\",\"kind\":\"\",\"silen