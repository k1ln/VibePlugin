  "html": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Fourfold FM</title>\n<style>\n:root{--a:#4fe0a4;--a2:#c6ffe8;--pn:#0f2119;--ink:#e2f6ee;--dim:#7fa898;--ln:rgba(79,224,164,.16)}\n*{box-sizing:border-box}html,body{margin:0;background:radial-gradient(120% 80% at 50% 0%,#123a2b,#07130d 65%);color:var(--ink);font:12px/1.3 -apple-system,\"Segoe UI\",Helvetica,sans-serif;min-height:100%}\n#app{max-width:1040px;margin:0 auto;padding:12px}\nh1{margin:0 0 8px;font-size:18px;letter-spacing:.3em;font-weight:300;color:var(--a2)}h1 small{letter-spacing:.15em;color:var(--dim);font-size:10px;margin-left:10px}\ncanvas{width:100%;height:150px;display:block;background:#050d09;border:1px solid var(--ln);border-radius:8px}\n.row{display:grid;gap:8px;margin-top:8px}.r3{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}.r4{grid-template-columns:repeat(auto-fit,minmax(235px,1fr))}\n.g{background:var(--pn);border:1px solid var(--ln);border-radius:10px;padding:8px 10px}\n.g h2{margin:0 0 6px;font-size:9px;letter-spacing:.25em;color:var(--a);font-weight:600}\n.ks{display:grid;grid-template-columns:repeat(auto-fill,minmax(54px,1fr));gap:6px 2px;margin-top:6px}\n.tg{display:flex;flex-wrap:wrap;gap:4px;align-items:center;margin-bottom:2px}.tg span{font-size:8px;letter-spacing:.2em;color:var(--dim);width:44px}\n.tg button{background:#0a1a13;color:var(--dim);border:1px solid var(--ln);border-radius:5px;padding:5px 7px;font:600 9px/1 inherit;letter-spacing:.1em;cursor:pointer}\n.tg button.on{background:var(--a);color:#04150d;border-color:var(--a)}\n.k{display:flex;flex-direction:column;align-items:center;user-select:none;touch-action:none;cursor:ns-resize}\n.k svg{width:40px;height:40px}.k .n{font-size:9px;color:var(--dim);text-align:center;margin-top:1px}.k .v{font-size:9px;color:var(--a2)}\n#kb{position:relative;height:76px;margin-top:8px;user-select:none;touch-action:none}\n.w{position:absolute;top:0;height:100%;background:linear-gradient(#eefaf4,#b6d9c8);border:1px solid #07130d;border-radius:0 0 4px 4px}.w.on{background:var(--a)}\n.b{position:absolute;top:0;height:58%;background:linear-gradient(#1f3a2d,#08160f);border-radius:0 0 3px 3px;z-index:2}.b.on{background:var(--a)}\n</style></head><body><div id=\"app\"><h1>FOURFOLD FM<small>4-OPERATOR FM</small></h1><canvas id=\"cv\"></canvas><div class=\"row r4\" id=\"voices\"></div><div class=\"row r3\" id=\"rest\"></div><div id=\"kb\"></div></div>\n<script>\n(function(){\nvar PARAMS=[{\"name\": \"Op1 TL\", \"index\": 0, \"min\": 0, \"max\": 127, \"default\": 30, \"step\": 1}, {\"name\": \"Op1 Multiple\", \"index\": 1, \"min\": 0, \"max\": 15, \"default\": 1, \"step\": 1}, {\"name\": \"Op1 Detune\", \"index\": 2, \"min\": -3, \"max\": 3, \"default\": 0, \"step\": 1}, {\"name\": \"Op1 Attack Rate\", \"index\": 3, \"min\": 0, \"max\": 31, \"default\": 31, \"step\": 1}, {\"name\": \"Op1 Decay 1 Rate\", \"index\": 4, \"min\": 0, \"max\": 31, \"default\": 14, \"step\": 1}, {\"name\": \"Op1 Decay 1 Level\", \"index\": 5, \"min\": 0, \"max\": 15, \"default\": 6, \"step\": 1}, {\"name\": \"Op1 Decay 2 Rate\", \"index\": 6, \"min\": 0, \"max\": 31, \"default\": 2, \"step\": 1}, {\"name\": \"Op1 Release Rate\", \"index\": 7, \"min\": 0, \"max\": 15, \"default\": 8, \"step\": 1}, {\"name\": \"Op1 Key Scale\", \"index\": 8, \"min\": 0, \"max\": 3, \"default\": 1, \"step\": 1}, {\"name\": \"Op1 AM Enable\", \"index\": 9, \"min\": 0, \"max\": 1, \"default\": 0, \"step\": 1}, {\"name\": \"Op1 Wave\", \"index\": 10, \"min\": 0, \"max\": 3, \"default\": 0, \"step\": 1}, {\"name\": \"Op2 TL\", \"index\": 11, \"min\": 0, \"max\": 127, \"default\": 0, \"step\": 1}, {\"name\": \"Op2 Multiple\", \"index\": 12, \"min\": 0, \"max\": 15, \"default\": 1, \"step\": 1}, {\"name\": \"Op2 Detune\", \"index\": 13, \"min\": -3, \"max\": 3, \"default\": 0, \"step\": 1}, {\"name\": \"Op2 Attack Rate\", \"index\": 14, \"min\": 0, \"max\